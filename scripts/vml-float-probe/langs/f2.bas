' f2.bas —— float/double/int64 运算
PRINT "F-MUL="
PRINT INT(3.14# * 2.0# * 100.0#)
PRINT "D-MUL="
PRINT INT(3.14# * 2.0# * 100.0#)
PRINT "F-NEG="
PRINT INT(-0.5# * 100.0#)
PRINT "D-NEG="
PRINT INT(-0.5# * 100.0#)
' ⚠ 「64 位运算」在 BASIC 里只能用 **DOUBLE** 表达 —— QBasic 的数值类型是
'   INTEGER(16) / LONG(32) / SINGLE(32) / DOUBLE(64)，**根本没有 64 位整数**。
'   所以这里显式写成 `xxx.0#`（双精度字面量）：不带 `#`/小数点的大整数会被当
'   整数字面量，`3000000000` 在 32 位里截断（实测 INT(3000000000) 饱和成 2147483647、
'   `(3000000000 + 1000000000)` 得垃圾）。双精度尾数 53 位 ⇒ 2^53 以内的整数精确。
PRINT "L-ADD="
PRINT INT((3000000000.0# + 1000000000.0#) / 1000000000.0#)
PRINT "L-MUL="
PRINT INT(((5000000000.0# / 5.0#) * 2.0#) / 1000000000.0#)
PRINT "L-NEG="
PRINT INT((0.0# - 4294967296.0#) / 1000000000.0#)
