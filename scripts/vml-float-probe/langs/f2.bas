' f2.bas —— float/double/int64 运算
PRINT "F-MUL="; INT(3.14# * 2.0# * 100.0#)
PRINT "D-MUL="; INT(3.14# * 2.0# * 100.0#)
PRINT "F-NEG="; INT(-0.5# * 100.0#)
PRINT "D-NEG="; INT(-0.5# * 100.0#)
PRINT "L-ADD="; INT((3000000000 + 1000000000) / 1000000000)
PRINT "L-MUL="; INT((123456789 * 1000) / 1000000000)
PRINT "L-NEG="; INT((0 - 4294967296) / 1000000000)
