<!-- 输入对话框 -->
<Dialog title="输入" width="48" height="9" border="rounded" borderColor="cyan">
  <VBox align="center" spacing="1">
    <Label id="prompt" text="请输入项目名称" />
    <Input id="input" width="40" value="" />
    <HBox align="center" spacing="2">
      <Button id="ok" text="确定" />
      <Button id="cancel" text="取消" />
    </HBox>
  </VBox>
</Dialog>
