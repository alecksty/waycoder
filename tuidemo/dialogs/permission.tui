<!-- 权限确认对话框（黄底黑字风格） -->
<Dialog title="权限确认" width="48" height="8" border="solid" borderColor="warning" shortcut="escape">
  <VBox align="center" spacing="1">
    <Label id="msg" text="bash 工具请求执行：rm -rf /tmp/cache/*" fg="text" />
    <HBox align="center" spacing="2">
      <Button id="allow" text="允许 (Y)" shortcut="y" />
      <Button id="deny" text="拒绝 (N)" shortcut="n" />
      <Button id="always" text="全部允许 (A)" shortcut="a" />
    </HBox>
  </VBox>
</Dialog>
