<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WayCoder</RootNamespace>
    <!-- AOT 编译：单文件 NativeAOT 部署，零依赖瞬时启动 -->
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <AssemblyName>waycoder</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- AOT: 项目中使用的 JsonSerializer/JsonArray.Add<T> 在 AOT 路径中已被 JsonHelper 替代，
         这些 IL 警告仅在非 AOT Debug 构建中产生，不影响 AOT 发布 -->
    <NoWarn>IL2026;IL3050</NoWarn>
    <!-- TerminalRawMode 用 [LibraryImport] P/Invoke termios（探测字符宽度），源生成要求 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 测试代码开关：WAYCODER_TEST 仅在 Debug 定义（/test 指令、Keypad、SelfTest 等）；
         Release 不定义并排除 Test/ 目录 —— 生产版不含 test 系列指令 -->
    <DefineConstants Condition="'$(Configuration)'=='Debug'">$(DefineConstants);WAYCODER_TEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)'=='Release'">
    <Compile Remove="Test/**" />
  </ItemGroup>


  <!-- 编译期合并 Web 前端资源（www/*.html/css/js → WebAssets.Generated.cs），编辑源文件后重新构建即可 -->
  <Target Name="GenerateWebAssets" BeforeTargets="CoreCompile"
          Inputs="$(MSBuildProjectDirectory)/UI/WEB/www/index.html;$(MSBuildProjectDirectory)/UI/WEB/www/style.css;$(MSBuildProjectDirectory)/UI/WEB/www/app.js"
          Outputs="$(MSBuildProjectDirectory)/UI/WEB/WebAssets.Generated.cs">
    <Exec Command="python3 ../scripts/merge_webassets.py" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <!-- glob 以相对路径 Identity 自动包含生成文件，先按相对路径 Remove 去重，再显式 Include 一次 -->
      <Compile Remove="UI/WEB/WebAssets.Generated.cs" />
      <Compile Include="$(MSBuildProjectDirectory)/UI/WEB/WebAssets.Generated.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Remove="game/**/*.cs" />
    <Compile Remove="games/**/*.cs" />
    <None Remove="game/**/*" />
    <None Remove="games/**/*" />
    <Compile Remove="lottery/**/*.cs" />
    <None Remove="lottery/**/*" />
    <Compile Remove="subs/**/*.cs" />
    <Compile Remove="works/**/*.cs" />
    <None Remove="subs/**/*" />
    <None Remove="works/**/*" />
    <!-- WayEngine 是独立游戏引擎（自带 .sln），误置于本源码树内，排除出主项目编译 -->
    <Compile Remove="WayEngine/**/*.cs" />
    <None Remove="WayEngine/**/*" />
    <!-- SnakeGame 是独立控制台游戏（自带 .csproj + Main），误置于本源码树内，
         其 obj/Debug、obj/Release 生成的 AssemblyInfo 会与主项目编译冲突（CS0579），排除 -->
    <Compile Remove="SnakeGame/**/*.cs" />
    <None Remove="SnakeGame/**/*" />
    <!-- Hello / Hello.Tests 是独立演示项目（net8.0 + xunit），误置于本源码树内，
         默认编译通配会卷入其 .cs / obj 生成文件（CS0579/CS0246），排除 -->
    <Compile Remove="Hello/**/*.cs" />
    <None Remove="Hello/**/*" />
    <Compile Remove="Hello.Tests/**/*.cs" />
    <None Remove="Hello.Tests/**/*" />
    <!-- CommLib/PortLib 是独立 .NET 4.8 通信库（用户旧库，自带 csproj + AssemblyInfo），
         默认编译通配卷入其 .cs/obj 生成文件会与主项目冲突（CS0579 特性重复），排除（调试工具用途另行评估） -->
    <Compile Remove="CommLib/**/*.cs" />
    <None Remove="CommLib/**/*" />
    <Compile Remove="PortLib/**/*.cs" />
    <None Remove="PortLib/**/*" />
  </ItemGroup>

  <ItemGroup>
    <!-- 声明式标记资源（.tui）：UI/TUI/Raw/** 嵌入 exe（AOT 单文件内可直接读），
         同时复制到输出（开发/预览热刷新优先读文件系统）。
         逻辑名 WayCoder.UI.TUI.Raw.<相对路径>，由 TuiMarkupPaths.LoadText 解析。 -->
    <EmbeddedResource Include="UI\TUI\Raw\**\*.tui">
      <LogicalName>WayCoder.UI.TUI.Raw.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Include="UI\TUI\Raw\**\*.tui"
          Link="Raw\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
