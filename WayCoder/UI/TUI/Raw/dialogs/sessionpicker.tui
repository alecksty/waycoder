<!-- 会话管理 —— 配合 SessionPicker code-behind。
     标记声明结构；会话列表逐行 AddItem + 双色高亮、按钮渐变、过滤/快捷键由代码填充。 -->
<Dialog title="会话管理" border="solid" borderColor="info"
        width="68" minWidth="68" maxWidth="100" height="18"
        gradient="true" gradientStart="#00e6ff" gradientEnd="#0064dc">
  <VBox>
    <Label id="stats" height="1" fg="4" />
    <HBox spacing="1">
      <Label text="搜索:" width="6" fg="8" />
      <Input id="search" height="1" flex="1" focused="true" />
    </HBox>
    <!-- 列表项 code-behind 动态填充；{InDesign '…'} 内为设计态样本，真实运行解析为空串 -->
    <ListView id="list" height="12" autoScroll="false"
              items="{InDesign '今日会话 (12:30),修 bug (11:05),添加新工具 (09:40),昨天会话'}" />
    <HBox spacing="2">
      <Button id="openBtn" text="打开 (Enter)" flex="1" />
      <Button id="renameBtn" text="重命名 (R)" flex="1" />
      <Button id="delBtn" text="删除 (Del)" flex="1" />
      <Button id="closeBtn" text="关闭 (Esc)" flex="1" />
    </HBox>
    <Label id="help" height="1" fg="8" />
  </VBox>
</Dialog>
