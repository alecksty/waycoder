<!-- 推理深度选择 —— 配合 ReasoningPicker code-behind（最简迁移样板）。
     标题/级别列表项由代码填充；过滤/确认/重置/取消快捷键由代码处理。 -->
<Dialog title="推理深度" border="solid" borderColor="info"
        scale="0.6" minWidth="44" height="10" minHeight="10"
        gradient="true" gradientStart="#b450ff" gradientEnd="#ff64c8">
  <VBox>
    <Label text="选择推理深度：控制模型思考强度（↑↓ 选择 · Enter 确认）" />
    <Input id="search" height="1" focused="true" />
    <List id="list" height="5"
          items="{InDesign '极简（速度优先）,标准（平衡）,深度（慢但更好）,极限（最深入）'}" />
    <Label text="↑↓ 选择 · Enter 确认 · ← 重置 · Esc 取消" fg="8" />
  </VBox>
</Dialog>
