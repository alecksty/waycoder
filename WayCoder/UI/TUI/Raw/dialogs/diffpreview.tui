<!-- Diff 预览 —— 配合 DiffPreview code-behind。
     窗口标题/宽高、DiffView 主体（flex 填充）、Y/N/A/Q 状态机由代码处理；
     DiffView 控件由 code 创建并注入 body 首位。
     底部四个按钮（接受/跳过/全部接受/取消）由 code-behind 接线，同时保留 Y/N/A/Q 快捷键：
     焦点切到按钮按空格 = 点按钮，直接按字母 = 快捷键，两条路走同一个动作。 -->
<Dialog title="Diff 预览" border="solid" borderColor="info" mask="true"
        minWidth="60" minHeight="12" width="90" height="20"
        gradient="warning">
  <VBox id="body" spacing="1">
    <!-- DiffView（自定义 TuiControl）由 code-behind Insert(0) 注入，flex=1 填充剩余空间 -->
    <Label id="status" height="1" fg="black" bg="white" align="center" />
    <HBox align="center" spacing="2">
      <Button id="btnAccept" text="接受(Y)" shortcut="y" />
      <Button id="btnSkip" text="跳过(N)" shortcut="n" />
      <Button id="btnAll" text="全部接受(A)" shortcut="a" />
      <Button id="btnCancel" text="取消(Q)" shortcut="q" />
    </HBox>
  </VBox>
</Dialog>
