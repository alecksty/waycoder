<!-- 模型选择器 —— 配合 ModelPicker code-behind。
     标记声明结构；表格行数据/槽位条/帮助文本/按钮回调由代码填充。 -->
<!-- 底色不写死：跟所有对话框一样走主题灰底（WindowBg），文字黑；
     搜索框与表格是控件，走主题的黑底白字（InputBg/ListBg），选中行反色。
     gradient="warning"：金色渐变外框（对标权限框），色值随主题（GradOrangeYellow）；
     渐变分支顺带把标题居中（非渐变分支的标题是硬左对齐的）。
     按钮的金色渐变底是 TuiButton 默认值（同色系亮 30%），标记不写；
     要关或换色才写 gradient="false" / gradient="btnCyanBlue"。

     交互原则：功能一律做成按钮，Tab 切焦点 + 空格/Enter 执行，不抢字母键 ——
     否则以 s/i/o/k/a 或数字开头的过滤词首字符会被快捷键吞掉。 -->
<Dialog title="选择模型" border="solid" borderColor="warning"
        width="78" minWidth="62" minHeight="16" height="22" gradient="warning">
  <VBox>
    <HBox spacing="1">
      <Label text="搜索:" width="6" fg="black" />
      <Input id="search" height="1" flex="1" focused="true" />
    </HBox>
    <!-- 占位：搜索框与表格都是黑底控件，贴在一起看不出边界 -->
    <Space height="1" />
    <!-- flex="1"：表格吃掉剩余高度，下面四行（槽位/两行按钮/帮助）由 VBox 保底留出。
         stretch="true"：列宽按下面声明的比例放大铺满控件宽，否则固定列宽在宽窗口里全挤左边 -->
    <TableList id="table" height="11" flex="1" showHeader="true" stretch="true"
               columns="🔑:3,模型:24,厂商:11,状态:6,窗口:6,价格:6,大:2,小:2"
               items="{InDesign '🔑,✔连通,deepseek-v4-pro,深言科技,128k,¥20,✓,✓|🔑,无key,deepseek-v4-flash,深言科技,64k,¥1,✓,✓|🔑,欠费,gpt-5.4-pro,OpenAI,200k,¥180,✓,✓|🔑,✖不通,qwen-max,阿里云,128k,¥40,✓,✓|🔑,✔连通,glm-4.5,智谱AI,128k,¥10,✓,✓'}" />
    <Label id="slotBar" height="1" fg="black" align="center" />
    <!-- 按钮文本 code-behind 会改（btnMode 在大/小模型间切），flex="1" 让整行等宽铺满：
         窄窗口不溢出、宽窗口自适应，且「按钮一样宽」不靠手算列宽 -->
    <HBox align="center" spacing="1">
      <Button id="btnMode" text="→小模型" flex="1" />
      <Button id="btnAllSlots" text="全部槽位" flex="1" />
      <Button id="btnScan" text="扫描" flex="1" />
      <Button id="btnImport" text="本地导入" flex="1" />
      <Button id="btnOnline" text="在线导入" flex="1" />
      <Button id="btnClear" text="清空" flex="1" />
    </HBox>
    <!-- 占位：两行按钮挨太紧，中间留一行呼吸（与搜索框下空行同理） -->
    <Space height="1" />
    <HBox align="center" spacing="1">
      <Button id="btnSetKey" text="设Key" flex="1" />
      <Button id="btnClrKey" text="清Key" flex="1" />
      <Button id="btnAdd" text="添加" flex="1" />
      <Button id="btnEdit" text="编辑" flex="1" />
      <Button id="btnDel" text="删除" flex="1" />
      <Button id="btnSave" text="✓ 保存" flex="1" />
    </HBox>
    <!-- 两行提示：静态键位说明 + 状态回显（扫描/导入结果覆盖 help、清空 help2） -->
    <Label id="help" height="1" fg="black" align="center" />
    <Label id="help2" height="1" fg="black" align="center" />
  </VBox>
</Dialog>
