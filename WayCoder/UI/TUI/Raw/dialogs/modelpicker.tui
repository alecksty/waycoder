<!-- 模型选择器 —— 配合 ModelPicker code-behind。
     标记声明结构；搜索过滤/表格列与行数据/槽位/帮助文本/键盘拦截由代码填充。 -->
<Dialog title="选择模型" border="solid" borderColor="brightblack" bg="black"
        width="78" minWidth="62" minHeight="16" height="20" gradient="false">
  <VBox>
    <HBox spacing="1">
      <Label text="搜索:" width="6" fg="8" />
      <Input id="search" height="1" flex="1" focused="true" fg="white" bg="black" />
    </HBox>
    <TableList id="table" height="13" showHeader="true"
               columns="🔑:2,模型:24,厂商:11,窗口:6,价格:7,大:2,小:2"
               items="{InDesign '🔑,deepseek-v4-pro,深言科技,128k,¥20,✓,✓|🔑,deepseek-v4-flash,深言科技,64k,¥1,✓,✓|🔑,gpt-5.4-pro,OpenAI,200k,¥180,✓,✓|🔑,qwen-max,阿里云,128k,¥40,✓,✓|🔑,glm-4.5,智谱AI,128k,¥10,✓,✓'}" />
    <Label id="slotBar" height="1" fg="8" />
    <Label id="help" height="1" fg="8" />
    <Label id="help2" height="1" fg="8" />
  </VBox>
</Dialog>
