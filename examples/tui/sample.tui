<!-- WayCoder TUI 声明式标记示例 —— 预览：waycoder --tui-preview examples/tui/sample.tui -->
<Window title="WayCoder 欢迎" width="52" height="12" border="rounded" borderColor="cyan">
  <VBox align="center" spacing="1">
    <Label text="欢迎使用 WayCoder（道码）" align="center" fg="cyan" />
    <Label text="一个中文易用编程智能体" align="center" fg="grey" />
    <Label text="" />
    <HBox align="center" spacing="2">
      <Button text="新建会话" />
      <Button text="继续会话" />
      <Button text="设置" />
    </HBox>
    <Progress value="67" width="40" />
    <Label text="按 F1-F10 切换槽位  |  Ctrl+M 模型" align="center" fg="grey" />
  </VBox>
</Window>
