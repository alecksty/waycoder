<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WayCoder.UI.Gui.ProviderWindow"
        Width="880"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}">
    <DockPanel>

        <!-- 顶部操作按钮行 -->
        <StackPanel x:Name="TopBtn"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="12,10,12,4" />

        <!-- 表头（代码填充 6 列） -->
        <Grid x:Name="HeaderGrid"
              DockPanel.Dock="Top"
              Margin="12,4,12,0" />

        <!-- 状态行 -->
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   FontSize="12"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="12,0,12,10" />

        <!-- 供应商列表 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,4,12,4">
            <StackPanel x:Name="ListHost" Spacing="6" />
        </ScrollViewer>
    </DockPanel>
</Window>
