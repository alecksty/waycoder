<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WayCoder.UI.Gui.MainWindow"
        Title="WayCoder（道码）"
        Width="1180" Height="720"
        Background="{DynamicResource WindowBgBrush}">
    <Grid RowDefinitions="Auto,*">

        <!-- 顶栏（跨三栏，对齐 Web <header>） -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="14,9">
                <!-- 标志：🤖 道码 WayCoder（Coder 品牌蓝高亮） -->
                <TextBlock x:Name="HeaderLabel"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center">
                    <Run Text="🤖 道码 Way" />
                    <Run Text="Coder"
                         Foreground="{DynamicResource AccentBrush}" />
                </TextBlock>
                <TextBlock Grid.Column="1" x:Name="SlotLabel"
                           Text="智能体1" FontSize="13"
                           Foreground="{DynamicResource DimTextBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                <Button
                    Grid.Column="2"
                    x:Name="ThemeButton" Content="🌙"
                    Foreground="{DynamicResource TextBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    ToolTip.Tip="切换主题"
                    Click="Theme_Click"
                    Margin="0,0,8,0" />

                <Button
                    Grid.Column="3"
                    x:Name="ModelButton"
                    ToolTip.Tip="选择模型"
                    IsVisible="False"
                    Foreground="{DynamicResource TextBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Click="ModelButton_Click"
                    Margin="0,0,8,0" />

                <Button
                    Grid.Column="4"
                    x:Name="EditorButton"
                    Content="✏ 编辑器"
                    Foreground="{DynamicResource TextBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    ToolTip.Tip="打开内置代码编辑器"
                    Click="EditorButton_Click"
                    Margin="0,0,8,0" />

                <Button
                    Grid.Column="5"
                    x:Name="SettingsButton"
                    Content="⚙ 设置"
                    Foreground="{DynamicResource TextBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    ToolTip.Tip="设置"
                    Click="Settings_Click"
                    Margin="0,0,8,0" />
            </Grid>
        </Border>

        <!-- 三栏：左（槽位+会话）/ 中（聊天+composer）/ 右（面板） -->
        <Grid Grid.Row="1" ColumnDefinitions="250,*,300">

            <!-- 左栏 -->
            <Border Grid.Column="0" x:Name="LeftPanel"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock Text="🗂 槽位"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DimTextBrush}"
                               Margin="14,12,14,6" />

                    <StackPanel x:Name="SlotPanel"
                                Orientation="Horizontal"
                                Spacing="4"
                                Margin="12,0,12,6" />

                    <Grid ColumnDefinitions="*,Auto" Margin="12,4,12,8">
                        <Button
                            x:Name="NewSessionBtn"
                            Content="＋ 新建会话"
                            FontSize="11"
                            Padding="8,4"
                            Foreground="{DynamicResource TextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            ToolTip.Tip="新建会话"
                            Click="NewSession_Click" />

                        <Button Grid.Column="1" x:Name="ClearSessionsBtn" Content="🗑"
                                Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                FontSize="11" Padding="8,4" Margin="6,0,0,0"
                                ToolTip.Tip="清空所有会话记录" Click="ClearSessions_Click" />
                    </Grid>
                    <TextBlock
                        Text="📜 历史会话"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource DimTextBrush}"
                        Margin="14,0,14,6" />
                    <ScrollViewer
                        x:Name="SessionListHost"
                        VerticalScrollBarVisibility="Auto"
                        Margin="8,0,8,8" />
                </StackPanel>
            </Border>

            <!-- 中栏 -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto">
                <ScrollViewer
                    x:Name="ChatScroll"
                    VerticalScrollBarVisibility="Auto"
                    Background="{DynamicResource WindowBgBrush}"
                    Padding="16,12">
                    <StackPanel x:Name="MessagesHost" Spacing="10" />
                </ScrollViewer>

                <!-- Agent 动态状态栏（聊天与输入框之间）：空闲隐藏，活动显示状态 + Braille 等待动画 -->
                <Border
                    Grid.Row="1"
                    x:Name="AgentStatusBar"
                    IsVisible="False"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="16,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="AgentStatusSpin" Text="⠋" FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock x:Name="AgentStatusText" Text="就绪" FontSize="12"
                                   Foreground="{DynamicResource DimTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Composer 输入卡（对齐 Web #composer） -->
                <Border Grid.Row="2"
                        x:Name="ComposerHost"
                        Padding="16,10"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,0">

                    <Border CornerRadius="22"
                            MaxWidth="940"
                            Background="{DynamicResource PanelBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="12,8">

                        <StackPanel>
                            <!-- / 前缀命令建议列表（输入 / 时显示，点击填入） -->
                            <ListBox
                                x:Name="SlashSuggest"
                                MaxHeight="150"
                                IsVisible="False"
                                Margin="0,0,0,4"
                                FontSize="12"
                                SelectionChanged="SlashSuggest_SelectionChanged" />

                            <!-- 输入框 -->
                            <TextBox
                                x:Name="InputBox"
                                Background="Transparent"
                                BorderThickness="0"
                                MinHeight="64"
                                MaxHeight="240"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                FontSize="13"
                                PlaceholderForeground="Gray"
                                Foreground="{DynamicResource TextBrush}"
                                PlaceholderText="输入消息…（Ctrl+Enter 发送）"
                                KeyDown="Input_KeyDown"
                                TextChanged="Input_TextChanged" />

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                Margin="3">

                                <Button
                                    x:Name="AttachButton"
                                    Content="+"
                                    Width="40"
                                    Height="40"
                                    FontSize="24"
                                    CornerRadius="20"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Background="Transparent"
                                    Foreground="{DynamicResource DimTextBrush}"
                                    ToolTip.Tip="上传图片/音频"
                                    Click="Attach_Click" />

                                <Grid
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ColumnDefinitions="5*,5*,*,2*,*,2*">

                                    <Button
                                        x:Name="BigModelBtn"
                                        Grid.Column="0"
                                        Content="大"
                                        Foreground="{DynamicResource TextBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        ToolTip.Tip="选择大模型（复杂任务）"
                                        Click="BigModel_Click"
                                        FontSize="11"
                                        Margin="5"
                                        CornerRadius="5" />

                                    <Button
                                        x:Name="SmallModelBtn"
                                        Grid.Column="1"
                                        Foreground="{DynamicResource TextBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Content="小"
                                        ToolTip.Tip="选择小模型（简单 / 压缩）" Click="SmallModel_Click"
                                        FontSize="11"
                                        Margin="5"
                                        CornerRadius="5" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="经济"
                                        FontSize="11"
                                        Margin="5"
                                        Foreground="{DynamicResource DimTextBrush}"
                                        VerticalAlignment="Center" />

                                    <ComboBox
                                        x:Name="EconomyCombo"
                                        Grid.Column="3"
                                        Foreground="{DynamicResource TextBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0.5"
                                        CornerRadius="5"
                                        FontSize="10"
                                        Margin="5"
                                        SelectionChanged="Economy_SelectionChanged" />

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="权限"
                                        FontSize="11"
                                        Margin="5"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource DimTextBrush}" />

                                    <ComboBox
                                        x:Name="PermCombo"
                                        Grid.Column="5"
                                        FontSize="11"
                                        Margin="5"
                                        Foreground="{DynamicResource TextBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0.5"
                                        CornerRadius="5"
                                        SelectionChanged="Perm_SelectionChanged" />
                                </Grid>

                                <Button
                                    Grid.Column="2"
                                    x:Name="SendButton"
                                    Content="↑"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="White"
                                    FontSize="18"
                                    Click="Send_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- 右栏 -->
            <Border Grid.Column="2" x:Name="RightPanel"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
                    <StackPanel x:Name="RightCards" />
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</Window>