<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WayCoder.UI.Gui.MainWindow"
        Title="WayCoder（道码）GUI"
        Width="960" Height="680"
        Background="#0f1117">
    <DockPanel Margin="12">

        <!-- 顶部：模型 + 槽位 + 停止 -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderLabel"
                       Text="WayCoder（道码）"
                       FontSize="16" FontWeight="Bold" Foreground="#e6e8ee"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="SlotLabel"
                       Text="槽位 F1"
                       FontSize="12" Foreground="#8b93a7"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Grid.Column="2" x:Name="StopButton"
                    Content="⏹ 停止"
                    IsEnabled="False"
                    Click="Stop_Click" />
        </Grid>

        <!-- 底部：输入 + 发送 -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBox x:Name="InputBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="64"
                     MaxHeight="200"
                     PlaceholderText="输入消息，Ctrl+Enter 发送"
                     KeyDown="Input_KeyDown" />
            <Button Grid.Column="1" x:Name="SendButton"
                    Content="➤ 发送"
                    Margin="10,0,0,0"
                    VerticalAlignment="Stretch"
                    Click="Send_Click" />
        </Grid>

        <!-- 聊天区（占满剩余空间） -->
        <TextBox x:Name="ChatBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="Menlo,Consolas,monospace"
                 FontSize="13"
                 Background="#171a23"
                 Foreground="#e6e8ee"
                 BorderThickness="0"
                 Padding="12" />
    </DockPanel>
</Window>
