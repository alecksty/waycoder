<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WayCoder.UI.Gui.MainWindow"
        Title="WayCoder（道码）GUI"
        Width="960" Height="700"
        Background="#0f1117">
    <DockPanel Margin="12">

        <!-- 顶部：标题 + 模型下拉 + 设置 + 停止 -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderLabel"
                       Text="WayCoder（道码）"
                       FontSize="15" FontWeight="Bold" Foreground="#e6e8ee"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="ModelCombo"
                      MinWidth="200" HorizontalAlignment="Right" Margin="12,0"
                      SelectionChanged="Model_SelectionChanged" />
            <TextBlock Grid.Column="2" x:Name="SlotLabel"
                       Text="槽位 F1"
                       FontSize="12" Foreground="#8b93a7"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="3" x:Name="SettingsButton"
                    Content="⚙"
                    Margin="0,0,8,0"
                    Click="Settings_Click" />
            <Button Grid.Column="4" x:Name="StopButton"
                    Content="⏹ 停止"
                    IsEnabled="False"
                    Click="Stop_Click" />
        </Grid>

        <!-- 槽位行：F1-F10 -->
        <StackPanel DockPanel.Dock="Top" x:Name="SlotPanel"
                    Orientation="Horizontal" Spacing="4" Margin="0,0,0,8" />

        <!-- 底部：输入 + 发送 -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBox x:Name="InputBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="64"
                     MaxHeight="200"
                     PlaceholderText="输入消息，Ctrl+Enter 发送"
                     KeyDown="Input_KeyDown" />
            <Button Grid.Column="1" x:Name="SendButton"
                    Content="➤ 发送"
                    Margin="10,0,0,0"
                    VerticalAlignment="Stretch"
                    Click="Send_Click" />
        </Grid>

        <!-- 聊天区（占满剩余空间）：富文本渲染 Markdown + «» 标记 -->
        <ScrollViewer x:Name="ChatScroll"
                      VerticalScrollBarVisibility="Auto"
                      Background="#171a23"
                      Padding="12">
            <SelectableTextBlock x:Name="ChatBox"
                                 TextWrapping="Wrap"
                                 FontSize="13"
                                 Foreground="#e6e8ee" />
        </ScrollViewer>
    </DockPanel>
</Window>
