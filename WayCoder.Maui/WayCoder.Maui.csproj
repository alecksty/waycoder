<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- ⚠ 苹果两端的 TFM **必须带平台版本**，不能写裸 `net10.0-ios`。
		     裸写法会落到工作负载清单的默认版本（本机是 26.5），而那个 SDK 会**硬性检查 Xcode 版本**：
		     `Microsoft.iOS.Sdk.net10.0_26.5 (26.5.10318) requires Xcode 26.6, current 27.0`
		     —— 构建直接失败，且这跟代码无关（实测 7 秒就挂）。
		     本机同时装着 26.0 / 26.5 / **27.0** 三个包，显式钉 27.0 就能选到对应 Xcode 27 的那个。
		     想换 Xcode 时不用改文件：`dotnet build -p:AppleSdkVersion=26.5`。 -->
		<AppleSdkVersion Condition="'$(AppleSdkVersion)' == ''">27.0</AppleSdkVersion>
		<TargetFrameworks>net10.0-android;net10.0-ios$(AppleSdkVersion);net10.0-maccatalyst$(AppleSdkVersion)</TargetFrameworks>
		<!-- Windows（WinUI 3）**只能在 Windows 上构建**：它的构建链是 Windows 专有的 PE 可执行文件
		     （XAML 编译器 / MakePri / WindowsAppSDK 的那些 task），别的 OS 上连评估这个 TFM 都会失败。
		     所以按宿主 OS 条件追加 —— macOS/Linux 上 `dotnet build` 连看都看不到它，
		     本地正常的构建流程一个字都不受影响。
		     ⚠ 这也意味着**改这个 TFM 相关的东西在本机验证不了**，只能靠 CI 或 Windows 机器。 -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>WayCoder.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- 主工程源码含 TerminalRawMode 的 [LibraryImport] P/Invoke，源生成要求 unsafe -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- 编译共享桌面源码时的噪音告警消除（非代码缺陷）：
		     CS1570/CS1587 —— 共享源码 XML 注释含 < >（如 List<T>、1.5x→）在 MAUI 文档解析下报格式错（主工程不开文档生成不报）；
		     CA1416/CA1422 —— Android 目标下 Console 等桌面 API 平台不可用（移动端不执行这些路径）；
		     CA2255 —— ModuleInitializer 仅限应用代码规则（共享 DrawCommands 静态注册）。 -->
		<!-- XCODE_27_0_PREVIEW —— Xcode 27 SDK 把一批 API 标成「仅用于评估」，dotnet-macios 默认当**错误**
		     （`error XCODE_27_0_PREVIEW: …仅用于评估…取消此诊断以继续`）。命中的包括
		     `Foundation.RegisterAttribute`（**每个 MAUI 模板都有的 `[Register("AppDelegate")]`**）
		     和 `AVAudioEngine`/`AVAudioPlayerNode`（VmlAudio.cs）—— 也就是**不是我们代码特有的用法**，
		     是这个 SDK 对上层的整体收紧。构建被它整个挡住，按提示抑制。
		     ⚠ 这是"知情接受"：Apple 说这些 API 将来可能改。升级 SDK 时要回头看一眼这条还在不在。 -->
		<NoWarn>$(NoWarn);CS1570;CS1587;CS1591;CA1416;CA1422;CA2255;XCODE_27_0_PREVIEW</NoWarn>

		<!-- Android 工具链路径：本机（macOS）用 `dotnet build -t:InstallAndroidDependencies` 装到
		     ~/Library/Android/{sdk,jdk}。三重守卫保证跨平台安全：
		       1. IsOSPlatform('OSX') —— 该路径仅 macOS host 上评估，Windows/Linux 完全不进；
		       2. Exists() —— 惰性判断，路径不存在则不生效；
		       3. '$(AndroidSdkDirectory)' == '' —— 不覆盖显式 -p: 传入的值。
		     其他平台（CI / Windows / Linux 开发者）走 .NET Android 默认探测（ANDROID_HOME / Android Studio）。 -->
		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and Exists('$(HOME)/Library/Android/sdk')">$(HOME)/Library/Android/sdk</AndroidSdkDirectory>
		<JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and Exists('$(HOME)/Library/Android/jdk')">$(HOME)/Library/Android/jdk</JavaSdkDirectory>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name —— **只是兜底**：Android 那边清单里的 android:label 指向
		     `@string/app_name`（按系统语言给「道码」/「WayCoder」，见 Resources/values*/strings.xml），
		     iOS 用 Info.plist 的 CFBundleDisplayName。这里给英文名，作为没有专门配置的平台的默认值。 -->
		<ApplicationTitle>WayCoder</ApplicationTitle>

		<!-- 作者 / 版权（进 APK 的 manifest 与 IPA 的 Info.plist，商店与"应用信息"里显示的就是它） -->
		<Authors>施探宇</Authors>
		<Product>WayCoder 道码</Product>
		<Copyright>© 施探宇</Copyright>

		<!-- App Identifier -->
		<!-- 包名：公司（深圳市探索智能科技有限公司 / tanso）反写 + 产品名。
		     ⚠ **改包名 = 换一个 App**：Android 按包名认身份，改了之后新包不会覆盖旧包
		     （两个图标并存），而且**私有目录里的东西（Preferences 存的最分/设置、解压出来的 vml 库）
		     不会跟过来**。工作区与 config 在外部存储（sdcard/waycoder）不受影响。
		     签名的 keystore 不变，所以旧包可以随时卸。 -->
		<ApplicationId>com.tanso.waycoder</ApplicationId>

		<!-- Versions —— **从 Global.cs 推导，不在这里手写**。
		     起因：这两个字段和 `WayCoder/Config/Global.cs` 的 `Global.Version` 是**同一份事实的两处拷贝**，
		     而 `scripts/release.sh` 的 VERSION 恰恰是从 **Global.cs** 里 sed 出来的 ⇒ 桌面端打出来的包
		     是 Global.Version、Android 包是 ApplicationDisplayVersion。两边一旦漏同步（v0.96.128~134
		     连续 8 版只改了这里）就会出现「设置里显示 0.96.135、About 页和 TUI 标题栏显示 0.96.127」
		     这种自相矛盾，而且**构建全绿**，只有人眼看才发现。现在唯一真源 = Global.cs。
		     `ApplicationVersion`（供 Android 的 versionCode）一并推导：major*1000000+minor*10000+patch
		     —— 只要单调递增即可（当前 0.96.135 → 960135，远大于旧的 121），不要再手工维护一个计数器。
		     ⚠ **每段的位宽必须大于该段的取值上限**：一开始写的是 `minor*100+patch`，而 patch 已经到
		     135 > 100 ⇒ 0.96.135 算成 9735，**高于** 0.97.0 的 9700 —— 一次 minor 升级会让
		     versionCode 变小，Android 直接拒绝覆盖安装（"version downgrade"）。 -->
		<_GlobalCsPath>$(MSBuildThisFileDirectory)../WayCoder/Config/Global.cs</_GlobalCsPath>
		<_GlobalCsText Condition="Exists('$(_GlobalCsPath)')">$([System.IO.File]::ReadAllText('$(_GlobalCsPath)'))</_GlobalCsText>
		<_VerMajor>$([System.Text.RegularExpressions.Regex]::Match($(_GlobalCsText), 'Version\s*=\s*"v(\d+)\.').Groups[1].Value)</_VerMajor>
		<_VerMinor>$([System.Text.RegularExpressions.Regex]::Match($(_GlobalCsText), 'Version\s*=\s*"v\d+\.(\d+)\.').Groups[1].Value)</_VerMinor>
		<_VerPatch>$([System.Text.RegularExpressions.Regex]::Match($(_GlobalCsText), 'Version\s*=\s*"v[\d.]+?\.(\d+)"').Groups[1].Value)</_VerPatch>
		<!-- 数值运算只喂**已确认非空**的值（空串喂给 [MSBuild]::Multiply 会在**属性求值阶段**就抛
		     MSB4186，那条报错完全看不出是版本号没解析出来）。这里退化成 0，把「解析失败」留给
		     下面那个 Target 用能读懂的话报。 -->
		<_VerMajorNum Condition="'$(_VerMajor)' != ''">$(_VerMajor)</_VerMajorNum>
		<_VerMajorNum Condition="'$(_VerMajor)' == ''">0</_VerMajorNum>
		<_VerMinorNum Condition="'$(_VerMinor)' != ''">$(_VerMinor)</_VerMinorNum>
		<_VerMinorNum Condition="'$(_VerMinor)' == ''">0</_VerMinorNum>
		<_VerPatchNum Condition="'$(_VerPatch)' != ''">$(_VerPatch)</_VerPatchNum>
		<_VerPatchNum Condition="'$(_VerPatch)' == ''">0</_VerPatchNum>
		<ApplicationDisplayVersion>$(_VerMajor).$(_VerMinor).$(_VerPatch)</ApplicationDisplayVersion>
		<ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(_VerMajorNum), 1000000)), $([MSBuild]::Multiply($(_VerMinorNum), 10000)))), $(_VerPatchNum)))</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<!-- MacCatalyst 最低 17.0：SDK 27.0 起把下限从 15.0 抬到了 17.0，
		     写 15.0 会硬失败（`SupportedOSPlatformVersion value '15.0' is lower than the minimum value '17.0'`）。 -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!--
		  字体**必须不压缩**打包。

		  自绘编辑器每帧都要让 MAUI 解析一次字体（`canvas.FontSize` → `FontPaint` →
		  `Microsoft.Maui.Graphics.Platform.FontExtensions.ToTypeface()`，那条路**没有缓存**），
		  而 `Typeface.CreateFromAsset` 读的是 APK 里的资产：**资产若是 Deflate 压缩的，
		  每次调用都要把整个 25MB 解压一遍** —— 这就是「滑动/缩放卡顿」的真身
		  （实测每次 ~110ms，一帧两次 ≈ 220ms，而真正画字只要 ~15ms）。
		  不压缩后 Android 能直接 mmap，解析代价随之崩掉。

		  ⚠ 别删这一行。删了不会报错、只是慢，而且**只在真机滚动时才看得出来**。
		-->
		<AndroidStoreUncompressedFileExtensions>.ttf;.otf</AndroidStoreUncompressedFileExtensions>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon / Splash：使用 appicon.png（app.png 的 1024x1024 副本；四角透明保留，
		     不设 Color 避免背景把透明角染黑；与 Resources\Images\app.png 分开避免重名） -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />
		<!-- Color 决定**启动画面背景**（生成到 @color/maui_splash_color）。不写就是 MAUI 模板默认的
		     #512BD4 紫 —— 用户反馈「启动时背景是紫的」就是它。取 App 的暗色页面背景 PageBgDark，
		     与启动后的界面无缝衔接。 -->
		<MauiSplashScreen Include="Resources\AppIcon\appicon.png" BaseSize="128,128" Color="#0E0E12" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Include="Resources\Images\icons\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!--
	  VML（用户自己的编译器+翻译器+虚拟机，纯 C# / .NET 10）以**库**的形式并入，
	  在进程内调用 —— 不是把它编成可执行文件丢进 shell 跑。

	  为什么不走进程：① iOS 的 fork/exec 被沙箱物理拒绝，这条路永远上不了 iOS；
	  ② Android 10+ 的 W^X 让 app 私有目录里的文件不可 exec，得塞 jniLibs 当 .so；
	  ③ 自包含运行时几百 MB。托管代码链进来这三条全没有。

	  路径走属性且**只在存在时才引用**：VML 是独立仓库（在 WayCoder 之外的目录），
	  别人 clone 这个仓库时它不存在 —— 不这么写会让所有人的构建直接挂掉。
	  本机开发可用 -p:VmlRoot=<路径> 覆盖。
	-->
	<ItemGroup>
		<!-- VML 已经**复制进本仓库**（third_party/vml/，来源与同步方式见那里的 README）。
		     这里引用「跑一段 VML 程序」真正需要的项目：汇编器 + 运行时 + 下面那批前端编译器。
		     （早期只引汇编器 + 运行时，因为命令行页当时只跑 `.vml` 汇编；后来接上
		       「高级语言 → VML 汇编 → 运行」这条链，就得把 22 个前端编译器也引进来。） -->
		<ProjectReference Include="../third_party/vml/VMLAssembler/VMLAssembler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLRuntime/VMLRuntime.csproj" />

		<!-- **22 个前端编译器逐个直引**（上游 VMLTool.csproj 的 StaticLink 分支也是这么列的）。

		     为什么不引 VMLTool.csproj 一个了事：它还**编译依赖** VMLTranslators（18 个后端翻译器，
		     302.5 KB）与 VMLToHex（158 KB，产物 vml2hex.dll）—— 那两个是给**裸机/单片机**输出后端
		     汇编与 hex/elf/bin 的，手机端只用得到「高级语言 → VML 汇编 → 虚拟机执行」这一条链，
		     引它就会把那 ~460 KB 一起链进 APK（实测 APK 里确实躺着 libaot-VMLTranslators.dll.so
		     与 libaot-vml2hex.dll.so）。

		     代价是 VMLTool 那边的两样东西要**本地化**（前端编译器清单 + vmltool.config.xml 的读取器）：
		       · Services/VmlFrontendCompilers.cs —— 抄上游 StaticLinkInitializer 的前端那半截，
		         并把清单钉在 UI/Shared/VmlFrontendCompilerList.cs（唯一真源 + 漂移判据）；
		       · Services/VmlLibConfig.cs —— 抄上游 VmlToolConfig 的 Load/ResolveLibs 两件事。
		     ⚠ 上游**加一门语言**时这三处要一起改（清单 / RegisterAll / 这里的 ProjectReference），
		        漏了会被桌面自测的 `[VML 前端编译器清单]` 段与手机端的注册断言**响亮地**拦下。

		     ⚠ 这四个本地适配（都在 third_party/vml/，由 sync.sh 重新施加）是它们能被引用的前提：
		       OutputType Exe→Library（否则 NETSDK1150）、去 StartupObject（否则 CS2017）、
		       去 RuntimeIdentifiers（否则 NETSDK1047：它的列表里没有 android-arm64）、
		       去 PublishAot（AOT 发布需要 RID，而我们只要它的代码）。 -->
		<ProjectReference Include="../third_party/vml/VMLPrepares/CompilerBase/CompilerBase.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/CCompiler/CCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/BasicCompiler/BasicCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/PascalCompiler/PascalCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/PythonCompiler/PythonCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/LuaCompiler/LuaCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/ForthCompiler/ForthCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/RustCompiler/RustCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/GoCompiler/GoCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/LadderCompiler/LadderCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/CSharpCompiler/CSharpCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/JavaCompiler/JavaCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/JavaScriptCompiler/JavaScriptCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/SwiftCompiler/SwiftCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/CppCompiler/CppCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/KotlinCompiler/KotlinCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/SchemeCompiler/SchemeCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/RubyCompiler/RubyCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/DartCompiler/DartCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/ObjCCompiler/ObjCCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/RCompiler/RCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/DCompiler/DCompiler.csproj" />
		<ProjectReference Include="../third_party/vml/VMLPrepares/FortranCompiler/FortranCompiler.csproj" />
	</ItemGroup>

	<!--
	  抽库：复用主项目核心源码（Agent/LLM/Tools/Infra/Memory/UI 等）。
	  排除（GUI 基线之上增排）：
	    CLI 入口/命令层、测试/演示、编译期插件、误置游戏目录、Properties —— 同 GUI。
	    UI/TUI/**（终端 TUI）、UI/WEB/**（Web 服务器）、Batch/**、Watch/** —— 移动端不需要。
	    进程类工具（iOS 物理禁止 Process.Start）+ MCP 全家桶 + Doctor/Import/McpCache —— 桩或裁掉。
	    Git/WorktreeIsolation.cs + Git/GitRunner.cs —— git 进程，GitRunner 由 CoreStubs 桩。
	    ThemeConfig（TUI 主题）、AgentSlot（多槽位）、ToolRegistry（MAUI 自有替代）。
	  加回：UI/TUI/Edit/（编辑器数据核心 EditorCore/Syntax/DiagnosticManager）、
	        ContentDiffFormatter（纯逻辑 diff 格式化）。
	-->
	<ItemGroup>
		<Compile Include="../WayCoder/**/*.cs" Exclude="../WayCoder/Program*.cs;../WayCoder/Test/**/*.cs;../WayCoder/UI/CLI/Arguments/**/*.cs;../WayCoder/Plugins/**/*.cs;../WayCoder/Properties/**/*.cs;../WayCoder/bin/**/*.cs;../WayCoder/obj/**/*.cs;../WayCoder/WayEngine/**/*.cs;../WayCoder/game/**/*.cs;../WayCoder/games/**/*.cs;../WayCoder/lottery/**/*.cs;../WayCoder/subs/**/*.cs;../WayCoder/works/**/*.cs;../WayCoder/SnakeGame/**/*.cs;../WayCoder/UI/WEB/WebAssets.Generated.cs;../WayCoder/UI/TUI/**/*.cs;../WayCoder/UI/CLI/Commands/SyncQrCommand.cs;../WayCoder/UI/WEB/**/*.cs;../WayCoder/Batch/**/*.cs;../WayCoder/Watch/**/*.cs;../WayCoder/Git/GitRunner.cs;../WayCoder/Tools/ToolRegistry.cs;../WayCoder/Tools/BashTool.cs;../WayCoder/Tools/GitTool.cs;../WayCoder/Tools/GitPRTool.cs;../WayCoder/Tools/LspTool.cs;../WayCoder/Tools/LintTool.cs;../WayCoder/Tools/PsTool.cs;../WayCoder/Tools/KillTool.cs;../WayCoder/Tools/ScreenshotTool.cs;../WayCoder/Tools/SqliteTool.cs;../WayCoder/Tools/TestTool.cs;../WayCoder/Tools/JobOutputTool.cs;../WayCoder/Tools/JobKillTool.cs;../WayCoder/Config/ThemeConfig.cs;../WayCoder/Agent/AgentSlot.cs;../WayCoder/demo/**/*.cs" />
		<Compile Include="../WayCoder/UI/TUI/Edit/**/*.cs" />
		<!--
		  **真 BashTool 只在 Android 上编译**（桌面那个 498 行的实现，一行都没重写）。
		  iOS / MacCatalyst 不编它，改用 CoreStubs.cs 里的「不支持」桩 ——
		  iOS 的沙箱**物理拒绝 fork/exec**，真实现拉起来只会抛。

		  Android 为什么可以：`Process.Start` 在 .NET for Android 上是**真实现**
		  （Mono 运行时包里 System.Diagnostics.Process.dll 有 SystemNative_ForkAndExecProcess
		  的 P/Invoke，126KB 不是抛异常的桩）；它唯一不支持的 `UseShellExecute`
		  恰好没被用到（BashTool 写的是 false）。

		  ⚠ 这是本仓库**第一次**用「按平台条件 include 源文件」这个模式（此前的 Condition
		  都只用在属性级）。之所以必须用它：真实现与桩**同名同命名空间**
		  （WayCoder.Tools.BashTool），两者不能同时参与编译（CS0101）。
		-->
		<Compile Include="../WayCoder/Tools/BashTool.cs"
		         Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
		<Compile Include="../WayCoder/UI/TUI/Custom/ContentDiffFormatter.cs" />
	</ItemGroup>

	<!-- 版本号解析失败要**当场炸掉**：正则一失效就会静默产出空版本号的包
	     （Android 会构建失败或装出一个没有版本的应用），而「静默降级」正是上面 Version 那段
	     注释里要根除的东西。（Target 必须挂在 Project 下，放进 PropertyGroup 里会报 MSB4066。） -->
	<Target Name="VerifyAppVersionParsed" BeforeTargets="Build;Publish">
		<Error Condition="'$(_VerPatch)' == '' or '$(_VerMajor)' == ''"
		       Text="无法从 $(_GlobalCsPath) 解析版本号 —— 请确认 WayCoder/Config/Global.cs 里仍是 `public const string Version = &quot;vX.Y.Z&quot;;` 的写法。" />
	</Target>

</Project>
