<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WayCoder.Maui.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:WayCoder.Maui.Controls"
    Title="编辑器">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- 文件名 + 菜单（菜单放在右上角：字号/保存/另存为/新建这些不是每时每刻都用，
             但一旦要调就得翻工具栏去找，放这里一眼可见） -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="8,4,4,0">
            <Label
                x:Name="FileLabel"
                Grid.Column="0"
                Text=""
                VerticalOptions="Center"
                FontSize="13"
                LineBreakMode="TailTruncation" />
            <!-- ⚠ 必须显式接 Clicked：加了按钮却忘了接线 = 点了没反应（用户实测「没看到菜单」） -->
            <Button
                x:Name="MenuBtn"
                Grid.Column="1"
                Text="☰"
                FontSize="19"
                Padding="14,0"
                HeightRequest="38"
                WidthRequest="56"
                CornerRadius="10"
                TextColor="{AppThemeBinding Light=#222222, Dark=#EEEEEE}"
                BackgroundColor="{AppThemeBinding Light=#EFEFF2, Dark=#2A2A2E}"
                Clicked="OnMenuClicked"
                SemanticProperties.Hint="编辑器菜单" />
        </Grid>

        <!-- 编辑工具条（SVG 图标按钮）：撤销 / 重做 / 查找 / 大纲 / 预览(源码) / 编辑(只读↔可写) / 保存 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*" Padding="8,2" ColumnSpacing="4">
            <ImageButton
                x:Name="UndoBtn"
                Source="icon_undo"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnUndoClicked"
                SemanticProperties.Hint="撤销" />
            <ImageButton
                x:Name="RedoBtn"
                Grid.Column="1"
                Source="icon_redo"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnRedoClicked"
                SemanticProperties.Hint="重做" />
            <ImageButton
                x:Name="FindBtn"
                Grid.Column="2"
                Source="icon_find"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnFindClicked"
                SemanticProperties.Hint="查找" />
            <ImageButton
                x:Name="OutlineBtn"
                Grid.Column="3"
                Source="icon_outline"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnOutlineClicked"
                SemanticProperties.Hint="大纲" />
            <ImageButton
                x:Name="PreviewBtn"
                Grid.Column="4"
                Source="icon_preview"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnPreviewClicked"
                SemanticProperties.Hint="预览/源码" />
            <ImageButton
                x:Name="EditBtn"
                Grid.Column="5"
                Source="icon_edit"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnEditClicked"
                SemanticProperties.Hint="切换只读/编辑" />
            <ImageButton
                x:Name="SaveBtn"
                Grid.Column="6"
                Source="icon_save"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnSaveClicked"
                SemanticProperties.Hint="保存" />
        </Grid>

        <!-- 内容区：自绘画布 + 浮动的单行输入 + Markdown 预览。
             **所有行由 CodeCanvasView 自行绘制**（虚拟滚动，只画可见的几十行），
             **只有光标所在行在编辑时**浮一个原生 Entry 叠在该行位置上 ——
             这样 IME、软键盘、选区、系统复制粘贴全部复用平台能力，而渲染始终虚拟化。
             每帧代价与文件大小无关，所以 100MB 也能打开、能滚（改造前是整份塞进原生 Editor）。 -->
        <Grid Grid.Row="2">
            <ctl:CodeCanvasView x:Name="Canvas" />

            <!-- 单行编辑框：字体/字号/内边距全部取自 EditorTypography（与画布同一份常量），
                 否则切换编辑的瞬间两者会错位。垂直位置靠 TranslationY 对齐到当前行。 -->
            <Entry
                x:Name="LineEditor"
                IsVisible="False"
                VerticalOptions="Start"
                HorizontalOptions="Fill"
                ReturnType="Done"
                Completed="OnLineEditorCompleted"
                TextChanged="OnLineEditorTextChanged"
                Unfocused="OnLineEditorUnfocused" />

            <ScrollView x:Name="PreviewScroll" IsVisible="False">
                <VerticalStackLayout x:Name="PreviewContent" />
            </ScrollView>

            <!-- 选区操作条 —— **我们自己画的**，不用平台的选中弹窗。
                 平台那套（选择手柄 + 复制/粘贴浮层）所有坐标都是按它自己那层输入框算的，
                 与我们自绘的正文只要差一点点就会「看起来对不上」；全自己做就没有第二个坐标系。
                 长按选词 / 拖动扩选后由 UpdateSelectionBar 摆到选区上方。 -->
            <Border x:Name="SelectionBar"
                    IsVisible="False"
                    ZIndex="20"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"
                    Padding="2"
                    StrokeThickness="0"
                    BackgroundColor="#EE2C2C2E">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="0">
                    <Button x:Name="SelCopyBtn" Text="复制" Clicked="OnSelCopyClicked"
                            BackgroundColor="Transparent" TextColor="#FFFFFF" FontSize="13" Padding="10,4" />
                    <Button x:Name="SelAllBtn" Text="全选" Clicked="OnSelAllClicked"
                            BackgroundColor="Transparent" TextColor="#FFFFFF" FontSize="13" Padding="10,4" />
                    <Button x:Name="SelPasteBtn" Text="粘贴" Clicked="OnSelPasteClicked"
                            BackgroundColor="Transparent" TextColor="#FFFFFF" FontSize="13" Padding="10,4" />
                    <Button x:Name="SelCloseBtn" Text="✕" Clicked="OnSelCloseClicked"
                            BackgroundColor="Transparent" TextColor="#FFFFFF" FontSize="13" Padding="10,4" />
                </HorizontalStackLayout>
            </Border>

            <!-- 打开中遮罩：大文件要顺序扫一遍建行索引（100MB 在百毫秒~数秒级），
                 这期间没有任何反馈的话，用户会以为是「没点到」或者「卡死了」。
                 放在内容区最上层，盖住画布与输入框。 -->
            <Grid x:Name="LoadingMask" IsVisible="False" BackgroundColor="#99000000">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <ActivityIndicator IsRunning="True" Color="White" />
                    <Label
                        x:Name="LoadingText"
                        Text="文件打开中…"
                        TextColor="White"
                        FontSize="14"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- 状态栏：行列 / 字符数 / 修改标记 -->
        <Label
            Grid.Row="3"
            x:Name="StatusLabel"
            FontSize="11"
            Padding="8,4"
            TextColor="{AppThemeBinding Light=#888888, Dark=#999999}" />
    </Grid>
</ContentPage>
