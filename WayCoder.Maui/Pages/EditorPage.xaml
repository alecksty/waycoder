<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WayCoder.Maui.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:WayCoder.Maui.Controls"
    Title="编辑器">

    <!-- x:Name：软键盘弹出时按 IME inset 往它加底部内边距（见 EditorPage.xaml.cs 的 HookImeInsets）。
         Android 15+ 的 edge-to-edge 下 WindowSoftInputMode=AdjustResize 已经失效，
         「把内容区压矮」这件事只能自己还原。 -->
    <!-- 编辑器菜单：**放在顶部导航栏里**（与返回箭头/标题同一行），不再占内容区的一行。
         用户实测反馈「菜单按钮往上挪一行」——原来它和文件名挤在同一行、且方块比标题栏还高，
         视觉上像是压在工具条那一行上。放进 ToolbarItems 就是 Android 标准的动作栏位置，
         同时也把「文件名」那一行整行让给文件名（长路径不再被按钮挤掉）。 -->
    <ContentPage.Resources>
        <!-- 辅助输入条上的格子按钮 —— 六个格子共用这一份样式。
             收成样式有两个理由：① 颜色原先在五个按钮上各写一遍，改主题要改五处；
             ② 跟随系统主题只能靠 `AppThemeBinding`（它会在系统切换时**自动**更新，
             而「开浮条时算一次颜色」只会在下次打开时才变）—— 放一处才收得住。
             ⚠ 浅色主题下别用纯白底：代码底本身就是白的，浮条会「浮不起来」，
             所以给一个比行号栏（#F2F2F4）再深一点的浅灰。 -->
        <Style x:Key="AssistChip" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="InputTransparent" Value="True" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
        </Style>

        <!-- 选区操作条与运行面板的按钮 —— 与 AssistChip 同样是「跟随主题」，区别只有
             它们**要能点**（不带 InputTransparent）与内外边距不同。
             浮层底色统一用 `FloatBg` 那一对值，三处保持一致。 -->
        <Style x:Key="SelChip" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
        </Style>
        <Style x:Key="PanelChip" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <!-- ⚠ 必须显式接 Clicked：加了按钮却忘了接线 = 点了没反应（用户实测「没看到菜单」） -->
        <ToolbarItem Text="☰" Order="Primary" Priority="0"
                     Clicked="OnMenuClicked"
                     SemanticProperties.Hint="编辑器菜单" />
        <!-- 全屏：把导航栏 + 文件名行 + 工具条 + 状态栏全收掉，画布占满整屏。
             ⚠ 进全屏后**这个按钮自己也跟着导航栏一起没了**，所以恢复入口必须另放一个
             浮在画布上的按钮（RestoreBtn）—— 不能只靠这一个 ToolbarItem。 -->
        <ToolbarItem IconImageSource="icon_fullscreen.png" Order="Primary" Priority="1"
                     Clicked="OnFullscreenEnterClicked"
                     SemanticProperties.Hint="全屏（隐藏所有栏）" />
    </ContentPage.ToolbarItems>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto">

        <!-- 文件名（整行：菜单已挪到导航栏）。全屏时整行收起（Auto 行随子元素 IsVisible=False 塌成 0）。 -->
        <Grid x:Name="FileRow" Grid.Row="0" ColumnDefinitions="*" Padding="8,4,8,0">
            <Label
                x:Name="FileLabel"
                Grid.Column="0"
                Text=""
                VerticalOptions="Center"
                FontSize="13"
                LineBreakMode="TailTruncation" />
        </Grid>

        <!-- 编辑工具条（SVG 图标按钮）：撤销 / 重做 / 查找 / 大纲 / 预览或运行(按文件类型) / 编辑(只读↔可写) / 保存
             第 5 格是**变形**的：Markdown → 👁 预览，VML 能编译/汇编/装载的源码 → ▶ 运行，
             其它（.txt/.json/未知扩展名）→ 整格隐藏。图标与可见性由 ApplyActionButton 统一设，
             判据只有 ActionForCurrentFile 一处（全屏浮层那个按钮同源）。 -->
        <Grid x:Name="ToolRow" Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*,*" Padding="8,2" ColumnSpacing="4">
            <ImageButton
                x:Name="UndoBtn"
                Source="icon_undo.png"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnUndoClicked"
                SemanticProperties.Hint="撤销" />
            <ImageButton
                x:Name="RedoBtn"
                Grid.Column="1"
                Source="icon_redo.png"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnRedoClicked"
                SemanticProperties.Hint="重做" />
            <ImageButton
                x:Name="FindBtn"
                Grid.Column="2"
                Source="icon_find.png"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnFindClicked"
                SemanticProperties.Hint="查找" />
            <ImageButton
                x:Name="OutlineBtn"
                Grid.Column="3"
                Source="icon_outline.png"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnOutlineClicked"
                SemanticProperties.Hint="大纲" />
            <ImageButton
                x:Name="PreviewBtn"
                Grid.Column="4"
                Source="icon_preview.png"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnActionButtonClicked"
                SemanticProperties.Hint="预览/运行" />
            <ImageButton
                x:Name="EditBtn"
                Grid.Column="5"
                Source="icon_edit.png"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnEditClicked"
                SemanticProperties.Hint="切换只读/编辑" />
            <ImageButton
                x:Name="SaveBtn"
                Grid.Column="6"
                Source="icon_save.png"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnSaveClicked"
                SemanticProperties.Hint="保存" />
            <!-- 辅助输入条开关 —— 用户要求放工具栏（去 ☰ 菜单里找不方便）。
                 图标带**状态**：开着时高亮，一眼能看出它是开是关。 -->
            <ImageButton
                x:Name="AssistBtn"
                Grid.Column="7"
                Source="icon_assist.png"
                BackgroundColor="Transparent"
                Padding="8"
                Opacity="0.45"
                Clicked="OnAssistToggleClicked"
                SemanticProperties.Hint="辅助输入条" />
        </Grid>

        <!-- 内容区：自绘画布 + 浮动的单行输入 + Markdown 预览。
             **所有行由 CodeCanvasView 自行绘制**（虚拟滚动，只画可见的几十行），
             只有光标所在行在编辑时挂一个原生 Entry ——
             这样 IME、软键盘、系统剪贴板全部复用平台能力，而渲染始终虚拟化。
             每帧代价与文件大小无关，所以 100MB 也能打开、能滚（改造前是整份塞进原生 Editor）。 -->
        <Grid Grid.Row="2">
            <!-- 单行编辑框：字体/字号/内边距全部取自 EditorTypography（与画布同一份常量），
                 否则切换编辑的瞬间两者会错位。垂直位置靠 TranslationY 对齐到当前行。

                 ⚠ **它必须声明在画布之前（= 压在画布底下），绝不能盖在画布上**。
                 盖在上面时，手指点在「正在编辑的那一行」会被这个 EditText 接走，而
                 x→字符下标由**平台自己的排版 + 它内部自己的横向滚动**决定，与我们这套
                 「逐字形推进量」的网格毫无关系（两者每格差不到 1px，但沿行累积，到第 80 列
                 就差出一整格，且它内部滚动随光标位置变化 ⇒ 偏差还会跳变）。表现就是
                 **手点的地方和光标落点差出好几格、越靠右越明显**（用户实测）。
                 压在底下则所有触摸都归画布，点哪儿由 `CharIndexAtX` 一把尺子决定；
                 而它的系统光标/手柄/放大镜也被不透明的画布盖住，正好一并看不见了。
                 它自己仍然能被 `Focus()` 聚焦（IME 照常），只是不再接收触摸。 -->
            <!-- StyleId：MauiProgram 里那两处「关掉平台选中浮层」的 mapper 是全局静态的，
                 靠它把作用范围限到这一个输入框（否则全 App 18 个 Entry 的粘贴一起没了）。 -->
            <Entry
                x:Name="LineEditor"
                StyleId="code-line-editor"
                IsVisible="False"
                VerticalOptions="Start"
                HeightRequest="1"
                MaximumHeightRequest="1"
                HorizontalOptions="Fill"
                ReturnType="Done"
                Completed="OnLineEditorCompleted"
                TextChanged="OnLineEditorTextChanged"
                Unfocused="OnLineEditorUnfocused" />

            <ctl:CodeCanvasView x:Name="Canvas" />

            <!-- 全屏时右上角的浮层：**还原** + **运行/预览**。
                 两个都只能浮在画布上 —— 导航栏与工具栏（含全屏按钮自己）在全屏时整条消失，
                 不另放就没有出口了。运行那格是用户要的「写了代码就运行一下」，不必退出全屏。

                 横排而不是上下叠：右上角一条 44pt 高，对正文的遮挡只有叠放的一半。
                 ZIndex 高于选区操作条与气泡、低于打开中遮罩。

                 ⚠ 底色**必须跟随主题**，原因不显然：图标是 SVG 里烘死的 `#777777` 灰（工具栏同一批），
                 而底色原来是写死的 `#99000000`（60% 黑）。它叠在**代码底**上，
                 于是两种主题下的实际底色完全不同 —— 日间是 `#666666`、夜间是 `#070708`：
                 **同一支灰图标叠在 `#666666` 上对比度只有 1.28，等于看不见**（夜间 4.50 正常）。
                 换成浅色底 `#E9E9EE` 后是 3.70，两端都够（图形元素门槛 3.0）。
                 ⚠ **注释里绝不能出现注释结束符本身**（哪怕只是想举例说明它）——
                 它会把剩下的说明变成 Grid 的裸文本，而报出来的错是
                 「Children 找不到」，完全指不到病因。这里就踩过一次。 -->
            <!-- 两个按钮**合在一个圆角面板里**（用户要求：「应该做圆角粘在一起，像一个 panel 上面的两个按钮」）：
                 原来它们是两个各自 44×44 的方块、中间隔着 8pt。
                 底色挪到外层这个 Border 上、两个按钮自己透明；中间一道细分隔线把两格分开。
                 分隔线的可见性跟着「运行」那格走（非源码文件时那格隐藏，留着孤零零一条竖线像坏了），
                 同步放在 ApplyActionButton 一处 —— 那本来就是「这一格长什么样」的唯一出口。 -->
            <Border x:Name="FullscreenBar"
                    IsVisible="False"
                    ZIndex="21"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,8,8,0"
                    Padding="0"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#E9E9EE, Dark=#99000000}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="0">
                    <ImageButton x:Name="FullscreenActionBtn"
                            Source="icon_run.png"
                            IsVisible="False"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="10"
                            BackgroundColor="Transparent"
                            Clicked="OnActionButtonClicked"
                            SemanticProperties.Hint="运行" />
                    <BoxView x:Name="FullscreenDivider"
                            WidthRequest="1"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            Color="{AppThemeBinding Light=#D5D5DB, Dark=#40FFFFFF}" />
                    <ImageButton x:Name="RestoreBtn"
                            Source="icon_restore.png"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="10"
                            BackgroundColor="Transparent"
                            Clicked="OnFullscreenExitClicked"
                            SemanticProperties.Hint="退出全屏" />
                </HorizontalStackLayout>
            </Border>

            <ScrollView x:Name="PreviewScroll" IsVisible="False">
                <VerticalStackLayout x:Name="PreviewContent" />
            </ScrollView>

            <!-- 选区操作条 —— **我们自己画的**，不用平台的选中弹窗。
                 平台那套（选择手柄 + 复制/粘贴浮层）所有坐标都是按它自己那层输入框算的，
                 与我们自绘的正文只要差一点点就会「看起来对不上」；全自己做就没有第二个坐标系。
                 长按选词 / 拖动扩选后由 UpdateSelectionBar 摆到选区上方。 -->
            <Border x:Name="SelectionBar"
                    IsVisible="False"
                    ZIndex="20"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"
                    Padding="2"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#EEF0F0F3, Dark=#EE2C2C2E}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="0">
                    <Button x:Name="SelCopyBtn" Text="复制" Style="{StaticResource SelChip}"
                            Clicked="OnSelCopyClicked" />
                    <Button x:Name="SelDeleteBtn" Text="删除" Style="{StaticResource SelChip}"
                            Clicked="OnSelDeleteClicked" />
                    <Button x:Name="SelAllBtn" Text="全选" Style="{StaticResource SelChip}"
                            Clicked="OnSelAllClicked" />
                    <Button x:Name="SelPasteBtn" Text="粘贴" Style="{StaticResource SelChip}"
                            Clicked="OnSelPasteClicked" />
                    <Button x:Name="SelCloseBtn" Text="✕" Style="{StaticResource SelChip}"
                            TextColor="{AppThemeBinding Light=#8A8A8E, Dark=#FFFFFF}"
                            Clicked="OnSelCloseClicked" />
                </HorizontalStackLayout>
            </Border>

            <!-- 编译诊断气泡层：**浮在代码之上**，数据从 DiagnosticManager 取
                 （与行下那条波浪线是同一份，所以关掉气泡时波浪线一起消失）。
                 下面两个属性**缺一不可**：
                 · InputTransparent=True —— 整层必须透明，否则它会吃掉画布的触摸（点不动行、滑不动）
                 · CascadeInputTransparent=False —— MAUI 的 InputTransparent **默认向下级联**，
                   不关掉的话气泡里的 ✕ 也点不动
                 气泡各自再设 InputTransparent=False 覆盖回来。
                 ZIndex 22：高于全屏浮层(21)与选区条(20)，低于打开中/编译中遮罩(30)。 -->
            <Grid x:Name="DiagLayer"
                  IsVisible="False"
                  ZIndex="22"
                  InputTransparent="True"
                  CascadeInputTransparent="False"
                  IsClippedToBounds="True" />

            <!-- 运行面板：**贴在底部**的小窗，两个 Tab（错误列表 / 输出）。
                 有了它，「运行」就不必跳到命令行页 —— 输出、报错都在原地看得见。
                 数据来源与气泡是**同一份**：错误列表读 DiagnosticManager，点一条跳到那一行。
                 ZIndex 23：压住气泡层(22)，否则气泡会飘在面板上面。 -->
            <Grid x:Name="OutputPanel"
                  IsVisible="False"
                  ZIndex="23"
                  VerticalOptions="End"
                  BackgroundColor="{AppThemeBinding Light=#F2F0F0F3, Dark=#F21A1A1E}"
                  RowDefinitions="Auto,*"
                  HeightRequest="220">
                <HorizontalStackLayout Grid.Row="0" Spacing="0" Padding="4,2">
                    <!-- 这两个 Tab 的 TextColor **故意不在 XAML 里给**：选中/未选中是运行期状态，
                         由代码 `SwitchPanelTab` 一处决定（原来 XAML 挂的 AppThemeBinding 被代码
                         写死的 Colors.White 盖掉，日间主题下选中那格就成了白底白字）。
                         两处都给 = 「谁生效」要看执行顺序，正是本仓库反复踩的坑。 -->
                    <Button x:Name="PanelTabErrors" Text="错误列表" Style="{StaticResource PanelChip}"
                            Clicked="OnPanelTabErrorsClicked" />
                    <Button x:Name="PanelTabOutput" Text="输出" Style="{StaticResource PanelChip}"
                            Clicked="OnPanelTabOutputClicked" />
                    <Button x:Name="PanelStopBtn" Text="■ 停止" Style="{StaticResource PanelChip}"
                            TextColor="{AppThemeBinding Light=#C4382F, Dark=#FF7B72}"
                            IsVisible="False" Clicked="OnPanelStopClicked" />
                    <Button x:Name="PanelCloseBtn" Text="✕" Style="{StaticResource PanelChip}"
                            TextColor="{AppThemeBinding Light=#8A8A8E, Dark=#999999}"
                            Clicked="OnPanelCloseClicked" />
                </HorizontalStackLayout>

                <!-- 错误列表：与气泡/波浪线**同一份数据** -->
                <ScrollView Grid.Row="1" x:Name="PanelErrorsScroll">
                    <VerticalStackLayout x:Name="PanelErrorsList" Padding="8,2" Spacing="4" />
                </ScrollView>

                <!-- 输出：程序写到控制台的东西（含运行时崩溃的寄存器 dump） -->
                <ScrollView Grid.Row="1" x:Name="PanelOutputScroll" IsVisible="False">
                    <VerticalStackLayout Padding="8,2" Spacing="6">
                        <Label x:Name="PanelOutputText" FontSize="11"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#DDDDDD}"
                               LineBreakMode="WordWrap" />
                        <!-- stdin 输入行：只在程序真的读输入时亮出来（与命令行页同一个语义） -->
                        <Grid x:Name="PanelStdinRow" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <Entry x:Name="PanelStdinEntry" Placeholder="输入后回车…" FontSize="12"
                                   Completed="OnPanelStdinSubmitted" />
                            <Button Grid.Column="1" Text="发送" FontSize="12" Padding="10,4"
                                    Clicked="OnPanelStdinSendClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- ═══ 浮动代码辅助输入条 ═══
                 可自由拖动、10 秒不碰自动缩小半透明、点分类弹字符/关键字表。
                 关键字与运算符**按当前语言自动填充**（问 Syntax.ForFile，不另立表）。
                 ZIndex 24：压住气泡层(22)与运行面板(23) —— 它是要被点的那一层。
                 弹出表单独一层（ZIndex 25），因为要能盖住条子本身。 -->
            <Border x:Name="AssistBar"
                  IsVisible="False"
                  ZIndex="24"
                  HorizontalOptions="Start"
                  VerticalOptions="Start"
                  Padding="1"
                  StrokeThickness="0"
                  BackgroundColor="{AppThemeBinding Light=#E9E9EE, Dark=#F22C2C2E}"
                  AnchorX="0"
                  AnchorY="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <!-- 拖动区：**一个填满整条、声明在最底下的 GraphicsView**。
                     为什么不是 PanGestureRecognizer —— 真机实测（当时挂了个 logcat 探针量的）：
                     那条路上报的 TotalX 是**两条各自有效、相差一个恒定偏移的流**交替出现
                     （慢速匀速的程序化滑动也是 ±39 来回，与速度无关），
                     而 PanUpdatedEventArgs 只有 TotalX/TotalY，没有任何字段能区分它们。
                     换 GraphicsView 亲手接原始触摸 —— 画布的选区手柄走的正是这条路，
                     用户实测「手柄拖动不乱晃」，这是有对照的选择。

                     为什么垫在最底下还能收到触摸：Android 的 ViewGroup 分发是
                     「从最上层子元素往下找，**谁不消费就继续找下一个**」。
                     按钮 clickable=true 会消费 → 点击归按钮；⣿ 与内边距没人消费
                     → 落到这一层。所以**可拖区域 = 整条减去按钮**，与今天实测到的
                     可达范围一致（实测：从按钮起划，pan 事件 0 个 —— 按钮上从来就拖不动）。 -->
                <Grid>
                    <!-- ⚠ 必须是 AssistDragSurface 而不是裸 GraphicsView：后者配上 `Fill`
                         会把期望尺寸报成「可用空间的全部」，把整条 Border 撑成近全屏。 -->
                    <ctl:AssistDragSurface x:Name="AssistDrag"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill" />
                    <HorizontalStackLayout x:Name="AssistRow" Spacing="0">
                        <!-- 拖动区放**最左边**（用户要求）：原先它紧挨着右边的 ✕，
                             手指想拖条子时很容易滑到关闭上、一不小心就把浮条关了。
                             它现在只是个**视觉提示** —— 真正的拖动面是下面那层 GraphicsView。 -->
                        <Label x:Name="AssistDragHandle" Text="⣿" FontSize="14" Padding="12,4"
                               TextColor="{AppThemeBinding Light=#8A8A8E, Dark=#999999}"
                               VerticalTextAlignment="Center" />
                        <!-- ⚠ 这六个按钮用的 `AssistChip` 样式里带 `InputTransparent="True"` ——
                             用户要求「只有关闭按钮位置不可拖动，其他地方都应该能拖动」。
                             Button 是 clickable，会**消费掉触摸**（实测：从按钮起划，pan 事件 0 个），
                             于是底下那层拖动面永远收不到 —— 调到透明后触摸穿到拖动面，
                             按钮的「点击」由拖动面在 `EndInteraction` 里**按坐标判定**后派发
                             （见 EditorPage.xaml.cs 的 AssistHitTargets）。
                             ⚠ 与它们配套的是 `AssistRow`：布局本身不消费，子元素透明后就整条可拖。
                             ⚠ 弹表里的按钮**不受影响**（那是另一棵树、另一组按钮）。 -->
                        <Button x:Name="AssistTabBtn" Text="TAB" Style="{StaticResource AssistChip}"
                                Clicked="OnAssistTabClicked" />
                        <Button x:Name="AssistSymBtn" Text="符号" Style="{StaticResource AssistChip}"
                                Clicked="OnAssistSymbolsClicked" />
                        <Button x:Name="AssistOpBtn" Text="运算符" Style="{StaticResource AssistChip}"
                                Clicked="OnAssistOperatorsClicked" />
                        <Button x:Name="AssistKwBtn" Text="关键字" Style="{StaticResource AssistChip}"
                                Clicked="OnAssistKeywordsClicked" />
                        <!-- 退格 —— **不依赖输入法**的自己实现。
                             起因（用户实测发现）：**部分输入法的退格只作用于它自己的联想词库，
                             从不回调编辑框**，于是「候选区在变、文本一个字不动」。
                             那种情况下平台输入连接这条路根本够不着（它不调用我们），
                             只能由应用提供一个自己的退格键。
                             ⚠ 它排在**最右边、紧挨 ✕**（用户要求）：左边那条是抓握/拖动区，
                             退格杵在那里时「想拖条子」很容易顺手删掉一个字。右边是低频区。 -->
                        <!-- ⚠ 这两格（⌫ / ✕）**单独收小、并且去掉外框**（用户要求：大了容易误触）。
                             必须显式给宽高与 `MinimumHeightRequest` —— App 的全局 Button 隐式样式
                             设了 `BorderWidth=1` 与 `MinimumHeight/WidthRequest=44`
                             （`Resources/Styles/Styles.xaml:33-37`），只改 `Padding`/`FontSize` 是**压不下去**的，
                             点击区（命中判定直接取 `Bounds`）照样是 44×44。
                             `VerticalOptions=Center` 也是必需的：不写就会被拉满整行高度。 -->
                        <Button x:Name="AssistBackspaceBtn" Text="⌫"
                                Style="{StaticResource AssistChip}"
                                FontSize="12" Padding="0"
                                WidthRequest="34" HeightRequest="28"
                                MinimumWidthRequest="34" MinimumHeightRequest="28"
                                VerticalOptions="Center"
                                BorderWidth="0"
                                Clicked="OnAssistBackspaceClicked" />
                        <!-- ✕ 是**唯一不可拖动**的一格（用户指定）：它照旧只关闭浮条，
                             手指落在它上面时不进入拖动 —— 见 AssistCloseRect 的用法。 -->
                        <Button x:Name="AssistCloseBtn" Text="✕"
                                Style="{StaticResource AssistChip}"
                                FontSize="12" Padding="0"
                                WidthRequest="28" HeightRequest="28"
                                MinimumWidthRequest="28" MinimumHeightRequest="28"
                                VerticalOptions="Center"
                                BorderWidth="0"
                                TextColor="{AppThemeBinding Light=#8A8A8E, Dark=#999999}"
                                Clicked="OnAssistCloseClicked" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- 弹出表：紧贴条的**上方或下方**（哪边放得下放哪边），内容可滚动 -->
            <Border x:Name="AssistPopup"
                    IsVisible="False"
                    ZIndex="25"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#E9E9EE, Dark=#F22C2C2E}"
                    Padding="6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <!-- 高度上限与按钮尺寸同源缩放（按钮缩到 3/4 ⇒ 220×0.75=165）：
                     只缩按钮不缩这个上限的话，弹表还是占那么大一块，白缩。 -->
                <ScrollView x:Name="AssistPopupScroll" MaximumHeightRequest="165">
                    <!-- ⚠ `AlignContent="Start"` 不能省：它的默认值是 `Stretch`，
                         意思是「把这些**行**拉伸去填满容器高度」。于是格子的高度取决于
                         **排了几行** —— 符号二十来项行少、每行被拉得很高，运算符三十来项
                         行多、每行本来就接近自然高度，两边看着就不一样
                         （用户实测：「运算符的按钮大小正确，符号按钮的高度大了」）。
                         `AlignItems="Center"` 让同一行里高矮不同的格子仍然居中对齐。 -->
                    <FlexLayout x:Name="AssistPopupItems" Wrap="Wrap" Direction="Row"
                                AlignContent="Start" AlignItems="Center" />
                </ScrollView>
            </Border>

            <!-- 打开中遮罩：大文件要顺序扫一遍建行索引（100MB 在百毫秒~数秒级），
                 这期间没有任何反馈的话，用户会以为是「没点到」或者「卡死了」。
                 放在内容区最上层，盖住画布与输入框。
                 ⚠ ZIndex 必须**显式写 30**：原来没写（默认 0），而全屏浮层是 21 ⇒ 实际是
                 浮层盖在遮罩上，与这段注释里说的「最上层」正好相反。 -->
            <Grid x:Name="LoadingMask" IsVisible="False" ZIndex="30" BackgroundColor="#99000000">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <ActivityIndicator IsRunning="True" Color="White" />
                    <Label
                        x:Name="LoadingText"
                        Text="文件打开中…"
                        TextColor="White"
                        FontSize="14"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- 状态栏：行列 / 字符数 / 修改标记 -->
        <Label
            Grid.Row="3"
            x:Name="StatusLabel"
            FontSize="11"
            Padding="8,4"
            TextColor="{AppThemeBinding Light=#888888, Dark=#999999}" />
    </Grid>
</ContentPage>
