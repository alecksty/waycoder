<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WayCoder.Maui.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="编辑器">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- 文件名 -->
        <Label
            Grid.Row="0"
            x:Name="FileLabel"
            Text=""
            VerticalOptions="Center"
            FontSize="13"
            Padding="8,4,8,0"
            LineBreakMode="TailTruncation" />

        <!-- 编辑工具条（SVG 图标按钮）：撤销 / 重做 / 查找 / 大纲 / 预览(源码) / 编辑(只读↔可写) / 保存 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*" Padding="8,2" ColumnSpacing="4">
            <ImageButton
                x:Name="UndoBtn"
                Source="icon_undo"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnUndoClicked"
                SemanticProperties.Hint="撤销" />
            <ImageButton
                x:Name="RedoBtn"
                Grid.Column="1"
                Source="icon_redo"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnRedoClicked"
                SemanticProperties.Hint="重做" />
            <ImageButton
                x:Name="FindBtn"
                Grid.Column="2"
                Source="icon_find"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnFindClicked"
                SemanticProperties.Hint="查找" />
            <ImageButton
                x:Name="OutlineBtn"
                Grid.Column="3"
                Source="icon_outline"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnOutlineClicked"
                SemanticProperties.Hint="大纲" />
            <ImageButton
                x:Name="PreviewBtn"
                Grid.Column="4"
                Source="icon_preview"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnPreviewClicked"
                SemanticProperties.Hint="预览/源码" />
            <ImageButton
                x:Name="EditBtn"
                Grid.Column="5"
                Source="icon_edit"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnEditClicked"
                SemanticProperties.Hint="切换只读/编辑" />
            <ImageButton
                x:Name="SaveBtn"
                Grid.Column="6"
                Source="icon_save"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="OnSaveClicked"
                SemanticProperties.Hint="保存" />
        </Grid>

        <!-- 编辑/预览区（触控软键盘）：
             源码 = 透明文字 Editor 叠加高亮 Label（语法高亮「透明叠加」方案）。
             Editor 文字透明、光标保留、不自动换行（横向滚动）；高亮 Label 同 FontFamily/FontSize
             对齐、LineBreakMode=NoWrap + IsClippedToBounds 裁剪，横向滚动靠 EditText ScrollChanged
             平移 TranslationX 同步（EditorPage.xaml.cs HandlerChanged 挂载）。
             左侧行号栏与代码同处纵向 ScrollView → 纵向同步滚动，横向固定不随代码滚动。
             markdown 文件点「预览」切换预览区（MarkdownPreview 渲染，表格等成块显示）。 -->
        <Grid Grid.Row="2">
            <ScrollView x:Name="EditorScroll" HorizontalScrollBarVisibility="Never">
                <Grid ColumnDefinitions="Auto,*" VerticalOptions="Start">
                    <Label
                        x:Name="LineNumbers"
                        FontFamily="Courier New"
                        FontSize="14"
                        Padding="8,7,4,6"
                        HorizontalTextAlignment="End"
                        VerticalOptions="Start"
                        TextColor="{AppThemeBinding Light=#999999, Dark=#666666}"
                        IsVisible="False" />
                    <!-- 内容区：HighlightLayer 按内容高度驱动（Start），Editor 填满同高。
                         不设 IsClippedToBounds——此前裁剪会把内容压到一行只显示首行（行号外层溢出却全显示）；
                         横向裁剪交给外层 ScrollView 视口，横向滚动靠 EditorPage 的 TranslationX 平移同步。 -->
                    <Grid Grid.Column="1" VerticalOptions="Start">
                        <!-- 高亮层：LineBreakMode 不能用 NoWrap——它会让 FormattedString 里的 \n 不换行，
                             内容并成一行只有首行可见（行号 Label 未设 NoWrap 所以正常分行）。
                             宽度靠 UpdateHighlight 按最大行宽设的 WidthRequest 约束，长行不换行、\n 正常分行。 -->
                        <Label
                            x:Name="HighlightLayer"
                            FontFamily="Courier New"
                            FontSize="14"
                            Padding="4,6"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            IsVisible="False" />
                        <Editor
                            x:Name="CodeEditor"
                            StyleId="code-editor"
                            TextChanged="OnTextChanged"
                            FontFamily="Courier New"
                            FontSize="14"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />
                    </Grid>
                </Grid>
            </ScrollView>
            <ScrollView x:Name="PreviewScroll" IsVisible="False">
                <VerticalStackLayout x:Name="PreviewContent" />
            </ScrollView>
        </Grid>

        <!-- 状态栏：行列 / 字符数 / 修改标记 -->
        <Label
            Grid.Row="3"
            x:Name="StatusLabel"
            FontSize="11"
            Padding="8,4"
            TextColor="{AppThemeBinding Light=#888888, Dark=#999999}" />
    </Grid>
</ContentPage>
