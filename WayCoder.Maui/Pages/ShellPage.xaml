<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WayCoder.Maui.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WayCoder.Maui.Controls"
    Title="命令行">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- 顶栏：三个尺寸模式 + 清屏。
             工作目录**改由输入行的提示符表示**（`~/examples>`）—— 它才是"我下一条命令在哪跑"
             的唯一出处；原先这里还有一行 `cwd: …`，和提示符说同一件事，等于同一屏写两遍。 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6" Padding="12,8,8,2">
            <!-- 尺寸模式：**三个正交组合**（都不固定 / 横向固定 / 都固定）——
                 不是"自动 vs 固定"两档：老程序按 80 列排表格 ⇒ 列必须钉死，
                 而手机屏幕高度各家不同 ⇒ 行没必要跟着钉死（钉了反而上下留白）。
                 三态互斥，当前生效那个用主色底高亮（见 UpdateSizeButtons）；
                 **重复点生效中的那个 = 换预设**（列数 / 尺寸档），省一次弹窗。 -->
            <Button
                x:Name="AutoSizeBtn"
                Grid.Column="0"
                Text="大小自适应"
                FontSize="13"
                Padding="10,4"
                HeightRequest="34"
                CornerRadius="8"
                Clicked="OnAutoSizeClicked" />
            <Button
                x:Name="WidthFixedBtn"
                Grid.Column="1"
                Text="横向固定"
                FontSize="13"
                Padding="10,4"
                HeightRequest="34"
                CornerRadius="8"
                Clicked="OnWidthFixedClicked" />
            <Button
                x:Name="FixedSizeBtn"
                Grid.Column="2"
                Text="固定 80×25"
                FontSize="13"
                Padding="10,4"
                HeightRequest="34"
                CornerRadius="8"
                Clicked="OnFixedSizeClicked" />
            <!-- 菜单：**常用操作收进一个按钮**（原来是「清屏」单个按钮）。
                 为什么改成菜单：这一页真正常用的操作不止"清屏"一个 ——
                 字号加减（捏合不好使时的可靠入口）、重置字号、复制整屏输出。
                 顶栏就那么宽，一个一个摆按钮会把三个尺寸档挤出去；
                 而**每加一个操作就加一个按钮**这条路上，顶栏迟早装不下。
                 「复制整屏输出」还有个非它不可的理由：输出区是**自绘画布**，
                 没有文本选择 —— 不加这个入口，用户看到一段输出是**拿不走**的。 -->
            <!-- 「⏹ 停止」：**只在有 VML 程序在跑的时候出现**。
                 ⚠ 为什么要这个按钮：出口本来就有（返回键 → 「强制停止」），但**它不可见** ——
                 一个卡在等输入的程序，用户看到的就是一个死界面，不会想到去按返回。
                 用户原话：「有些程序在命令行不停的要输入，**不知道怎么结束这个程序**」。
                 这里不新开机制，走的就是返回键那条路的同一个出口 `CancelRunningVml()`。 -->
            <Button
                x:Name="StopBtn"
                Grid.Column="4"
                Text="⏹ 停止"
                FontSize="13"
                Padding="12,4"
                HeightRequest="34"
                CornerRadius="8"
                BackgroundColor="#B3261E"
                TextColor="White"
                IsVisible="False"
                Clicked="OnStopClicked" />
            <Button
                x:Name="MenuBtn"
                Grid.Column="5"
                Text="菜单"
                FontSize="13"
                Padding="14,4"
                HeightRequest="34"
                CornerRadius="8"
                Clicked="OnMenuClicked" />
        </Grid>

        <!-- 输出区：**等宽 + 纯文本**，刻意不做富文本着色 ——
             一条命令的输出轻松上万字符，拆成 Span 会让滚动卡死
             （移动端编辑器那轮踩过：相邻同色 Span 合并 + 超大降级纯文本才压住 ANR）。
             这里直接就是那个「降级形态」，量级再大也不用再降。

             滚动条是**自己画的一条细轨**（不是 ScrollView 自带的）：系统那条在 Android 上
             只在滑动时闪一下，输出长到几十屏时完全不知道自己在哪。它只在内容超出视口时出现
             （判据是 ScrollBarMath.ShouldShow，几何也全在那边，页面里不重算一份）。 -->
        <Grid Grid.Row="1">
            <!-- 输出区 = **一块自绘画布**（`TerminalGrid`）：内容、滚动、滚动条都由它自己管
                 （用户定的原则：「**自己画内容，自己管理滚动条，自己管理光标**」）。

                 ⚠ **外面不套 `ScrollView`**（原本套着，已去掉）—— 两个理由，都不是样式问题：
                   ① 套着的时候**双指的第二根手指会被滚动容器截走**，画布的捏合根本不触发
                      （实测"捏不动"）；
                   ② 画布就不必再"既要内容尺寸、又要视口尺寸" —— 上一版没解开这个结，
                      量成了 0×0，输出区**一片空白**。
                 照的是编辑器：它的正文就是个裸 `CodeCanvasView`，外面没有滚动容器。

                 ⚠ 这里原本还有两条**页面自绘的滚动轨道**（`ScrollTrack`/`HScrollTrack`）—— 已删。
                 它们当初的判断是对的（"系统那条在 Android 上只在滑动时闪一下，输出长到几十屏时
                 完全不知道自己在哪"），只是现在那一层画在**画布**里（`TerminalGrid.DrawBars`）：
                 滚动条与内容必须是同一套坐标系，分在两处就是"同一件事两处实现"。 -->
            <controls:TerminalGrid
                x:Name="OutputGrid"
                Margin="12,4,16,4" />
        </Grid>

        <!-- 输入区：$ 提示符 + 输入框 + 历史 + 运行。
             手机上软键盘没有可靠的方向键，所以历史做成了按钮而不是 ↑/↓ 按键。 -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Padding="12,6,8,8" ColumnSpacing="6">
            <!-- 提示符：空闲时是**缩写路径 + `>`**（`~/examples>`），运行中是 `⋯`。
                 这一格就是全页唯一的状态灯 —— 用户在哪儿、有没有在跑，看它一眼就够。 -->
            <Label
                x:Name="PromptLabel"
                Grid.Column="0"
                Text="~>"
                FontSize="13"
                LineBreakMode="MiddleTruncation"
                MaximumWidthRequest="132"
                VerticalOptions="Center" />
            <!-- ⚠ `Keyboard="Plain"` 是**必须的**，不是样式偏好：
                 Android 输入法默认**自动首字母大写**，`cd /sdcard` 会被送成 `CD /sdcard`，
                 而 shell 的命令名是大小写敏感的 ⇒ 直接 `exit 127: CD: not found`。
                 实测踩到（真机上每条命令都被大写）。Plain = 关掉大写/纠错/联想三件套。 -->
            <Entry
                x:Name="CmdEntry"
                Grid.Column="1"
                Placeholder="输入 shell 命令…"
                FontSize="13"
                Keyboard="Plain"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                ReturnType="Go"
                Completed="OnRunRequested" />
            <Button
                x:Name="HistUpBtn"
                Grid.Column="2"
                Text="↑"
                FontSize="14"
                Padding="12,4"
                HeightRequest="38"
                CornerRadius="8"
                Clicked="OnHistoryUpClicked" />
            <Button
                x:Name="RunBtn"
                Grid.Column="3"
                Text="运行"
                FontSize="13"
                Padding="16,4"
                HeightRequest="38"
                CornerRadius="8"
                Clicked="OnRunRequested" />
        </Grid>

        <!-- stdin 提示行：**只在程序真的在读输入时出现**（默认隐藏）。
             这是"程序要输入时弹输入框"那个模型的落点 —— VML 程序调 read/scanf 时会阻塞，
             宿主把这一行亮出来，用户填一行回车，值就喂给它，程序接着往下跑。
             所以它不是"运行前先填完"那种一次性输入区，而是**跟着程序的节奏一问一答**。 -->
        <Grid
            x:Name="StdinPanel"
            Grid.Row="3"
            IsVisible="False"
            ColumnDefinitions="Auto,*,Auto"
            Padding="12,2,8,8"
            ColumnSpacing="6">
            <Label
                Grid.Column="0"
                Text="⌨ 等输入"
                FontSize="12"
                VerticalOptions="Center"
                TextColor="{AppThemeBinding Light=#B4690E, Dark=#E0A030}" />
            <Entry
                x:Name="StdinEntry"
                Grid.Column="1"
                Placeholder="程序在等一行输入…"
                FontSize="13"
                Keyboard="Plain"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                ReturnType="Go"
                TextChanged="OnStdinTextChanged"
                Completed="OnStdinSubmitted" />
            <Button
                Grid.Column="2"
                Text="喂给它"
                FontSize="13"
                Padding="14,4"
                HeightRequest="38"
                CornerRadius="8"
                Clicked="OnStdinSubmitted" />
        </Grid>
    </Grid>
</ContentPage>
