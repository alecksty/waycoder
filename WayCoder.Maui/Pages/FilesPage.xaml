<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WayCoder.Maui.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:svc="clr-namespace:WayCoder.Maui.Services"
    Title="文件">

    <Grid>
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- 顶部导航条：返回上级 + 当前路径 + 编辑模式开关 + 导入文档 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Padding="8,4" ColumnSpacing="4">
            <Button
                x:Name="UpBtn"
                Text="↩ 上级"
                FontSize="13"
                Clicked="OnUpClicked" />
            <Label
                x:Name="PathLabel"
                Grid.Column="1"
                Text="/"
                VerticalOptions="Center"
                FontSize="13"
                Margin="8,0"
                LineBreakMode="TailTruncation" />
            <Button
                x:Name="EditBtn"
                Grid.Column="2"
                Text="✏️ 编辑"
                FontSize="13"
                Clicked="OnEditModeClicked" />
            <Button
                x:Name="ImportBtn"
                Grid.Column="3"
                Text="导入"
                FontSize="13"
                Clicked="OnImportClicked" />
        </Grid>

        <!-- 新建文件 / 文件夹 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="8,2" ColumnSpacing="8">
            <Button
                x:Name="NewFileBtn"
                Grid.Column="0"
                Text="＋ 新建文件"
                FontSize="13"
                Clicked="OnNewFileClicked" />
            <Button
                x:Name="NewDirBtn"
                Grid.Column="1"
                Text="＋ 新建文件夹"
                FontSize="13"
                Clicked="OnNewDirClicked" />
        </Grid>

        <!-- 文件列表：正常模式点目录进入/点文件操作；编辑模式（✏️ 编辑开启）点任意项弹删除/改名/打包菜单 -->
        <CollectionView
            Grid.Row="2"
            x:Name="FileList"
            SelectionMode="Single"
            SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:SandboxFsService+FsEntry">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,10">
                        <Label
                            Text="{Binding Icon}"
                            FontSize="20"
                            VerticalOptions="Center" />
                        <!-- 文件名配色按「在 VML 这条线上是什么角色」分档（红/黄/绿），
                             取值与判据都在 SandboxFsService.FsEntry.NameColor / DetectVmlRole，
                             这里只负责绑上去，不在这里写颜色。 -->
                        <Label
                            Grid.Column="1"
                            Text="{Binding Name}"
                            FontSize="14"
                            VerticalOptions="Center"
                            LineBreakMode="TailTruncation"
                            TextColor="{Binding NameColor}" />
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="0">
                            <Label
                                Text="{Binding DisplaySize}"
                                FontSize="11"
                                HorizontalTextAlignment="End"
                                TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                            <Label
                                Text="{Binding DisplayModified}"
                                FontSize="11"
                                HorizontalTextAlignment="End"
                                TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="沙箱工作区为空，点「导入」加入文件" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>

        <!--
            耗时操作（删除 / 打包）的进度遮罩。

            ⚠ 铺满**整页**、带不透明底色 —— 这样它自己就是可命中的，底层列表/按钮
              收不到任何触摸 ⇒「没完成之前不让点其他地方」不用另写开关，遮罩天然就是模态。
              （只把 `FileList.IsEnabled = false` 是不够的：顶部那几个按钮还点得动。）

            显示/隐藏走 FilesPage.ShowBusy/HideBusy；删除与打包两处共用。
        -->
        <Grid
            x:Name="BusyOverlay"
            IsVisible="False"
            BackgroundColor="#C0000000">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="14">
                <ActivityIndicator
                    x:Name="BusySpin"
                    IsRunning="True"
                    Color="White"
                    WidthRequest="46"
                    HeightRequest="46" />
                <Label
                    x:Name="BusyLabel"
                    Text="正在处理…"
                    TextColor="White"
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    MaximumWidthRequest="280" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
