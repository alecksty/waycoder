<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WayCoder.Maui.Pages.DrawWindowPage"
             Title="VML 窗口"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <!-- VML 程序开的窗口。布局三行：画布 / 折叠条 / 手柄。
         **标题只有一处**：Shell 的标题栏（代码里 `Title = scene.Title`）。
         原来页面内还有一个 HeaderLabel 写着同一句话，屏幕上就是上下两个一样的标题 —— 已去掉。
         底部的操控区按**游戏机手柄**排布 —— 而不是排成一排按钮：
           · 左：十字方向键（四个方向在拇指自然落点上）
           · 中：SELECT / START
           · 右：X/Y/A/B 菱形（Y 上、X 左、B 右、A 下，与主流手柄一致）
         手机没有物理键盘，不做成手柄的话「用方向键+动作键写的游戏」在真机上没法玩；
         而排成一排时拇指要横跨整屏找键，做游戏时根本按不过来。
         手柄上方那条**折叠条**（点中间的箭头收起/展开手柄）是为了看长内容 ——
         手柄区占掉约 150dp，收起后画布立刻多出这一截。 -->
    <!-- ⚠ **三块手柄是 `RootGrid` 的直接子元素，中间没有包装层**。
         横竖屏切换只改 `Grid.SetRow/SetColumn`（父子关系自始至终不变）——
         这是"不搬控件"的前提：运行时先摘再挂会撞 `IllegalStateException:
         The specified child already has a parent`（真机实测闪退），
         而且中间任何一步让 `CanvasHost` 量到 0 就会连锁失败。
         原来那层 `PadArea` 就是为了竖屏"一整排"，现在由 `RootGrid` 自己的
         `ColumnDefinitions="Auto,*,Auto"` + 各块自己的 Padding 还原同样的排布。 -->
    <Grid x:Name="RootGrid" RowDefinitions="*,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="6" Padding="0">

        <!-- 画布：**`GraphicsView` 就地重绘**，不是 `<Image>` 换 `Source`。
             ⚠ 换 `Image.Source` 会先卸掉旧图再解码新图，中间必然空一拍 —— 那就是"闪"
             （实测：把渲染从"每条图元一次"降到"每帧一次"之后仍然闪，说明问题不在**次数**，
             而在**换了控件内容这件事本身**）。`GraphicsView` 由平台双缓冲：旧帧一直在屏上，
             直到新帧画完才替换，中间不会露出背景色。 -->
        <!-- ⚠ **这里不能套 ScrollView。**
             即便是 `Orientation="Both"` 的 ScrollView 也会把拖动当成滚动手势截走，
             而绘图窗口里的触摸**就是游戏的操作输入** —— 实测"手指一拖，画面跟着滑走，
             程序收不到连续的 TOUCHMOVE"，拖动操作整个失灵。
             容器只需要给 FitCanvas 提供一个"可用视口尺寸"（code-behind 只读它的 Width/Height），
             普通 Grid 完全够用，且触摸直达 GraphicsView。 -->
        <Grid x:Name="CanvasHost" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <GraphicsView x:Name="CanvasView" Margin="8" />
        </Grid>

        <!-- 折叠条：左右两条细线 + 中间一个箭头按钮（点一下收起/展开手柄）。
             没有它的话，手柄区是**永久占着**的 —— 而很多 VML 程序只是打印文本或画一张静态图，
             根本用不到手柄，却要一直空掉屏幕底部那一块。 -->
        <Grid x:Name="CollapseBar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
              ColumnDefinitions="*,Auto,*" Padding="14,0" ColumnSpacing="8" HeightRequest="26">
            <BoxView
                Grid.Column="0"
                HeightRequest="1"
                VerticalOptions="Center"
                Color="{AppThemeBinding Light={StaticResource BorderLineLight}, Dark={StaticResource BorderLineDark}}" />
            <!-- 箭头 + 一句话说明「点下去会发生什么」—— 只画一个箭头的话，
                 "▲ 是收起还是展开"得靠用户点一次才知道。 -->
            <Button
                x:Name="PadToggleBtn"
                Grid.Column="1"
                Text="▲ 收起手柄"
                Clicked="OnTogglePad"
                FontSize="12"
                Padding="0"
                WidthRequest="132"
                HeightRequest="26"
                CornerRadius="13" />
            <BoxView
                Grid.Column="2"
                HeightRequest="1"
                VerticalOptions="Center"
                Color="{AppThemeBinding Light={StaticResource BorderLineLight}, Dark={StaticResource BorderLineDark}}" />
        </Grid>

        <!-- 手柄区：整体压小一档，让棋盘多占地方。
             ⚠ **每列都要 Auto 且互不重叠** —— SELECT/START 原来靠 Padding 撑宽，
             加上全局 Button 样式的 MinimumWidthRequest(44)，实际宽度超出中列、
             压到左右两侧的方向键上（截图里能直接看到叠在一起）。
             ⚠ 三块自己是 `RootGrid` 的子元素（见上），**键盘那两块各自多包一层**
             （`PadLeftArea` / `PadRightArea`）：外层是"这一侧键盘区"的边界，
             内层的 `*Keys` 才是那块键位。横屏时 SELECT/START 要落在**键盘区的角落**里，
             而角落那一格必须空着才不把十字键撑歪 —— 所以槽位放在外层。 -->

        <!-- 左：十字方向键。**圆角方块**（角落 10 而不是半圆），比圆形更好按、也更像手柄 -->
        <Grid x:Name="PadLeftArea" Grid.Row="2" Grid.Column="0" Padding="14,4,0,8"
              RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto" VerticalOptions="Center">
            <Grid x:Name="PadLeftKeys" Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                  RowSpacing="3" ColumnSpacing="3" VerticalOptions="Center">
                <Button Grid.Row="0" Grid.Column="1" x:Name="PadUp"    Text="↑" Pressed="OnPadPressed" Released="OnPadReleased"
                        WidthRequest="42" HeightRequest="38" CornerRadius="10" Padding="0" FontSize="16" />
                <Button Grid.Row="1" Grid.Column="0" x:Name="PadLeft"  Text="←" Pressed="OnPadPressed" Released="OnPadReleased"
                        WidthRequest="42" HeightRequest="38" CornerRadius="10" Padding="0" FontSize="16" />
                <Button Grid.Row="1" Grid.Column="2" x:Name="PadRight" Text="→" Pressed="OnPadPressed" Released="OnPadReleased"
                        WidthRequest="42" HeightRequest="38" CornerRadius="10" Padding="0" FontSize="16" />
                <Button Grid.Row="2" Grid.Column="1" x:Name="PadDown"  Text="↓" Pressed="OnPadPressed" Released="OnPadReleased"
                        WidthRequest="42" HeightRequest="38" CornerRadius="10" Padding="0" FontSize="16" />
            </Grid>
            <!-- (1,1) 空着 = 横屏时 SELECT 的落点（左键盘区**右下角**）。
                 竖屏这里没有子元素 ⇒ 整格塌成 0，外层又**不设** RowSpacing/ColumnSpacing，
                 所以竖屏尺寸与原样一字不差。 -->
        </Grid>

        <!-- 中：SELECT / START。小尺寸、上下排开，**不与两侧重叠**
             ⚠ 必须显式给 WidthRequest：全局 Button 样式的 MinimumWidthRequest(44)
             会在只靠 Padding 撑宽时变成宽度上限，文字被裁成一个字母。
             ⚠ 横屏时这两个键会被挪进左右键盘区（见 ApplyOrientation），本栈随即清空、置不可见。 -->
        <VerticalStackLayout x:Name="PadCenterArea" Grid.Row="2" Grid.Column="1" Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
            <Button x:Name="BtnSelect" Text="SELECT" Pressed="OnPadPressed" Released="OnPadReleased"
                    FontSize="10" Padding="0" WidthRequest="70" HeightRequest="28" CornerRadius="9" />
            <Button x:Name="BtnStart"  Text="START"  Pressed="OnPadPressed" Released="OnPadReleased"
                    FontSize="10" Padding="0" WidthRequest="70" HeightRequest="28" CornerRadius="9" />
        </VerticalStackLayout>

        <!-- 右：X/Y/A/B 菱形（Y 上 X 左 B 右 A 下） -->
        <Grid x:Name="PadRightArea" Grid.Row="2" Grid.Column="2" Padding="0,4,14,8"
              RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto" VerticalOptions="Center">
            <Grid x:Name="PadRightKeys" Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                  RowSpacing="3" ColumnSpacing="3" VerticalOptions="Center">
                <Button Grid.Row="0" Grid.Column="1" x:Name="FaceY" Text="Y" Pressed="OnPadPressed" Released="OnPadReleased"
                        WidthRequest="42" HeightRequest="38" CornerRadius="10" Padding="0" FontSize="15" FontAttributes="Bold" />
                <Button Grid.Row="1" Grid.Column="0" x:Name="FaceX" Text="X" Pressed="OnPadPressed" Released="OnPadReleased"
                        WidthRequest="42" HeightRequest="38" CornerRadius="10" Padding="0" FontSize="15" FontAttributes="Bold" />
                <Button Grid.Row="1" Grid.Column="2" x:Name="FaceB" Text="B" Pressed="OnPadPressed" Released="OnPadReleased"
                        WidthRequest="42" HeightRequest="38" CornerRadius="10" Padding="0" FontSize="15" FontAttributes="Bold" />
                <Button Grid.Row="2" Grid.Column="1" x:Name="FaceA" Text="A" Pressed="OnPadPressed" Released="OnPadReleased"
                        WidthRequest="42" HeightRequest="38" CornerRadius="10" Padding="0" FontSize="15" FontAttributes="Bold" />
            </Grid>
            <!-- (1,0) 空着 = 横屏时 START 的落点（右键盘区**左下角**）。理由同左区。 -->
        </Grid>

        <!-- ═══ **屏幕键盘**（电脑屏窗口用，`WIN_OPEN_PC` 的 R4 决定显不显示）═══

             ⚠ **它占自己的一行（row 3），不盖在画布上** —— 与手柄区同一种做法：
             键盘是**页面 chrome**，chrome 让画布变小，而不是压在画布上面。

             一开始做成了浮层（`Grid.Row="0"` + `VerticalOptions="End"`），理由是
             "不动 `ApplyOrientation` 的行列定义 + 画布尺寸不变"。那是**错的** ——
             用户一句话就点破了：**键盘盖住了画面底部**，而老程序的状态行、命令行、
             提示语恰恰都画在底部（`pcscreen.c` 的 `KEY`/`MOUSE` 两行当场看不见了）。
             画面被遮住是**用户直接看得见的功能缺失**，而"多摆一个控件进
             `ApplyOrientation`"只是实现上麻烦一点 —— 拿前者换后者不划算。

             `Auto` 行 ⇒ 收起时高度自然塌成 0（只留那个 26dp 的开关），画布立刻吃回来。
             键位表在 code-behind 的 `PcKeyboardRows`（一处数据，不散在 XAML 里）。

             ⚠ **键盘不再可拖动**（用户定的）。拖动本来是为"把面板挪开、把画布让出来"，
             而那件事**收起键盘**（`PcKeyToggle`）已经包了；代价却是一直挂着的手势 +
             一整套"浮层化 / 夹取"的状态机 + 一个 26dp 的把柄。去掉之后面板恒定停靠在自己
             那一行，画布尺寸只由"显示 / 收起"决定 —— 少一个能拖丢的浮层。
             （**不能**给 `PcKeyboard` 容器挂手势：给容器挂会把它子控件的按压整个吃掉，
              本仓记过这条，真机表现就是"按钮看着在、按下去没反应"。） -->
        <Grid x:Name="PcKeyboard" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
              IsVisible="False" Padding="4,0,4,4" RowSpacing="2"
              RowDefinitions="Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <!-- **三态合并行的切换键**（用户定：原来分开的那三行 —— `Esc/F1–F12`、数字行、
                     `Ins/Del/Home/End/PgUp/PgDn` —— 合并成一行，一个按钮循环切；键盘因此**少两行高**）。
                     放在表头而不是塞进键位行：键位行本来就挤着 13~14 个键，再插一格会把每个键
                     压得更窄；而表头这一行**本来就在**（原来放拖拽把柄的位置，把柄删了正好空出来）。
                     按钮上的字就是**当前那一页**（`Fn` / `8` / `Ins`），见 `ApplyPcKeyPage`。 -->
                <Button x:Name="PcKeyModeBtn" Grid.Column="0" Text="Fn"
                        FontSize="11" HeightRequest="26" Padding="12,0" CornerRadius="8"
                        Clicked="OnCyclePcKeyPage" />
                <Button x:Name="PcKeyToggle" Grid.Column="1" Text="⌨ 收起键盘"
                        FontSize="11" HeightRequest="26" Padding="0" CornerRadius="8"
                        Clicked="OnTogglePcKeyboard" />
            </Grid>
            <VerticalStackLayout x:Name="PcKeyRows" Grid.Row="1" Spacing="3" />
        </Grid>
    </Grid>
</ContentPage>
