<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WayCoder.Maui.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:WayCoder.Maui.Models"
    xmlns:pages="clr-namespace:WayCoder.Maui.Pages"
    Title="对话">

    <ContentPage.Resources>
        <!-- 用户消息：右对齐气泡 -->
        <DataTemplate x:Key="UserTemplate" x:DataType="models:ChatMessage">
            <Grid Padding="12,6">
                <Border
                    HorizontalOptions="End"
                    MaximumWidthRequest="320"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource UserBubbleBgLight}, Dark={StaticResource UserBubbleBgDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14,14,4,14" />
                    </Border.StrokeShape>
                    <Label
                        Text="{Binding RawText}"
                        Padding="12,8"
                        FontSize="15"
                        TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- AI 消息：左对齐，卡片背景 + 富文本（«» 已解码）。思考已独立为 Thinking 泡泡，不再内嵌入口 -->
        <DataTemplate x:Key="AssistantTemplate" x:DataType="models:ChatMessage">
            <Grid Padding="12,6">
                <Border
                    HorizontalOptions="Start"
                    MaximumWidthRequest="480"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AiBubbleBgLight}, Dark={StaticResource AiBubbleBgDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14,14,14,4" />
                    </Border.StrokeShape>
                    <Label
                        FormattedText="{Binding Formatted}"
                        Padding="12,8"
                        FontSize="15"
                        LineHeight="1.3" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 思考泡泡：与工具组同构——聊天流只留一行「已思考 N 秒」，点开弹 ReasoningDetailPage 看完整推理 -->
        <DataTemplate x:Key="ThinkingTemplate" x:DataType="models:ChatMessage">
            <VerticalStackLayout Padding="12,2">
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}"
                    StrokeThickness="0"
                    Padding="10,5"
                    HorizontalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShowReasoning" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="{Binding RawText}"
                        FontSize="11"
                        FontAttributes="Italic"
                        TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <!-- 工具消息：工具组 = 一行「工具调用:N 次」（点开弹详情页）；普通灰字行（错误/任务摘要）直接显示文本 -->
        <DataTemplate x:Key="ToolTemplate" x:DataType="models:ChatMessage">
            <VerticalStackLayout Padding="12,2" Spacing="1">
                <!-- 工具调用组：默认一行计数，点击弹 ToolCallsDetailPage 看每个工具 -->
                <Border
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0,2,0,2"
                    IsVisible="{Binding HasToolCalls}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShowToolCalls" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="{Binding RawText}"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                </Border>
                <!-- 普通灰字行（工具错误 ⚠ / 任务摘要 ⏱ 等非组消息）：无 ToolCalls 时直接显示 -->
                <Label
                    Text="{Binding RawText}"
                    FontSize="12"
                    TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                    IsVisible="{Binding IsPlainTool}" />
            </VerticalStackLayout>
        </DataTemplate>

        <pages:MessageTemplateSelector
            x:Key="TemplateSelector"
            UserTemplate="{StaticResource UserTemplate}"
            AssistantTemplate="{StaticResource AssistantTemplate}"
            ToolTemplate="{StaticResource ToolTemplate}"
            ThinkingTemplate="{StaticResource ThinkingTemplate}" />
    </ContentPage.Resources>

    <!-- 外层容器：主界面 MainGrid + 抽屉浮层 DrawerLayer 同一 cell 叠放。
         浮层独立布局，不再用 RowSpan 跨主 grid 行——否则浮层首开触发布局重排会干扰
         CollectionView（首次开左抽屉聊天区被压没/抽屉过窄），先右后左才正常即由此引起 -->
    <Grid>
        <!-- MainHost：抽屉推开内容时对其 Padding 左右让位（聊天整体收缩到抽屉另一侧完整重排，
             不被浮层盖住、不出现右侧空白） -->
        <Grid x:Name="MainHost">
        <Grid x:Name="MainGrid" RowDefinitions="Auto,*,Auto,Auto">

        <!-- 顶部状态区：行1 模型（点击切换），行2 工作模式/权限/todo/上下文/用量/花费 -->
        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" StrokeThickness="0"
                Padding="14,6" Margin="8,6">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <!-- 点击手势挂在 Border（容器）上而非 Label：MAUI Label 的 TapGestureRecognizer
                 在 Android 上不响应（原生 TextView clickable=false），导致模型选择窗口弹不出。 -->
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnModelBarTapped" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- 左 ≡：滑出左抽屉（会话历史列表） -->
                <Button Grid.Column="0"
                        x:Name="SessionsBtn"
                        Text="≡"
                        FontSize="16"
                        Padding="4,2"
                        Margin="0,0,6,0"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}"
                        Clicked="OnSessionsBtnClicked"
                        SemanticProperties.Hint="会话历史" />
                <!-- 行1：模型（左）+ 工作模式/权限（右）；行2：todo/上下文/用量/花费 -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="1">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label x:Name="ModelBar"
                               FontSize="13"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}"
                               HorizontalOptions="Start" VerticalOptions="Center" />
                        <Label x:Name="ModeBar"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               FontSize="10"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}"
                               HorizontalOptions="End" VerticalOptions="Center" />
                    </Grid>
                    <Label x:Name="StatusBar"
                           Grid.Row="1"
                           FontSize="10"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                           HorizontalOptions="Start" />
                </Grid>
                <!-- 右 ☰：滑出右抽屉（侧边栏：模式/权限/todo/上下文/记忆/命令） -->
                <Button Grid.Column="2"
                        x:Name="MenuBtn"
                        Text="☰"
                        FontSize="16"
                        Padding="8,2"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}"
                        Clicked="OnMenuClicked"
                        SemanticProperties.Hint="侧边栏" />
            </Grid>
        </Border>

        <CollectionView
            Grid.Row="1"
            x:Name="MsgList"
            ItemsSource="{Binding Messages}"
            ItemTemplate="{StaticResource TemplateSelector}"
            ItemsUpdatingScrollMode="KeepScrollOffset"
            Scrolled="OnMsgListScrolled">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Image Source="app.png" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" />
                    <Label Text="道码 · 手机编程智能体" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="问点什么，或去「文件」页导入项目" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- 浮动「滚到底」按钮：手动上翻离开底部时显示，点它滚到底并恢复自动滚动后隐藏 -->
        <Button
            x:Name="JumpBottomBtn"
            Grid.Row="1"
            Text="↓"
            FontSize="20"
            FontAttributes="Bold"
            WidthRequest="46"
            HeightRequest="46"
            CornerRadius="23"
            Padding="0"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,12,10"
            IsVisible="False"
            BackgroundColor="{StaticResource Primary}"
            TextColor="White"
            Opacity="0.92"
            Clicked="OnJumpBottomClicked"
            SemanticProperties.Hint="滚动到底部" />

        <!-- 输入框上方动态状态栏：左侧动画图标（思考旋转）+ 状态文本（思考中/等待确认中） -->
        <Border Grid.Row="2" x:Name="AgentStatusBar" IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                StrokeThickness="0" Padding="14,4" Margin="8,2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label x:Name="AgentStatusIcon" Text="⠋" FontSize="14" VerticalOptions="Center" />
                <Label x:Name="AgentStatusText" Grid.Column="1" Text="思考中..."
                       FontSize="12" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
            </Grid>
        </Border>

        <!-- 底部输入栏：圆形加号（语音/图片菜单） / 输入框 / 圆形发送 / 停止（运行中才显示） -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Padding="8,6" ColumnSpacing="8">
            <Button
                x:Name="AddBtn"
                Text="＋"
                FontSize="22"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}"
                Clicked="OnAddClicked"
                VerticalOptions="End"
                SemanticProperties.Hint="添加语音或图片" />
            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0" Margin="0,0,0,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <!-- / 前缀命令建议列表（输入 / 时显示，点击填入） -->
                    <CollectionView x:Name="SlashSuggest" IsVisible="False" HeightRequest="160" Margin="4,4,4,0"
                                    SelectionChanged="SlashSuggest_SelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}"
                                        Padding="10,6" StrokeThickness="0" Margin="0,0,0,2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding .}" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Entry
                        x:Name="InputBox"
                        Placeholder="问点什么…"
                        MaxLength="8000"
                        Margin="12,0"
                        VerticalOptions="Center"
                        ReturnType="Send"
                        Completed="OnEditorCompleted"
                        TextChanged="InputBox_TextChanged" />
                </VerticalStackLayout>
            </Border>
            <Button
                x:Name="SendBtn"
                Grid.Column="2"
                Text="↑"
                FontSize="20"
                FontAttributes="Bold"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Padding="0"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                Clicked="OnSendClicked"
                VerticalOptions="End"
                SemanticProperties.Hint="发送（忙时点=停止；键盘发送忙时排队）" />
        </Grid>

        </Grid>
        </Grid>
    </Grid>
</ContentPage>
