<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WayCoder.Maui.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:markup="clr-namespace:WayCoder.Maui.Markup"
    Title="{markup:Tr Zh='设置', En='Settings'}">

    <!-- 设置的**一级页**：只列分组 + 当前值摘要，点进去才是可改的控件（二级页
         SettingsGroupPage）。手机上「先看概要、要看细节再进去」比一页到底的长滚动好找。 -->
    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="10">

            <!-- 分组行模板：图标 | 标题+摘要 | › -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="🤖" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{markup:Tr Zh='模型', En='Model'}" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                        <Label x:Name="ModelSummary" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnModelTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="💰" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{markup:Tr Zh='参数', En='Parameters'}" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                        <Label x:Name="ParamsSummary" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnParamsTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="🔐" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{markup:Tr Zh='权限', En='Permission'}" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                        <Label x:Name="PermSummary" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPermTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="🗂" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{markup:Tr Zh='存储', En='Storage'}" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                        <Label x:Name="StorageSummary" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStorageTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <!-- 编辑器**单独一张卡片**（用户要求：编辑器以后还要增加很多设置，
                 与「存储」合并成一页的话会越来越长）。 -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="📝" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{markup:Tr Zh='编辑器', En='Editor'}" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                        <Label x:Name="EditorSummary" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditorTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="🎤" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{markup:Tr Zh='语音', En='Voice'}" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                        <Label x:Name="VoiceSummary" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVoiceTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <!-- 虚拟机：内存 / 栈 / 两个运行超时（VML 程序跑起来之后才用得上的那几项） -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="🖥" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{markup:Tr Zh='虚拟机', En='VM'}" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                        <Label x:Name="VmSummary" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVmTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <!-- 编译：编译器行为参数（优化 / 警告 / 浮点）—— 影响"编出来的程序"，与上面
                 「虚拟机」（影响"跑起来之后"）分开两张卡：改的时机不同（编译时 vs 运行时）。 -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="🛠" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{markup:Tr Zh='编译', En='Compile'}" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                        <Label x:Name="CompileSummary" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCompileTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="ℹ️" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{markup:Tr Zh='关于', En='About'}" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                        <Label x:Name="AboutSummary" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAboutTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
