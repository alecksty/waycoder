<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WayCoder.Maui.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="设置">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="10">

            <!-- ═══ 大模型（主任务推理）═══ -->
            <Label Text="大模型（主任务推理）" FontSize="12" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" Margin="4,8,0,0" />
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="14,8" Spacing="6">
                    <Label Text="服务商" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Picker x:Name="ProviderPicker" Title="选择服务商"
                            TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedIndexChanged="OnProviderChanged" />

                    <Label Text="模型" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Picker x:Name="ModelPicker" Title="选择模型"
                            TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}"
                            ItemDisplayBinding="{Binding DisplayName}" />

                    <Label Text="接口地址 BaseUrl（留空用服务商默认）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="BaseUrlEntry" Placeholder="https://api.example.com/v1" Margin="10,2" />
                    </Border>

                    <Label Text="API Key（留空保留原 Key）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="KeyEntry" IsPassword="True" Placeholder="sk-..." Margin="10,2" />
                    </Border>
                    <Button x:Name="TestKeyBtn" Text="🔍 测试 API Key（填好立即测，有效自动保存）"
                            FontSize="13" Clicked="OnTestKeyClicked" />
                    <Label x:Name="KeyStatusLabel" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 小模型（摘要/压缩/补全，便宜快速）═══ -->
            <Label Text="小模型（摘要/压缩/补全，便宜快速）" FontSize="12" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" Margin="4,8,0,0" />
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="14,8" Spacing="6">
                    <Label Text="服务商" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Picker x:Name="SmallProviderPicker" Title="选择服务商"
                            TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedIndexChanged="OnSmallProviderChanged" />

                    <Label Text="模型" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Picker x:Name="SmallModelPicker" Title="选择小模型"
                            TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}"
                            ItemDisplayBinding="{Binding DisplayName}" />

                    <Label Text="接口地址 BaseUrl（留空用服务商默认）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="SmallBaseUrlEntry" Placeholder="https://api.example.com/v1" Margin="10,2" />
                    </Border>

                    <Label Text="API Key（留空保留原 Key）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="SmallKeyEntry" IsPassword="True" Placeholder="sk-..." Margin="10,2" />
                    </Border>
                    <Button x:Name="SmallTestKeyBtn" Text="🔍 测试 API Key（填好立即测，有效自动保存）"
                            FontSize="13" Clicked="OnSmallTestKeyClicked" />
                    <Label x:Name="SmallKeyStatusLabel" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 模型工具：导入 / 扫描 / 免费模型 ═══ -->
            <Label Text="模型工具" FontSize="12" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" Margin="4,8,0,0" />
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" StrokeThickness="0" Margin="0,4,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="12,8" Spacing="6">
                    <Button Text="📥 导入模型" FontSize="13" Clicked="OnImportModelsClicked" />
                    <Button Text="📡 扫描连接" FontSize="13" Clicked="OnScanConnectionsClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 存储：外部 workspace（卸载重装代码不丢） ═══ -->
            <Label Text="存储" FontSize="12" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" Margin="4,8,0,0" />
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" StrokeThickness="0" Margin="0,4,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="12,8" Spacing="6">
                    <Label x:Name="WorkspaceStatusLabel" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Button x:Name="ExternalWorkspaceBtn" Text="🗂 启用外部存储 workspace（卸载重装代码不丢）"
                            FontSize="13" Clicked="OnExternalWorkspaceClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 参数 ═══ -->
            <Label Text="参数" FontSize="12" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" Margin="4,8,0,0" />
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="14,8" Spacing="6">
                    <Label Text="MaxTokens（最大输出 token）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="MaxTokensEntry" Keyboard="Numeric" Placeholder="32768" Margin="10,2" />
                    </Border>

                    <Label Text="Temperature（温度）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="TemperatureEntry" Keyboard="Numeric" Placeholder="0.1" Margin="10,2" />
                    </Border>

                    <Label Text="上下文窗口（未知模型兜底，默认 128K）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="MaxContextEntry" Keyboard="Numeric" Placeholder="131072" Margin="10,2" />
                    </Border>

                    <Label Text="预算上限 USD（留空不限，防花费失控）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="BudgetEntry" Keyboard="Numeric" Placeholder="5.0" Margin="10,2" />
                    </Border>

                    <Label Text="推理深度（推理模型的思考深度，空=默认）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Picker x:Name="ReasoningPicker" Title="推理深度"
                            TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />

                    <Label Text="经济模式" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Picker x:Name="EconomyPicker" Title="经济模式"
                            TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 权限 ═══ -->
            <Label Text="权限（何时打断确认）" FontSize="12" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" Margin="4,8,0,0" />
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="14,8" Spacing="6">
                    <Label Text="确认模式（Yolo = 不打断，适合信任沙箱内操作）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Picker x:Name="PermModePicker" Title="确认模式"
                            TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 语音 ═══ -->
            <Label Text="语音（语音输入转录）" FontSize="12" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" Margin="4,8,0,0" />
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="14,8" Spacing="6">
                    <Label Text="转录模型" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="WhisperModelEntry" Placeholder="whisper-1" Margin="10,2" />
                    </Border>

                    <Label Text="转录 API 地址（空=默认 OpenAI）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="WhisperBaseUrlEntry" Placeholder="https://api.openai.com" Margin="10,2" />
                    </Border>

                    <Label Text="转录 API Key（空=回退主 Key）" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="WhisperKeyEntry" IsPassword="True" Placeholder="sk-..." Margin="10,2" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Button x:Name="SaveBtn" Text="保存配置" Clicked="OnSaveClicked" Margin="0,14,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
