<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WayCoder.Maui.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="首页">

    <ScrollView>
        <VerticalStackLayout Padding="28,48" Spacing="12">

            <Label Text="🀄" FontSize="64" HorizontalTextAlignment="Center" />
            <Label Text="道码" FontSize="30" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
            <Label x:Name="VersionLabel" FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" HorizontalTextAlignment="Center" />
            <Label Text="手机编程智能体 —— 问点什么，或去「文件」页导入项目"
                   FontSize="14" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                   HorizontalTextAlignment="Center" Margin="0,6,0,0" />

            <!-- 配置状态卡 -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" StrokeThickness="0" Margin="0,20,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="18" Spacing="8">
                    <Label Text="当前配置" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Label x:Name="ModelLabel" FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                    <Label x:Name="KeyLabel" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="💬  开始对话" Clicked="OnChatClicked" Margin="0,16,0,0" />
            <Button Text="⚙️  配置 API Key" Clicked="OnSettingsClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
