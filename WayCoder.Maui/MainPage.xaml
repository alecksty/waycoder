<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WayCoder.Maui.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:markup="clr-namespace:WayCoder.Maui.Markup"
    Title="{markup:Tr Zh='首页', En='Home'}">

    <ScrollView>
        <VerticalStackLayout Padding="28,48" Spacing="12">

            <Image Source="app.png" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" />
            <Label Text="{markup:Tr Zh='都来码', En='Dolaima'}" FontSize="30" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
            <Label x:Name="VersionLabel" FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" HorizontalTextAlignment="Center" />
            <Label Text="{markup:Tr Zh='手机编程智能体 —— 问点什么，或去「文件」页导入项目', En='Coding agent for your phone. Ask something, or import a project from Files.'}"
                   FontSize="14" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                   HorizontalTextAlignment="Center" Margin="0,6,0,0" />

            <!-- 配置状态卡 -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" StrokeThickness="0" Margin="0,20,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="18" Spacing="8">
                    <Label Text="{markup:Tr Zh='当前配置', En='Current setup'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                    <Label x:Name="ModelLabel" FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource MainTextLight}, Dark={StaticResource MainTextDark}}" />
                    <Label x:Name="KeyLabel" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{markup:Tr Zh='💬  对话', En='💬  Chat'}" Clicked="OnChatClicked" Margin="0,12,0,0" />
            <Button Text="{markup:Tr Zh='⚙️  配置', En='⚙️  Settings'}" Clicked="OnSettingsClicked" />
            <Button Text="{markup:Tr Zh='🗂  模型', En='🗂  Models'}" Clicked="OnModelsClicked" />
            <Button Text="{markup:Tr Zh='🔄  同步', En='🔄  Sync'}" Clicked="OnGitSyncClicked" />
            <!-- 「关于」**不在这儿** —— 首页摆的是"要去哪儿干活"的入口，
                 而「关于」是"看看这个 App 是什么"，属于设置那一类。
                 它已经在「设置」页里（`SettingsPage.xaml` 的「关于」行），
                 另有一条 `/about` 斜杠命令、以及侧栏命令页的「ℹ️ 关于」，入口不缺。 -->

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
