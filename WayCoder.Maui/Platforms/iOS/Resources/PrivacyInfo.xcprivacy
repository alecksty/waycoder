<?xml version="1.0" encoding="UTF-8"?>
<!--
This is the minimum required version of the Apple Privacy Manifest for .NET MAUI apps.
The contents below are needed because of APIs that are used in the .NET framework and .NET MAUI SDK.

You are responsible for adding extra entries as needed for your application.

More information: https://aka.ms/maui-privacy-manifest
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
        <!--
            本 App **确实**用 Preferences API，所以这一条**必须开** —— MAUI 模板默认把它注释掉、
            注明「只有用 Preferences API 时才需要」，于是很容易被当成"模板里的可选样例"漏过去。
            实测：WayCoder.Maui 下 `Preferences.Get/Set/ContainsKey` 共 35 处
            （MauiCompileStore 编译开关、MauiSessions 当前会话 id、MauiShellStore 字号/行列/回滚、
            MauiVmStatusStore 面板形态、MauiEditorStore 字号、VmlHostRuntime 的 `vml.` 前缀存档），
            而 iOS 上 `Preferences` 就是 `NSUserDefaults`。
            缺声明的后果：提交时被苹果的自动化检查拦下（ITMS-91053: Missing API declaration），
            **构建全绿、只有上传才报**。

            理由码 CA92.1 = 「读写只有本 App 自己能访问的 user defaults」——
            本 App 的 Preferences 全部落在自己的容器里，不涉及 App Group / 第三方 SDK，故用这一条。
            新增任何走 App Group 或第三方 SDK 的存储时，要另加对应条目（1C8F.1 / C56D.1）。
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>

    <!-- ── 收集的数据类型：**空数组 = 不收集任何数据类型**（2026-09-29 定） ──
         口径要说清楚，别让下一个人以为这是"忘了填"：

         本 App 把用户的代码/对话发给 LLM 接口，而那个接口是**用户自己配置的**
         （自带的 key、自己的服务器）。开发者**既不接触**这些内容、**也不留存**，
         数据流向完全由用户指定 ⇒ 按苹果口径不计入"开发者收集"。
         这也是绝大多数「自带 API Key」客户端的通行做法。

         ⚠ 两件事要**同时**保持一致，缺一条就是自相矛盾的申报：
           ① **App Store Connect 的隐私问卷**要按同一口径填（"不收集"）；
           ② 将来若接了**自己的**中转/统计/崩溃上报（把数据落到我们这边），
              **这里与问卷都要同步改** —— 那就不再是"不收集"了。

         ⚠ 空数组是**合法且明确**的写法（表示"一种也不收集"），不是占位符。 -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- 本 App 不做跨 App/跨站点的追踪，也不含追踪域。显式声明（苹果建议写出，
         缺省虽等同于 false，但写出来审核时不必再问一轮）。 -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
</dict>
</plist>
