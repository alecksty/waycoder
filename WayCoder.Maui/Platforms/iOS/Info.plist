<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- UIScene 生命周期（2026-09-27 加）：⚠ 少了这段，**用 SDK 27 编译的包在 iOS 27 上起不来**
	     （UIKit 断言 "UIScene life cycle is required…"）。iOS 26 只是警告，所以真机一直没暴露。
	     `UISceneDelegateClassName` 是 **ObjC 注册名**，必须与 `SceneDelegate.cs`（项目根，两端共用一份）
	     的 `[Register("SceneDelegate")]` 逐字相同 —— 写错不报错，只是回到"起不来"或黑屏。
	     ⚠⚠ **`Platforms/MacCatalyst/Info.plist` 里也有一份一模一样的**（2026-09-27 补）：
	     上一轮只改了本文件 ⇒ iOS 好了、**macOS 版照样秒退（133/SIGTRAP）**。
	     改这里就要改那里，反之亦然（`SelfTest.Chunk19` 有护栏：漏一处即红）。 -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<!-- ⚠⚠ **这个名字必须逐字是这样**：MauiUISceneDelegate.WillConnect 第一句就是
					     `if (session.Configuration.Name != "__MAUI_DEFAULT_SCENE_CONFIGURATION__") return;`
					     —— 名字不对**不报错**，只是 MAUI 不建窗口 ⇒ App 在前台但屏幕全黑（实测踩过）。 -->
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<key>NSCameraUsageDescription</key>
	<string>用于拍照，让道码「看图」修 bug</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于从相册选择图片，让道码「看图」修 bug</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于语音输入（说话代替打字）</string>
</dict>
</plist>
