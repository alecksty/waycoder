<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WayCoder.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WayCoder.Maui"
    xmlns:pages="clr-namespace:WayCoder.Maui.Pages"
    Title="WayCoder 道码">

    <TabBar>
        <!-- 首页 Tab：欢迎/引导 + 配置状态 -->
        <Tab Title="首页">
            <Tab.Icon>
                <FontImageSource Glyph="🏠" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="home" />
        </Tab>
        <!-- 对话 Tab：流式对话 -->
        <Tab Title="对话">
            <Tab.Icon>
                <FontImageSource Glyph="💬" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:ChatPage}" Route="chat" />
        </Tab>
        <!-- 文件 Tab：沙箱文件浏览 -->
        <Tab Title="文件">
            <Tab.Icon>
                <FontImageSource Glyph="📁" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:FilesPage}" Route="files" />
        </Tab>
        <!-- 设置 Tab：服务商 / 模型 / API Key -->
        <Tab Title="设置">
            <Tab.Icon>
                <FontImageSource Glyph="⚙️" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}" Route="settings" />
        </Tab>
    </TabBar>
</Shell>
