<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WayCoder.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WayCoder.Maui"
    xmlns:pages="clr-namespace:WayCoder.Maui.Pages"
    Title="WayCoder 道码">

    <TabBar>
        <!-- 首页 Tab：欢迎/引导 + 配置状态 -->
        <Tab Title="首页">
            <Tab.Icon>
                <FontImageSource Glyph="🏠" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="home" Shell.NavBarIsVisible="False" />
        </Tab>
        <!-- 对话 Tab：流式对话 -->
        <Tab Title="对话">
            <Tab.Icon>
                <FontImageSource Glyph="💬" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:ChatPage}" Route="chat" Shell.NavBarIsVisible="False" />
        </Tab>
        <!-- 命令行 Tab：模拟终端的 shell 页。
             iOS 上会礼貌拒绝（那边没有 shell 进程），Android 上走真 /system/bin/sh。

             ⚠ 图标**别用 `⌨️`**（U+2328 + U+FE0F）：它是 Unicode「杂项技术符号」块里的
             符号，Android 的 Noto Color Emoji 没有它的彩色字形，回落成文本样式后
             就是一个空心方块 —— 用户实测「看不出是什么类型」。
             Tab 图标一律选 **U+1F300 以上 emoji 块**里的（那里 100% 有彩色字形）。 -->
        <Tab Title="命令行">
            <Tab.Icon>
                <FontImageSource Glyph="💻" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:ShellPage}" Route="shell" Shell.NavBarIsVisible="False" />
        </Tab>
        <!-- 文件 Tab：沙箱文件浏览 -->
        <Tab Title="文件">
            <Tab.Icon>
                <FontImageSource Glyph="📁" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate pages:FilesPage}" Route="files" Shell.NavBarIsVisible="False" />
        </Tab>
        <!-- 设置 Tab：服务商 / 模型 / API Key -->
        <Tab Title="设置">
            <Tab.Icon>
                <FontImageSource Glyph="⚙️" />
            </Tab.Icon>
            <!-- ⚠ **只有这一页留着标题栏**（用户要的：顶端显示「设置」二字）。
                 其余 Tab 一律 `NavBarIsVisible="False"` 是为了把纵向空间全留给内容
                 —— 列表 / 终端 / 聊天那些页确实一屏都嫌少。而设置页是**一串卡片**，
                 顶上留一条标题栏既点明"这是哪儿"、也不挤掉什么。 -->
            <ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}" Route="settings" />
        </Tab>
    </TabBar>
</Shell>
