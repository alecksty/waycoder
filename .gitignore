# C# build artifacts
bin/
obj/
# 旁路构建输出（主 bin/ 被运行中的实例锁住时用 -p:OutputPath=bin2/ 等躲开）
bin2/
obj2/
# 本地自测/构建的重定向日志（临时产物，别误提交）
WayCoder/build.log
WayCoder/test.log
*.user
.vs/
*.DotSettings.user
publish/
dist/

# Environment
.env
.venv/
venv/

# API keys (personal, never commit)
key-apis.txt
key*.txt

# Android 签名私钥（自签名 keystore，本机持有即可，勿提交；
# 团队要共用同一签名就删掉这两行、并把 keystore 一起纳入版本管理）
*.keystore
*.jks

# WayCoder
.corecoder_history

# Legacy
CoreCoderSharp/

# OS
.DS_Store

# Reference code (crush competitor analysis)
crush/
test_game/

# 参考/校验代码（含嵌套 git 仓库，不随主仓库管理）
check/

# Temp
.tmp/
logs/
.idea/
verify_build/

# Agent session state (never commit)
.omo/

# AI 工具生成的配置/目录（勿提交）
.claude/
.opencode/
.codex/
.crush/
*.bak
*.patch
# 例外：vendored 副本的本地适配 patch **必须进仓库** —— 它是 sync.sh 重放适配的唯一来源，
# 被忽略掉的话别人同步上游后 sync.sh 会直接报「patch 打不上」退出（或更糟：适配静默消失）。
!third_party/vml/patches/*.patch
excalidraw.log
.waycoder/
__pycache__/
*.pyc
