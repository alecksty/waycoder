\ =========================================
\ 设备初始化
\ =========================================

: COMMODORE_64-INIT ( -- )
  \ 初始化Commodore-64设备
  ." 初始化Commodore-64..." CR

  \ 初始化寄存器
  0 A!  \ Accumulator
  0 X!  \ Index Register X
  0 Y!  \ Index Register Y
  0 SP!  \ Stack Pointer
  0 PC!  \ Program Counter
  0 P!  \ Status Register
  0 PORT!  \ I/O Port (6510 specific)

  \ 初始化外设
  \ 初始化VIC-II
  0 VIC_II-VIC_CTRL1!  \ VIC_CTRL1寄存器
  0 VIC_II-VIC_CTRL2!  \ VIC_CTRL2寄存器
  0 VIC_II-VIC_RASTER!  \ VIC_RASTER寄存器
  0 VIC_II-VIC_MEMPTR!  \ VIC_MEMPTR寄存器
  0 VIC_II-VIC_IRQ!  \ VIC_IRQ寄存器
  0 VIC_II-VIC_IRQMASK!  \ VIC_IRQMASK寄存器
  0 VIC_II-VIC_BORDER!  \ VIC_BORDER寄存器
  0 VIC_II-VIC_BG0!  \ VIC_BG0寄存器
  0 VIC_II-VIC_BG1!  \ VIC_BG1寄存器
  0 VIC_II-VIC_BG2!  \ VIC_BG2寄存器
  0 VIC_II-VIC_BG3!  \ VIC_BG3寄存器
  0 VIC_II-VIC_SPRITE0_X!  \ VIC_SPRITE0_X寄存器
  0 VIC_II-VIC_SPRITE0_Y!  \ VIC_SPRITE0_Y寄存器
  0 VIC_II-VIC_SPRITE1_X!  \ VIC_SPRITE1_X寄存器
  0 VIC_II-VIC_SPRITE1_Y!  \ VIC_SPRITE1_Y寄存器
  \ 初始化SID
  0 SID-SID_VOICE1_FREQ_LO!  \ SID_VOICE1_FREQ_LO寄存器
  0 SID-SID_VOICE1_FREQ_HI!  \ SID_VOICE1_FREQ_HI寄存器
  0 SID-SID_VOICE1_PW_LO!  \ SID_VOICE1_PW_LO寄存器
  0 SID-SID_VOICE1_PW_HI!  \ SID_VOICE1_PW_HI寄存器
  0 SID-SID_VOICE1_CTRL!  \ SID_VOICE1_CTRL寄存器
  0 SID-SID_VOICE1_AD!  \ SID_VOICE1_AD寄存器
  0 SID-SID_VOICE1_SR!  \ SID_VOICE1_SR寄存器
  0 SID-SID_VOICE2_FREQ_LO!  \ SID_VOICE2_FREQ_LO寄存器
  0 SID-SID_VOICE2_FREQ_HI!  \ SID_VOICE2_FREQ_HI寄存器
  0 SID-SID_VOICE2_PW_LO!  \ SID_VOICE2_PW_LO寄存器
  0 SID-SID_VOICE2_PW_HI!  \ SID_VOICE2_PW_HI寄存器
  0 SID-SID_VOICE2_CTRL!  \ SID_VOICE2_CTRL寄存器
  0 SID-SID_VOICE2_AD!  \ SID_VOICE2_AD寄存器
  0 SID-SID_VOICE2_SR!  \ SID_VOICE2_SR寄存器
  0 SID-SID_VOICE3_FREQ_LO!  \ SID_VOICE3_FREQ_LO寄存器
  0 SID-SID_VOICE3_FREQ_HI!  \ SID_VOICE3_FREQ_HI寄存器
  0 SID-SID_VOICE3_PW_LO!  \ SID_VOICE3_PW_LO寄存器
  0 SID-SID_VOICE3_PW_HI!  \ SID_VOICE3_PW_HI寄存器
