\ 设备初始化
\ =========================================

: ESP8266-INIT ( -- )
  \ 初始化ESP8266设备
  ." 初始化ESP8266..." CR


  \ 初始化外设
  \ 初始化WiFi
  0 WIFI-WIFI_MAC!  \ WIFI_MAC寄存器
  0 WIFI-WIFI_MODE!  \ WIFI_MODE寄存器
  0 WIFI-WIFI_CHANNEL!  \ WIFI_CHANNEL寄存器
  0 WIFI-WIFI_RATE!  \ WIFI_RATE寄存器
  \ 初始化UART0
  0 UART0-UART0_FIFO!  \ UART0_FIFO寄存器
  0 UART0-UART0_INT_RAW!  \ UART0_INT_RAW寄存器
  0 UART0-UART0_INT_ST!  \ UART0_INT_ST寄存器
  0 UART0-UART0_INT_ENA!  \ UART0_INT_ENA寄存器
  0 UART0-UART0_INT_CLR!  \ UART0_INT_CLR寄存器
  0 UART0-UART0_CLKDIV!  \ UART0_CLKDIV寄存器
  0 UART0-UART0_AUTOBAUD!  \ UART0_AUTOBAUD寄存器
  0 UART0-UART0_STATUS!  \ UART0_STATUS寄存器
  0 UART0-UART0_CONF0!  \ UART0_CONF0寄存器
  0 UART0-UART0_CONF1!  \ UART0_CONF1寄存器
  0 UART0-UART0_LOWPULSE!  \ UART0_LOWPULSE寄存器
  0 UART0-UART0_HIGHPULSE!  \ UART0_HIGHPULSE寄存器
  0 UART0-UART0_RXD_CNT!  \ UART0_RXD_CNT寄存器
  \ 初始化SPI
  0 SPI-SPI_CMD!  \ SPI_CMD寄存器
  0 SPI-SPI_ADDR!  \ SPI_ADDR寄存器
  0 SPI-SPI_CTRL!  \ SPI_CTRL寄存器
  0 SPI-SPI_RD_STATUS!  \ SPI_RD_STATUS寄存器
  0 SPI-SPI_CTRL2!  \ SPI_CTRL2寄存器
  0 SPI-SPI_CLOCK!  \ SPI_CLOCK寄存器
  0 SPI-SPI_USER!  \ SPI_USER寄存器
  0 SPI-SPI_USER1!  \ SPI_USER1寄存器
  0 SPI-SPI_USER2!  \ SPI_USER2寄存器
  0 SPI-SPI_W0!  \ SPI_W0寄存器
  \ 初始化I2C
  0 I2C-I2C_SCL_LOW!  \ I2C_SCL_LOW寄存器
  0 I2C-I2C_SCL_HIGH!  \ I2C_SCL_HIGH寄存器
  0 I2C-I2C_SDA_HOLD!  \ I2C_SDA_HOLD寄存器
  0 I2C-I2C_SCL_START_HOLD!  \ I2C_SCL_START_HOLD寄存器
  0 I2C-I2C_SCL_STOP_HOLD!  \ I2C_SCL_STOP_HOLD寄存器
  0 I2C-I2C_INT_RAW!  \ I2C_INT_RAW寄存器
  0 I2C-I2C_INT_ST!  \ I2C_INT_ST寄存器
  0 I2C-I2C_INT_ENA!  \ I2C_INT_ENA寄存器
  0 I2C-I2C_INT_CLR!  \ I2C_INT_CLR寄存器
  0 I2C-I2C_CMD!  \ I2C_CMD寄存器
  0 I2C-I2C_FIFO_DATA!  \ I2C_FIFO_DATA寄存器
  0 I2C-I2C_FIFO_CNT!  \ I2C_FIFO_CNT寄存器
  \ 初始化GPIO
  0 GPIO-GPIO_OUT!  \ GPIO_OUT寄存器
  0 GPIO-GPIO_OUT_W1TS!  \ GPIO_OUT_W1TS寄存器
  0 GPIO-GPIO_OUT_W1TC!  \ GPIO_OUT_W1TC寄存器
