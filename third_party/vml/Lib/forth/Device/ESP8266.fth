  0 GPIO-GPIO_PIN!  \ GPIO_PIN寄存器
  \ 初始化Timer
  0 TIMER-TIMER_LOAD!  \ TIMER_LOAD寄存器
  0 TIMER-TIMER_COUNT!  \ TIMER_COUNT寄存器
  0 TIMER-TIMER_CTRL!  \ TIMER_CTRL寄存器
