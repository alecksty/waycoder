\ =========================================
\ 设备初始化
\ =========================================

: NRF52840-INIT ( -- )
  \ 初始化nRF52840设备
  ." 初始化nRF52840..." CR

  \ 初始化寄存器
  0 R0!  \ General Purpose Register 0
  0 R1!  \ General Purpose Register 1
  0 R2!  \ General Purpose Register 2
  0 R3!  \ General Purpose Register 3
  0 R4!  \ General Purpose Register 4
  0 R5!  \ General Purpose Register 5
  0 R6!  \ General Purpose Register 6
  0 R7!  \ General Purpose Register 7
  0 R8!  \ General Purpose Register 8
  0 R9!  \ General Purpose Register 9
  0 R10!  \ General Purpose Register 10
  0 R11!  \ General Purpose Register 11
  0 R12!  \ General Purpose Register 12
  0 SP!  \ Stack Pointer
  0 LR!  \ Link Register
  0 PC!  \ Program Counter
  0 XPSR!  \ Program Status Register
  0 PRIMASK!  \ Priority Mask Register
  0 BASEPRI!  \ Base Priority Register
  0 FAULTMASK!  \ Fault Mask Register
  0 CONTROL!  \ Control Register
  0 FPSCR!  \ FPU Status Control
  0 S0!  \ FPU Register S0
  0 S1!  \ FPU Register S1
  0 S2!  \ FPU Register S2
  0 S3!  \ FPU Register S3
  0 S4!  \ FPU Register S4
  0 S5!  \ FPU Register S5
  0 S6!  \ FPU Register S6
  0 S7!  \ FPU Register S7
  0 S8!  \ FPU Register S8
  0 S9!  \ FPU Register S9
  0 S10!  \ FPU Register S10
  0 S11!  \ FPU Register S11
  0 S12!  \ FPU Register S12
  0 S13!  \ FPU Register S13
  0 S14!  \ FPU Register S14
  0 S15!  \ FPU Register S15
  0 S16!  \ FPU Register S16
  0 S17!  \ FPU Register S17
  0 S18!  \ FPU Register S18
  0 S19!  \ FPU Register S19
  0 S20!  \ FPU Register S20
  0 S21!  \ FPU Register S21
  0 S22!  \ FPU Register S22
  0 S23!  \ FPU Register S23
  0 S24!  \ FPU Register S24
  0 S25!  \ FPU Register S25
  0 S26!  \ FPU Register S26
  0 S27!  \ FPU Register S27
  0 S28!  \ FPU Register S28
  0 S29!  \ FPU Register S29
  0 S30!  \ FPU Register S30
  0 S31!  \ FPU Register S31

  \ 初始化外设
  \ 初始化GPIO
  0 GPIO-OUT!  \ OUT寄存器
  0 GPIO-OUTSET!  \ OUTSET寄存器
  0 GPIO-OUTCLR!  \ OUTCLR寄存器
  0 GPIO-IN!  \ IN寄存器
  0 GPIO-DIR!  \ DIR寄存器
  0 GPIO-DIRSET!  \ DIRSET寄存器
  0 GPIO-DIRCLR!  \ DIRCLR寄存器
  0 GPIO-PIN_CNF0!  \ PIN_CNF0寄存器
  0 GPIO-PIN_CNF1!  \ PIN_CNF1寄存器
  0 GPIO-PIN_CNF2!  \ PIN_CNF2寄存器
  0 GPIO-PIN_CNF3!  \ PIN_CNF3寄存器
  0 GPIO-PIN_CNF4!  \ PIN_CNF4寄存器
  0 GPIO-PIN_CNF5!  \ PIN_CNF5寄存器
  0 GPIO-PIN_CNF6!  \ PIN_CNF6寄存器
  0 GPIO-PIN_CNF7!  \ PIN_CNF7寄存器
  0 GPIO-PIN_CNF8!  \ PIN_CNF8寄存器
  0 GPIO-PIN_CNF9!  \ PIN_CNF9寄存器
  0 GPIO-PIN_CNF10!  \ PIN_CNF10寄存器
  0 GPIO-PIN_CNF11!  \ PIN_CNF11寄存器
  0 GPIO-PIN_CNF12!  \ PIN_CNF12寄存器
  0 GPIO-PIN_CNF13!  \ PIN_CNF13寄存器
  0 GPIO-PIN_CNF14!  \ PIN_CNF14寄存器
  0 GPIO-PIN_CNF15!  \ PIN_CNF15寄存器
  0 GPIO-PIN_CNF16!  \ PIN_CNF16寄存器
  0 GPIO-PIN_CNF17!  \ PIN_CNF17寄存器
  0 GPIO-PIN_CNF18!  \ PIN_CNF18寄存器
  0 GPIO-PIN_CNF19!  \ PIN_CNF19寄存器
