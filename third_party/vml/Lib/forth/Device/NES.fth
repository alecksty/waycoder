\ =========================================
\ 设备初始化
\ =========================================

: NINTENDO_ENTERTAINMENT_SYSTEM-INIT ( -- )
  \ 初始化Nintendo Entertainment System设备
  ." 初始化Nintendo Entertainment System..." CR


  \ 初始化外设
  \ 初始化PPU
  0 PPU-PPUCTRL!  \ PPUCTRL寄存器
  0 PPU-PPUMASK!  \ PPUMASK寄存器
  0 PPU-PPUSTATUS!  \ PPUSTATUS寄存器
  0 PPU-OAMADDR!  \ OAMADDR寄存器
  0 PPU-OAMDATA!  \ OAMDATA寄存器
  0 PPU-PPUSCROLL!  \ PPUSCROLL寄存器
  0 PPU-PPUADDR!  \ PPUADDR寄存器
  0 PPU-PPUDATA!  \ PPUDATA寄存器
  0 PPU-OAMDMA!  \ OAMDMA寄存器
  \ 初始化APU
  0 APU-SQ1_VOL!  \ SQ1_VOL寄存器
  0 APU-SQ1_SWEEP!  \ SQ1_SWEEP寄存器
  0 APU-SQ1_LO!  \ SQ1_LO寄存器
  0 APU-SQ1_HI!  \ SQ1_HI寄存器
  0 APU-SQ2_VOL!  \ SQ2_VOL寄存器
  0 APU-SQ2_SWEEP!  \ SQ2_SWEEP寄存器
  0 APU-SQ2_LO!  \ SQ2_LO寄存器
  0 APU-SQ2_HI!  \ SQ2_HI寄存器
  0 APU-TRI_LINEAR!  \ TRI_LINEAR寄存器
  0 APU-TRI_LO!  \ TRI_LO寄存器
  0 APU-TRI_HI!  \ TRI_HI寄存器
  0 APU-NOISE_VOL!  \ NOISE_VOL寄存器
  0 APU-NOISE_LO!  \ NOISE_LO寄存器
  0 APU-NOISE_HI!  \ NOISE_HI寄存器
  0 APU-DMC_FREQ!  \ DMC_FREQ寄存器
  0 APU-DMC_RAW!  \ DMC_RAW寄存器
  0 APU-DMC_START!  \ DMC_START寄存器
  0 APU-DMC_LEN!  \ DMC_LEN寄存器
  0 APU-OAMDMA!  \ OAMDMA寄存器
  0 APU-APUSTATUS!  \ APUSTATUS寄存器
  0 APU-APUFRAME!  \ APUFRAME寄存器
  \ 初始化Controller
  0 CONTROLLER-JOY1!  \ JOY1寄存器
  0 CONTROLLER-JOY2!  \ JOY2寄存器
  \ 初始化Mapper
  0 MAPPER-PRGROM!  \ PRGROM寄存器
  0 MAPPER-CHRROM!  \ CHRROM寄存器
  0 MAPPER-PRGRAM!  \ PRGRAM寄存器
  0 MAPPER-CHRRAM!  \ CHRRAM寄存器

  ." Nintendo Entertainment System初始化完成" CR
;

