\ =========================================
\ 设备初始化
\ =========================================

: ESP32_WROOM_32-INIT ( -- )
  \ 初始化ESP32-WROOM-32设备
  ." 初始化ESP32-WROOM-32..." CR

  \ 初始化寄存器
  0 PC!  \ Program Counter
  0 A0!  \ General Purpose Register 0
  0 A1!  \ Stack Pointer
  0 A2!  \ General Purpose Register 2
  0 A3!  \ General Purpose Register 3
  0 A4!  \ General Purpose Register 4
  0 A5!  \ General Purpose Register 5
  0 A6!  \ General Purpose Register 6
  0 A7!  \ General Purpose Register 7
  0 A8!  \ General Purpose Register 8
  0 A9!  \ General Purpose Register 9
  0 A10!  \ General Purpose Register 10
  0 A11!  \ General Purpose Register 11
  0 A12!  \ General Purpose Register 12
  0 A13!  \ General Purpose Register 13
  0 A14!  \ General Purpose Register 14
  0 A15!  \ General Purpose Register 15
  0 SAREG1!  \ Special Address Register 1
  0 SAREG2!  \ Special Address Register 2
  0 LBEG!  \ Loop Beginning
  0 LEND!  \ Loop End
  0 LCOUNT!  \ Loop Counter
  0 PS!  \ Processor Status
  0 WINDOWBASE!  \ Window Base
  0 WINDOWSTART!  \ Window Start
  0 PTEBASE!  \ Page Table Base
  0 PTESIZE!  \ Page Table Entry Size
  0 SCOMPARE1!  \ Special Compare 1
  0 ATOMCTL!  \ Atomic Operation Control
  0 DDR!  \ Data Destination Register

  \ 初始化外设
  \ 初始化GPIO
  0 GPIO-OUT!  \ OUT寄存器
  0 GPIO-OUT_W1TS!  \ OUT_W1TS寄存器
  0 GPIO-OUT_W1TC!  \ OUT_W1TC寄存器
  0 GPIO-IN!  \ IN寄存器
  0 GPIO-STATUS!  \ STATUS寄存器
  0 GPIO-STATUS_W1TS!  \ STATUS_W1TS寄存器
  0 GPIO-STATUS_W1TC!  \ STATUS_W1TC寄存器
  0 GPIO-PIN!  \ PIN寄存器
  0 GPIO-ENABLE!  \ ENABLE寄存器
  0 GPIO-STRAP!  \ STRAP寄存器
  0 GPIO-IN_NEXT!  \ IN_NEXT寄存器
  \ 初始化RTC_GPIO
  0 RTC_GPIO-OUT!  \ OUT寄存器
  0 RTC_GPIO-OUT_W1TS!  \ OUT_W1TS寄存器
  0 RTC_GPIO-OUT_W1TC!  \ OUT_W1TC寄存器
  0 RTC_GPIO-IN!  \ IN寄存器
  0 RTC_GPIO-STATUS!  \ STATUS寄存器
  0 RTC_GPIO-PIN!  \ PIN寄存器
  0 RTC_GPIO-ENABLE!  \ ENABLE寄存器
  \ 初始化IO_MUX
