\ =========================================
\ 设备信息显示
\ =========================================

: .DEVICE-INFO ( -- )
  CR
  ." 设备: " DEVICE-NAME TYPE CR
  ." 厂商: " MANUFACTURER TYPE CR
  ." 系列: " FAMILY TYPE CR
  ." 版本: " VERSION TYPE CR
  ." 架构: " ARCHITECTURE TYPE CR
  ." 位宽: " BITS . CR
  ." 时钟: " CLOCK-FREQ . ." Hz" CR
;

: .REGISTERS ( -- )
  CR ." 寄存器状态:" CR
  ." ----------" CR
  PC@ PC .R 8 .R SPACE ."  PC: " PC@ .
  A0@ A0 .R 8 .R SPACE ."  A0: " A0@ .
  A1@ A1 .R 8 .R SPACE ."  A1: " A1@ .
  A2@ A2 .R 8 .R SPACE ."  A2: " A2@ .
  A3@ A3 .R 8 .R SPACE ."  A3: " A3@ .
  A4@ A4 .R 8 .R SPACE ."  A4: " A4@ .
  A5@ A5 .R 8 .R SPACE ."  A5: " A5@ .
  A6@ A6 .R 8 .R SPACE ."  A6: " A6@ .
  A7@ A7 .R 8 .R SPACE ."  A7: " A7@ .
  A8@ A8 .R 8 .R SPACE ."  A8: " A8@ .
  A9@ A9 .R 8 .R SPACE ."  A9: " A9@ .
  A10@ A10 .R 8 .R SPACE ."  A10: " A10@ .
  A11@ A11 .R 8 .R SPACE ."  A11: " A11@ .
  A12@ A12 .R 8 .R SPACE ."  A12: " A12@ .
  A13@ A13 .R 8 .R SPACE ."  A13: " A13@ .
  A14@ A14 .R 8 .R SPACE ."  A14: " A14@ .
  A15@ A15 .R 8 .R SPACE ."  A15: " A15@ .
  SAREG1@ SAREG1 .R 8 .R SPACE ."  SAREG1: " SAREG1@ .
  SAREG2@ SAREG2 .R 8 .R SPACE ."  SAREG2: " SAREG2@ .
  LBEG@ LBEG .R 8 .R SPACE ."  LBEG: " LBEG@ .
  LEND@ LEND .R 8 .R SPACE ."  LEND: " LEND@ .
  LCOUNT@ LCOUNT .R 8 .R SPACE ."  LCOUNT: " LCOUNT@ .
  PS@ PS .R 8 .R SPACE ."  PS: " PS@ .
  WINDOWBASE@ WINDOWBASE .R 8 .R SPACE ."  WINDOWBASE: " WINDOWBASE@ .
  WINDOWSTART@ WINDOWSTART .R 8 .R SPACE ."  WINDOWSTART: " WINDOWSTART@ .
  PTEBASE@ PTEBASE .R 8 .R SPACE ."  PTEBASE: " PTEBASE@ .
  PTESIZE@ PTESIZE .R 8 .R SPACE ."  PTESIZE: " PTESIZE@ .
  SCOMPARE1@ SCOMPARE1 .R 8 .R SPACE ."  SCOMPARE1: " SCOMPARE1@ .
  ATOMCTL@ ATOMCTL .R 8 .R SPACE ."  ATOMCTL: " ATOMCTL@ .
