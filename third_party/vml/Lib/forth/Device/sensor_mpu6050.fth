\ MPU6050设备定义 - Forth文件
\ 生成自: InvenSense/TDK/Sensor/MPU6050
\ 版本: 1.0
\ 日期: 2026-05-06
\ 作者: VML Team
\ 描述: 6-Axis MEMS Accelerometer and Gyroscope (I2C)
\ CPU架构: Sensor
\ 位宽: 8位
\ 时钟频率: 400000 Hz

\ =========================================
\ MPU6050设备定义
\ =========================================

\ 设备信息
: DEVICE-NAME   S" MPU6050" ;
: MANUFACTURER  S" InvenSense/TDK" ;
: FAMILY        S" Sensor" ;
: VERSION       S" 1.0" ;
: ARCHITECTURE  S" Sensor" ;
8 CONSTANT BITS
400000 CONSTANT CLOCK-FREQ

\ 内存段定义
0x00 CONSTANT PACKAGE-START
0x00 CONSTANT PACKAGE-END
24 CONSTANT PACKAGE-SIZE  \ QFN-24 (4x4x0.9mm)

\ 外设定义
\ MPU6050 IMU (0x68/0x69, 2.375V-3.46V)
0x68 CONSTANT MPU6050-BASE
0x19 CONSTANT MPU6050-SMPLRT_DIV
0x1A CONSTANT MPU6050-CONFIG
0 CONSTANT MPU6050-CONFIG-DLPF_CFG  \ Digital low-pass filter configuration
0x1B CONSTANT MPU6050-GYRO_CONFIG
3 CONSTANT MPU6050-GYRO_CONFIG-FS_SEL  \ Gyro full scale: 0=±250, 1=±500, 2=±1000, 3=±2000 °/s
0x1C CONSTANT MPU6050-ACCEL_CONFIG
3 CONSTANT MPU6050-ACCEL_CONFIG-AFS_SEL  \ Accel full scale: 0=±2g, 1=±4g, 2=±8g, 3=±16g
0x3B CONSTANT MPU6050-ACCEL_XOUT_H
0x3C CONSTANT MPU6050-ACCEL_XOUT_L
0x3D CONSTANT MPU6050-ACCEL_YOUT_H
0x3E CONSTANT MPU6050-ACCEL_YOUT_L
0x3F CONSTANT MPU6050-ACCEL_ZOUT_H
0x40 CONSTANT MPU6050-ACCEL_ZOUT_L
0x41 CONSTANT MPU6050-TEMP_OUT_H
0x42 CONSTANT MPU6050-TEMP_OUT_L
0x43 CONSTANT MPU6050-GYRO_XOUT_H
0x44 CONSTANT MPU6050-GYRO_XOUT_L
0x45 CONSTANT MPU6050-GYRO_YOUT_H
0x46 CONSTANT MPU6050-GYRO_YOUT_L
0x47 CONSTANT MPU6050-GYRO_ZOUT_H
0x48 CONSTANT MPU6050-GYRO_ZOUT_L
0x6B CONSTANT MPU6050-PWR_MGMT_1
7 CONSTANT MPU6050-PWR_MGMT_1-DEVICE_RESET  \ 1=Reset all internal registers
6 CONSTANT MPU6050-PWR_MGMT_1-SLEEP  \ 1=Sleep mode
5 CONSTANT MPU6050-PWR_MGMT_1-CYCLE  \ 1=Cycle mode
0 CONSTANT MPU6050-PWR_MGMT_1-CLKSEL  \ Clock source select
0x75 CONSTANT MPU6050-WHO_AM_I

\ =========================================
\ 寄存器访问字
\ =========================================

\ 外设访问
\ MPU6050外设
: MPU6050-SMPLRT_DIV@ ( -- n ) MPU6050-SMPLRT_DIV C@ ;
: MPU6050-SMPLRT_DIV! ( n -- ) MPU6050-SMPLRT_DIV C! ;
: MPU6050-CONFIG@ ( -- n ) MPU6050-CONFIG C@ ;
: MPU6050-CONFIG! ( n -- ) MPU6050-CONFIG C! ;
: MPU6050-CONFIG-DLPF_CFG@ ( -- flag ) MPU6050-CONFIG@ 0 BIT@ ;
: MPU6050-CONFIG-DLPF_CFG! ( flag -- ) MPU6050-CONFIG@ 0 BIT! MPU6050-CONFIG! ;
: MPU6050-GYRO_CONFIG@ ( -- n ) MPU6050-GYRO_CONFIG C@ ;
: MPU6050-GYRO_CONFIG! ( n -- ) MPU6050-GYRO_CONFIG C! ;
: MPU6050-GYRO_CONFIG-FS_SEL@ ( -- flag ) MPU6050-GYRO_CONFIG@ 3 BIT@ ;
: MPU6050-GYRO_CONFIG-FS_SEL! ( flag -- ) MPU6050-GYRO_CONFIG@ 3 BIT! MPU6050-GYRO_CONFIG! ;
: MPU6050-ACCEL_CONFIG@ ( -- n ) MPU6050-ACCEL_CONFIG C@ ;
: MPU6050-ACCEL_CONFIG! ( n -- ) MPU6050-ACCEL_CONFIG C! ;
: MPU6050-ACCEL_CONFIG-AFS_SEL@ ( -- flag ) MPU6050-ACCEL_CONFIG@ 3 BIT@ ;
: MPU6050-ACCEL_CONFIG-AFS_SEL! ( flag -- ) MPU6050-ACCEL_CONFIG@ 3 BIT! MPU6050-ACCEL_CONFIG! ;
: MPU6050-ACCEL_XOUT_H@ ( -- n ) MPU6050-ACCEL_XOUT_H C@ ;
: MPU6050-ACCEL_XOUT_H! ( n -- ) MPU6050-ACCEL_XOUT_H C! ;
: MPU6050-ACCEL_XOUT_L@ ( -- n ) MPU6050-ACCEL_XOUT_L C@ ;
: MPU6050-ACCEL_XOUT_L! ( n -- ) MPU6050-ACCEL_XOUT_L C! ;
: MPU6050-ACCEL_YOUT_H@ ( -- n ) MPU6050-ACCEL_YOUT_H C@ ;
: MPU6050-ACCEL_YOUT_H! ( n -- ) MPU6050-ACCEL_YOUT_H C! ;
: MPU6050-ACCEL_YOUT_L@ ( -- n ) MPU6050-ACCEL_YOUT_L C@ ;
: MPU6050-ACCEL_YOUT_L! ( n -- ) MPU6050-ACCEL_YOUT_L C! ;
: MPU6050-ACCEL_ZOUT_H@ ( -- n ) MPU6050-ACCEL_ZOUT_H C@ ;
: MPU6050-ACCEL_ZOUT_H! ( n -- ) MPU6050-ACCEL_ZOUT_H C! ;
: MPU6050-ACCEL_ZOUT_L@ ( -- n ) MPU6050-ACCEL_ZOUT_L C@ ;
: MPU6050-ACCEL_ZOUT_L! ( n -- ) MPU6050-ACCEL_ZOUT_L C! ;
: MPU6050-TEMP_OUT_H@ ( -- n ) MPU6050-TEMP_OUT_H C@ ;
: MPU6050-TEMP_OUT_H! ( n -- ) MPU6050-TEMP_OUT_H C! ;
: MPU6050-TEMP_OUT_L@ ( -- n ) MPU6050-TEMP_OUT_L C@ ;
: MPU6050-TEMP_OUT_L! ( n -- ) MPU6050-TEMP_OUT_L C! ;
: MPU6050-GYRO_XOUT_H@ ( -- n ) MPU6050-GYRO_XOUT_H C@ ;
: MPU6050-GYRO_XOUT_H! ( n -- ) MPU6050-GYRO_XOUT_H C! ;
: MPU6050-GYRO_XOUT_L@ ( -- n ) MPU6050-GYRO_XOUT_L C@ ;
: MPU6050-GYRO_XOUT_L! ( n -- ) MPU6050-GYRO_XOUT_L C! ;
: MPU6050-GYRO_YOUT_H@ ( -- n ) MPU6050-GYRO_YOUT_H C@ ;
: MPU6050-GYRO_YOUT_H! ( n -- ) MPU6050-GYRO_YOUT_H C! ;
: MPU6050-GYRO_YOUT_L@ ( -- n ) MPU6050-GYRO_YOUT_L C@ ;
: MPU6050-GYRO_YOUT_L! ( n -- ) MPU6050-GYRO_YOUT_L C! ;
: MPU6050-GYRO_ZOUT_H@ ( -- n ) MPU6050-GYRO_ZOUT_H C@ ;
: MPU6050-GYRO_ZOUT_H! ( n -- ) MPU6050-GYRO_ZOUT_H C! ;
: MPU6050-GYRO_ZOUT_L@ ( -- n ) MPU6050-GYRO_ZOUT_L C@ ;
: MPU6050-GYRO_ZOUT_L! ( n -- ) MPU6050-GYRO_ZOUT_L C! ;
: MPU6050-PWR_MGMT_1@ ( -- n ) MPU6050-PWR_MGMT_1 C@ ;
: MPU6050-PWR_MGMT_1! ( n -- ) MPU6050-PWR_MGMT_1 C! ;
: MPU6050-PWR_MGMT_1-DEVICE_RESET@ ( -- flag ) MPU6050-PWR_MGMT_1@ 7 BIT@ ;
: MPU6050-PWR_MGMT_1-DEVICE_RESET! ( flag -- ) MPU6050-PWR_MGMT_1@ 7 BIT! MPU6050-PWR_MGMT_1! ;
: MPU6050-PWR_MGMT_1-SLEEP@ ( -- flag ) MPU6050-PWR_MGMT_1@ 6 BIT@ ;
: MPU6050-PWR_MGMT_1-SLEEP! ( flag -- ) MPU6050-PWR_MGMT_1@ 6 BIT! MPU6050-PWR_MGMT_1! ;
: MPU6050-PWR_MGMT_1-CYCLE@ ( -- flag ) MPU6050-PWR_MGMT_1@ 5 BIT@ ;
: MPU6050-PWR_MGMT_1-CYCLE! ( flag -- ) MPU6050-PWR_MGMT_1@ 5 BIT! MPU6050-PWR_MGMT_1! ;
: MPU6050-PWR_MGMT_1-CLKSEL@ ( -- flag ) MPU6050-PWR_MGMT_1@ 0 BIT@ ;
: MPU6050-PWR_MGMT_1-CLKSEL! ( flag -- ) MPU6050-PWR_MGMT_1@ 0 BIT! MPU6050-PWR_MGMT_1! ;
: MPU6050-WHO_AM_I@ ( -- n ) MPU6050-WHO_AM_I C@ ;
: MPU6050-WHO_AM_I! ( n -- ) MPU6050-WHO_AM_I C! ;

\ =========================================
\ 设备初始化
\ =========================================

: MPU6050-INIT ( -- )
  \ 初始化MPU6050设备
  ." 初始化MPU6050..." CR


  \ 初始化外设
  \ 初始化MPU6050
  0 MPU6050-SMPLRT_DIV!  \ SMPLRT_DIV寄存器
  0 MPU6050-CONFIG!  \ CONFIG寄存器
  0 MPU6050-GYRO_CONFIG!  \ GYRO_CONFIG寄存器
  0 MPU6050-ACCEL_CONFIG!  \ ACCEL_CONFIG寄存器
  0 MPU6050-ACCEL_XOUT_H!  \ ACCEL_XOUT_H寄存器
  0 MPU6050-ACCEL_XOUT_L!  \ ACCEL_XOUT_L寄存器
  0 MPU6050-ACCEL_YOUT_H!  \ ACCEL_YOUT_H寄存器
  0 MPU6050-ACCEL_YOUT_L!  \ ACCEL_YOUT_L寄存器
  0 MPU6050-ACCEL_ZOUT_H!  \ ACCEL_ZOUT_H寄存器
  0 MPU6050-ACCEL_ZOUT_L!  \ ACCEL_ZOUT_L寄存器
  0 MPU6050-TEMP_OUT_H!  \ TEMP_OUT_H寄存器
  0 MPU6050-TEMP_OUT_L!  \ TEMP_OUT_L寄存器
  0 MPU6050-GYRO_XOUT_H!  \ GYRO_XOUT_H寄存器
  0 MPU6050-GYRO_XOUT_L!  \ GYRO_XOUT_L寄存器
  0 MPU6050-GYRO_YOUT_H!  \ GYRO_YOUT_H寄存器
  0 MPU6050-GYRO_YOUT_L!  \ GYRO_YOUT_L寄存器
  0 MPU6050-GYRO_ZOUT_H!  \ GYRO_ZOUT_H寄存器
  0 MPU6050-GYRO_ZOUT_L!  \ GYRO_ZOUT_L寄存器
  0 MPU6050-PWR_MGMT_1!  \ PWR_MGMT_1寄存器
  0 MPU6050-WHO_AM_I!  \ WHO_AM_I寄存器

  ." MPU6050初始化完成" CR
;

\ =========================================
\ 设备信息显示
\ =========================================

: .DEVICE-INFO ( -- )
  CR
  ." 设备: " DEVICE-NAME TYPE CR
  ." 厂商: " MANUFACTURER TYPE CR
  ." 系列: " FAMILY TYPE CR
  ." 版本: " VERSION TYPE CR
  ." 架构: " ARCHITECTURE TYPE CR
  ." 位宽: " BITS . CR
  ." 时钟: " CLOCK-FREQ . ." Hz" CR
;

\ =========================================
\ 示例程序
\ =========================================

: EXAMPLE ( -- )
  MPU6050-INIT
  .DEVICE-INFO
  .REGISTERS
  CR ." 示例程序运行完成" CR
;

\ 自动运行示例
( EXAMPLE )
