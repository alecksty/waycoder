\ =========================================
\ 设备初始化
\ =========================================

: TMS320F280049-INIT ( -- )
  \ 初始化TMS320F280049设备
  ." 初始化TMS320F280049..." CR

  \ 初始化寄存器
  0 AL!  \ Accumulator Low
  0 AH!  \ Accumulator High
  0 PH!  \ Product High
  0 PL!  \ Product Low
  0 TREG!  \ Temporary Register
  0 AR0!  \ 
  0 AR1!  \ 
  0 ST0!  \ Status 0
  0 ST1!  \ Status 1
  0 PC!  \ Program Counter
  0 SP!  \ Stack Pointer

  \ 初始化外设
  \ 初始化PLL
  0 PLL-SYSPLLCTL1!  \ SYSPLLCTL1寄存器
  0 PLL-SYSPLLCTL2!  \ SYSPLLCTL2寄存器
  0 PLL-CLKSRCCTL1!  \ CLKSRCCTL1寄存器
  0 PLL-CLKSRCCTL2!  \ CLKSRCCTL2寄存器
  \ 初始化GPIO_CTRL
  0 GPIO_CTRL-GPACTRL!  \ GPACTRL寄存器
  0 GPIO_CTRL-GPAQSEL1!  \ GPAQSEL1寄存器
  0 GPIO_CTRL-GPAQSEL2!  \ GPAQSEL2寄存器
  0 GPIO_CTRL-GPAMUX1!  \ GPAMUX1寄存器
  0 GPIO_CTRL-GPAMUX2!  \ GPAMUX2寄存器
  0 GPIO_CTRL-GPADIR!  \ GPADIR寄存器
  0 GPIO_CTRL-GPAPUD!  \ GPAPUD寄存器
  \ 初始化GPIO_DATA
  0 GPIO_DATA-GPADAT!  \ GPADAT寄存器
  0 GPIO_DATA-GPASET!  \ GPASET寄存器
  0 GPIO_DATA-GPACLEAR!  \ GPACLEAR寄存器
  0 GPIO_DATA-GPATOGGLE!  \ GPATOGGLE寄存器
  0 GPIO_DATA-GPBDAT!  \ GPBDAT寄存器
  0 GPIO_DATA-GPBSET!  \ GPBSET寄存器
  0 GPIO_DATA-GPBCLEAR!  \ GPBCLEAR寄存器
  0 GPIO_DATA-GPBTOGGLE!  \ GPBTOGGLE寄存器
  \ 初始化GPIO_B_CTRL
  0 GPIO_B_CTRL-GPBMUX1!  \ GPBMUX1寄存器
  0 GPIO_B_CTRL-GPBMUX2!  \ GPBMUX2寄存器
  0 GPIO_B_CTRL-GPBDIR!  \ GPBDIR寄存器
  0 GPIO_B_CTRL-GPBPUD!  \ GPBPUD寄存器
  \ 初始化SCI_A
  0 SCI_A-SCICCR!  \ SCICCR寄存器
  0 SCI_A-SCICTL1!  \ SCICTL1寄存器
  0 SCI_A-SCIBAUD!  \ SCIBAUD寄存器
  0 SCI_A-SCIRXBUF!  \ SCIRXBUF寄存器
  0 SCI_A-SCITXBUF!  \ SCITXBUF寄存器

  ." TMS320F280049初始化完成" CR
;

\ =========================================
\ 设备信息显示
\ =========================================

: .DEVICE-INFO ( -- )
  CR
  ." 设备: " DEVICE-NAME TYPE CR
  ." 厂商: " MANUFACTURER TYPE CR
  ." 系列: " FAMILY TYPE CR
  ." 版本: " VERSION TYPE CR
  ." 架构: " ARCHITECTURE TYPE CR
  ." 位宽: " BITS . CR
  ." 时钟: " CLOCK-FREQ . ." Hz" CR
;

: .REGISTERS ( -- )
  CR ." 寄存器状态:" CR
  ." ----------" CR
  AL@ AL .R 8 .R SPACE ."  AL: " AL@ .
  AH@ AH .R 8 .R SPACE ."  AH: " AH@ .
  PH@ PH .R 8 .R SPACE ."  PH: " PH@ .
  PL@ PL .R 8 .R SPACE ."  PL: " PL@ .
  TREG@ TREG .R 8 .R SPACE ."  TREG: " TREG@ .
  AR0@ AR0 .R 8 .R SPACE ."  AR0: " AR0@ .
  AR1@ AR1 .R 8 .R SPACE ."  AR1: " AR1@ .
  ST0@ ST0 .R 8 .R SPACE ."  ST0: " ST0@ .
  ST1@ ST1 .R 8 .R SPACE ."  ST1: " ST1@ .
  PC@ PC .R 8 .R SPACE ."  PC: " PC@ .
  SP@ SP .R 8 .R SPACE ."  SP: " SP@ .
;

\ =========================================
\ 中断处理
\ =========================================

\ 
: INT-RESET-HANDLER ( -- )
  ." Reset中断处理" CR
  \ 添加具体的中断处理代码
;

: INT-RESET-ENABLE ( -- )
  INT-RESET INT-ENABLE
;

: INT-RESET-DISABLE ( -- )
  INT-RESET INT-DISABLE
;

\ SCI-A Receive Interrupt
: INT-SCIA_RX-HANDLER ( -- )
  ." SCIA_RX中断处理" CR
  \ 添加具体的中断处理代码
;

: INT-SCIA_RX-ENABLE ( -- )
  INT-SCIA_RX INT-ENABLE
;

: INT-SCIA_RX-DISABLE ( -- )
  INT-SCIA_RX INT-DISABLE
;

\ SCI-A Transmit Interrupt
: INT-SCIA_TX-HANDLER ( -- )
  ." SCIA_TX中断处理" CR
  \ 添加具体的中断处理代码
;

: INT-SCIA_TX-ENABLE ( -- )
  INT-SCIA_TX INT-ENABLE
;

: INT-SCIA_TX-DISABLE ( -- )
  INT-SCIA_TX INT-DISABLE
;

\ =========================================
\ 示例程序
\ =========================================

: EXAMPLE ( -- )
  TMS320F280049-INIT
  .DEVICE-INFO
  .REGISTERS
  CR ." 示例程序运行完成" CR
;

