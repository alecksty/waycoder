\ TMS320F280049设备定义 - Forth文件
\ 生成自: Texas Instruments/C2000/TMS320F280049
\ 版本: 1.0
\ 日期: 2026-04-28
\ 作者: VML Team
\ 描述: 32-bit C28x DSP + CLA MCU with 256KB Flash, 100KB RAM, 100MHz
\ CPU架构: C28x-DSP
\ 位宽: 32位
\ 时钟频率: 100000000 Hz

\ =========================================
\ TMS320F280049设备定义
\ =========================================

\ 设备信息
: DEVICE-NAME   S" TMS320F280049" ;
: MANUFACTURER  S" Texas Instruments" ;
: FAMILY        S" C2000" ;
: VERSION       S" 1.0" ;
: ARCHITECTURE  S" C28x-DSP" ;
32 CONSTANT BITS
100000000 CONSTANT CLOCK-FREQ

\ 寄存器地址定义
0x00 CONSTANT AL  \ Accumulator Low
0x02 CONSTANT AH  \ Accumulator High
0x04 CONSTANT PH  \ Product High
0x06 CONSTANT PL  \ Product Low
0x08 CONSTANT TREG  \ Temporary Register
0x0A CONSTANT AR0  \ 
0x0C CONSTANT AR1  \ 
0x20 CONSTANT ST0  \ Status 0
0x22 CONSTANT ST1  \ Status 1
0x24 CONSTANT PC  \ Program Counter
0x26 CONSTANT SP  \ Stack Pointer

\ 内存段定义
0x080000 CONSTANT FLASH-START
0x0BFFFF CONSTANT FLASH-END
262144 CONSTANT FLASH-SIZE  \ 
0x008000 CONSTANT SRAM_LS-START
0x00BFFF CONSTANT SRAM_LS-END
16384 CONSTANT SRAM_LS-SIZE  \ Local Shared RAM
0x00C000 CONSTANT SRAM_GS-START
0x01FFFF CONSTANT SRAM_GS-END
81920 CONSTANT SRAM_GS-SIZE  \ Global Shared RAM
0x400000 CONSTANT PERIPHERAL-START
0x40FFFF CONSTANT PERIPHERAL-END
65536 CONSTANT PERIPHERAL-SIZE  \ 

\ 外设定义
\ PLL Clock Control
0x5C10 CONSTANT PLL-BASE
0x00 CONSTANT PLL-SYSPLLCTL1
0x02 CONSTANT PLL-SYSPLLCTL2
0x04 CONSTANT PLL-CLKSRCCTL1
0x06 CONSTANT PLL-CLKSRCCTL2
\ GPIO Control Registers
0x7C00 CONSTANT GPIO_CTRL-BASE
0x00 CONSTANT GPIO_CTRL-GPACTRL
0x02 CONSTANT GPIO_CTRL-GPAQSEL1
0x04 CONSTANT GPIO_CTRL-GPAQSEL2
0x06 CONSTANT GPIO_CTRL-GPAMUX1
0x08 CONSTANT GPIO_CTRL-GPAMUX2
0x0A CONSTANT GPIO_CTRL-GPADIR
0x0C CONSTANT GPIO_CTRL-GPAPUD
\ GPIO Data Registers
0x7F00 CONSTANT GPIO_DATA-BASE
0x00 CONSTANT GPIO_DATA-GPADAT
0x02 CONSTANT GPIO_DATA-GPASET
0x04 CONSTANT GPIO_DATA-GPACLEAR
0x06 CONSTANT GPIO_DATA-GPATOGGLE
0x08 CONSTANT GPIO_DATA-GPBDAT
0x0A CONSTANT GPIO_DATA-GPBSET
0x0C CONSTANT GPIO_DATA-GPBCLEAR
0x0E CONSTANT GPIO_DATA-GPBTOGGLE
\ GPIO B Control
0x7C20 CONSTANT GPIO_B_CTRL-BASE
0x00 CONSTANT GPIO_B_CTRL-GPBMUX1
0x02 CONSTANT GPIO_B_CTRL-GPBMUX2
0x04 CONSTANT GPIO_B_CTRL-GPBDIR
0x06 CONSTANT GPIO_B_CTRL-GPBPUD
\ SCI-A UART
0x7320 CONSTANT SCI_A-BASE
0x00 CONSTANT SCI_A-SCICCR
0x02 CONSTANT SCI_A-SCICTL1
0x04 CONSTANT SCI_A-SCIBAUD
0x0A CONSTANT SCI_A-SCIRXBUF
0x0C CONSTANT SCI_A-SCITXBUF

\ 中断向量定义
1 CONSTANT INT-RESET  \ 
8 CONSTANT INT-SCIA_RX  \ SCI-A Receive Interrupt
9 CONSTANT INT-SCIA_TX  \ SCI-A Transmit Interrupt

\ =========================================
\ 寄存器访问字
\ =========================================

\ 通用寄存器访问
: AL@ ( -- n ) AL @ ;
: AL! ( n -- ) AL ! ;

: AH@ ( -- n ) AH @ ;
: AH! ( n -- ) AH ! ;

: PH@ ( -- n ) PH @ ;
: PH! ( n -- ) PH ! ;

: PL@ ( -- n ) PL @ ;
: PL! ( n -- ) PL ! ;

: TREG@ ( -- n ) TREG @ ;
: TREG! ( n -- ) TREG ! ;

: AR0@ ( -- n ) AR0 @ ;
: AR0! ( n -- ) AR0 ! ;

: AR1@ ( -- n ) AR1 @ ;
: AR1! ( n -- ) AR1 ! ;

: ST0@ ( -- n ) ST0 @ ;
: ST0! ( n -- ) ST0 ! ;

: ST1@ ( -- n ) ST1 @ ;
: ST1! ( n -- ) ST1 ! ;

: PC@ ( -- n ) PC @ ;
: PC! ( n -- ) PC ! ;

: SP@ ( -- n ) SP @ ;
: SP! ( n -- ) SP ! ;

\ 外设访问
