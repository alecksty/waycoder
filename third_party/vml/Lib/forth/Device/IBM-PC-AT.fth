\ =========================================
\ 设备初始化
\ =========================================

: IBM_PC_AT-INIT ( -- )
  \ 初始化IBM PC/AT设备
  ." 初始化IBM PC/AT..." CR


  \ 初始化外设
  \ 初始化8259A
  0 _8259A-ICW1!  \ ICW1寄存器
  0 _8259A-ICW2!  \ ICW2寄存器
  0 _8259A-ICW3!  \ ICW3寄存器
  0 _8259A-ICW4!  \ ICW4寄存器
  0 _8259A-OCW1!  \ OCW1寄存器
  0 _8259A-OCW2!  \ OCW2寄存器
  0 _8259A-OCW3!  \ OCW3寄存器
  \ 初始化8253
  0 _8253-COUNTER0!  \ Counter0寄存器
  0 _8253-COUNTER1!  \ Counter1寄存器
  0 _8253-COUNTER2!  \ Counter2寄存器
  0 _8253-CONTROL!  \ Control寄存器
  \ 初始化8237
  0 _8237-CHANNEL0!  \ Channel0寄存器
  0 _8237-CHANNEL1!  \ Channel1寄存器
  0 _8237-CHANNEL2!  \ Channel2寄存器
  0 _8237-CHANNEL3!  \ Channel3寄存器
  0 _8237-STATUS!  \ Status寄存器
  0 _8237-COMMAND!  \ Command寄存器
  0 _8237-REQUEST!  \ Request寄存器
  0 _8237-MASK!  \ Mask寄存器
  0 _8237-MODE!  \ Mode寄存器
  \ 初始化8042
  0 _8042-DATA!  \ Data寄存器
  0 _8042-STATUS!  \ Status寄存器
  \ 初始化CMOS
  0 CMOS-ADDRESS!  \ Address寄存器
  0 CMOS-DATA!  \ Data寄存器
  \ 初始化FDC
  0 FDC-SRA!  \ SRA寄存器
  0 FDC-MSR!  \ MSR寄存器
  0 FDC-DATA!  \ DATA寄存器
  0 FDC-DIR!  \ DIR寄存器
  0 FDC-CCR!  \ CCR寄存器
  \ 初始化HDC
  0 HDC-DATA!  \ Data寄存器
  0 HDC-ERROR!  \ Error寄存器
  0 HDC-SECTORCOUNT!  \ SectorCount寄存器
  0 HDC-SECTORNUMBER!  \ SectorNumber寄存器
  0 HDC-CYLINDERLOW!  \ CylinderLow寄存器
  0 HDC-CYLINDERHIGH!  \ CylinderHigh寄存器
  0 HDC-DRIVEHEAD!  \ DriveHead寄存器
  0 HDC-STATUS!  \ Status寄存器
  0 HDC-COMMAND!  \ Command寄存器
  \ 初始化CGA
  0 CGA-CRTC_INDEX!  \ CRTC_Index寄存器
  0 CGA-CRTC_DATA!  \ CRTC_Data寄存器
  0 CGA-MODECONTROL!  \ ModeControl寄存器
  0 CGA-COLORSELECT!  \ ColorSelect寄存器
  0 CGA-STATUS!  \ Status寄存器
  \ 初始化EGA
  0 EGA-CRTC_INDEX!  \ CRTC_Index寄存器
  0 EGA-CRTC_DATA!  \ CRTC_Data寄存器
  0 EGA-FEATURECONTROL!  \ FeatureControl寄存器
  0 EGA-GRAPHICS1POS!  \ Graphics1Pos寄存器
  0 EGA-GRAPHICS2POS!  \ Graphics2Pos寄存器
  0 EGA-SEQUENCERINDEX!  \ SequencerIndex寄存器
  0 EGA-SEQUENCERDATA!  \ SequencerData寄存器
  0 EGA-GRAPHICSINDEX!  \ GraphicsIndex寄存器
  0 EGA-GRAPHICSDATA!  \ GraphicsData寄存器
  0 EGA-ATTRIBUTEINDEX!  \ AttributeIndex寄存器
  0 EGA-ATTRIBUTEDATA!  \ AttributeData寄存器
  \ 初始化VGA
  0 VGA-CRTC_INDEX!  \ CRTC_Index寄存器
  0 VGA-CRTC_DATA!  \ CRTC_Data寄存器
  0 VGA-INPUTSTATUS1!  \ InputStatus1寄存器
  0 VGA-FEATURECONTROL!  \ FeatureControl寄存器
  0 VGA-MISCOUTPUT!  \ MiscOutput寄存器
  0 VGA-SEQUENCERINDEX!  \ SequencerIndex寄存器
  0 VGA-SEQUENCERDATA!  \ SequencerData寄存器
  0 VGA-GRAPHICSINDEX!  \ GraphicsIndex寄存器
  0 VGA-GRAPHICSDATA!  \ GraphicsData寄存器
  0 VGA-ATTRIBUTEINDEX!  \ AttributeIndex寄存器
  0 VGA-ATTRIBUTEDATA!  \ AttributeData寄存器
  0 VGA-DACMASK!  \ DACMask寄存器
  0 VGA-DACREADINDEX!  \ DACReadIndex寄存器
  0 VGA-DACWRITEINDEX!  \ DACWriteIndex寄存器
  0 VGA-DACDATA!  \ DACData寄存器
  \ 初始化GamePort
  0 GAMEPORT-DATA!  \ Data寄存器
  \ 初始化ParallelPort
  0 PARALLELPORT-DATA!  \ Data寄存器
  0 PARALLELPORT-STATUS!  \ Status寄存器
  0 PARALLELPORT-CONTROL!  \ Control寄存器
  \ 初始化SerialPort
  0 SERIALPORT-DATA!  \ Data寄存器
  0 SERIALPORT-IER!  \ IER寄存器
  0 SERIALPORT-IIR!  \ IIR寄存器
  0 SERIALPORT-LCR!  \ LCR寄存器
  0 SERIALPORT-MCR!  \ MCR寄存器
  0 SERIALPORT-LSR!  \ LSR寄存器
  0 SERIALPORT-MSR!  \ MSR寄存器
  0 SERIALPORT-SCR!  \ SCR寄存器
  \ 初始化Speaker
  0 SPEAKER-CONTROL!  \ Control寄存器

  ." IBM PC/AT初始化完成" CR
;

\ =========================================
\ 设备信息显示
\ =========================================

: .DEVICE-INFO ( -- )
  CR
  ." 设备: " DEVICE-NAME TYPE CR
  ." 厂商: " MANUFACTURER TYPE CR
  ." 系列: " FAMILY TYPE CR
  ." 版本: " VERSION TYPE CR
  ." 架构: " ARCHITECTURE TYPE CR
  ." 位宽: " BITS . CR
  ." 时钟: " CLOCK-FREQ . ." Hz" CR
;

\ =========================================
\ 中断处理
\ =========================================

