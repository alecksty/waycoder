\ =========================================
\ IBM PC/AT设备定义
\ =========================================

\ 设备信息
: DEVICE-NAME   S" IBM PC/AT" ;
: MANUFACTURER  S" IBM" ;
: FAMILY        S" IBM PC" ;
: VERSION       S" " ;
: ARCHITECTURE  S" x86-16" ;
0 CONSTANT BITS
0 CONSTANT CLOCK-FREQ

\ 外设定义
\ Programmable Interrupt Controller
 CONSTANT _8259A-BASE
0x20 CONSTANT _8259A-ICW1
0x21 CONSTANT _8259A-ICW2
0x21 CONSTANT _8259A-ICW3
0x21 CONSTANT _8259A-ICW4
0x21 CONSTANT _8259A-OCW1
0x20 CONSTANT _8259A-OCW2
0x20 CONSTANT _8259A-OCW3
\ Programmable Interval Timer
 CONSTANT _8253-BASE
0x40 CONSTANT _8253-COUNTER0
0x41 CONSTANT _8253-COUNTER1
0x42 CONSTANT _8253-COUNTER2
0x43 CONSTANT _8253-CONTROL
\ Direct Memory Access Controller
 CONSTANT _8237-BASE
0x00 CONSTANT _8237-CHANNEL0
0x02 CONSTANT _8237-CHANNEL1
0x04 CONSTANT _8237-CHANNEL2
0x06 CONSTANT _8237-CHANNEL3
0x08 CONSTANT _8237-STATUS
0x08 CONSTANT _8237-COMMAND
0x09 CONSTANT _8237-REQUEST
0x0A CONSTANT _8237-MASK
0x0B CONSTANT _8237-MODE
\ Keyboard Controller
 CONSTANT _8042-BASE
0x60 CONSTANT _8042-DATA
0x64 CONSTANT _8042-STATUS
\ Real-Time Clock with CMOS RAM
 CONSTANT CMOS-BASE
0x70 CONSTANT CMOS-ADDRESS
0x71 CONSTANT CMOS-DATA
\ Floppy Disk Controller
 CONSTANT FDC-BASE
0x3F2 CONSTANT FDC-SRA
0x3F4 CONSTANT FDC-MSR
0x3F5 CONSTANT FDC-DATA
0x3F7 CONSTANT FDC-DIR
0x3F7 CONSTANT FDC-CCR
\ Hard Disk Controller (ST-506/412)
 CONSTANT HDC-BASE
0x1F0 CONSTANT HDC-DATA
0x1F1 CONSTANT HDC-ERROR
0x1F2 CONSTANT HDC-SECTORCOUNT
0x1F3 CONSTANT HDC-SECTORNUMBER
0x1F4 CONSTANT HDC-CYLINDERLOW
0x1F5 CONSTANT HDC-CYLINDERHIGH
0x1F6 CONSTANT HDC-DRIVEHEAD
0x1F7 CONSTANT HDC-STATUS
0x1F7 CONSTANT HDC-COMMAND
\ Color Graphics Adapter
 CONSTANT CGA-BASE
0x3D4 CONSTANT CGA-CRTC_INDEX
0x3D5 CONSTANT CGA-CRTC_DATA
0x3D8 CONSTANT CGA-MODECONTROL
0x3D9 CONSTANT CGA-COLORSELECT
0x3DA CONSTANT CGA-STATUS
\ Enhanced Graphics Adapter
 CONSTANT EGA-BASE
0x3D4 CONSTANT EGA-CRTC_INDEX
0x3D5 CONSTANT EGA-CRTC_DATA
0x3DA CONSTANT EGA-FEATURECONTROL
0x3CC CONSTANT EGA-GRAPHICS1POS
0x3CA CONSTANT EGA-GRAPHICS2POS
0x3C4 CONSTANT EGA-SEQUENCERINDEX
0x3C5 CONSTANT EGA-SEQUENCERDATA
0x3CE CONSTANT EGA-GRAPHICSINDEX
0x3CF CONSTANT EGA-GRAPHICSDATA
0x3C0 CONSTANT EGA-ATTRIBUTEINDEX
0x3C1 CONSTANT EGA-ATTRIBUTEDATA
\ Video Graphics Array
 CONSTANT VGA-BASE
0x3D4 CONSTANT VGA-CRTC_INDEX
0x3D5 CONSTANT VGA-CRTC_DATA
0x3DA CONSTANT VGA-INPUTSTATUS1
0x3DA CONSTANT VGA-FEATURECONTROL
0x3C2 CONSTANT VGA-MISCOUTPUT
0x3C4 CONSTANT VGA-SEQUENCERINDEX
0x3C5 CONSTANT VGA-SEQUENCERDATA
0x3CE CONSTANT VGA-GRAPHICSINDEX
0x3CF CONSTANT VGA-GRAPHICSDATA
0x3C0 CONSTANT VGA-ATTRIBUTEINDEX
0x3C1 CONSTANT VGA-ATTRIBUTEDATA
0x3C6 CONSTANT VGA-DACMASK
0x3C7 CONSTANT VGA-DACREADINDEX
0x3C8 CONSTANT VGA-DACWRITEINDEX
0x3C9 CONSTANT VGA-DACDATA
\ Game Port
 CONSTANT GAMEPORT-BASE
0x201 CONSTANT GAMEPORT-DATA
\ Parallel Printer Port
 CONSTANT PARALLELPORT-BASE
0x378 CONSTANT PARALLELPORT-DATA
0x379 CONSTANT PARALLELPORT-STATUS
0x37A CONSTANT PARALLELPORT-CONTROL
\ Serial Communications Port
 CONSTANT SERIALPORT-BASE
0x3F8 CONSTANT SERIALPORT-DATA
0x3F9 CONSTANT SERIALPORT-IER
0x3FA CONSTANT SERIALPORT-IIR
0x3FB CONSTANT SERIALPORT-LCR
0x3FC CONSTANT SERIALPORT-MCR
0x3FD CONSTANT SERIALPORT-LSR
0x3FE CONSTANT SERIALPORT-MSR
0x3FF CONSTANT SERIALPORT-SCR
\ PC Speaker
 CONSTANT SPEAKER-BASE
0x61 CONSTANT SPEAKER-CONTROL

\ 中断向量定义
0 CONSTANT INT-DIVIDE_ERROR  \ Division by zero
1 CONSTANT INT-SINGLE_STEP  \ Debug single step
2 CONSTANT INT-NMI  \ Non-maskable interrupt
3 CONSTANT INT-BREAKPOINT  \ INT 3 instruction
4 CONSTANT INT-OVERFLOW  \ INTO instruction
5 CONSTANT INT-PRINT_SCREEN  \ Print screen key
8 CONSTANT INT-IRQ0  \ Timer interrupt
9 CONSTANT INT-IRQ1  \ Keyboard interrupt
10 CONSTANT INT-IRQ2  \ Cascade to IRQ8-15
11 CONSTANT INT-IRQ3  \ COM2 interrupt
12 CONSTANT INT-IRQ4  \ COM1 interrupt
13 CONSTANT INT-IRQ5  \ LPT2 interrupt
14 CONSTANT INT-IRQ6  \ Floppy disk interrupt
15 CONSTANT INT-IRQ7  \ LPT1 interrupt
112 CONSTANT INT-IRQ8  \ Real-time clock interrupt
113 CONSTANT INT-IRQ9  \ Redirected IRQ2
114 CONSTANT INT-IRQ10  \ Reserved
115 CONSTANT INT-IRQ11  \ Reserved
116 CONSTANT INT-IRQ12  \ PS/2 mouse interrupt
117 CONSTANT INT-IRQ13  \ Coprocessor interrupt
118 CONSTANT INT-IRQ14  \ Primary IDE interrupt
119 CONSTANT INT-IRQ15  \ Secondary IDE interrupt
16 CONSTANT INT-VIDEO_SERVICES  \ Video BIOS services
19 CONSTANT INT-DISK_SERVICES  \ Disk BIOS services
21 CONSTANT INT-DOS_SERVICES  \ DOS function calls

