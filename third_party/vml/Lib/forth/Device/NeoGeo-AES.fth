\ NeoGeo-68000设备定义 - Forth文件
\ 生成自: SNK/M68K/NeoGeo-68000
\ 版本: 1.0
\ 日期: 2026-04-16
\ 作者: VML Team
\ 描述: SNK Neo Geo AES main processor - Motorola 68000 @ 12MHz + Z80 @ 4MHz (audio coprocessor)
\ CPU架构: MC68000
\ 位宽: 32位
\ 时钟频率: 12000000 Hz

\ =========================================
\ NeoGeo-68000设备定义
\ =========================================

\ 设备信息
: DEVICE-NAME   S" NeoGeo-68000" ;
: MANUFACTURER  S" SNK" ;
: FAMILY        S" M68K" ;
: VERSION       S" 1.0" ;
: ARCHITECTURE  S" MC68000" ;
32 CONSTANT BITS
12000000 CONSTANT CLOCK-FREQ

\ 寄存器地址定义
0x00 CONSTANT D0  \ Data Register 0
0x04 CONSTANT D1  \ Data Register 1
0x08 CONSTANT D2  \ Data Register 2
0x0C CONSTANT D3  \ Data Register 3
0x10 CONSTANT D4  \ Data Register 4
0x14 CONSTANT D5  \ Data Register 5
0x18 CONSTANT D6  \ Data Register 6
0x1C CONSTANT D7  \ Data Register 7
0x20 CONSTANT A0  \ Address Register 0
0x24 CONSTANT A1  \ Address Register 1
0x28 CONSTANT A2  \ Address Register 2
0x2C CONSTANT A3  \ Address Register 3
0x30 CONSTANT A4  \ Address Register 4
0x34 CONSTANT A5  \ Address Register 5
0x38 CONSTANT A6  \ Address Register 6
0x3C CONSTANT A7  \ User Stack Pointer (USP)
0x3C CONSTANT SP  \ Supervisor Stack Pointer (SSP)
0x40 CONSTANT PC  \ Program Counter
0x44 CONSTANT SR  \ Status Register
0 CONSTANT SR-C  \ Carry
1 CONSTANT SR-V  \ Overflow
2 CONSTANT SR-Z  \ Zero
3 CONSTANT SR-N  \ Negative
4 CONSTANT SR-X  \ Extend
8 CONSTANT SR-I0  \ Interrupt Mask 0
9 CONSTANT SR-I1  \ Interrupt Mask 1
10 CONSTANT SR-I2  \ Interrupt Mask 2
11 CONSTANT SR-M  \ Master/Interrupt
13 CONSTANT SR-S  \ Supervisor/User
14 CONSTANT SR-T0  \ Trace Mode 0
15 CONSTANT SR-T1  \ Trace Mode 1

\ 内存段定义
0x100000 CONSTANT WORK_RAM-START
0x10FFFF CONSTANT WORK_RAM-END
65536 CONSTANT WORK_RAM-SIZE  \ Work RAM (64KB)
0x200000 CONSTANT BACKUP_RAM-START
0x20FFFF CONSTANT BACKUP_RAM-END
65536 CONSTANT BACKUP_RAM-SIZE  \ Backup SRAM (battery-backed, 64KB)
0x000000 CONSTANT FIX_ROM-START
0x07FFFF CONSTANT FIX_ROM-END
524288 CONSTANT FIX_ROM-SIZE  \ Fix Layer ROM (512KB)
0x400000 CONSTANT SPR_ROM-START
0x4FFFFF CONSTANT SPR_ROM-END
1048576 CONSTANT SPR_ROM-SIZE  \ Sprite ROM (up to 1MB)
0x800000 CONSTANT AUDIO_ROM-START
0x80FFFF CONSTANT AUDIO_ROM-END
65536 CONSTANT AUDIO_ROM-SIZE  \ Audio ROM (up to 64KB)
0xC00000 CONSTANT CART_ROM-START
0xC7FFFF CONSTANT CART_ROM-END
524288 CONSTANT CART_ROM-SIZE  \ Cartridge ROM (up to 512KB, expandable)
0x300000 CONSTANT IO_AREA-START
0x3FFFFF CONSTANT IO_AREA-END
1048576 CONSTANT IO_AREA-SIZE  \ I/O Area (VDP, YM2610, Z80 port, etc.)
0x10000 CONSTANT Z80_RAM-START
0x107FF CONSTANT Z80_RAM-END
2048 CONSTANT Z80_RAM-SIZE  \ Z80 Work RAM (2KB)

