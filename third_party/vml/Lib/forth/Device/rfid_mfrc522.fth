\ MFRC522设备定义 - Forth文件
\ 生成自: NXP/RFID/MFRC522
\ 版本: 1.0
\ 日期: 2026-05-06
\ 作者: VML Team
\ 描述: MFRC522 13.56MHz RFID/NFC Reader (SPI, ISO 14443A, MIFARE)
\ CPU架构: RFID
\ 位宽: 8位
\ 时钟频率: 10000000 Hz

\ =========================================
\ MFRC522设备定义
\ =========================================

\ 设备信息
: DEVICE-NAME   S" MFRC522" ;
: MANUFACTURER  S" NXP" ;
: FAMILY        S" RFID" ;
: VERSION       S" 1.0" ;
: ARCHITECTURE  S" RFID" ;
8 CONSTANT BITS
10000000 CONSTANT CLOCK-FREQ

\ 内存段定义
0x00 CONSTANT FIFO-START
0x3F CONSTANT FIFO-END
64 CONSTANT FIFO-SIZE  \ 64-byte FIFO buffer

\ 外设定义
\ MFRC522 NFC Reader (SPI, 3.3V, 13.56MHz)
0x00 CONSTANT MFRC522-BASE
0x01 CONSTANT MFRC522-CMD
0x04 CONSTANT MFRC522-COM_IRQ
6 CONSTANT MFRC522-COM_IRQ-TX_IRQ  \ Transmitter interrupt
5 CONSTANT MFRC522-COM_IRQ-RX_IRQ  \ Receiver interrupt
4 CONSTANT MFRC522-COM_IRQ-IDLE_IRQ  \ Idle interrupt
0 CONSTANT MFRC522-COM_IRQ-TIMER_IRQ  \ Timer interrupt
0x05 CONSTANT MFRC522-COM_IRQ_EN
0x06 CONSTANT MFRC522-ERROR
0x08 CONSTANT MFRC522-STATUS2
0x09 CONSTANT MFRC522-FIFO_DATA
0x0A CONSTANT MFRC522-FIFO_LEVEL
0x14 CONSTANT MFRC522-TX_CTRL
0x15 CONSTANT MFRC522-TX_ASK
0x11 CONSTANT MFRC522-MODE
0x37 CONSTANT MFRC522-VERSION

\ =========================================
\ 寄存器访问字
\ =========================================

\ 外设访问
\ MFRC522外设
: MFRC522-CMD@ ( -- n ) MFRC522-CMD C@ ;
: MFRC522-CMD! ( n -- ) MFRC522-CMD C! ;
: MFRC522-COM_IRQ@ ( -- n ) MFRC522-COM_IRQ C@ ;
: MFRC522-COM_IRQ! ( n -- ) MFRC522-COM_IRQ C! ;
: MFRC522-COM_IRQ-TX_IRQ@ ( -- flag ) MFRC522-COM_IRQ@ 6 BIT@ ;
: MFRC522-COM_IRQ-TX_IRQ! ( flag -- ) MFRC522-COM_IRQ@ 6 BIT! MFRC522-COM_IRQ! ;
: MFRC522-COM_IRQ-RX_IRQ@ ( -- flag ) MFRC522-COM_IRQ@ 5 BIT@ ;
: MFRC522-COM_IRQ-RX_IRQ! ( flag -- ) MFRC522-COM_IRQ@ 5 BIT! MFRC522-COM_IRQ! ;
: MFRC522-COM_IRQ-IDLE_IRQ@ ( -- flag ) MFRC522-COM_IRQ@ 4 BIT@ ;
: MFRC522-COM_IRQ-IDLE_IRQ! ( flag -- ) MFRC522-COM_IRQ@ 4 BIT! MFRC522-COM_IRQ! ;
: MFRC522-COM_IRQ-TIMER_IRQ@ ( -- flag ) MFRC522-COM_IRQ@ 0 BIT@ ;
: MFRC522-COM_IRQ-TIMER_IRQ! ( flag -- ) MFRC522-COM_IRQ@ 0 BIT! MFRC522-COM_IRQ! ;
: MFRC522-COM_IRQ_EN@ ( -- n ) MFRC522-COM_IRQ_EN C@ ;
: MFRC522-COM_IRQ_EN! ( n -- ) MFRC522-COM_IRQ_EN C! ;
: MFRC522-ERROR@ ( -- n ) MFRC522-ERROR C@ ;
: MFRC522-ERROR! ( n -- ) MFRC522-ERROR C! ;
: MFRC522-STATUS2@ ( -- n ) MFRC522-STATUS2 C@ ;
: MFRC522-STATUS2! ( n -- ) MFRC522-STATUS2 C! ;
: MFRC522-FIFO_DATA@ ( -- n ) MFRC522-FIFO_DATA C@ ;
: MFRC522-FIFO_DATA! ( n -- ) MFRC522-FIFO_DATA C! ;
: MFRC522-FIFO_LEVEL@ ( -- n ) MFRC522-FIFO_LEVEL C@ ;
: MFRC522-FIFO_LEVEL! ( n -- ) MFRC522-FIFO_LEVEL C! ;
: MFRC522-TX_CTRL@ ( -- n ) MFRC522-TX_CTRL C@ ;
: MFRC522-TX_CTRL! ( n -- ) MFRC522-TX_CTRL C! ;
: MFRC522-TX_ASK@ ( -- n ) MFRC522-TX_ASK C@ ;
: MFRC522-TX_ASK! ( n -- ) MFRC522-TX_ASK C! ;
: MFRC522-MODE@ ( -- n ) MFRC522-MODE C@ ;
: MFRC522-MODE! ( n -- ) MFRC522-MODE C! ;
: MFRC522-VERSION@ ( -- n ) MFRC522-VERSION C@ ;
: MFRC522-VERSION! ( n -- ) MFRC522-VERSION C! ;

\ =========================================
\ 设备初始化
\ =========================================

: MFRC522-INIT ( -- )
  \ 初始化MFRC522设备
  ." 初始化MFRC522..." CR


  \ 初始化外设
  \ 初始化MFRC522
  0 MFRC522-CMD!  \ CMD寄存器
  0 MFRC522-COM_IRQ!  \ COM_IRQ寄存器
  0 MFRC522-COM_IRQ_EN!  \ COM_IRQ_EN寄存器
  0 MFRC522-ERROR!  \ ERROR寄存器
  0 MFRC522-STATUS2!  \ STATUS2寄存器
  0 MFRC522-FIFO_DATA!  \ FIFO_DATA寄存器
  0 MFRC522-FIFO_LEVEL!  \ FIFO_LEVEL寄存器
  0 MFRC522-TX_CTRL!  \ TX_CTRL寄存器
  0 MFRC522-TX_ASK!  \ TX_ASK寄存器
  0 MFRC522-MODE!  \ MODE寄存器
  0 MFRC522-VERSION!  \ VERSION寄存器

  ." MFRC522初始化完成" CR
;

\ =========================================
\ 设备信息显示
\ =========================================

: .DEVICE-INFO ( -- )
  CR
  ." 设备: " DEVICE-NAME TYPE CR
  ." 厂商: " MANUFACTURER TYPE CR
  ." 系列: " FAMILY TYPE CR
  ." 版本: " VERSION TYPE CR
  ." 架构: " ARCHITECTURE TYPE CR
  ." 位宽: " BITS . CR
  ." 时钟: " CLOCK-FREQ . ." Hz" CR
;

\ =========================================
\ 示例程序
\ =========================================

: EXAMPLE ( -- )
  MFRC522-INIT
  .DEVICE-INFO
  .REGISTERS
  CR ." 示例程序运行完成" CR
;

\ 自动运行示例
( EXAMPLE )
