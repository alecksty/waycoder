: CPSR@ ( -- n ) CPSR L@ ;
: CPSR! ( n -- ) CPSR L! ;
: CPSR-MODE@ ( -- flag ) CPSR@ 0 BIT@ ;
: CPSR-MODE! ( flag -- ) CPSR@ 0 BIT! CPSR! ;
: CPSR-MODE-SET ( -- ) TRUE CPSR-MODE! ;
: CPSR-MODE-CLR ( -- ) FALSE CPSR-MODE! ;
: CPSR-T@ ( -- flag ) CPSR@ 5 BIT@ ;
: CPSR-T! ( flag -- ) CPSR@ 5 BIT! CPSR! ;
: CPSR-T-SET ( -- ) TRUE CPSR-T! ;
: CPSR-T-CLR ( -- ) FALSE CPSR-T! ;
: CPSR-F@ ( -- flag ) CPSR@ 6 BIT@ ;
: CPSR-F! ( flag -- ) CPSR@ 6 BIT! CPSR! ;
: CPSR-F-SET ( -- ) TRUE CPSR-F! ;
: CPSR-F-CLR ( -- ) FALSE CPSR-F! ;
: CPSR-I@ ( -- flag ) CPSR@ 7 BIT@ ;
: CPSR-I! ( flag -- ) CPSR@ 7 BIT! CPSR! ;
: CPSR-I-SET ( -- ) TRUE CPSR-I! ;
: CPSR-I-CLR ( -- ) FALSE CPSR-I! ;
: CPSR-A@ ( -- flag ) CPSR@ 8 BIT@ ;
: CPSR-A! ( flag -- ) CPSR@ 8 BIT! CPSR! ;
: CPSR-A-SET ( -- ) TRUE CPSR-A! ;
: CPSR-A-CLR ( -- ) FALSE CPSR-A! ;
: CPSR-E@ ( -- flag ) CPSR@ 9 BIT@ ;
: CPSR-E! ( flag -- ) CPSR@ 9 BIT! CPSR! ;
: CPSR-E-SET ( -- ) TRUE CPSR-E! ;
: CPSR-E-CLR ( -- ) FALSE CPSR-E! ;
: CPSR-GE@ ( -- flag ) CPSR@ 0 BIT@ ;
: CPSR-GE! ( flag -- ) CPSR@ 0 BIT! CPSR! ;
: CPSR-GE-SET ( -- ) TRUE CPSR-GE! ;
: CPSR-GE-CLR ( -- ) FALSE CPSR-GE! ;
: CPSR-N@ ( -- flag ) CPSR@ 31 BIT@ ;
: CPSR-N! ( flag -- ) CPSR@ 31 BIT! CPSR! ;
: CPSR-N-SET ( -- ) TRUE CPSR-N! ;
: CPSR-N-CLR ( -- ) FALSE CPSR-N! ;
: CPSR-Z@ ( -- flag ) CPSR@ 30 BIT@ ;
: CPSR-Z! ( flag -- ) CPSR@ 30 BIT! CPSR! ;
: CPSR-Z-SET ( -- ) TRUE CPSR-Z! ;
: CPSR-Z-CLR ( -- ) FALSE CPSR-Z! ;
