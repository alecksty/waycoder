: WAITCNT-WAITCNT-PREFE! ( flag -- ) WAITCNT-WAITCNT@ 12 BIT! WAITCNT-WAITCNT! ;

\ =========================================
\ 设备初始化
\ =========================================

: ARM7TDMI-INIT ( -- )
  \ 初始化ARM7TDMI设备
  ." 初始化ARM7TDMI..." CR

  \ 初始化寄存器
  0 R0!  \ General Purpose Register 0
  0 R1!  \ General Purpose Register 1
  0 R2!  \ General Purpose Register 2
  0 R3!  \ General Purpose Register 3
  0 R4!  \ General Purpose Register 4
  0 R5!  \ General Purpose Register 5
  0 R6!  \ General Purpose Register 6
  0 R7!  \ General Purpose Register 7
  0 R8!  \ General Purpose Register 8
  0 R9!  \ General Purpose Register 9 / SB
  0 R10!  \ General Purpose Register 10 / SL
  0 R11!  \ Frame Pointer / FP
  0 R12!  \ Intra-Procedure-call Scratch Register / IP
  0 R13!  \ Stack Pointer / SP
  0 R14!  \ Link Register / LR
  0 R15!  \ Program Counter / PC
  0 CPSR!  \ Current Program Status Register
  0 SPSR_SVC!  \ Saved PSR (Supervisor Mode)
  0 SPSR_ABT!  \ Saved PSR (Abort Mode)
  0 SPSR_IRQ!  \ Saved PSR (IRQ Mode)
  0 SPSR_FIQ!  \ Saved PSR (FIQ Mode)

  \ 初始化外设
  \ 初始化LCD
  0 LCD-DISPCNT!  \ DISPCNT寄存器
  0 LCD-GREEN_SWAP!  \ GREEN_SWAP寄存器
  0 LCD-DISPSTAT!  \ DISPSTAT寄存器
  0 LCD-VCOUNT!  \ VCOUNT寄存器
  0 LCD-BG0CNT!  \ BG0CNT寄存器
  0 LCD-BG1CNT!  \ BG1CNT寄存器
  0 LCD-BG2CNT!  \ BG2CNT寄存器
  0 LCD-BG3CNT!  \ BG3CNT寄存器
  0 LCD-BG0HOFS!  \ BG0HOFS寄存器
  0 LCD-BG0VOFS!  \ BG0VOFS寄存器
  0 LCD-BG1HOFS!  \ BG1HOFS寄存器
  0 LCD-BG1VOFS!  \ BG1VOFS寄存器
  0 LCD-BG2HOFS!  \ BG2HOFS寄存器
  0 LCD-BG2VOFS!  \ BG2VOFS寄存器
  0 LCD-BG3HOFS!  \ BG3HOFS寄存器
  0 LCD-BG3VOFS!  \ BG3VOFS寄存器
  0 LCD-BG2PA!  \ BG2PA寄存器
  0 LCD-BG2PB!  \ BG2PB寄存器
  0 LCD-BG2PC!  \ BG2PC寄存器
  0 LCD-BG2PD!  \ BG2PD寄存器
  0 LCD-BG2X!  \ BG2X寄存器
  0 LCD-BG2Y!  \ BG2Y寄存器
  0 LCD-BG3PA!  \ BG3PA寄存器
  0 LCD-BG3PB!  \ BG3PB寄存器
  0 LCD-BG3PC!  \ BG3PC寄存器
  0 LCD-BG3PD!  \ BG3PD寄存器
  0 LCD-BG3X!  \ BG3X寄存器
  0 LCD-BG3Y!  \ BG3Y寄存器
  0 LCD-WIN0H!  \ WIN0H寄存器
  0 LCD-WIN1H!  \ WIN1H寄存器
  0 LCD-WIN0V!  \ WIN0V寄存器
  0 LCD-WIN1V!  \ WIN1V寄存器
  0 LCD-WININ!  \ WININ寄存器
  0 LCD-WINOUT!  \ WINOUT寄存器
  0 LCD-MOSAIC!  \ MOSAIC寄存器
  0 LCD-BLDCNT!  \ BLDCNT寄存器
  0 LCD-BLDALPHA!  \ BLDALPHA寄存器
  0 LCD-BLDY!  \ BLDY寄存器
  \ 初始化DMA
  0 DMA-DMA0SAD!  \ DMA0SAD寄存器
  0 DMA-DMA0DAD!  \ DMA0DAD寄存器
  0 DMA-DMA0CNT_L!  \ DMA0CNT_L寄存器
  0 DMA-DMA0CNT_H!  \ DMA0CNT_H寄存器
  0 DMA-DMA1SAD!  \ DMA1SAD寄存器
  0 DMA-DMA1DAD!  \ DMA1DAD寄存器
  0 DMA-DMA1CNT_L!  \ DMA1CNT_L寄存器
  0 DMA-DMA1CNT_H!  \ DMA1CNT_H寄存器
  0 DMA-DMA2SAD!  \ DMA2SAD寄存器
  0 DMA-DMA2DAD!  \ DMA2DAD寄存器
  0 DMA-DMA2CNT_L!  \ DMA2CNT_L寄存器
  0 DMA-DMA2CNT_H!  \ DMA2CNT_H寄存器
  0 DMA-DMA3SAD!  \ DMA3SAD寄存器
  0 DMA-DMA3DAD!  \ DMA3DAD寄存器
  0 DMA-DMA3CNT_L!  \ DMA3CNT_L寄存器
  0 DMA-DMA3CNT_H!  \ DMA3CNT_H寄存器
  \ 初始化TIMER
  0 TIMER-TM0CNT_L!  \ TM0CNT_L寄存器
  0 TIMER-TM0CNT_H!  \ TM0CNT_H寄存器
  0 TIMER-TM1CNT_L!  \ TM1CNT_L寄存器
  0 TIMER-TM1CNT_H!  \ TM1CNT_H寄存器
  0 TIMER-TM2CNT_L!  \ TM2CNT_L寄存器
  0 TIMER-TM2CNT_H!  \ TM2CNT_H寄存器
  0 TIMER-TM3CNT_L!  \ TM3CNT_L寄存器
  0 TIMER-TM3CNT_H!  \ TM3CNT_H寄存器
  \ 初始化SIO
  0 SIO-SIOCNT!  \ SIOCNT寄存器
  0 SIO-SIODATA8!  \ SIODATA8寄存器
  0 SIO-JOYCNT!  \ JOYCNT寄存器
  0 SIO-JOYSTAT!  \ JOYSTAT寄存器
  0 SIO-JOY_RECV!  \ JOY_RECV寄存器
  0 SIO-JOY_TRANS!  \ JOY_TRANS寄存器
  \ 初始化KEYINPUT
  0 KEYINPUT-KEYINPUT!  \ KEYINPUT寄存器
  0 KEYINPUT-KEYCNT!  \ KEYCNT寄存器
  \ 初始化INTERRUPT
  0 INTERRUPT-IME!  \ IME寄存器
  0 INTERRUPT-IE!  \ IE寄存器
  0 INTERRUPT-IF!  \ IF寄存器
  \ 初始化WAITCNT
  0 WAITCNT-WAITCNT!  \ WAITCNT寄存器

  ." ARM7TDMI初始化完成" CR
;

\ =========================================
\ 设备信息显示
\ =========================================

: .DEVICE-INFO ( -- )
  CR
  ." 设备: " DEVICE-NAME TYPE CR
  ." 厂商: " MANUFACTURER TYPE CR
  ." 系列: " FAMILY TYPE CR
  ." 版本: " VERSION TYPE CR
  ." 架构: " ARCHITECTURE TYPE CR
  ." 位宽: " BITS . CR
  ." 时钟: " CLOCK-FREQ . ." Hz" CR
;

: .REGISTERS ( -- )
  CR ." 寄存器状态:" CR
  ." ----------" CR
  R0@ R0 .R 8 .R SPACE ."  R0: " R0@ .
  R1@ R1 .R 8 .R SPACE ."  R1: " R1@ .
  R2@ R2 .R 8 .R SPACE ."  R2: " R2@ .
  R3@ R3 .R 8 .R SPACE ."  R3: " R3@ .
  R4@ R4 .R 8 .R SPACE ."  R4: " R4@ .
  R5@ R5 .R 8 .R SPACE ."  R5: " R5@ .
  R6@ R6 .R 8 .R SPACE ."  R6: " R6@ .
  R7@ R7 .R 8 .R SPACE ."  R7: " R7@ .
  R8@ R8 .R 8 .R SPACE ."  R8: " R8@ .
  R9@ R9 .R 8 .R SPACE ."  R9: " R9@ .
  R10@ R10 .R 8 .R SPACE ."  R10: " R10@ .
  R11@ R11 .R 8 .R SPACE ."  R11: " R11@ .
  R12@ R12 .R 8 .R SPACE ."  R12: " R12@ .
  R13@ R13 .R 8 .R SPACE ."  R13: " R13@ .
  R14@ R14 .R 8 .R SPACE ."  R14: " R14@ .
  R15@ R15 .R 8 .R SPACE ."  R15: " R15@ .
  CPSR@ CPSR .R 8 .R SPACE ."  CPSR: " CPSR@ .
  SPSR_SVC@ SPSR_SVC .R 8 .R SPACE ."  SPSR_SVC: " SPSR_SVC@ .
  SPSR_ABT@ SPSR_ABT .R 8 .R SPACE ."  SPSR_ABT: " SPSR_ABT@ .
  SPSR_IRQ@ SPSR_IRQ .R 8 .R SPACE ."  SPSR_IRQ: " SPSR_IRQ@ .
  SPSR_FIQ@ SPSR_FIQ .R 8 .R SPACE ."  SPSR_FIQ: " SPSR_FIQ@ .
;

