\ ATmega2560设备定义 - Forth文件
\ 生成自: Atmel/AVR/ATmega2560
\ 版本: 1.0
\ 日期: 2026-04-28
\ 作者: VML Team
\ 描述: 8-bit AVR MCU with 256KB Flash, 8KB RAM, 4KB EEPROM, 16MHz, Arduino Mega
\ CPU架构: AVR
\ 位宽: 8位
\ 时钟频率: 16000000 Hz

\ =========================================
\ ATmega2560设备定义
\ =========================================

\ 设备信息
: DEVICE-NAME   S" ATmega2560" ;
: MANUFACTURER  S" Atmel" ;
: FAMILY        S" AVR" ;
: VERSION       S" 1.0" ;
: ARCHITECTURE  S" AVR" ;
8 CONSTANT BITS
16000000 CONSTANT CLOCK-FREQ

\ 寄存器地址定义
0x00 CONSTANT R0  \ 
0x01 CONSTANT R1  \ 
0x02 CONSTANT R2  \ 
0x5D CONSTANT SPL  \ 
0x5E CONSTANT SPH  \ 
0x5F CONSTANT SREG  \ 

\ 内存段定义
0x0000 CONSTANT FLASH-START
0x3FFFF CONSTANT FLASH-END
262144 CONSTANT FLASH-SIZE  \ 
0x0200 CONSTANT SRAM-START
0x21FF CONSTANT SRAM-END
8192 CONSTANT SRAM-SIZE  \ 
0x0000 CONSTANT EEPROM-START
0x0FFF CONSTANT EEPROM-END
4096 CONSTANT EEPROM-SIZE  \ 
0x00 CONSTANT IO-START
0x3F CONSTANT IO-END
64 CONSTANT IO-SIZE  \ 
0x40 CONSTANT EXTIO-START
0xFF CONSTANT EXTIO-END
192 CONSTANT EXTIO-SIZE  \ 

\ 外设定义
\ Port A
0x22 CONSTANT PORTA-BASE
0x21 CONSTANT PORTA-DDRA
0x22 CONSTANT PORTA-PORTA
0x20 CONSTANT PORTA-PINA
\ Port B
0x25 CONSTANT PORTB-BASE
0x24 CONSTANT PORTB-DDRB
0x25 CONSTANT PORTB-PORTB
0x23 CONSTANT PORTB-PINB
\ Port C
0x28 CONSTANT PORTC-BASE
0x27 CONSTANT PORTC-DDRC
0x28 CONSTANT PORTC-PORTC
0x26 CONSTANT PORTC-PINC
\ Port D
0x2B CONSTANT PORTD-BASE
0x2A CONSTANT PORTD-DDRD
0x2B CONSTANT PORTD-PORTD
0x29 CONSTANT PORTD-PIND
\ Port E
0x2E CONSTANT PORTE-BASE
0x2D CONSTANT PORTE-DDRE
0x2E CONSTANT PORTE-PORTE
0x2C CONSTANT PORTE-PINE
\ Port F
0x31 CONSTANT PORTF-BASE
0x30 CONSTANT PORTF-DDRF
0x31 CONSTANT PORTF-PORTF
0x2F CONSTANT PORTF-PINF
\ Port G
0x34 CONSTANT PORTG-BASE
0x33 CONSTANT PORTG-DDRG
0x34 CONSTANT PORTG-PORTG
0x32 CONSTANT PORTG-PING
\ USART 0
0xC0 CONSTANT USART0-BASE
0xC6 CONSTANT USART0-UDR0
0xC0 CONSTANT USART0-UCSR0A
0xC1 CONSTANT USART0-UCSR0B
0xC2 CONSTANT USART0-UCSR0C
0xC4 CONSTANT USART0-UBRR0L
0xC5 CONSTANT USART0-UBRR0H

\ 中断向量定义
1 CONSTANT INT-RESET  \ 
2 CONSTANT INT-INT0  \ 
3 CONSTANT INT-INT1  \ 
4 CONSTANT INT-INT2  \ 
5 CONSTANT INT-INT3  \ 
6 CONSTANT INT-INT4  \ 
7 CONSTANT INT-INT5  \ 
8 CONSTANT INT-INT6  \ 
9 CONSTANT INT-INT7  \ 
10 CONSTANT INT-PCINT0  \ 
11 CONSTANT INT-PCINT1  \ 
12 CONSTANT INT-PCINT2  \ 
13 CONSTANT INT-WDT  \ 
14 CONSTANT INT-TIM2_COMPA  \ 
15 CONSTANT INT-TIM2_COMPB  \ 
16 CONSTANT INT-TIM2_OVF  \ 
17 CONSTANT INT-TIM1_CAPT  \ 
18 CONSTANT INT-TIM1_COMPA  \ 
19 CONSTANT INT-TIM1_COMPB  \ 
20 CONSTANT INT-TIM1_OVF  \ 
21 CONSTANT INT-TIM0_COMPA  \ 
22 CONSTANT INT-TIM0_COMPB  \ 
23 CONSTANT INT-TIM0_OVF  \ 
24 CONSTANT INT-SPI_STC  \ 
25 CONSTANT INT-USART0_RX  \ 
26 CONSTANT INT-USART0_UDRE  \ 
27 CONSTANT INT-USART0_TX  \ 

\ =========================================
\ 寄存器访问字
\ =========================================

\ 通用寄存器访问
: R0@ ( -- n ) R0 C@ ;
: R0! ( n -- ) R0 C! ;

: R1@ ( -- n ) R1 C@ ;
: R1! ( n -- ) R1 C! ;

: R2@ ( -- n ) R2 C@ ;
: R2! ( n -- ) R2 C! ;

: SPL@ ( -- n ) SPL C@ ;
: SPL! ( n -- ) SPL C! ;

: SPH@ ( -- n ) SPH C@ ;
: SPH! ( n -- ) SPH C! ;

: SREG@ ( -- n ) SREG C@ ;
: SREG! ( n -- ) SREG C! ;

\ 外设访问
\ PORTA外设
: PORTA-DDRA@ ( -- n ) PORTA-DDRA C@ ;
: PORTA-DDRA! ( n -- ) PORTA-DDRA C! ;
: PORTA-PORTA@ ( -- n ) PORTA-PORTA C@ ;
: PORTA-PORTA! ( n -- ) PORTA-PORTA C! ;
: PORTA-PINA@ ( -- n ) PORTA-PINA C@ ;
: PORTA-PINA! ( n -- ) PORTA-PINA C! ;

\ PORTB外设
: PORTB-DDRB@ ( -- n ) PORTB-DDRB C@ ;
: PORTB-DDRB! ( n -- ) PORTB-DDRB C! ;
: PORTB-PORTB@ ( -- n ) PORTB-PORTB C@ ;
: PORTB-PORTB! ( n -- ) PORTB-PORTB C! ;
: PORTB-PINB@ ( -- n ) PORTB-PINB C@ ;
: PORTB-PINB! ( n -- ) PORTB-PINB C! ;

\ PORTC外设
: PORTC-DDRC@ ( -- n ) PORTC-DDRC C@ ;
: PORTC-DDRC! ( n -- ) PORTC-DDRC C! ;
: PORTC-PORTC@ ( -- n ) PORTC-PORTC C@ ;
: PORTC-PORTC! ( n -- ) PORTC-PORTC C! ;
: PORTC-PINC@ ( -- n ) PORTC-PINC C@ ;
: PORTC-PINC! ( n -- ) PORTC-PINC C! ;

\ PORTD外设
: PORTD-DDRD@ ( -- n ) PORTD-DDRD C@ ;
: PORTD-DDRD! ( n -- ) PORTD-DDRD C! ;
: PORTD-PORTD@ ( -- n ) PORTD-PORTD C@ ;
: PORTD-PORTD! ( n -- ) PORTD-PORTD C! ;
: PORTD-PIND@ ( -- n ) PORTD-PIND C@ ;
: PORTD-PIND! ( n -- ) PORTD-PIND C! ;

\ PORTE外设
: PORTE-DDRE@ ( -- n ) PORTE-DDRE C@ ;
: PORTE-DDRE! ( n -- ) PORTE-DDRE C! ;
: PORTE-PORTE@ ( -- n ) PORTE-PORTE C@ ;
: PORTE-PORTE! ( n -- ) PORTE-PORTE C! ;
: PORTE-PINE@ ( -- n ) PORTE-PINE C@ ;
: PORTE-PINE! ( n -- ) PORTE-PINE C! ;

\ PORTF外设
: PORTF-DDRF@ ( -- n ) PORTF-DDRF C@ ;
: PORTF-DDRF! ( n -- ) PORTF-DDRF C! ;
: PORTF-PORTF@ ( -- n ) PORTF-PORTF C@ ;
: PORTF-PORTF! ( n -- ) PORTF-PORTF C! ;
: PORTF-PINF@ ( -- n ) PORTF-PINF C@ ;
: PORTF-PINF! ( n -- ) PORTF-PINF C! ;

\ PORTG外设
: PORTG-DDRG@ ( -- n ) PORTG-DDRG C@ ;
: PORTG-DDRG! ( n -- ) PORTG-DDRG C! ;
: PORTG-PORTG@ ( -- n ) PORTG-PORTG C@ ;
: PORTG-PORTG! ( n -- ) PORTG-PORTG C! ;
: PORTG-PING@ ( -- n ) PORTG-PING C@ ;
: PORTG-PING! ( n -- ) PORTG-PING C! ;

\ USART0外设
: USART0-UDR0@ ( -- n ) USART0-UDR0 C@ ;
: USART0-UDR0! ( n -- ) USART0-UDR0 C! ;
: USART0-UCSR0A@ ( -- n ) USART0-UCSR0A C@ ;
: USART0-UCSR0A! ( n -- ) USART0-UCSR0A C! ;
: USART0-UCSR0B@ ( -- n ) USART0-UCSR0B C@ ;
: USART0-UCSR0B! ( n -- ) USART0-UCSR0B C! ;
: USART0-UCSR0C@ ( -- n ) USART0-UCSR0C C@ ;
: USART0-UCSR0C! ( n -- ) USART0-UCSR0C C! ;
: USART0-UBRR0L@ ( -- n ) USART0-UBRR0L C@ ;
: USART0-UBRR0L! ( n -- ) USART0-UBRR0L C! ;
: USART0-UBRR0H@ ( -- n ) USART0-UBRR0H C@ ;
: USART0-UBRR0H! ( n -- ) USART0-UBRR0H C! ;

\ =========================================
\ 设备初始化
\ =========================================

: ATMEGA2560-INIT ( -- )
  \ 初始化ATmega2560设备
  ." 初始化ATmega2560..." CR

  \ 初始化寄存器
  0 R0!  \ 
  0 R1!  \ 
  0 R2!  \ 
  0 SPL!  \ 
  0 SPH!  \ 
  0 SREG!  \ 

  \ 初始化外设
  \ 初始化PORTA
  0 PORTA-DDRA!  \ DDRA寄存器
  0 PORTA-PORTA!  \ PORTA寄存器
  0 PORTA-PINA!  \ PINA寄存器
  \ 初始化PORTB
  0 PORTB-DDRB!  \ DDRB寄存器
  0 PORTB-PORTB!  \ PORTB寄存器
  0 PORTB-PINB!  \ PINB寄存器
  \ 初始化PORTC
  0 PORTC-DDRC!  \ DDRC寄存器
  0 PORTC-PORTC!  \ PORTC寄存器
  0 PORTC-PINC!  \ PINC寄存器
  \ 初始化PORTD
  0 PORTD-DDRD!  \ DDRD寄存器
  0 PORTD-PORTD!  \ PORTD寄存器
  0 PORTD-PIND!  \ PIND寄存器
  \ 初始化PORTE
  0 PORTE-DDRE!  \ DDRE寄存器
  0 PORTE-PORTE!  \ PORTE寄存器
  0 PORTE-PINE!  \ PINE寄存器
  \ 初始化PORTF
  0 PORTF-DDRF!  \ DDRF寄存器
  0 PORTF-PORTF!  \ PORTF寄存器
  0 PORTF-PINF!  \ PINF寄存器
  \ 初始化PORTG
  0 PORTG-DDRG!  \ DDRG寄存器
  0 PORTG-PORTG!  \ PORTG寄存器
  0 PORTG-PING!  \ PING寄存器
  \ 初始化USART0
  0 USART0-UDR0!  \ UDR0寄存器
  0 USART0-UCSR0A!  \ UCSR0A寄存器
  0 USART0-UCSR0B!  \ UCSR0B寄存器
  0 USART0-UCSR0C!  \ UCSR0C寄存器
  0 USART0-UBRR0L!  \ UBRR0L寄存器
  0 USART0-UBRR0H!  \ UBRR0H寄存器

  ." ATmega2560初始化完成" CR
;

\ =========================================
\ 设备信息显示
\ =========================================

: .DEVICE-INFO ( -- )
  CR
  ." 设备: " DEVICE-NAME TYPE CR
  ." 厂商: " MANUFACTURER TYPE CR
  ." 系列: " FAMILY TYPE CR
  ." 版本: " VERSION TYPE CR
  ." 架构: " ARCHITECTURE TYPE CR
  ." 位宽: " BITS . CR
  ." 时钟: " CLOCK-FREQ . ." Hz" CR
;

: .REGISTERS ( -- )
  CR ." 寄存器状态:" CR
  ." ----------" CR
  R0@ R0 .R 8 .R SPACE ."  R0: " R0@ .
  R1@ R1 .R 8 .R SPACE ."  R1: " R1@ .
  R2@ R2 .R 8 .R SPACE ."  R2: " R2@ .
  SPL@ SPL .R 8 .R SPACE ."  SPL: " SPL@ .
  SPH@ SPH .R 8 .R SPACE ."  SPH: " SPH@ .
  SREG@ SREG .R 8 .R SPACE ."  SREG: " SREG@ .
;

