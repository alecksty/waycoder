\ NRF24L01设备定义 - Forth文件
\ 生成自: Nordic/RF/NRF24L01
\ 版本: 1.0
\ 日期: 2026-05-06
\ 作者: VML Team
\ 描述: nRF24L01+ 2.4GHz RF Transceiver (SPI, 2Mbps, 125-channel, 6-pipe)
\ CPU架构: RF
\ 位宽: 8位
\ 时钟频率: 10000000 Hz

\ =========================================
\ NRF24L01设备定义
\ =========================================

\ 设备信息
: DEVICE-NAME   S" NRF24L01" ;
: MANUFACTURER  S" Nordic" ;
: FAMILY        S" RF" ;
: VERSION       S" 1.0" ;
: ARCHITECTURE  S" RF" ;
8 CONSTANT BITS
10000000 CONSTANT CLOCK-FREQ

\ 外设定义
\ nRF24L01+ 2.4GHz Transceiver (SPI, 1.9V-3.6V)
0x00 CONSTANT NRF24L01-BASE
0x00 CONSTANT NRF24L01-CONFIG
1 CONSTANT NRF24L01-CONFIG-PWR_UP  \ Power up (1=on)
0 CONSTANT NRF24L01-CONFIG-PRIM_RX  \ Primary RX mode (1=RX, 0=TX)
0x01 CONSTANT NRF24L01-EN_AA
0x02 CONSTANT NRF24L01-EN_RXADDR
0x03 CONSTANT NRF24L01-SETUP_AW
0x04 CONSTANT NRF24L01-SETUP_RETR
0x05 CONSTANT NRF24L01-RF_CH
0x06 CONSTANT NRF24L01-RF_SETUP
1 CONSTANT NRF24L01-RF_SETUP-RF_PWR  \ TX power: 00=-18dBm,01=-12dBm,10=-6dBm,11=0dBm
3 CONSTANT NRF24L01-RF_SETUP-RF_DR  \ Data rate: 0=1Mbps,1=2Mbps
0x07 CONSTANT NRF24L01-STATUS
0x11 CONSTANT NRF24L01-RX_PW_P0
0x17 CONSTANT NRF24L01-FIFO_STATUS
0xA0 CONSTANT NRF24L01-TX_PAYLOAD
0x61 CONSTANT NRF24L01-RX_PAYLOAD

\ =========================================
\ 寄存器访问字
\ =========================================

\ 外设访问
\ NRF24L01外设
: NRF24L01-CONFIG@ ( -- n ) NRF24L01-CONFIG C@ ;
: NRF24L01-CONFIG! ( n -- ) NRF24L01-CONFIG C! ;
: NRF24L01-CONFIG-PWR_UP@ ( -- flag ) NRF24L01-CONFIG@ 1 BIT@ ;
: NRF24L01-CONFIG-PWR_UP! ( flag -- ) NRF24L01-CONFIG@ 1 BIT! NRF24L01-CONFIG! ;
: NRF24L01-CONFIG-PRIM_RX@ ( -- flag ) NRF24L01-CONFIG@ 0 BIT@ ;
: NRF24L01-CONFIG-PRIM_RX! ( flag -- ) NRF24L01-CONFIG@ 0 BIT! NRF24L01-CONFIG! ;
: NRF24L01-EN_AA@ ( -- n ) NRF24L01-EN_AA C@ ;
: NRF24L01-EN_AA! ( n -- ) NRF24L01-EN_AA C! ;
: NRF24L01-EN_RXADDR@ ( -- n ) NRF24L01-EN_RXADDR C@ ;
: NRF24L01-EN_RXADDR! ( n -- ) NRF24L01-EN_RXADDR C! ;
: NRF24L01-SETUP_AW@ ( -- n ) NRF24L01-SETUP_AW C@ ;
: NRF24L01-SETUP_AW! ( n -- ) NRF24L01-SETUP_AW C! ;
: NRF24L01-SETUP_RETR@ ( -- n ) NRF24L01-SETUP_RETR C@ ;
: NRF24L01-SETUP_RETR! ( n -- ) NRF24L01-SETUP_RETR C! ;
: NRF24L01-RF_CH@ ( -- n ) NRF24L01-RF_CH C@ ;
: NRF24L01-RF_CH! ( n -- ) NRF24L01-RF_CH C! ;
: NRF24L01-RF_SETUP@ ( -- n ) NRF24L01-RF_SETUP C@ ;
: NRF24L01-RF_SETUP! ( n -- ) NRF24L01-RF_SETUP C! ;
: NRF24L01-RF_SETUP-RF_PWR@ ( -- flag ) NRF24L01-RF_SETUP@ 1 BIT@ ;
: NRF24L01-RF_SETUP-RF_PWR! ( flag -- ) NRF24L01-RF_SETUP@ 1 BIT! NRF24L01-RF_SETUP! ;
: NRF24L01-RF_SETUP-RF_DR@ ( -- flag ) NRF24L01-RF_SETUP@ 3 BIT@ ;
: NRF24L01-RF_SETUP-RF_DR! ( flag -- ) NRF24L01-RF_SETUP@ 3 BIT! NRF24L01-RF_SETUP! ;
: NRF24L01-STATUS@ ( -- n ) NRF24L01-STATUS C@ ;
: NRF24L01-STATUS! ( n -- ) NRF24L01-STATUS C! ;
: NRF24L01-RX_PW_P0@ ( -- n ) NRF24L01-RX_PW_P0 C@ ;
: NRF24L01-RX_PW_P0! ( n -- ) NRF24L01-RX_PW_P0 C! ;
: NRF24L01-FIFO_STATUS@ ( -- n ) NRF24L01-FIFO_STATUS C@ ;
: NRF24L01-FIFO_STATUS! ( n -- ) NRF24L01-FIFO_STATUS C! ;
: NRF24L01-TX_PAYLOAD@ ( -- n ) NRF24L01-TX_PAYLOAD  32 CHARS@ ;
: NRF24L01-TX_PAYLOAD! ( n -- ) NRF24L01-TX_PAYLOAD  32 CHARS! ;
: NRF24L01-RX_PAYLOAD@ ( -- n ) NRF24L01-RX_PAYLOAD  32 CHARS@ ;
: NRF24L01-RX_PAYLOAD! ( n -- ) NRF24L01-RX_PAYLOAD  32 CHARS! ;

\ =========================================
\ 设备初始化
\ =========================================

: NRF24L01-INIT ( -- )
  \ 初始化NRF24L01设备
  ." 初始化NRF24L01..." CR


  \ 初始化外设
  \ 初始化NRF24L01
  0 NRF24L01-CONFIG!  \ CONFIG寄存器
  0 NRF24L01-EN_AA!  \ EN_AA寄存器
  0 NRF24L01-EN_RXADDR!  \ EN_RXADDR寄存器
  0 NRF24L01-SETUP_AW!  \ SETUP_AW寄存器
  0 NRF24L01-SETUP_RETR!  \ SETUP_RETR寄存器
  0 NRF24L01-RF_CH!  \ RF_CH寄存器
  0 NRF24L01-RF_SETUP!  \ RF_SETUP寄存器
  0 NRF24L01-STATUS!  \ STATUS寄存器
  0 NRF24L01-RX_PW_P0!  \ RX_PW_P0寄存器
  0 NRF24L01-FIFO_STATUS!  \ FIFO_STATUS寄存器
  0 NRF24L01-TX_PAYLOAD!  \ TX_PAYLOAD寄存器
  0 NRF24L01-RX_PAYLOAD!  \ RX_PAYLOAD寄存器

  ." NRF24L01初始化完成" CR
;

\ =========================================
\ 设备信息显示
\ =========================================

: .DEVICE-INFO ( -- )
  CR
  ." 设备: " DEVICE-NAME TYPE CR
  ." 厂商: " MANUFACTURER TYPE CR
  ." 系列: " FAMILY TYPE CR
  ." 版本: " VERSION TYPE CR
  ." 架构: " ARCHITECTURE TYPE CR
  ." 位宽: " BITS . CR
  ." 时钟: " CLOCK-FREQ . ." Hz" CR
;

\ =========================================
\ 示例程序
\ =========================================

: EXAMPLE ( -- )
  NRF24L01-INIT
  .DEVICE-INFO
  .REGISTERS
  CR ." 示例程序运行完成" CR
;

\ 自动运行示例
( EXAMPLE )
