\ 设备信息
: DEVICE-NAME   S" Ricoh-5A22" ;
: MANUFACTURER  S" Ricoh" ;
: FAMILY        S" MOS-6502" ;
: VERSION       S" 1.0" ;
: ARCHITECTURE  S" Ricoh-5A22" ;
16 CONSTANT BITS
3580000 CONSTANT CLOCK-FREQ

\ 寄存器地址定义
0x00 CONSTANT A  \ Accumulator (8-bit, expandable to 16-bit)
0x01 CONSTANT B  \ Accumulator high byte when 16-bit
0x02 CONSTANT X  \ X Index Register (8/16-bit)
0x03 CONSTANT Y  \ Y Index Register (8/16-bit)
0x04 CONSTANT SP  \ Stack Pointer (8-bit, banked)
0x06 CONSTANT PC  \ Program Counter (16-bit)
0x08 CONSTANT D  \ Direct Page Register
0x0A CONSTANT P  \ Processor Status
0 CONSTANT P-N  \ Negative
1 CONSTANT P-V  \ Overflow
2 CONSTANT P-M  \ Memory/Accumulator Select (0=16-bit, 1=8-bit)
3 CONSTANT P-X  \ Index Select (0=16-bit, 1=8-bit)
4 CONSTANT P-B  \ Break
5 CONSTANT P-D  \ Decimal Mode
6 CONSTANT P-I  \ Interrupt Disable
7 CONSTANT P-Z  \ Zero
8 CONSTANT P-C  \ Carry

