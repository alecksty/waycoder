\ 寄存器访问字
\ =========================================

\ 通用寄存器访问
: A@ ( -- n ) A C@ ;
: A! ( n -- ) A C! ;

: B@ ( -- n ) B C@ ;
: B! ( n -- ) B C! ;

: X@ ( -- n ) X C@ ;
: X! ( n -- ) X C! ;

: Y@ ( -- n ) Y C@ ;
: Y! ( n -- ) Y C! ;

: SP@ ( -- n ) SP C@ ;
: SP! ( n -- ) SP C! ;

: PC@ ( -- n ) PC @ ;
: PC! ( n -- ) PC ! ;

: D@ ( -- n ) D C@ ;
: D! ( n -- ) D C! ;

: P@ ( -- n ) P C@ ;
: P! ( n -- ) P C! ;
: P-N@ ( -- flag ) P@ 0 BIT@ ;
: P-N! ( flag -- ) P@ 0 BIT! P! ;
: P-N-SET ( -- ) TRUE P-N! ;
: P-N-CLR ( -- ) FALSE P-N! ;
: P-V@ ( -- flag ) P@ 1 BIT@ ;
: P-V! ( flag -- ) P@ 1 BIT! P! ;
: P-V-SET ( -- ) TRUE P-V! ;
: P-V-CLR ( -- ) FALSE P-V! ;
: P-M@ ( -- flag ) P@ 2 BIT@ ;
: P-M! ( flag -- ) P@ 2 BIT! P! ;
: P-M-SET ( -- ) TRUE P-M! ;
: P-M-CLR ( -- ) FALSE P-M! ;
: P-X@ ( -- flag ) P@ 3 BIT@ ;
: P-X! ( flag -- ) P@ 3 BIT! P! ;
: P-X-SET ( -- ) TRUE P-X! ;
: P-X-CLR ( -- ) FALSE P-X! ;
: P-B@ ( -- flag ) P@ 4 BIT@ ;
: P-B! ( flag -- ) P@ 4 BIT! P! ;
: P-B-SET ( -- ) TRUE P-B! ;
: P-B-CLR ( -- ) FALSE P-B! ;
: P-D@ ( -- flag ) P@ 5 BIT@ ;
: P-D! ( flag -- ) P@ 5 BIT! P! ;
: P-D-SET ( -- ) TRUE P-D! ;
: P-D-CLR ( -- ) FALSE P-D! ;
: P-I@ ( -- flag ) P@ 6 BIT@ ;
: P-I! ( flag -- ) P@ 6 BIT! P! ;
: P-I-SET ( -- ) TRUE P-I! ;
: P-I-CLR ( -- ) FALSE P-I! ;
: P-Z@ ( -- flag ) P@ 7 BIT@ ;
: P-Z! ( flag -- ) P@ 7 BIT! P! ;
: P-Z-SET ( -- ) TRUE P-Z! ;
: P-Z-CLR ( -- ) FALSE P-Z! ;
: P-C@ ( -- flag ) P@ 8 BIT@ ;
: P-C! ( flag -- ) P@ 8 BIT! P! ;
: P-C-SET ( -- ) TRUE P-C! ;
: P-C-CLR ( -- ) FALSE P-C! ;

