: INTERRUPT-MI_VERSION@ ( -- n ) INTERRUPT-MI_VERSION L@ ;
: INTERRUPT-MI_VERSION! ( n -- ) INTERRUPT-MI_VERSION L! ;
: INTERRUPT-MI_INTR@ ( -- n ) INTERRUPT-MI_INTR L@ ;
: INTERRUPT-MI_INTR! ( n -- ) INTERRUPT-MI_INTR L! ;
: INTERRUPT-MI_INTR-SP@ ( -- flag ) INTERRUPT-MI_INTR@ 0 BIT@ ;
: INTERRUPT-MI_INTR-SP! ( flag -- ) INTERRUPT-MI_INTR@ 0 BIT! INTERRUPT-MI_INTR! ;
: INTERRUPT-MI_INTR-SI@ ( -- flag ) INTERRUPT-MI_INTR@ 1 BIT@ ;
: INTERRUPT-MI_INTR-SI! ( flag -- ) INTERRUPT-MI_INTR@ 1 BIT! INTERRUPT-MI_INTR! ;
: INTERRUPT-MI_INTR-AI@ ( -- flag ) INTERRUPT-MI_INTR@ 2 BIT@ ;
: INTERRUPT-MI_INTR-AI! ( flag -- ) INTERRUPT-MI_INTR@ 2 BIT! INTERRUPT-MI_INTR! ;
: INTERRUPT-MI_INTR-VI@ ( -- flag ) INTERRUPT-MI_INTR@ 3 BIT@ ;
: INTERRUPT-MI_INTR-VI! ( flag -- ) INTERRUPT-MI_INTR@ 3 BIT! INTERRUPT-MI_INTR! ;
: INTERRUPT-MI_INTR-PI@ ( -- flag ) INTERRUPT-MI_INTR@ 4 BIT@ ;
: INTERRUPT-MI_INTR-PI! ( flag -- ) INTERRUPT-MI_INTR@ 4 BIT! INTERRUPT-MI_INTR! ;
: INTERRUPT-MI_INTR-DP@ ( -- flag ) INTERRUPT-MI_INTR@ 5 BIT@ ;
: INTERRUPT-MI_INTR-DP! ( flag -- ) INTERRUPT-MI_INTR@ 5 BIT! INTERRUPT-MI_INTR! ;
: INTERRUPT-MI_INTR_MASK@ ( -- n ) INTERRUPT-MI_INTR_MASK L@ ;
: INTERRUPT-MI_INTR_MASK! ( n -- ) INTERRUPT-MI_INTR_MASK L! ;
: INTERRUPT-MI_INTR_MASK-SP_MASK@ ( -- flag ) INTERRUPT-MI_INTR_MASK@ 0 BIT@ ;
: INTERRUPT-MI_INTR_MASK-SP_MASK! ( flag -- ) INTERRUPT-MI_INTR_MASK@ 0 BIT! INTERRUPT-MI_INTR_MASK! ;
: INTERRUPT-MI_INTR_MASK-SI_MASK@ ( -- flag ) INTERRUPT-MI_INTR_MASK@ 1 BIT@ ;
: INTERRUPT-MI_INTR_MASK-SI_MASK! ( flag -- ) INTERRUPT-MI_INTR_MASK@ 1 BIT! INTERRUPT-MI_INTR_MASK! ;
: INTERRUPT-MI_INTR_MASK-AI_MASK@ ( -- flag ) INTERRUPT-MI_INTR_MASK@ 2 BIT@ ;
: INTERRUPT-MI_INTR_MASK-AI_MASK! ( flag -- ) INTERRUPT-MI_INTR_MASK@ 2 BIT! INTERRUPT-MI_INTR_MASK! ;
: INTERRUPT-MI_INTR_MASK-VI_MASK@ ( -- flag ) INTERRUPT-MI_INTR_MASK@ 3 BIT@ ;
: INTERRUPT-MI_INTR_MASK-VI_MASK! ( flag -- ) INTERRUPT-MI_INTR_MASK@ 3 BIT! INTERRUPT-MI_INTR_MASK! ;
: INTERRUPT-MI_INTR_MASK-PI_MASK@ ( -- flag ) INTERRUPT-MI_INTR_MASK@ 4 BIT@ ;
: INTERRUPT-MI_INTR_MASK-PI_MASK! ( flag -- ) INTERRUPT-MI_INTR_MASK@ 4 BIT! INTERRUPT-MI_INTR_MASK! ;
: INTERRUPT-MI_INTR_MASK-DP_MASK@ ( -- flag ) INTERRUPT-MI_INTR_MASK@ 5 BIT@ ;
: INTERRUPT-MI_INTR_MASK-DP_MASK! ( flag -- ) INTERRUPT-MI_INTR_MASK@ 5 BIT! INTERRUPT-MI_INTR_MASK! ;

\ CONTROLLER外设
: CONTROLLER-SI_CH0_DATA@ ( -- n ) CONTROLLER-SI_CH0_DATA XL@ ;
: CONTROLLER-SI_CH0_DATA! ( n -- ) CONTROLLER-SI_CH0_DATA XL! ;
: CONTROLLER-SI_CH1_DATA@ ( -- n ) CONTROLLER-SI_CH1_DATA XL@ ;
: CONTROLLER-SI_CH1_DATA! ( n -- ) CONTROLLER-SI_CH1_DATA XL! ;
: CONTROLLER-SI_CH2_DATA@ ( -- n ) CONTROLLER-SI_CH2_DATA XL@ ;
: CONTROLLER-SI_CH2_DATA! ( n -- ) CONTROLLER-SI_CH2_DATA XL! ;
: CONTROLLER-SI_CH3_DATA@ ( -- n ) CONTROLLER-SI_CH3_DATA XL@ ;
: CONTROLLER-SI_CH3_DATA! ( n -- ) CONTROLLER-SI_CH3_DATA XL! ;

\ =========================================
\ 设备初始化
\ =========================================

: NEC_VR4300-INIT ( -- )
  \ 初始化NEC-VR4300设备
  ." 初始化NEC-VR4300..." CR

  \ 初始化寄存器
  0 R0!  \ Hard-wired Zero
  0 R1!  \ Assembler Temporary
  0 R2!  \ Value Return
  0 R3!  \ Expression Evaluation
  0 R4!  \ Expression Evaluation
  0 R5!  \ Expression Evaluation
  0 R6!  \ Expression Evaluation
  0 R7!  \ Expression Evaluation
  0 R8!  \ Expression Evaluation
  0 R9!  \ Expression Evaluation
  0 R10!  \ Expression Evaluation
  0 R11!  \ Expression Evaluation
  0 R12!  \ Expression Evaluation
  0 R13!  \ Expression Evaluation
  0 R14!  \ Expression Evaluation
  0 R15!  \ Expression Evaluation
  0 R16!  \ Saved Value
  0 R17!  \ Saved Value
  0 R18!  \ Saved Value
  0 R19!  \ Saved Value
  0 R20!  \ Saved Value
  0 R21!  \ Saved Value
  0 R22!  \ Saved Value
  0 R23!  \ Saved Value
  0 R24!  \ Temporary
  0 R25!  \ Temporary
  0 R26!  \ Kernel Reserved
  0 R27!  \ Kernel Reserved
  0 R28!  \ Global Pointer
  0 R29!  \ Stack Pointer
  0 R30!  \ Frame Pointer
  0 R31!  \ Return Address
  0 HI!  \ Multiply/Divide High (64-bit)
  0 LO!  \ Multiply/Divide Low (64-bit)
  0 PC!  \ Program Counter
  0 LLB!  \ LLAddr / LLBit (for LL/SC)
  0 CP0_INDEX!  \ TLB Index
  0 CP0_RANDOM!  \ TLB Random
  0 CP0_ENTRYLO0!  \ TLB EntryLo 0 (even page)
  0 CP0_ENTRYLO1!  \ TLB EntryLo 1 (odd page)
  0 CP0_CONTEXT!  \ Context Register (PTE base)
  0 CP0_PAGEMASK!  \ Page Mask (variable page size)
  0 CP0_WIRED!  \ TLB Wired
  0 CP0_BADVADDR!  \ Bad Virtual Address
  0 CP0_COUNT!  \ Count (incrementing timer)
  0 CP0_ENTRYHI!  \ TLB EntryHi (VPN2 + ASID)
  0 CP0_COMPARE!  \ Compare (timer interrupt)
  0 CP0_STATUS!  \ Status Register
  0 CP0_CAUSE!  \ Cause Register
  0 CP0_EPC!  \ Exception PC
  0 CP0_CONFIG!  \ Config Register
  0 CP0_LLADDR!  \ Load Linked Address
  0 CP0_WATCHLO!  \ WatchLo (data/instruction break)
  0 CP0_WATCHHI!  \ WatchHi
  0 CP0_XCONTEXT!  \ Extended Context
  0 CP0_PID!  \ Tag/Process ID
  0 CP0_DEBUG!  \ Debug Register
  0 CP0_PERF!  \ Performance Counter

  \ 初始化外设
  \ 初始化RSP
  0 RSP-SP_MEM_ADDR!  \ SP_MEM_ADDR寄存器
  0 RSP-SP_DRAM_ADDR!  \ SP_DRAM_ADDR寄存器
  0 RSP-SP_RD_LEN!  \ SP_RD_LEN寄存器
  0 RSP-SP_WR_LEN!  \ SP_WR_LEN寄存器
  0 RSP-SP_STATUS!  \ SP_STATUS寄存器
  0 RSP-SP_DMA_FULL!  \ SP_DMA_FULL寄存器
  0 RSP-SP_DMA_BUSY!  \ SP_DMA_BUSY寄存器
  0 RSP-SP_SEMAPHORE!  \ SP_SEMAPHORE寄存器
  0 RSP-SP_PC!  \ SP_PC寄存器
  0 RSP-SP_IBIST!  \ SP_IBIST寄存器
  \ 初始化RDP
  0 RDP-DP_START!  \ DP_START寄存器
  0 RDP-DP_END!  \ DP_END寄存器
  0 RDP-DP_CURRENT!  \ DP_CURRENT寄存器
  0 RDP-DP_STATUS!  \ DP_STATUS寄存器
  0 RDP-DP_CLOCK!  \ DP_CLOCK寄存器
  0 RDP-DP_BUFBUSY!  \ DP_BUFBUSY寄存器
  0 RDP-DP_PIPEBUSY!  \ DP_PIPEBUSY寄存器
  0 RDP-DP_TMEM!  \ DP_TMEM寄存器
  \ 初始化VI
  0 VI-VI_STATUS!  \ VI_STATUS寄存器
  0 VI-VI_ORIGIN!  \ VI_ORIGIN寄存器
  0 VI-VI_WIDTH!  \ VI_WIDTH寄存器
  0 VI-VI_V_INTR!  \ VI_V_INTR寄存器
  0 VI-VI_V_CURRENT!  \ VI_V_CURRENT寄存器
  0 VI-VI_BURST!  \ VI_BURST寄存器
  0 VI-VI_H_SYNC!  \ VI_H_SYNC寄存器
  0 VI-VI_H_SYNC_LEAP!  \ VI_H_SYNC_LEAP寄存器
  0 VI-VI_H_VIDEO!  \ VI_H_VIDEO寄存器
  0 VI-VI_V_VIDEO!  \ VI_V_VIDEO寄存器
  0 VI-VI_V_BURST!  \ VI_V_BURST寄存器
  0 VI-VI_X_SCALE!  \ VI_X_SCALE寄存器
  0 VI-VI_Y_SCALE!  \ VI_Y_SCALE寄存器
  \ 初始化AI
  0 AI-AI_DRAM_ADDR!  \ AI_DRAM_ADDR寄存器
  0 AI-AI_LEN!  \ AI_LEN寄存器
  0 AI-AI_CONTROL!  \ AI_CONTROL寄存器
  0 AI-AI_STATUS!  \ AI_STATUS寄存器
  0 AI-AI_DACRATE!  \ AI_DACRATE寄存器
  0 AI-AI_BITRATE!  \ AI_BITRATE寄存器
  \ 初始化PI
  0 PI-PI_DRAM_ADDR!  \ PI_DRAM_ADDR寄存器
  0 PI-PI_CART_ADDR!  \ PI_CART_ADDR寄存器
  0 PI-PI_RD_LEN!  \ PI_RD_LEN寄存器
  0 PI-PI_WR_LEN!  \ PI_WR_LEN寄存器
  0 PI-PI_STATUS!  \ PI_STATUS寄存器
  0 PI-PI_BSD_DOM1_LAT!  \ PI_BSD_DOM1_LAT寄存器
  0 PI-PI_BSD_DOM1_PWD!  \ PI_BSD_DOM1_PWD寄存器
  0 PI-PI_BSD_DOM1_PGS!  \ PI_BSD_DOM1_PGS寄存器
  0 PI-PI_BSD_DOM1_RLS!  \ PI_BSD_DOM1_RLS寄存器
  0 PI-PI_BSD_DOM2_LAT!  \ PI_BSD_DOM2_LAT寄存器
  0 PI-PI_BSD_DOM2_PWD!  \ PI_BSD_DOM2_PWD寄存器
  0 PI-PI_BSD_DOM2_PGS!  \ PI_BSD_DOM2_PGS寄存器
  0 PI-PI_BSD_DOM2_RLS!  \ PI_BSD_DOM2_RLS寄存器
  \ 初始化SI
  0 SI-SI_DRAM_ADDR!  \ SI_DRAM_ADDR寄存器
  0 SI-SI_PIF_ADDR_RD64B!  \ SI_PIF_ADDR_RD64B寄存器
  0 SI-SI_PIF_ADDR_WR64B!  \ SI_PIF_ADDR_WR64B寄存器
  0 SI-SI_STATUS!  \ SI_STATUS寄存器
  \ 初始化PIF
  0 PIF-PIF_CMD0!  \ PIF_CMD0寄存器
  0 PIF-PIF_CMD1!  \ PIF_CMD1寄存器
  0 PIF-PIF_CMD2!  \ PIF_CMD2寄存器
  0 PIF-PIF_CMD3!  \ PIF_CMD3寄存器
  0 PIF-PIF_CMD4!  \ PIF_CMD4寄存器
  0 PIF-PIF_CMD5!  \ PIF_CMD5寄存器
  0 PIF-PIF_CMD6!  \ PIF_CMD6寄存器
  0 PIF-PIF_CMD7!  \ PIF_CMD7寄存器
  0 PIF-PIF_STATUS!  \ PIF_STATUS寄存器
  \ 初始化INTERRUPT
  0 INTERRUPT-MI_MODE!  \ MI_MODE寄存器
  0 INTERRUPT-MI_VERSION!  \ MI_VERSION寄存器
  0 INTERRUPT-MI_INTR!  \ MI_INTR寄存器
  0 INTERRUPT-MI_INTR_MASK!  \ MI_INTR_MASK寄存器
  \ 初始化CONTROLLER
  0 CONTROLLER-SI_CH0_DATA!  \ SI_CH0_DATA寄存器
  0 CONTROLLER-SI_CH1_DATA!  \ SI_CH1_DATA寄存器
  0 CONTROLLER-SI_CH2_DATA!  \ SI_CH2_DATA寄存器
  0 CONTROLLER-SI_CH3_DATA!  \ SI_CH3_DATA寄存器

  ." NEC-VR4300初始化完成" CR
;

