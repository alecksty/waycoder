\ 设备信息
: DEVICE-NAME   S" NEC-VR4300" ;
: MANUFACTURER  S" NEC" ;
: FAMILY        S" MIPS-R4000" ;
: VERSION       S" 1.0" ;
: ARCHITECTURE  S" MIPS-R4300i" ;
64 CONSTANT BITS
93750000 CONSTANT CLOCK-FREQ

