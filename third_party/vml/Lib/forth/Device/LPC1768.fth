\ 寄存器访问字
\ =========================================

\ 通用寄存器访问
: R0@ ( -- n ) R0 L@ ;
: R0! ( n -- ) R0 L! ;

: R1@ ( -- n ) R1 L@ ;
: R1! ( n -- ) R1 L! ;

: R2@ ( -- n ) R2 L@ ;
: R2! ( n -- ) R2 L! ;

: R3@ ( -- n ) R3 L@ ;
: R3! ( n -- ) R3 L! ;

: R4@ ( -- n ) R4 L@ ;
: R4! ( n -- ) R4 L! ;

: R5@ ( -- n ) R5 L@ ;
: R5! ( n -- ) R5 L! ;

: R6@ ( -- n ) R6 L@ ;
: R6! ( n -- ) R6 L! ;

: R7@ ( -- n ) R7 L@ ;
: R7! ( n -- ) R7 L! ;

: R8@ ( -- n ) R8 L@ ;
: R8! ( n -- ) R8 L! ;

: R9@ ( -- n ) R9 L@ ;
: R9! ( n -- ) R9 L! ;

: R10@ ( -- n ) R10 L@ ;
: R10! ( n -- ) R10 L! ;

: R11@ ( -- n ) R11 L@ ;
: R11! ( n -- ) R11 L! ;

: R12@ ( -- n ) R12 L@ ;
: R12! ( n -- ) R12 L! ;

: SP@ ( -- n ) SP L@ ;
: SP! ( n -- ) SP L! ;

: LR@ ( -- n ) LR L@ ;
: LR! ( n -- ) LR L! ;

: PC@ ( -- n ) PC L@ ;
: PC! ( n -- ) PC L! ;

: PSR@ ( -- n ) PSR L@ ;
: PSR! ( n -- ) PSR L! ;
: PSR-N@ ( -- flag ) PSR@ 31 BIT@ ;
: PSR-N! ( flag -- ) PSR@ 31 BIT! PSR! ;
: PSR-N-SET ( -- ) TRUE PSR-N! ;
: PSR-N-CLR ( -- ) FALSE PSR-N! ;
: PSR-Z@ ( -- flag ) PSR@ 30 BIT@ ;
: PSR-Z! ( flag -- ) PSR@ 30 BIT! PSR! ;
: PSR-Z-SET ( -- ) TRUE PSR-Z! ;
: PSR-Z-CLR ( -- ) FALSE PSR-Z! ;
: PSR-C@ ( -- flag ) PSR@ 29 BIT@ ;
: PSR-C! ( flag -- ) PSR@ 29 BIT! PSR! ;
: PSR-C-SET ( -- ) TRUE PSR-C! ;
: PSR-C-CLR ( -- ) FALSE PSR-C! ;
: PSR-V@ ( -- flag ) PSR@ 28 BIT@ ;
: PSR-V! ( flag -- ) PSR@ 28 BIT! PSR! ;
: PSR-V-SET ( -- ) TRUE PSR-V! ;
: PSR-V-CLR ( -- ) FALSE PSR-V! ;
: PSR-Q@ ( -- flag ) PSR@ 27 BIT@ ;
: PSR-Q! ( flag -- ) PSR@ 27 BIT! PSR! ;
: PSR-Q-SET ( -- ) TRUE PSR-Q! ;
: PSR-Q-CLR ( -- ) FALSE PSR-Q! ;
: PSR-ICI1@ ( -- flag ) PSR@ 0 BIT@ ;
: PSR-ICI1! ( flag -- ) PSR@ 0 BIT! PSR! ;
: PSR-ICI1-SET ( -- ) TRUE PSR-ICI1! ;
: PSR-ICI1-CLR ( -- ) FALSE PSR-ICI1! ;
: PSR-GE@ ( -- flag ) PSR@ 0 BIT@ ;
: PSR-GE! ( flag -- ) PSR@ 0 BIT! PSR! ;
: PSR-GE-SET ( -- ) TRUE PSR-GE! ;
: PSR-GE-CLR ( -- ) FALSE PSR-GE! ;
: PSR-IT@ ( -- flag ) PSR@ 0 BIT@ ;
: PSR-IT! ( flag -- ) PSR@ 0 BIT! PSR! ;
: PSR-IT-SET ( -- ) TRUE PSR-IT! ;
