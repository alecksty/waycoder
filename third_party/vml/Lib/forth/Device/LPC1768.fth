  0 PINCONNECTBLOCK-PINSEL8!  \ PINSEL8寄存器
  0 PINCONNECTBLOCK-PINSEL9!  \ PINSEL9寄存器
  0 PINCONNECTBLOCK-PINMODE0!  \ PINMODE0寄存器
  0 PINCONNECTBLOCK-PINMODE1!  \ PINMODE1寄存器
  0 PINCONNECTBLOCK-PINMODE2!  \ PINMODE2寄存器
  0 PINCONNECTBLOCK-PINMODE3!  \ PINMODE3寄存器
  0 PINCONNECTBLOCK-PINMODE4!  \ PINMODE4寄存器
  0 PINCONNECTBLOCK-PINMODE5!  \ PINMODE5寄存器
  0 PINCONNECTBLOCK-PINMODE6!  \ PINMODE6寄存器
  0 PINCONNECTBLOCK-PINMODE7!  \ PINMODE7寄存器
  0 PINCONNECTBLOCK-PINMODE8!  \ PINMODE8寄存器
  0 PINCONNECTBLOCK-PINMODE9!  \ PINMODE9寄存器
  0 PINCONNECTBLOCK-PINOD0!  \ PINOD0寄存器
  0 PINCONNECTBLOCK-PINOD1!  \ PINOD1寄存器
  0 PINCONNECTBLOCK-PINOD2!  \ PINOD2寄存器
  0 PINCONNECTBLOCK-PINOD3!  \ PINOD3寄存器

  ." LPC1768初始化完成" CR
;

\ =========================================
\ 设备信息显示
\ =========================================

: .DEVICE-INFO ( -- )
  CR
  ." 设备: " DEVICE-NAME TYPE CR
  ." 厂商: " MANUFACTURER TYPE CR
  ." 系列: " FAMILY TYPE CR
  ." 版本: " VERSION TYPE CR
  ." 架构: " ARCHITECTURE TYPE CR
  ." 位宽: " BITS . CR
  ." 时钟: " CLOCK-FREQ . ." Hz" CR
;

: .REGISTERS ( -- )
  CR ." 寄存器状态:" CR
  ." ----------" CR
  R0@ R0 .R 8 .R SPACE ."  R0: " R0@ .
  R1@ R1 .R 8 .R SPACE ."  R1: " R1@ .
  R2@ R2 .R 8 .R SPACE ."  R2: " R2@ .
  R3@ R3 .R 8 .R SPACE ."  R3: " R3@ .
  R4@ R4 .R 8 .R SPACE ."  R4: " R4@ .
  R5@ R5 .R 8 .R SPACE ."  R5: " R5@ .
  R6@ R6 .R 8 .R SPACE ."  R6: " R6@ .
  R7@ R7 .R 8 .R SPACE ."  R7: " R7@ .
  R8@ R8 .R 8 .R SPACE ."  R8: " R8@ .
  R9@ R9 .R 8 .R SPACE ."  R9: " R9@ .
  R10@ R10 .R 8 .R SPACE ."  R10: " R10@ .
  R11@ R11 .R 8 .R SPACE ."  R11: " R11@ .
  R12@ R12 .R 8 .R SPACE ."  R12: " R12@ .
  SP@ SP .R 8 .R SPACE ."  SP: " SP@ .
  LR@ LR .R 8 .R SPACE ."  LR: " LR@ .
  PC@ PC .R 8 .R SPACE ."  PC: " PC@ .
  PSR@ PSR .R 8 .R SPACE ."  PSR: " PSR@ .
  PRIMASK@ PRIMASK .R 8 .R SPACE ."  PRIMASK: " PRIMASK@ .
  FAULTMASK@ FAULTMASK .R 8 .R SPACE ."  FAULTMASK: " FAULTMASK@ .
  BASEPRI@ BASEPRI .R 8 .R SPACE ."  BASEPRI: " BASEPRI@ .
  CONTROL@ CONTROL .R 8 .R SPACE ."  CONTROL: " CONTROL@ .
;

