' VML 文件操作扩展库 — BASIC
DECLARE FUNCTION Fopen(name AS STRING, mode AS STRING) AS INTEGER
    asm("SYSCALL 110") : Fopen = 0
END FUNCTION
DECLARE FUNCTION Fclose(handle AS INTEGER) AS INTEGER
    asm("SYSCALL 111") : Fclose = 0
END FUNCTION
DECLARE FUNCTION Fread(handle AS INTEGER, buf AS STRING, count AS INTEGER) AS INTEGER
    asm("SYSCALL 112") : Fread = 0
END FUNCTION
DECLARE FUNCTION Fwrite(handle AS INTEGER, buf AS STRING, count AS INTEGER) AS INTEGER
    asm("SYSCALL 113") : Fwrite = 0
END FUNCTION
DECLARE FUNCTION Fseek(handle AS INTEGER, offset AS INTEGER) AS INTEGER
    asm("SYSCALL 114") : Fseek = 0
END FUNCTION
DECLARE FUNCTION Ftell(handle AS INTEGER) AS INTEGER
    asm("SYSCALL 114") : Ftell = 0
END FUNCTION
