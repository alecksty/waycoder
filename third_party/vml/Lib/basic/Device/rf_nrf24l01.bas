CONST NRF24L01_BASE = 0x00
CONST NRF24L01_CONFIG = 0x00
CONST NRF24L01_CONFIG_PWR_UP = 1  ' Power up (1=on)
CONST NRF24L01_CONFIG_PRIM_RX = 0  ' Primary RX mode (1=RX, 0=TX)
CONST NRF24L01_EN_AA = 0x01
CONST NRF24L01_EN_RXADDR = 0x02
CONST NRF24L01_SETUP_AW = 0x03
CONST NRF24L01_SETUP_RETR = 0x04
CONST NRF24L01_RF_CH = 0x05
CONST NRF24L01_RF_SETUP = 0x06
CONST NRF24L01_RF_SETUP_RF_PWR = 1  ' TX power: 00=-18dBm,01=-12dBm,10=-6dBm,11=0dBm
CONST NRF24L01_RF_SETUP_RF_DR = 3  ' Data rate: 0=1Mbps,1=2Mbps
CONST NRF24L01_STATUS = 0x07
CONST NRF24L01_RX_PW_P0 = 0x11
CONST NRF24L01_FIFO_STATUS = 0x17
CONST NRF24L01_TX_PAYLOAD = 0xA0
CONST NRF24L01_RX_PAYLOAD = 0x61

' 设备初始化子程序
SUB nrf24l01_init()
    ' 初始化代码
END SUB

' 常用函数
FUNCTION read_register(addr AS INTEGER) AS INTEGER
    ' 读取寄存器值
    RETURN PEEK(addr)
END FUNCTION

SUB write_register(addr AS INTEGER, value AS INTEGER)
    ' 写入寄存器值
    POKE addr, value
END SUB
