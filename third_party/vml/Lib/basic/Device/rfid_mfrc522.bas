' 内存段定义
' 64-byte FIFO buffer
CONST FIFO_START = 0x00
CONST FIFO_END = 0x3F
CONST FIFO_SIZE = 64

' 外设定义
' MFRC522 NFC Reader (SPI, 3.3V, 13.56MHz)
CONST MFRC522_BASE = 0x00
CONST MFRC522_CMD = 0x01
CONST MFRC522_COM_IRQ = 0x04
CONST MFRC522_COM_IRQ_TX_IRQ = 6  ' Transmitter interrupt
CONST MFRC522_COM_IRQ_RX_IRQ = 5  ' Receiver interrupt
CONST MFRC522_COM_IRQ_IDLE_IRQ = 4  ' Idle interrupt
CONST MFRC522_COM_IRQ_TIMER_IRQ = 0  ' Timer interrupt
CONST MFRC522_COM_IRQ_EN = 0x05
CONST MFRC522_ERROR = 0x06
CONST MFRC522_STATUS2 = 0x08
CONST MFRC522_FIFO_DATA = 0x09
CONST MFRC522_FIFO_LEVEL = 0x0A
CONST MFRC522_TX_CTRL = 0x14
CONST MFRC522_TX_ASK = 0x15
CONST MFRC522_MODE = 0x11
CONST MFRC522_VERSION = 0x37

' 设备初始化子程序
SUB mfrc522_init()
    ' 初始化代码
END SUB

' 常用函数
FUNCTION read_register(addr AS INTEGER) AS INTEGER
    ' 读取寄存器值
    RETURN PEEK(addr)
END FUNCTION

SUB write_register(addr AS INTEGER, value AS INTEGER)
    ' 写入寄存器值
    POKE addr, value
END SUB
