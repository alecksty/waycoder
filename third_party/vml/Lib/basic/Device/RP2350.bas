' RP2350寄存器定义
' 生成自: Raspberry/RP2/RP2350
' 版本: 1.0
' 日期: 2026-04-28
' 作者: VML Team
' 描述: Dual Cortex-M33 + RISC-V Hazard3 MCU with 520KB SRAM, 150MHz

' CPU架构: ARM-Cortex-M33
' 位宽: 32位
' 时钟频率: 150000000 Hz

' 寄存器定义
CONST R0 = 0x00

CONST R1 = 0x04

CONST R2 = 0x08

CONST R3 = 0x0C

CONST R4 = 0x10

CONST R5 = 0x14

CONST SP = 0x34

CONST LR = 0x38

CONST PC = 0x3C

' 内存段定义
' XIP Flash
CONST FLASH_START = 0x10000000
CONST FLASH_END = 0x107FFFFF
CONST FLASH_SIZE = 8388608

' Total SRAM
CONST SRAM_START = 0x20000000
CONST SRAM_END = 0x20081FFF
CONST SRAM_SIZE = 532480

CONST PERIPHERAL_START = 0x40000000
CONST PERIPHERAL_END = 0x5000FFFF
CONST PERIPHERAL_SIZE = 16777216

' 外设定义
' Single-Cycle I/O (GPIO)
CONST SIO_BASE = 0xD0000000
CONST SIO_GPIO_IN = 0x004
CONST SIO_GPIO_OUT = 0x010
CONST SIO_GPIO_OUT_SET = 0x014
CONST SIO_GPIO_OUT_CLR = 0x018
CONST SIO_GPIO_OUT_XOR = 0x01C
CONST SIO_GPIO_OE = 0x020
CONST SIO_GPIO_OE_SET = 0x024
CONST SIO_GPIO_OE_CLR = 0x028

' IO Bank 0 (GPIO control)
CONST IO_BANK0_BASE = 0x40028000
CONST IO_BANK0_GPIO0_STATUS = 0x000
CONST IO_BANK0_GPIO0_CTRL = 0x004
CONST IO_BANK0_GPIO1_STATUS = 0x008
CONST IO_BANK0_GPIO1_CTRL = 0x00C

' Pad controls for GPIO 0-29
CONST PADS_BANK0_BASE = 0x4002C000
CONST PADS_BANK0_GPIO0 = 0x000
CONST PADS_BANK0_GPIO1 = 0x004

' Reset Controller
CONST RESETS_BASE = 0x4000C000
CONST RESETS_RESET = 0x000
CONST RESETS_RESET_DONE = 0x008

' 中断向量定义
CONST RESET_VECTOR = 0  ' 
CONST SVCALL_VECTOR = 11  ' 

' 设备初始化子程序
SUB rp2350_init()
    ' 初始化代码
END SUB

' 常用函数
FUNCTION read_register(addr AS INTEGER) AS INTEGER
    ' 读取寄存器值
    RETURN PEEK(addr)
END FUNCTION

SUB write_register(addr AS INTEGER, value AS INTEGER)
    ' 写入寄存器值
    POKE addr, value
END SUB
