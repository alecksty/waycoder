' VGA 8x16 Font Library
' Usage: INCLUDE "font8x16.bas"
'
' Font data loaded at FONT_BASE (default &H5000)
' Call FontLoad to initialize font data from DATA statements
'
' After FontLoad:
'   Font bitmap for ASCII character C is at FONT_BASE + (C-32) * 16
'   Each character is 16 bytes, 8x16 pixels, 1 bit per pixel
'   MSB of each byte = leftmost pixel

DIM FONT_BASE
FONT_BASE = &H5000

' Initialize font: READ DATA into memory
FontInit:
    RESTORE FontData
    I = 0
    WHILE I < 95 * 16
        READ D
        POKE FONT_BASE + I, D
        I = I + 1
    WEND
    RETURN

' Draw character at (X, Y) with color C
' CHR$ = the character to draw
' Uses the current font data at FONT_BASE
FontDrawChar:
    CI = CH - 32
    IF CI < 0 THEN CI = 0
    IF CI > 94 THEN CI = 94
    BA = FONT_BASE + CI * 16
    ROW = 0
    WHILE ROW < 16
        PX = PEEK(BA + ROW)
        COL = 0
        WHILE COL < 8
            IF (PX AND (128 / (COL + 1))) <> 0 THEN
                PSET (X + COL, Y + ROW), C
            END IF
            COL = COL + 1
        WEND
        ROW = ROW + 1
    WEND
    RETURN

' Draw string at (X, Y) with color C
' S$ = the string to draw
FontDrawString:
    J = 1
    WHILE J <= LEN(S$)
        CH = ASC(MID$(S$, J, 1))
        XC = X + (J - 1) * 8
        GOSUB FontDrawChar
        J = J + 1
    WEND
    RETURN

