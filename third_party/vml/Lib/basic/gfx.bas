' VML VGA 图形扩展库 (QBASIC风格) — BASIC
' 需显式 import gfx

' === Basic VGA ===
DECLARE SUB VgaClear()
    asm("SYSCALL 80")
END SUB

DECLARE SUB VgaPutchar(x AS INTEGER, y AS INTEGER, c AS INTEGER, color AS INTEGER)
    asm("SYSCALL 81")
END SUB

DECLARE SUB VgaPuts(x AS INTEGER, y AS INTEGER, s AS STRING, color AS INTEGER)
    asm("SYSCALL 82")
END SUB

' === Screen Mode & Info ===
DECLARE FUNCTION GfxScreen(mode AS INTEGER) AS INTEGER
    asm("SYSCALL 81")  ' stub
    GfxScreen = 0
END FUNCTION

DECLARE FUNCTION GfxWidth() AS INTEGER
    GfxWidth = 0
END FUNCTION

DECLARE FUNCTION GfxHeight() AS INTEGER
    GfxHeight = 0
END FUNCTION

DECLARE FUNCTION GfxDepth() AS INTEGER
    GfxDepth = 0
END FUNCTION

' === Palette ===
DECLARE SUB GfxPalette(index AS INTEGER, r AS INTEGER, g AS INTEGER, b AS INTEGER)
END SUB

DECLARE FUNCTION GfxPaletteGet(index AS INTEGER) AS INTEGER
    GfxPaletteGet = 0
END FUNCTION

' === Pixel Ops ===
DECLARE SUB GfxPset(x AS INTEGER, y AS INTEGER, color AS INTEGER)
END SUB

DECLARE FUNCTION GfxPoint(x AS INTEGER, y AS INTEGER) AS INTEGER
    GfxPoint = 0
END FUNCTION

DECLARE SUB GfxCls()
END SUB

DECLARE SUB GfxClsColor(color AS INTEGER)
END SUB

' === Drawing Primitives ===
DECLARE SUB GfxLine(x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER, color AS INTEGER)
END SUB

DECLARE SUB GfxRect(x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER, color AS INTEGER)
END SUB

DECLARE SUB GfxRectFill(x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER, color AS INTEGER)
END SUB

DECLARE SUB GfxCircle(cx AS INTEGER, cy AS INTEGER, r AS INTEGER, color AS INTEGER)
END SUB

DECLARE SUB GfxCircleFill(cx AS INTEGER, cy AS INTEGER, r AS INTEGER, color AS INTEGER)
END SUB

DECLARE SUB GfxArc(cx AS INTEGER, cy AS INTEGER, r AS INTEGER, sa AS INTEGER, ea AS INTEGER, color AS INTEGER)
END SUB

DECLARE SUB GfxSector(cx AS INTEGER, cy AS INTEGER, r AS INTEGER, sa AS INTEGER, ea AS INTEGER, color AS INTEGER)
END SUB

' === Text (8x16 font) ===
DECLARE SUB GfxPrint(x AS INTEGER, y AS INTEGER, text AS STRING, color AS INTEGER)
END SUB

DECLARE SUB GfxPrintScale(x AS INTEGER, y AS INTEGER, text AS STRING, color AS INTEGER, scale AS INTEGER)
END SUB

' === Flood Fill ===
DECLARE SUB GfxFloodFill(x AS INTEGER, y AS INTEGER, fc AS INTEGER, bc AS INTEGER)
END SUB

' === Advanced Graphics (SYSCALL) ===
DECLARE FUNCTION GfxScreenshot() AS INTEGER
    asm("SYSCALL 200")
    GfxScreenshot = 0
END FUNCTION

DECLARE FUNCTION GfxPutImage(x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER, data AS STRING) AS INTEGER
    asm("SYSCALL 201")
    GfxPutImage = 0
END FUNCTION

DECLARE FUNCTION GfxGetImage(x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER, buffer AS STRING) AS INTEGER
    asm("SYSCALL 202")
    GfxGetImage = 0
END FUNCTION

DECLARE FUNCTION GfxViewport(x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER) AS INTEGER
    asm("SYSCALL 203")
    GfxViewport = 0
END FUNCTION
