        pop @R1
        shr @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R12+12]
        push @R0
        move @R0 #32
        push @R0
        move @R0 [@R12+16]
        pop @R1
        sub @R1 @R0
        move @R0 @R1
        pop @R1
        shl @R1 @R0
        move @R0 @R1
        pop @R1
        or @R1 @R0
        move @R0 @R1
        jmp L_47790007
L_47790007:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
bit_set:
; -------------------------------------------
; source   : int bit_set(int val,int bit)
; function : bit_set
; param   : int val
; param   : int bit
; return   : int
; --------------------------------------------
bit_set:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 46:     return val | (1 << bit);
        move @R0 [@R12+12]
        push @R0
        move @R0 #1
        push @R0
        move @R0 [@R12+16]
        pop @R1
        shl @R1 @R0
        move @R0 @R1
        pop @R1
        or @R1 @R0
        move @R0 @R1
        jmp L_47790008
L_47790008:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
bit_clear:
; -------------------------------------------
; source   : int bit_clear(int val,int bit)
; function : bit_clear
