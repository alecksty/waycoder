        pop @R1
        shl @R1 @R0
        move @R0 @R1
        not @R0
        pop @R1
        and @R1 @R0
        move @R0 @R1
        jmp L_47790009
L_47790009:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
