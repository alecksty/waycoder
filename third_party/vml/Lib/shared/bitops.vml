bit_test:
; -------------------------------------------:
; -------------------------------------------
; source   : int bit_test(int val,int bit)
; function : bit_test
; param   : int val
; param   : int bit
; return   : int
; --------------------------------------------
bit_test:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 61:     return (val >> bit) & 1;
        move @R0 [@R12+12]
        push @R0
        move @R0 [@R12+16]
        pop @R1
        shr @R1 @R0
        move @R0 @R1
        push @R0
