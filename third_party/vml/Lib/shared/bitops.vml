bit_and:
; -------------------------------------------
; source   : int bit_and(int a,int b)
; function : bit_and
; param   : int a
; param   : int b
; return   : int
; --------------------------------------------
bit_and:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 6:     return a & b;
        move @R0 [@R12+12]
        push @R0
        move @R0 [@R12+16]
        pop @R1
        and @R1 @R0
        move @R0 @R1
        jmp L_47790000
L_47790000:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
bit_or:
; -------------------------------------------
; source   : int bit_or(int a,int b)
