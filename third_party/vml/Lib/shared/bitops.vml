rol:
; -------------------------------------------
; source   : int rol(int val,int bits)
; function : rol
; param   : int val
; param   : int bits
; return   : int
; --------------------------------------------
rol:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 36:     return (val << bits) | ((val >> (32 - bits)));
        move @R0 [@R12+12]
        push @R0
        move @R0 [@R12+16]
        pop @R1
        shl @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R12+12]
        push @R0
        move @R0 #32
        push @R0
        move @R0 [@R12+16]
        pop @R1
        sub @R1 @R0
        move @R0 @R1
        pop @R1
        shr @R1 @R0
        move @R0 @R1
        pop @R1
        or @R1 @R0
        move @R0 @R1
        jmp L_47790006
L_47790006:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
ror:
; -------------------------------------------
; source   : int ror(int val,int bits)
