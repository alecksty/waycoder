        sub @R13 #16
; 11:     return a | b;
        move @R0 [@R12+12]
        push @R0
        move @R0 [@R12+16]
        pop @R1
        or @R1 @R0
        move @R0 @R1
        jmp L_47790001
L_47790001:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
