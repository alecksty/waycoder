        jmp L_47790002
L_47790002:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
bit_not:
; -------------------------------------------
; source   : int bit_not(int a)
; function : bit_not
; param   : int a
; return   : int
; --------------------------------------------
bit_not:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 21:     return ~a;
        move @R0 [@R12+12]
        not @R0
