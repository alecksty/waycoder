
.linked "array.vml"
.linked "math.vml"
.data
_bgi_color: .word 15
_bgi_bgcolor: .word 0
_bgi_fill_pattern: .word 1
_bgi_fill_color: .word 15
L_56300026: .string "VGA"
L_56300028: .string "640x480x16"
L_56300036: .string "OK"

.text
InitGraph:
; -------------------------------------------
; source   : void InitGraph(int* driver,int* mode,const char* path)
; function : InitGraph
; param   : int* driver
; param   : int* mode
; param   : const char* path
; return   : void
; --------------------------------------------
InitGraph:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #24
; 51:     int d = driver ? *driver : 0;
        move @R0 [@R12+12]
        test @R0 @R0
        jz _L56300000
        move @R0 [@R12+12]
        move @R0 [@R0]
        jmp _L56300001
_L56300000:
        move @R0 #0
_L56300001:
        move [@R12-8] @R0
; 52:     int m = mode ? *mode : 2;
        move @R0 [@R12+16]
        test @R0 @R0
        jz _L56300002
        move @R0 [@R12+16]
        move @R0 [@R0]
        jmp _L56300003
_L56300002:
        move @R0 #2
_L56300003:
        move [@R12-12] @R0
; 54:     int vga_mode = 12; // 默认 VGA 640x480x16
        move @R0 #12
        move [@R12-16] @R0
; 55:     if (d == 0) {
        move @R0 [@R12-8]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        je _L56300006
        move @R0 #0
        jmp _L56300007
_L56300006:
        move @R0 #1
_L56300007:
        cmp @R0 #0
        jz sta_56300004
; 57:         vga_mode = 12;
        move @R0 #12
        move [@R12-16] @R0
        jmp sta_56300005
sta_56300004:
; 58:     } else if (d == 9) {
        move @R0 [@R12-8]
        push @R0
        move @R0 #9
        pop @R1
        cmp @R1 @R0
        je _L56300010
        move @R0 #0
        jmp _L56300011
_L56300010:
        move @R0 #1
_L56300011:
        cmp @R0 #0
        jz sta_56300008
; 59:         if (m == 0)  vga_mode = 8;   // 640x200x16
        move @R0 [@R12-12]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        je _L56300014
        move @R0 #0
        jmp _L56300015
_L56300014:
        move @R0 #1
_L56300015:
        cmp @R0 #0
        jz sta_56300012
        move @R0 #8
        move [@R12-16] @R0
        jmp sta_56300013
sta_56300012:
; 60:         else if (m == 1) vga_mode = 9;  // 640x350x16
        move @R0 [@R12-12]
        push @R0
        move @R0 #1
        pop @R1
        cmp @R1 @R0
        je _L56300018
        move @R0 #0
        jmp _L56300019
_L56300018:
        move @R0 #1
_L56300019:
        cmp @R0 #0
        jz sta_56300016
        move @R0 #9
        move [@R12-16] @R0
        jmp sta_56300017
sta_56300016:
; 61:         else vga_mode = 12;  // 640x480x16
        move @R0 #12
        move [@R12-16] @R0
sta_56300017:
sta_56300013:
sta_56300008:
sta_56300009:
sta_56300005:
; 63:     gfx_screen(vga_mode);
        move @R0 [@R12-16]
        push @R0
        move @R0 [@R13+0]
        call gfx_screen
        add @R13 #4
; 64:     gfx_cls_color(_bgi_bgcolor);
        move @R0 [_bgi_bgcolor]
        push @R0
        move @R0 [@R13+0]
        call gfx_cls_color
        add @R13 #4
        move @R13 @R12
        pop @R12
        pop @R15
        ret
CloseGraph:
; -------------------------------------------
; source   : void CloseGraph()
; function : CloseGraph
; return   : void
; --------------------------------------------
CloseGraph:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 68:     gfx_screen(0);  // 返回文本模式
        move @R0 #0
        push @R0
        move @R0 [@R13+0]
        call gfx_screen
        add @R13 #4
        move @R13 @R12
        pop @R12
        pop @R15
        ret
