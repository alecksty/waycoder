ui_dlg_msg:
; -------------------------------------------
; source   : int ui_dlg_msg(char* title,char* body,int style)
; function : ui_dlg_msg
; param   : char* title
; param   : char* body
; param   : int style
; return   : int
; --------------------------------------------
ui_dlg_msg:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 34:     return asm("SYSCALL #500, ${title}, ${body}, ${style}");
        move @R0 [@R12+12]
        move @R1 [@R12+16]
        move @R2 [@R12+20]
        syscall #500
        move [@R12-4] @R0
        jmp L_2170000
L_2170000:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
