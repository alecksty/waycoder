ui_put_qb_bitmap:
; -------------------------------------------
; source   : void ui_put_qb_bitmap(int x,int y,int* arr,int* pal,int planes,int action)
; function : ui_put_qb_bitmap
; param   : int x
; param   : int y
; param   : int* arr
; param   : int* pal
; param   : int planes
; param   : int action
; return   : void
; --------------------------------------------
ui_put_qb_bitmap:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #72
; 246:     hdr = arr[0];
        move @R0 [@R12+20]
        push @R0
        move @R0 #0
        mul @R0 #4
        pop @R11
        add @R0 @R11
        move @R0 [@R0]
        move [@R12-8] @R0
; 247:     w = hdr & 65535;
        move @R0 [@R12-8]
        push @R0
        move @R0 #65535
        pop @R1
        and @R1 @R0
        move @R0 @R1
        move [@R12-12] @R0
; 248:     h = (hdr >> 16) & 65535;
        move @R0 [@R12-8]
        push @R0
        move @R0 #16
        pop @R1
        shr @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 #65535
        pop @R1
        and @R1 @R0
        move @R0 @R1
        move [@R12-16] @R0
; 249:     if (w <= 0 || h <= 0) return;
        move @R0 [@R12-12]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        jle _L2170028
        move @R0 #0
        jmp _L2170029
_L2170028:
