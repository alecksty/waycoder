_L49580009:
        cmp @R0 #0
        jz sta_49580006
        movel @R24 [@R12+12]
        movel @R24 [@R12+12]
        negl @R24 @R24
        movel [@R12+12] @R24
        move @R0 [@R12-8]
        move @R0 [@R12-8]
        neg @R0 @R0
        move [@R12-8] @R0
sta_49580006:
sta_49580007:
; 18:     if (b < 0) { b = -b; sign = -sign; }
        movel @R24 [@R12+20]
        pushl @R24
        move @R0 #0
        i2l @R24 @R0
        popl @R25
        cmpl @R25 @R24
        jl _L49580012
        move @R0 #0
        i2l @R24 @R0
        jmp _L49580013
_L49580012:
        move @R0 #1
        i2l @R24 @R0
_L49580013:
        cmp @R0 #0
        jz sta_49580010
        movel @R24 [@R12+20]
        movel @R24 [@R12+20]
        negl @R24 @R24
        movel [@R12+20] @R24
        move @R0 [@R12-8]
        move @R0 [@R12-8]
        neg @R0 @R0
        move [@R12-8] @R0
sta_49580010:
sta_49580011:
; 19:     long q = 0;
        move @R0 #0
        i2l @R24 @R0
        movel [@R12-16] @R24
; 21:     for (i = 0; i < 64; i++) { q <<= 1; if (a >= b) { a -= b; q |= 1; } a <<= 1; }
        move @R0 #0
        move [@R12-20] @R0
sta_49580014:
        move @R0 [@R12-20]
        push @R0
        move @R0 #64
        pop @R1
        cmp @R1 @R0
        jl _L49580017
        move @R0 #0
