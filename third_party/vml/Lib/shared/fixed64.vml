        jmp _L49580004
_L49580003:
        move @R0 #1
        i2l @R24 @R0
_L49580004:
        cmp @R0 #0
        jz sta_49580001
        move @R0 #0
        jmp L_49580005
sta_49580001:
sta_49580002:
; 16:     int sign = 1;
        move @R0 #1
        move [@R12-8] @R0
; 17:     if (a < 0) { a = -a; sign = -sign; }
        movel @R24 [@R12+12]
        pushl @R24
        move @R0 #0
        i2l @R24 @R0
        popl @R25
        cmpl @R25 @R24
        jl _L49580008
        move @R0 #0
        i2l @R24 @R0
        jmp _L49580009
