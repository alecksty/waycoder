        shll @R25 @R0
        movel @R24 @R25
        movel [@R12-16] @R24
        movel @R24 [@R12+12]
        pushl @R24
        movel @R24 [@R12+20]
        popl @R25
        cmpl @R25 @R24
        jge _L49580021
        move @R0 #0
        i2l @R24 @R0
        jmp _L49580022
_L49580021:
        move @R0 #1
        i2l @R24 @R0
_L49580022:
        cmp @R0 #0
        jz sta_49580019
        movel @R24 [@R12+12]
        pushl @R24
        movel @R24 [@R12+20]
        popl @R25
        subl @R24 @R25 @R24
        movel [@R12+12] @R24
        movel @R24 [@R12-16]
        pushl @R24
        move @R0 #1
        popl @R25
        orl @R25 @R24
        movel @R24 @R25
        movel [@R12-16] @R24
sta_49580019:
sta_49580020:
        movel @R24 [@R12+12]
        pushl @R24
        move @R0 #1
        popl @R25
        shll @R25 @R0
        movel @R24 @R25
        movel [@R12+12] @R24
sta_49580015:
        move @R0 [@R12-20]
        move @R1 @R0
        add @R0 @R0 #1
        move [@R12-20] @R0
        move @R0 @R1
        jmp sta_49580014
sta_49580016:
; 22:     return sign * q;
        move @R0 [@R12-8]
        i2l @R24 @R0
        pushl @R24
        movel @R24 [@R12-16]
        popl @R25
        mull @R24 @R25 @R24
        jmp L_49580005
L_49580005:
        move @R13 @R12
