lfixed_mul64:
; -------------------------------------------
; source   : long lfixed_mul64(long a,long b)
; function : lfixed_mul64
; param   : long a
; param   : long b
; return   : long
; --------------------------------------------
lfixed_mul64:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #64
; 6:     long ah = a >> 32, al = a & 0xFFFFFFFF;
        movel @R24 [@R12+12]
        pushl @R24
        move @R0 #32
        popl @R25
        shrl @R25 @R0
        movel @R24 @R25
        movel [@R12-12] @R24
        movel @R24 [@R12+12]
        pushl @R24
        move @R0 #-1
        popl @R25
        andl @R25 @R24
        movel @R24 @R25
        movel [@R12-20] @R24
; 7:     long bh = b >> 32, bl = b & 0xFFFFFFFF;
        movel @R24 [@R12+20]
        pushl @R24
        move @R0 #32
        popl @R25
        shrl @R25 @R0
        movel @R24 @R25
        movel [@R12-28] @R24
        movel @R24 [@R12+20]
        pushl @R24
        move @R0 #-1
        popl @R25
        andl @R25 @R24
        movel @R24 @R25
        movel [@R12-36] @R24
; 8:     long mid = ah * bl + al * bh;
        movel @R24 [@R12-12]
        pushl @R24
        movel @R24 [@R12-36]
        popl @R25
        mull @R24 @R25 @R24
        pushl @R24
        movel @R24 [@R12-20]
        pushl @R24
        movel @R24 [@R12-28]
        popl @R25
        mull @R24 @R25 @R24
        popl @R25
        addl @R24 @R25 @R24
        movel [@R12-44] @R24
; 9:     long result = ((ah * bh) << 32) + (unsigned long)(al * bl) >> 32 + mid;
        movel @R24 [@R12-12]
        pushl @R24
        movel @R24 [@R12-28]
        popl @R25
        mull @R24 @R25 @R24
        pushl @R24
        move @R0 #32
        popl @R25
        shll @R25 @R0
        movel @R24 @R25
        pushl @R24
        movel @R24 [@R12-20]
        pushl @R24
        movel @R24 [@R12-36]
        popl @R25
        mull @R24 @R25 @R24
        popl @R25
        addl @R24 @R25 @R24
        pushl @R24
        move @R0 #32
        i2l @R24 @R0
        pushl @R24
        movel @R24 [@R12-44]
        popl @R25
        addl @R24 @R25 @R24
        popl @R25
        shrul @R25 @R0
        movel @R24 @R25
        movel [@R12-52] @R24
; 10:     return result;
        movel @R24 [@R12-52]
        jmp L_49580000
L_49580000:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
lfixed_div64:
; -------------------------------------------
