        movel R0 [R12-20]
        pushl R0
        movel R0 [R12-28]
        popl R1
        mull R0 R1 R0
        popl R1
        addl R0 R1 R0
        movel [R12-44] R0
; 9:     long result = ((ah * bh) << 32) + (unsigned long)(al * bl) >> 32 + mid;
