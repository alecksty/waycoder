; return   : long
; --------------------------------------------
lfixed_from_double:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 38:     return (long)(f * (double)(1L << 32));
        moved @R16 [@R12+12]
        dpush @R16
        movel @R24 [i64_49580027]
        pushl @R24
        move @R0 #32
        popl @R25
        shll @R25 @R0
        movel @R24 @R25
        l2d @R16 @R24
        dpop @R17
