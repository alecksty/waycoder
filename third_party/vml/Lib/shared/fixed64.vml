; --------------------------------------------
lfixed_div64:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #32
; 14:     if (b == 0) return 0;
        movel @R24 [@R12+20]
        pushl @R24
        move @R0 #0
        i2l @R24 @R0
        popl @R25
        cmpl @R25 @R24
        je _L49580003
        move @R0 #0
