realloc:
; -------------------------------------------:
; -------------------------------------------
; source   : void* realloc(void* ptr,size_t size)
; function : realloc
; param   : void* ptr
; param   : size_t size
; return   : void*
; --------------------------------------------
realloc:
        push R15
        push R12
        move R12 R13
        sub R13 #12
        move [R12+12] R0
        move [R12+16] R1
        move R0 #0
        move [R12-4] R0
        asm "LOAD R0 #0"
        move R0 [R12-4]
        jmp L65840000
L65840000:
        move R13 R12
        pop R12
        pop R15
        ret
