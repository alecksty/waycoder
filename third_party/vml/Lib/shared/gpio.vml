__gpio_pinmode:
; -------------------------------------------
; source   : void __gpio_pinmode(int pin,int mode)
; function : __gpio_pinmode
; param   : int pin
; param   : int mode
; return   : void
; --------------------------------------------
__gpio_pinmode:
        push R15
        push R12
        move R12 R13
        sub R13 #16
        move R13 R12
        pop R12
        pop R15
        ret
