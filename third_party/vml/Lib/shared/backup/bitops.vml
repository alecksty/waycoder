; -------------------------------------------
; source   : int shared_bit_and(int a,int b)
; function : shared_bit_and
; param   : int a
; param   : int b
; return   : int
; --------------------------------------------
shared_bit_and:
        push R15
        push R12
        move R12 R13
        move R0 [R12+12]
        push R0
        move R0 [R12+16]
        pop R1
        and R1 R0
        move R0 R1
        jmp L47790000
L47790000:
        move R13 R12
        pop R12
        pop R15
        move R1 [R13]
        add R13 #12
        push R1
        ret
