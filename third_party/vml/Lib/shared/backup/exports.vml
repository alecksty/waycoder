.data

.text
__vml_exports:
; -------------------------------------------:
; -------------------------------------------
; source   : void __vml_exports()
; function : __vml_exports
; return   : void
; --------------------------------------------
__vml_exports:
        push R15
        push R12
        move R12 R13
        asm ".export puts shared_puts"
        asm ".export putchar shared_putchar"
        asm ".export getchar shared_getchar"
        asm ".export gets shared_gets"
        asm ".export printf shared_printf"
        asm ".export sprintf shared_sprintf"
        asm ".export snprintf shared_snprintf"
        asm ".export vsnprintf shared_vsnprintf"
        asm ".export fprintf shared_fprintf"
        asm ".export scanf shared_scanf"
        asm ".export sscanf shared_sscanf"
        asm ".export abs shared_abs"
        asm ".export min shared_min"
        asm ".export max shared_max"
        asm ".export sqrt shared_sqrt"
        asm ".export pow shared_pow"
        asm ".export clamp vml_clamp"
        asm ".export random shared_random"
        asm ".export strlen shared_str_strlen"
        asm ".export strcmp shared_str_strcmp"
        asm ".export strcpy shared_str_strcpy"
        asm ".export strcat shared_str_strcat"
        asm ".export strncmp shared_str_strncmp"
        asm ".export strchr shared_str_strchr"
        asm ".export malloc vml_alloc"
        asm ".export free vml_free"
        asm ".export atoi shared_atoi"
        asm ".export itoa shared_itoa"
        move R13 R12
        pop R12
        pop R15
        ret
