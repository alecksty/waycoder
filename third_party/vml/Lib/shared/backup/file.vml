shared_fopen:
; -------------------------------------------
; source   : int fopen(const char* path,int mode)
; function : fopen
; param   : const char* path
; param   : int mode
; return   : int
; --------------------------------------------
shared_fopen:
        push R15
        push R12
        move R12 R13
        sub R13 #12
        syscall #110
        move [R12-4] R0
        move R0 [R12-4]
        jmp L30360000
L30360000:
        move R13 R12
        pop R12
        pop R15
        move R1 [R13]
        add R13 #12
        push R1
        ret
shared_fclose:
; -------------------------------------------
; source   : int fclose(int handle)
; function : fclose
