shared_getconfig:
; -------------------------------------------
; source   : int getconfig(int type)
; function : getconfig
; param   : int type
; return   : int
; --------------------------------------------
shared_getconfig:
        push R15
        push R12
        move R12 R13
        asm "SYSCALL 60"
        move R0 #0
        jmp L98610000
L98610000:
        move R13 R12
        pop R12
        pop R15
        move R1 [R13]
        add R13 #8
        push R1
        ret
