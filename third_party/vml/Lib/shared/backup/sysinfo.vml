shared_srand:
; -------------------------------------------
; source   : void srand(int seed)
; function : srand
; param   : int seed
; return   : void
; --------------------------------------------
shared_srand:
        push R15
        push R12
        move R12 R13
        asm "SYSCALL 51"
        move R13 R12
        pop R12
        pop R15
        move R1 [R13]
        add R13 #8
        push R1
        ret
