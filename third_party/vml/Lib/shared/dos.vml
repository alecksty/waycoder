GetDate:
; -------------------------------------------
; source   : void GetDate(int* year,int* month,int* day,int* wday)
; function : GetDate
; param   : int* year
; param   : int* month
; param   : int* day
; param   : int* wday
; return   : void
; --------------------------------------------
GetDate:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 18:     int d = asm("SYSCALL #55");  // R0 = packed date
        syscall #55
        move [@R12-4] @R0
        move [@R12-8] @R0
; 19:     if (year)  *year  = (d >> 16) & 0xFFFF;
        move @R0 [@R12+12]
        cmp @R0 #0
        jz sta_96560000
        move @R0 [@R12+12]
        move @R11 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 #16
        pop @R1
        shr @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 #65535
        pop @R1
        and @R1 @R0
        move @R0 @R1
        move [@R11] @R0
sta_96560000:
sta_96560001:
; 20:     if (month) *month = (d >> 8) & 0xFF;
        move @R0 [@R12+16]
        cmp @R0 #0
        jz sta_96560002
        move @R0 [@R12+16]
        move @R10 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 #8
        pop @R1
        shr @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 #255
        pop @R1
        and @R1 @R0
        move @R0 @R1
        move [@R10] @R0
sta_96560002:
sta_96560003:
; 21:     if (day)   *day   = d & 0xFF;
        move @R0 [@R12+20]
        cmp @R0 #0
        jz sta_96560004
        move @R0 [@R12+20]
        move @R9 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 #255
        pop @R1
        and @R1 @R0
        move @R0 @R1
        move [@R9] @R0
sta_96560004:
sta_96560005:
; 22:     if (wday)  *wday  = 0;
        move @R0 [@R12+24]
        cmp @R0 #0
        jz sta_96560006
        move @R0 [@R12+24]
        move @R8 @R0
        move @R0 #0
        move [@R8] @R0
sta_96560006:
sta_96560007:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
GetTime:
; -------------------------------------------
; source   : void GetTime(int* hour,int* min,int* sec,int* msec)
; function : GetTime
; param   : int* hour
; param   : int* min
; param   : int* sec
; param   : int* msec
; return   : void
; --------------------------------------------
GetTime:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 25:     int t = asm("SYSCALL #56");  // R0 = packed time
        syscall #56
        move [@R12-4] @R0
        move [@R12-8] @R0
; 26:     if (hour) *hour = (t >> 16) & 0xFF;
        move @R0 [@R12+12]
        cmp @R0 #0
        jz sta_96560008
        move @R0 [@R12+12]
        move @R7 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 #16
        pop @R1
        shr @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 #255
        pop @R1
        and @R1 @R0
        move @R0 @R1
        move [@R7] @R0
sta_96560008:
sta_96560009:
; 27:     if (min)  *min  = (t >> 8) & 0xFF;
        move @R0 [@R12+16]
        cmp @R0 #0
        jz sta_96560010
        move @R0 [@R12+16]
        move @R6 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 #8
        pop @R1
        shr @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 #255
        pop @R1
        and @R1 @R0
        move @R0 @R1
        move [@R6] @R0
sta_96560010:
sta_96560011:
; 28:     if (sec)  *sec  = t & 0xFF;
        move @R0 [@R12+20]
        cmp @R0 #0
        jz sta_96560012
        move @R0 [@R12+20]
        move @R5 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 #255
        pop @R1
        and @R1 @R0
        move @R0 @R1
        move [@R5] @R0
sta_96560012:
sta_96560013:
; 29:     if (msec) *msec = 0;
        move @R0 [@R12+24]
        cmp @R0 #0
        jz sta_96560014
        move @R0 [@R12+24]
        move @R4 @R0
        move @R0 #0
        move [@R4] @R0
sta_96560014:
sta_96560015:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
