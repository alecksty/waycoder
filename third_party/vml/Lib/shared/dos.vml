        move @R0 [@R12+16]
        move @R6 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 #3
        pop @R1
        add @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R13+0]
        call atoi
        add @R13 #4
        move [@R6] @R0
sta_96560010:
sta_96560011:
; 32:     if (sec)  *sec  = atoi(s + 6);
        move @R0 [@R12+20]
        cmp @R0 #0
        jz sta_96560012
        move @R0 [@R12+20]
        move @R5 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 #6
        pop @R1
        add @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R13+0]
        call atoi
        add @R13 #4
        move [@R5] @R0
sta_96560012:
sta_96560013:
; 33:     if (msec) *msec = 0;                   /* 本平台不提供百分秒 */
        move @R0 [@R12+24]
        cmp @R0 #0
        jz sta_96560014
        move @R0 [@R12+24]
        move @R4 @R0
        move @R0 #0
        move [@R4] @R0
sta_96560014:
sta_96560015:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
sleep:
; -------------------------------------------
; source   : void sleep(unsigned seconds)
; function : sleep
; param   : unsigned seconds
; return   : void
; --------------------------------------------
sleep:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 42:     delay((int)seconds * 1000);
        move @R0 [@R12+12]
        push @R0
        move @R0 #1000
        pop @R1
        mul @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R13+0]
        call delay
        add @R13 #4
        move @R13 @R12
        pop @R12
        pop @R15
        ret
