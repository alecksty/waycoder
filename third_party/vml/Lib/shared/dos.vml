        move @R0 @R1
        push @R0
        move @R0 [@R13+0]
        call atoi
        add @R13 #4
        move @R2 @R0
        move @R0 [@R12+12]
        add @R0 #5
        moveb [@R0] @R2
; 58:     d->da_day  = (char)atoi(s + 8);
        move @R0 [@R12-8]
        push @R0
        move @R0 #8
        pop @R1
        add @R1 @R0
        move @R0 @R1
