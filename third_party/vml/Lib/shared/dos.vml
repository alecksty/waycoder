GetDate:
; -------------------------------------------
; source   : void GetDate(int* year,int* month,int* day,int* wday)
; function : GetDate
; param   : int* year
; param   : int* month
; param   : int* day
; param   : int* wday
; return   : void
; --------------------------------------------
GetDate:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 21:     char* s = (char*)asm("SYSCALL #55");   /* "YYYY-MM-DD" */
        syscall #55
        move [@R12-4] @R0
        move [@R12-8] @R0
; 22:     if (year)  *year  = atoi(s);           /* 从串首取年 */
        move @R0 [@R12+12]
        cmp @R0 #0
        jz sta_96560000
        move @R0 [@R12+12]
        move @R11 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 [@R13+0]
        call atoi
        add @R13 #4
        move [@R11] @R0
sta_96560000:
sta_96560001:
; 23:     if (month) *month = atoi(s + 5);       /* 跳过 "YYYY-" */
        move @R0 [@R12+16]
        cmp @R0 #0
        jz sta_96560002
        move @R0 [@R12+16]
        move @R10 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 #5
        pop @R1
        add @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R13+0]
        call atoi
        add @R13 #4
        move [@R10] @R0
sta_96560002:
sta_96560003:
; 24:     if (day)   *day   = atoi(s + 8);       /* 跳过 "YYYY-MM-" */
        move @R0 [@R12+20]
        cmp @R0 #0
        jz sta_96560004
        move @R0 [@R12+20]
        move @R9 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 #8
        pop @R1
        add @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R13+0]
        call atoi
        add @R13 #4
        move [@R9] @R0
sta_96560004:
sta_96560005:
; 25:     if (wday)  *wday  = 0;                 /* 星期本平台不给，恒 0（占位） */
        move @R0 [@R12+24]
        cmp @R0 #0
        jz sta_96560006
        move @R0 [@R12+24]
        move @R8 @R0
        move @R0 #0
        move [@R8] @R0
sta_96560006:
sta_96560007:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
