        move @R0 [@R12+12]
        move @R7 @R0
        move @R0 [@R12-8]
        push @R0
        move @R0 [@R13+0]
        call atoi
        add @R13 #4
        move [@R7] @R0
sta_96560008:
sta_96560009:
; 31:     if (min)  *min  = atoi(s + 3);
        move @R0 [@R12+16]
        cmp @R0 #0
