; return   : int
; --------------------------------------------
DosVersion:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 33:     return 0x0700;  // 模拟 DOS 7.0
        move @R0 #1792
        jmp L_96560016
L_96560016:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
