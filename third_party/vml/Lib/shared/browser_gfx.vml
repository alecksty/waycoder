cmd_write:
; -------------------------------------------
; source   : void cmd_write(int val)
; function : cmd_write
; param   : int val
; return   : void
; --------------------------------------------
cmd_write:
        push R15
        push R12
        move R12 R13
        sub R13 #16
; 17:     volatile int* p = (volatile int*)(0x5000 + __cmd_offset);
        move R0 #20480
        push R0
        move R0 [__cmd_offset]
        pop R1
        add R1 R0
        move R0 R1
        move [R12-8] R0
; 18:     *p = val;
        move R0 [R12-8]
        move R11 R0
        move R0 [R12+12]
        move [R11] R0
; 19:     __cmd_offset += 4;
        move R0 [__cmd_offset]
        push R0
        move R0 #4
        pop R1
        add R1 R0
        move R0 R1
        move [__cmd_offset] R0
        move R13 R12
        pop R12
        pop R15
        ret
