ema_update:
; -------------------------------------------
; source   : int ema_update(int* state,int value,int alpha)
; function : ema_update
; param   : int* state
; param   : int value
; param   : int alpha
; return   : int
; --------------------------------------------
ema_update:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #24
; 53:     if (state == 0) return value;
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        je _L79280031
        move @R0 #0
        jmp _L79280032
_L79280031:
        move @R0 #1
_L79280032:
        cmp @R0 #0
        jz sta_79280029
        move @R0 [@R12+16]
        jmp L_79280033
sta_79280029:
sta_79280030:
; 54:     int prev = state[0];
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        mul @R0 #4
        pop @R8
        add @R0 @R8
        move @R0 [@R0]
        move [@R12-8] @R0
; 56:     int result = (alpha * value + (1000 - alpha) * prev) / 1000;
        move @R0 [@R12+20]
        push @R0
        move @R0 [@R12+16]
        pop @R1
        mul @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 #1000
        push @R0
        move @R0 [@R12+20]
        pop @R1
        sub @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R12-8]
        pop @R1
        mul @R1 @R0
        move @R0 @R1
        pop @R1
        add @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 #1000
        pop @R1
        div @R1 @R0
        move @R0 @R1
        move [@R12-12] @R0
; 57:     state[0] = result;
        move @R0 [@R12-12]
        move @R11 @R0
        push @R11
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        mul @R0 #4
        pop @R9
        add @R0 @R9
        pop @R11
        move [@R0] @R11
; 58:     return result;
        move @R0 [@R12-12]
        jmp L_79280033
L_79280033:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
kalman_init:
; -------------------------------------------
; source   : void kalman_init(int* state,int initial_value,int process_noise,int measure_noise)
; function : kalman_init
; param   : int* state
; param   : int initial_value
; param   : int process_noise
; param   : int measure_noise
; return   : void
; --------------------------------------------
kalman_init:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 65:     if (state == 0) return;
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        je _L79280036
        move @R0 #0
        jmp _L79280037
_L79280036:
        move @R0 #1
_L79280037:
        cmp @R0 #0
        jz sta_79280034
        jmp L_79280038
sta_79280034:
sta_79280035:
; 66:     state[0] = initial_value;  // x: 估计值
        move @R0 [@R12+16]
        move @R7 @R0
        push @R7
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        mul @R0 #4
        pop @R6
        add @R0 @R6
        pop @R7
        move [@R0] @R7
; 67:     state[1] = 1000;           // p: 初始估计误差(缩放)
        move @R0 #1000
        move @R4 @R0
        push @R4
        move @R0 [@R12+12]
        push @R0
        move @R0 #1
        mul @R0 #4
        pop @R5
        add @R0 @R5
        pop @R4
        move [@R0] @R4
; 68:     state[2] = process_noise;  // q: 过程噪声
        move @R0 [@R12+20]
        move @R2 @R0
        push @R2
        move @R0 [@R12+12]
        push @R0
        move @R0 #2
        mul @R0 #4
        pop @R3
        add @R0 @R3
        pop @R2
        move [@R0] @R2
; 69:     state[3] = measure_noise;  // r: 测量噪声
        move @R0 [@R12+24]
        move @R10 @R0
        push @R10
        move @R0 [@R12+12]
        push @R0
        move @R0 #3
        mul @R0 #4
        pop @R1
        add @R0 @R1
        pop @R10
        move [@R0] @R10
L_79280038:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
kalman_update:
; -------------------------------------------
; source   : int kalman_update(int* state,int measurement)
; function : kalman_update
; param   : int* state
; param   : int measurement
; return   : int
; --------------------------------------------
kalman_update:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #40
; 73:     if (state == 0) return measurement;
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        je _L79280041
        move @R0 #0
        jmp _L79280042
_L79280041:
        move @R0 #1
_L79280042:
        cmp @R0 #0
        jz sta_79280039
        move @R0 [@R12+16]
        jmp L_79280043
sta_79280039:
sta_79280040:
; 74:     int x = state[0], p = state[1];
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        mul @R0 #4
        pop @R8
        add @R0 @R8
        move @R0 [@R0]
        move [@R12-8] @R0
        move @R0 [@R12+12]
        push @R0
        move @R0 #1
        mul @R0 #4
        pop @R9
        add @R0 @R9
        move @R0 [@R0]
        move [@R12-12] @R0
; 75:     int q = state[2], r = state[3];
        move @R0 [@R12+12]
        push @R0
        move @R0 #2
        mul @R0 #4
        pop @R11
        add @R0 @R11
        move @R0 [@R0]
        move [@R12-16] @R0
        move @R0 [@R12+12]
        push @R0
        move @R0 #3
        mul @R0 #4
        pop @R6
        add @R0 @R6
        move @R0 [@R0]
        move [@R12-20] @R0
; 78:     p = p + q;
        move @R0 [@R12-12]
        push @R0
        move @R0 [@R12-16]
        pop @R1
        add @R1 @R0
        move @R0 @R1
        move [@R12-12] @R0
; 81:     int denom = p + r;
        move @R0 [@R12-12]
        push @R0
        move @R0 [@R12-20]
        pop @R1
        add @R1 @R0
        move @R0 @R1
        move [@R12-24] @R0
; 82:     if (denom > 0) {
        move @R0 [@R12-24]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        jg _L79280046
        move @R0 #0
        jmp _L79280047
_L79280046:
        move @R0 #1
_L79280047:
        cmp @R0 #0
        jz sta_79280044
; 83:         int k = (p * 1000) / denom;  // Kalman gain * 1000
        move @R0 [@R12-12]
        push @R0
        move @R0 #1000
        pop @R1
        mul @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R12-24]
        pop @R1
        div @R1 @R0
        move @R0 @R1
        move [@R12-28] @R0
; 84:         x = x + (k * (measurement - x)) / 1000;
        move @R0 [@R12-8]
        push @R0
        move @R0 [@R12-28]
        push @R0
        move @R0 [@R12+16]
        push @R0
        move @R0 [@R12-8]
        pop @R1
        sub @R1 @R0
        move @R0 @R1
        pop @R1
        mul @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 #1000
        pop @R1
        div @R1 @R0
        move @R0 @R1
        pop @R1
        add @R1 @R0
        move @R0 @R1
        move [@R12-8] @R0
; 85:         p = ((1000 - k) * p) / 1000;
        move @R0 #1000
        push @R0
        move @R0 [@R12-28]
        pop @R1
        sub @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R12-12]
        pop @R1
        mul @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 #1000
        pop @R1
        div @R1 @R0
        move @R0 @R1
        move [@R12-12] @R0
sta_79280044:
sta_79280045:
; 88:     state[0] = x;
        move @R0 [@R12-8]
        move @R7 @R0
        push @R7
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        mul @R0 #4
        pop @R5
        add @R0 @R5
        pop @R7
        move [@R0] @R7
; 89:     state[1] = p;
        move @R0 [@R12-12]
        move @R4 @R0
        push @R4
        move @R0 [@R12+12]
        push @R0
        move @R0 #1
        mul @R0 #4
        pop @R3
        add @R0 @R3
        pop @R4
        move [@R0] @R4
; 90:     return x;
        move @R0 [@R12-8]
        jmp L_79280043
L_79280043:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
lerp_table:
; -------------------------------------------
; source   : int lerp_table(int* x_table,int* y_table,int n,int x)
; function : lerp_table
; param   : int* x_table
; param   : int* y_table
; param   : int n
; param   : int x
; return   : int
; --------------------------------------------
lerp_table:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #32
; 97:     if (x_table == 0 || y_table == 0 || n < 2) return 0;
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        je _L79280056
        move @R0 #0
        jmp _L79280057
