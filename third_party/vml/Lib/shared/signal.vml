moving_avg_update:
; -------------------------------------------
; source   : int moving_avg_update(int* state,int new_value)
; function : moving_avg_update
; param   : int* state
; param   : int new_value
; return   : int
; --------------------------------------------
moving_avg_update:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #32
; 20:     if (state == 0) return new_value;
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        je _L79280017
        move @R0 #0
        jmp _L79280018
_L79280017:
        move @R0 #1
_L79280018:
        cmp @R0 #0
        jz sta_79280015
        move @R0 [@R12+16]
        jmp L_79280019
sta_79280015:
sta_79280016:
; 21:     int sum = state[0], count = state[1];
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        mul @R0 #4
        pop @R11
        add @R0 @R11
        move @R0 [@R0]
        move [@R12-8] @R0
        move @R0 [@R12+12]
        push @R0
        move @R0 #1
        mul @R0 #4
        pop @R8
        add @R0 @R8
        move @R0 [@R0]
        move [@R12-12] @R0
; 22:     int* buffer = (int*)state[2];
        move @R0 [@R12+12]
        push @R0
        move @R0 #2
        mul @R0 #4
        pop @R9
        add @R0 @R9
        move @R0 [@R0]
        move [@R12-16] @R0
; 23:     int window = state[3];
        move @R0 [@R12+12]
        push @R0
        move @R0 #3
        mul @R0 #4
        pop @R6
        add @R0 @R6
        move @R0 [@R0]
        move [@R12-20] @R0
; 24:     int idx = state[4];
        move @R0 [@R12+12]
        push @R0
        move @R0 #4
        mul @R0 #4
        pop @R7
        add @R0 @R7
        move @R0 [@R0]
        move [@R12-24] @R0
; 26:     if (count < window) {
        move @R0 [@R12-12]
        push @R0
        move @R0 [@R12-20]
        pop @R1
        cmp @R1 @R0
        jl _L79280022
        move @R0 #0
        jmp _L79280023
_L79280022:
        move @R0 #1
_L79280023:
        cmp @R0 #0
        jz sta_79280020
; 27:         buffer[idx] = new_value;
        move @R0 [@R12+16]
        move @R4 @R0
        push @R4
        move @R0 [@R12-16]
        push @R0
        move @R0 [@R12-24]
        mul @R0 #4
        pop @R5
        add @R0 @R5
        pop @R4
        move [@R0] @R4
; 28:         sum += new_value;
        move @R0 [@R12-8]
        push @R0
        move @R0 [@R12+16]
        pop @R1
        add @R1 @R0
        move @R0 @R1
        move [@R12-8] @R0
; 29:         count++;
        move @R0 [@R12-12]
        move @R1 @R0
        add @R0 @R0 #1
        move [@R12-12] @R0
        move @R0 @R1
; 30:         state[0] = sum;
        move @R0 [@R12-8]
        move @R2 @R0
        push @R2
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        mul @R0 #4
        pop @R3
        add @R0 @R3
        pop @R2
        move [@R0] @R2
; 31:         state[1] = count;
        move @R0 [@R12-12]
        move @R10 @R0
        push @R10
        move @R0 [@R12+12]
        push @R0
        move @R0 #1
        mul @R0 #4
        pop @R1
        add @R0 @R1
        pop @R10
        move [@R0] @R10
; 32:         state[4] = (idx + 1) % window;
        move @R0 [@R12-24]
        push @R0
        move @R0 #1
        pop @R1
        add @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R12-20]
        pop @R1
        mod @R1 @R0
        move @R0 @R1
        move @R11 @R0
        push @R11
        move @R0 [@R12+12]
        push @R0
        move @R0 #4
        mul @R0 #4
        pop @R8
        add @R0 @R8
        pop @R11
        move [@R0] @R11
; 33:         return sum / count;
        move @R0 [@R12-8]
        push @R0
        move @R0 [@R12-12]
        pop @R1
        div @R1 @R0
        move @R0 @R1
        jmp L_79280019
sta_79280020:
sta_79280021:
; 36:     sum = sum - buffer[idx] + new_value;
        move @R0 [@R12-8]
        push @R0
        move @R0 [@R12-16]
        push @R0
        move @R0 [@R12-24]
        mul @R0 #4
        pop @R9
        add @R0 @R9
        move @R0 [@R0]
        pop @R1
        sub @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R12+16]
        pop @R1
        add @R1 @R0
        move @R0 @R1
        move [@R12-8] @R0
; 37:     buffer[idx] = new_value;
        move @R0 [@R12+16]
        move @R6 @R0
        push @R6
        move @R0 [@R12-16]
        push @R0
        move @R0 [@R12-24]
        mul @R0 #4
        pop @R7
        add @R0 @R7
        pop @R6
        move [@R0] @R6
; 38:     state[0] = sum;
        move @R0 [@R12-8]
        move @R5 @R0
        push @R5
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        mul @R0 #4
        pop @R4
        add @R0 @R4
        pop @R5
        move [@R0] @R5
; 39:     state[4] = (idx + 1) % window;
        move @R0 [@R12-24]
        push @R0
        move @R0 #1
        pop @R1
        add @R1 @R0
        move @R0 @R1
        push @R0
        move @R0 [@R12-20]
        pop @R1
        mod @R1 @R0
        move @R0 @R1
        move @R3 @R0
        push @R3
        move @R0 [@R12+12]
        push @R0
        move @R0 #4
        mul @R0 #4
        pop @R2
        add @R0 @R2
        pop @R3
        move [@R0] @R3
; 40:     return sum / window;
        move @R0 [@R12-8]
        push @R0
        move @R0 [@R12-20]
        pop @R1
        div @R1 @R0
        move @R0 @R1
        jmp L_79280019
L_79280019:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
ema_init:
; -------------------------------------------
; source   : int ema_init(int* state)
; function : ema_init
; param   : int* state
; return   : int
; --------------------------------------------
ema_init:
        push @R15
        push @R12
        move @R12 @R13
