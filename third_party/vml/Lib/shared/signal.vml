; -------------------------------------------
; source   : int moving_avg_init(int window_size,int* buffer,int* state)
; function : moving_avg_init
; param   : int window_size
; param   : int* buffer
; param   : int* state
; return   : int
; --------------------------------------------
moving_avg_init:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 8:     if (state == 0 || buffer == 0) return 0;
        move @R0 [@R12+20]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        je _L79280005
        move @R0 #0
        jmp _L79280006
_L79280005:
        move @R0 #1
_L79280006:
        test @R0 @R0
        jnz _L79280002
        move @R0 [@R12+16]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        je _L79280007
        move @R0 #0
        jmp _L79280008
_L79280007:
        move @R0 #1
_L79280008:
        test @R0 @R0
        jz _L79280003
_L79280002:
        move @R0 #1
        jmp _L79280004
_L79280003:
        move @R0 #0
_L79280004:
        cmp @R0 #0
        jz sta_79280000
        move @R0 #0
        jmp L_79280009
sta_79280000:
sta_79280001:
; 10:     for (i = 0; i < window_size; i++) buffer[i] = 0;
        move @R0 #0
        move [@R12-8] @R0
sta_79280010:
        move @R0 [@R12-8]
        push @R0
        move @R0 [@R12+12]
        pop @R1
        cmp @R1 @R0
        jl _L79280013
        move @R0 #0
        jmp _L79280014
_L79280013:
        move @R0 #1
_L79280014:
        cmp @R0 #0
        jz sta_79280012
        move @R0 #0
        move @R11 @R0
        push @R11
        move @R0 [@R12+16]
        push @R0
        move @R0 [@R12-8]
        mul @R0 #4
        pop @R10
        add @R0 @R10
        pop @R11
        move [@R0] @R11
sta_79280011:
        move @R0 [@R12-8]
        move @R1 @R0
        add @R0 @R0 #1
        move [@R12-8] @R0
        move @R0 @R1
        jmp sta_79280010
sta_79280012:
; 11:     state[0] = 0;  // sum
        move @R0 #0
        move @R9 @R0
        push @R9
        move @R0 [@R12+20]
        push @R0
        move @R0 #0
        mul @R0 #4
        pop @R8
        add @R0 @R8
        pop @R9
        move [@R0] @R9
; 12:     state[1] = 0;  // count
        move @R0 #0
        move @R7 @R0
        push @R7
        move @R0 [@R12+20]
        push @R0
        move @R0 #1
        mul @R0 #4
        pop @R6
        add @R0 @R6
        pop @R7
        move [@R0] @R7
; 13:     state[2] = (int)buffer;
        move @R0 [@R12+16]
        move @R5 @R0
        push @R5
        move @R0 [@R12+20]
        push @R0
        move @R0 #2
        mul @R0 #4
        pop @R4
        add @R0 @R4
        pop @R5
        move [@R0] @R5
; 14:     state[3] = window_size;
        move @R0 [@R12+12]
        move @R3 @R0
        push @R3
        move @R0 [@R12+20]
        push @R0
        move @R0 #3
        mul @R0 #4
        pop @R2
        add @R0 @R2
        pop @R3
        move [@R0] @R3
; 15:     state[4] = 0;  // write_idx
        move @R0 #0
        move @R1 @R0
        push @R1
        move @R0 [@R12+20]
        push @R0
        move @R0 #4
        mul @R0 #4
        pop @R10
        add @R0 @R10
        pop @R1
        move [@R0] @R1
; 16:     return 1;
        move @R0 #1
        jmp L_79280009
L_79280009:
        move @R13 @R12
