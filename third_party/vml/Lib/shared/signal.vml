; 47:     if (state == 0) return 0;
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        pop @R1
        cmp @R1 @R0
        je _L79280026
        move @R0 #0
        jmp _L79280027
_L79280026:
        move @R0 #1
_L79280027:
        cmp @R0 #0
        jz sta_79280024
        move @R0 #0
        jmp L_79280028
sta_79280024:
sta_79280025:
; 48:     state[0] = 0;
        move @R0 #0
        move @R1 @R0
        push @R1
        move @R0 [@R12+12]
        push @R0
        move @R0 #0
        mul @R0 #4
        pop @R10
        add @R0 @R10
        pop @R1
        move [@R0] @R1
; 49:     return 1;
