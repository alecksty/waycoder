lutf8_strlen:
; -------------------------------------------
; source   : long lutf8_strlen(const char* s)
; function : lutf8_strlen
; param   : const char* s
; return   : long
; --------------------------------------------
lutf8_strlen:
        push @R15
        push @R12
        move @R12 @R13
        sub @R13 #16
; 3: __stdcall long lutf8_strlen(const char* s) { return encoding_utf8_strlen(s); }
        move @R0 [@R12+12]
        push @R0
        move @R0 [@R13+0]
        call encoding_utf8_strlen
        add @R13 #4
        jmp L_55030000
L_55030000:
        move @R13 @R12
        pop @R12
        pop @R15
        ret
