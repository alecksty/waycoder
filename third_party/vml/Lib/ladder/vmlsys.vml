    ADD @R13 #4
    move @R13 @R12
    pop @R12
    pop @R15
    RET

LABEL LADDER_VML_SCREENSHOT
    push @R15
    push @R12
    move @R12 @R13
    CALL vml_screenshot
    move @R13 @R12
    pop @R12
    pop @R15
    RET

LABEL LADDER_VML_SYSCALL5
    push @R15
    push @R12
    move @R12 @R13
    move @R0 [@R12+32]
    PUSH @R0
    move @R0 [@R12+28]
    PUSH @R0
    move @R0 [@R12+24]
    PUSH @R0
    move @R0 [@R12+20]
    PUSH @R0
    move @R0 [@R12+16]
    PUSH @R0
    move @R0 [@R12+12]
    PUSH @R0
    move @R0 [@R13+0]
    move @R1 [@R13+4]
    move @R2 [@R13+8]
    move @R3 [@R13+12]
    CALL vml_syscall5
    ADD @R13 #24
    move @R13 @R12
    pop @R12
    pop @R15
    RET

