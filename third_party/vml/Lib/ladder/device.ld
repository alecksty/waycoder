# VML 设备 I/O + 文件 + 键鼠扩展函数块 — Ladder
# 需显式 include device.ld

# 键盘
[KB_HIT]
SYSCALL 83
RET

[KB_GETCH]
SYSCALL 84
RET

# 鼠标
[MOUSE_GET_X]
SYSCALL 85
RET

[MOUSE_GET_Y]
SYSCALL 86
RET

[MOUSE_LEFT]
SYSCALL 87
RET

[MOUSE_RIGHT]
SYSCALL 88
RET

# 统一设备接口
[DEV_OPEN]
SYSCALL 100
RET

[DEV_CLOSE]
SYSCALL 101
RET

[DEV_READ]
SYSCALL 102
RET

[DEV_WRITE]
SYSCALL 103
RET

[DEV_CONTROL]
SYSCALL 104
RET

