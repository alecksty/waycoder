(* OpenCV FFI Bindings — Ladder *)
FUNCTION OcvImread : INT
    VAR_INPUT path : STRING; END_VAR
END_FUNCTION
FUNCTION OcvImwrite : INT
    VAR_INPUT path : STRING; h : INT; END_VAR
END_FUNCTION
FUNCTION OcvWaitkey : INT
    VAR_INPUT delay : INT; END_VAR
END_FUNCTION
FUNCTION_BLOCK OcvCvtcolor
    VAR_INPUT s : INT; d : INT; code : INT; END_VAR
END_FUNCTION_BLOCK
FUNCTION_BLOCK OcvResize
    VAR_INPUT s : INT; d : INT; w : INT; h : INT; END_VAR
END_FUNCTION_BLOCK
FUNCTION OcvWidth : INT
    VAR_INPUT h : INT; END_VAR
END_FUNCTION
FUNCTION_BLOCK OcvRelease
    VAR_INPUT h : INT; END_VAR
END_FUNCTION_BLOCK
