; Scheme Runtime — MCU built-in wrappers
.entry main
.stack 0

.text
; Scheme_make_string(k, ch) — static buffer fill
Scheme_make_string:
    PUSH R15
    PUSH R12
    MOVE R12 R13
    LOAD R0 [R12+16]    ; k
    LOAD R1 [R12+12]    ; ch
    ; Use static buffer at _sch_buf
    LEA R2 _sch_buf
    ; Fill loop: for i=0 to k-1: buf[i]=ch
    LOAD R3 #0           ; i=0
_sch_loop:
    CMP R3 R0
    JGE _sch_done
    STOREB R1 [R2]
    ADD R2 #1
    ADD R3 #1
    JMP _sch_loop
_sch_done:
    LOAD R1 #0
    STOREB R1 [R2]       ; null terminate
    LEA R0 _sch_buf
    POP R12
    POP R15
    RET

; Scheme_string_copy(str) — copy to static buffer
Scheme_string_copy:
    PUSH R15
    PUSH R12
    MOVE R12 R13
    LOAD R1 [R12+12]    ; src
    LEA R0 _sch_buf2
_sc_loop:
    LOADB R2 [R1]
    STOREB R2 [R0]
    CMP R2 #0
    JE _sc_done
    ADD R1 #1
    ADD R0 #1
    JMP _sc_loop
_sc_done:
    LEA R0 _sch_buf2
    POP R12
    POP R15
    RET

; Scheme_substring(str, start, end) — extract substring to static buffer
Scheme_substring:
    PUSH R15
    PUSH R12
    MOVE R12 R13
    LOAD R0 [R12+12]    ; str
    LOAD R1 [R12+16]    ; start
    LOAD R2 [R12+20]    ; end
    ADD R0 R1            ; str+start
    SUB R2 R1            ; len = end-start
    LEA R3 _sch_buf3
_ss_loop:
    CMP R2 #0
    JLE _ss_done
    LOADB R4 [R0]
    STOREB R4 [R3]
    ADD R0 #1
    ADD R3 #1
    SUB R2 #1
    JMP _ss_loop
_ss_done:
    LOAD R4 #0
    STOREB R4 [R3]       ; null
    LEA R0 _sch_buf3
    POP R12
    POP R15
    RET

; Scheme_string_append(count, str1, str2, ..., strN) — concatenate up to 4 strings
Scheme_string_append:
    PUSH R15
    PUSH R12
    MOVE R12 R13
    LOAD R0 [R12+12]    ; count
    LEA R1 _sch_buf4     ; dst
    LOAD R2 #0           ; arg index
_sa_next:
    CMP R2 R0
    JGE _sa_done
    ; Load str ptr from [R12+16+R2*4]
    LOAD R3 #16
    MUL R4 R2 #4
    ADD R3 R4
    ADD R3 R12
    LOAD R3 [R3]        ; R3 = str arg
_sa_copy:
    LOADB R4 [R3]
    STOREB R4 [R1]
    CMP R4 #0
    JE _sa_next_str
    ADD R3 #1
    ADD R1 #1
    JMP _sa_copy
_sa_next_str:
    ADD R2 #1
    JMP _sa_next
_sa_done:
    STOREB R4 [R1]      ; final null (R4 already 0)
    LEA R0 _sch_buf4
    POP R12
    POP R15
    RET

.data
_sch_buf:  .string ""    ; 256 bytes
_sch_buf2: .string ""    ; 256 bytes
_sch_buf3: .string ""    ; 256 bytes
_sch_buf4: .string ""    ; 256 bytes
