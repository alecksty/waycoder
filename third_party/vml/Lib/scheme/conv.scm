;; VML 全类型转换库 — Scheme 包装器 (v1.66.44)
;; 用法: (load "conv.scm") 或 (include "conv.scm")

(define (int->string val)  (conv-call "int_to_str" val))
(define (string->int s)    (conv-call "str_to_int" s))
(define (long->string val) (conv-call "long_to_str" val))
(define (string->long s)   (conv-call "str_to_long" s))
(define (float->string f)  (conv-call "float_to_str" f))
(define (string->float s)  (conv-call "str_to_float" s))
(define (double->string d) (conv-call "double_to_str" d))
(define (string->double s) (conv-call "str_to_double" s))
(define (bool->string b)   (conv-call "bool_to_str" (if b 1 0)))
(define (string->bool s)   (not (zero? (conv-call "str_to_bool" s))))
(define (char->string c)   (conv-call "char_to_str" (char->integer c)))
(define (string->char s)   (integer->char (conv-call "str_to_char" s)))
