; VML-level SYSCALL helpers
; Built on top of hardware SYSCALL 4 (OutputChar) and SYSCALL 5 (InputChar)
; Auto-linked by VMLToHex when translating for MCU targets

; === SYSCALL 6: OutputInt ===
; Prints R0 as signed decimal integer
LABEL __syscall_6
    PUSH R1
    PUSH R2
    PUSH R3
    MOVE R2 R0
    CMP R0 #0
    JGE __outputint_positive
    MOVE R0 #45
    SYSCALL 4
    NEG R2
LABEL __outputint_positive
    MOVE R0 R2
    MOVE R1 #10
LABEL __outputint_divloop
    MOVE R3 R0
    MUL R3 R1
    SUB R2 R3
    PUSH R2
    DIV R0 R1
    MOVE R2 R0
    CMP R0 #0
    JNZ __outputint_divloop
LABEL __outputint_poploop
    POP R0
    ADD R0 #48
    SYSCALL 4
    SUB R1 #1
    CMP R1 #9
    JNE __outputint_poploop
    POP R3
    POP R2
    POP R1
    RET

; === SYSCALL 10: OutputHex ===
; Prints R0 as "0x" + 8 hex digits
LABEL __syscall_10
    PUSH R1
    PUSH R2
    PUSH R3
    MOVE R2 R0
    MOVE R0 #48
    SYSCALL 4
    MOVE R0 #120
    SYSCALL 4
    MOVE R0 R2
    MOVE R1 #28
LABEL __outputhex_loop
    MOVE R3 R0
    SHR R3 R1
    AND R3 #15
    CMP R3 #10
    JL __outputhex_digit
    ADD R3 #55
    JMP __outputhex_put
LABEL __outputhex_digit
    ADD R3 #48
LABEL __outputhex_put
    PUSH R0
    PUSH R1
    MOVE R0 R3
    SYSCALL 4
    POP R1
    POP R0
    SUB R1 #4
    CMP R1 #0
    JGE __outputhex_loop
    POP R3
    POP R2
    POP R1
    RET

; === SYSCALL 2: InputString ===
; Reads line into buffer at R0, echoes chars, null-terminates
LABEL __syscall_2
    PUSH R0
    PUSH R1
    MOVE R1 R0
LABEL __inputstring_loop
    PUSH R1
    SYSCALL 5
    POP R1
    CMP R0 #13
    JE __inputstring_done
    CMP R0 #10
    JE __inputstring_done
    PUSH R0
    PUSH R1
    SYSCALL 4
    POP R1
    POP R0
    STORE R0 [R1]
    ADD R1 #1
    JMP __inputstring_loop
LABEL __inputstring_done
    MOVE R0 #0
    STORE R0 [R1]
    POP R1
    POP R0
    RET
