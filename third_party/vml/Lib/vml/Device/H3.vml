; Allwinner H3寄存器定义
; 生成自: Allwinner/H-Series/Allwinner H3
; 版本: 1.0
; 日期: 2026-04-29
; 作者: VML Team
; 描述: 32-bit ARM Cortex-A7 Quad-core SoC with 512KB L2 Cache, 1.6GHz, Mali-400 GPU

; CPU架构: ARM-Cortex-A7
; 位宽: 32位
; 时钟频率: 1200000000 Hz

; 外设定义
; UART 0 (debug console)
.equ UART0_BASE, 0x01C28000
.equ UART0_RBR, 0x00
.equ UART0_THR, 0x00
.equ UART0_IER, 0x04
.equ UART0_IIR, 0x08
.equ UART0_FCR, 0x08
.equ UART0_LCR, 0x0C
.equ UART0_MCR, 0x10
.equ UART0_LSR, 0x14
.equ UART0_MSR, 0x18
.equ UART0_DLL, 0x00
.equ UART0_DLH, 0x04

; UART 1
.equ UART1_BASE, 0x01C28400
.equ UART1_RBR, 0x00
.equ UART1_THR, 0x00
.equ UART1_LSR, 0x14

; GPIO 控制器
.equ GPIO_BASE, 0x01C20800
.equ GPIO_PA_CFG0, 0x00
.equ GPIO_PA_CFG1, 0x04
.equ GPIO_PA_DAT, 0x10
.equ GPIO_PA_DRV0, 0x14
.equ GPIO_PA_PUL0, 0x1C
.equ GPIO_PB_CFG0, 0x24
.equ GPIO_PB_DAT, 0x34
.equ GPIO_PC_CFG0, 0x48
.equ GPIO_PC_DAT, 0x58

; AVS 定时器
.equ TIMER_BASE, 0x01C20C00
.equ TIMER_CNT0, 0x00
.equ TIMER_CNT1, 0x04
.equ TIMER_CTRL, 0x08
.equ TIMER_INTV, 0x0C

; 时钟控制单元
.equ CCU_BASE, 0x01C20000
.equ CCU_PLL1_CFG, 0x000
.equ CCU_PLL3_CFG, 0x010
.equ CCU_CPU_AXI_CFG, 0x050
.equ CCU_AHB1_APB1_CFG, 0x054
.equ CCU_APB2_CFG, 0x058
.equ CCU_BUS_GATE0, 0x060
.equ CCU_BUS_GATE1, 0x064
.equ CCU_BUS_GATE2, 0x068

; 宏定义
.macro allwinner_h3_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
allwinner_h3_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
