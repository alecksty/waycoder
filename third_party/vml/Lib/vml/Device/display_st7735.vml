; ST7735寄存器定义
; 生成自: Sitronix/Display/ST7735
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: ST7735 1.8" 128x160 TFT LCD Display (SPI, 16-bit color)

; CPU架构: Display
; 位宽: 16位
; 时钟频率: 16000000 Hz

; 内存段定义
; Graphics RAM (128x160x16bit)
.equ GRAM_START, 0x00
.equ GRAM_END, 0x4FFF
.equ GRAM_SIZE, 20480

; 外设定义
; ST7735 128x160 TFT (SPI, 3.3V-5V)
.equ ST7735_BASE, 0x00
.equ ST7735_CMD, 0x00
.equ ST7735_DATA, 0x01
.equ ST7735_COL_START, 0x2A
.equ ST7735_ROW_START, 0x2B
.equ ST7735_WRITE_RAM, 0x2C
.equ ST7735_MADCTL, 0x36
.equ ST7735_COLMOD, 0x3A
.equ ST7735_INVON, 0x21
.equ ST7735_SLEEP_OUT, 0x11
.equ ST7735_DISP_ON, 0x29

; 宏定义
.macro st7735_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
st7735_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
