; MCP23017寄存器定义
; 生成自: Microchip/GPIO/MCP23017
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: MCP23017 16-bit I2C GPIO Expander (2 banks, interrupt, 25mA per pin)

; CPU架构: GPIO
; 位宽: 16位
; 时钟频率: 400000 Hz

; 外设定义
; MCP23017 16-bit GPIO (0x20-0x27, 1.8V-5.5V)
.equ MCP23017_BASE, 0x20
.equ MCP23017_IODIRA, 0x00
.equ MCP23017_IODIRB, 0x01
.equ MCP23017_GPIOA, 0x12
.equ MCP23017_GPIOB, 0x13
.equ MCP23017_GPINTENA, 0x04
.equ MCP23017_GPINTENB, 0x05
.equ MCP23017_INTCONA, 0x08
.equ MCP23017_IOCON, 0x0A
.equ MCP23017_GPPUA, 0x0C
.equ MCP23017_GPPUB, 0x0D

; 中断向量定义
.equ INTA_VECTOR, 0  ; Port A interrupt
.equ INTB_VECTOR, 1  ; Port B interrupt

; 宏定义
.macro mcp23017_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
mcp23017_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
