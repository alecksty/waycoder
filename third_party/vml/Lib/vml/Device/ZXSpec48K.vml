; ZX-Spectrum-48K寄存器定义
; 生成自: Sinclair Research/ZX Spectrum/ZX-Spectrum-48K
; 版本: 1.0
; 日期: 2026-04-17
; 作者: VML Team
; 描述: Sinclair ZX Spectrum 48K - Iconic British 8-bit home computer with Z80A CPU and ULA graphics

; CPU架构: Z80A
; 位宽: 8位
; 时钟频率: 3500000 Hz

; 寄存器定义
; Accumulator
.equ A, 0x00

; Flags Register
.equ F, 0x01
.equ F_C, 0  ; Carry
.equ F_N, 1  ; Add/Subtract
.equ F_PV, 2  ; Parity/Overflow
.equ F_H, 4  ; Half Carry
.equ F_Z, 6  ; Zero
.equ F_S, 7  ; Sign

; B Register
.equ B, 0x02

; C Register
.equ C, 0x03

; D Register
.equ D, 0x04

; E Register
.equ E, 0x05

; H Register
.equ H, 0x06

; L Register
.equ L, 0x07

; Alternate AF
.equ AF, 0x08

; Alternate BC
.equ BC, 0x0A

; Alternate DE
.equ DE, 0x0C

; Alternate HL
.equ HL, 0x0E

; Interrupt Vector Register
.equ I, 0x10

; Refresh Counter
.equ R, 0x11

; Index X
.equ IX, 0x12

; Index Y
.equ IY, 0x14

; Stack Pointer
.equ SP, 0x16

; Program Counter
.equ PC, 0x18

; 内存段定义
; 48KB ZX Spectrum ROM (BASIC + monitor)
.equ ROM_START, 0x0000
.equ ROM_END, 0x3FFF
.equ ROM_SIZE, 16384

; Display file (256x192 bitmap)
.equ VIDEO_RAM_START, 0x4000
.equ VIDEO_RAM_END, 0x57FF
.equ VIDEO_RAM_SIZE, 6144

; Attribute file (32x24 color cells)
.equ ATTR_RAM_START, 0x5800
.equ ATTR_RAM_END, 0x5AFF
.equ ATTR_RAM_SIZE, 768

; User RAM (40KB)
.equ USER_RAM_START, 0x5B00
.equ USER_RAM_END, 0xFFFF
.equ USER_RAM_SIZE, 40960

; 外设定义
; Uncommitted Logic Array - Sinclair custom IC
.equ ULA_BASE, 0xFE
.equ ULA_BORDER, 0xFE
.equ ULA_KBD_ROW0, 0xFE
.equ ULA_KBD_ROW1, 0xFE
.equ ULA_KBD_ROW2, 0xFE
.equ ULA_KBD_ROW3, 0xFE
.equ ULA_KBD_ROW4, 0xFE
.equ ULA_KBD_ROW5, 0xFE
.equ ULA_KBD_ROW6, 0xFE
.equ ULA_KBD_ROW7, 0xFE
.equ ULA_KBD_ROW8, 0xFE

; Keyboard Matrix (40 keys, 8 rows x 5 cols)
.equ KEYBOARD_BASE, 0xFE
.equ KEYBOARD_KBD_IN, 0xFE

; Internal Beeper
.equ BEEPER_BASE, 0xFE
.equ BEEPER_BEEP, 0xFE

; Tape Interface
.equ TAPE_BASE, 0xFE
.equ TAPE_EAR_IN, 0xFE
.equ TAPE_MIC_OUT, 0xFE

; Kempston Joystick Interface
.equ JOYSTICK_BASE, 0xF7FE
.equ JOYSTICK_KEMPSTON, 0xF7FE

; 中断向量定义
.equ RESET_VECTOR, 0  ; Power-on / Reset
.equ NMI_VECTOR, 1  ; Non-Maskable Interrupt (BREAK key)
.equ INT_VECTOR, 2  ; Maskable Interrupt (ULA vertical blank, 50Hz)

; 引脚定义
.equ PIN_VCC, 1  ; +5V Power
.equ PIN_GND, 2  ; Ground
.equ PIN_CLK, 3  ; Z80 Clock (3.5MHz)
.equ PIN_M1, 4  ; Machine Cycle 1
.equ PIN_MREQ, 5  ; Memory Request
.equ PIN_IORQ, 6  ; I/O Request
.equ PIN_RD, 7  ; Read
.equ PIN_WR, 8  ; Write
.equ PIN_HALT, 9  ; Halt State
.equ PIN_BUSAK, 10  ; Bus Acknowledge
.equ PIN_WAIT, 11  ; Wait State (ULA inserts)
.equ PIN_INT, 12  ; Interrupt Request
.equ PIN_NMI, 13  ; Non-Maskable Interrupt
.equ PIN_RESET, 14  ; Reset
.equ PIN_A0_A15, 15  ; Address Bus (16-bit)
.equ PIN_D0_D7, 16  ; Data Bus (8-bit)

; 宏定义
.macro zx_spectrum_48k_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
zx_spectrum_48k_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
