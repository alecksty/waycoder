; PCF8574寄存器定义
; 生成自: NXP/TI/GPIO/PCF8574
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: PCF8574 8-bit I2C GPIO Expander (quasi-bidirectional, interrupt)

; CPU架构: GPIO
; 位宽: 8位
; 时钟频率: 100000 Hz

; 外设定义
; PCF8574 8-bit GPIO (0x20-0x27, 2.5V-6V)
.equ PCF8574_BASE, 0x20
.equ PCF8574_INPUT, 0x00
.equ PCF8574_INPUT_P0, 0  ; Pin P0
.equ PCF8574_INPUT_P1, 1  ; Pin P1
.equ PCF8574_INPUT_P2, 2  ; Pin P2
.equ PCF8574_INPUT_P3, 3  ; Pin P3
.equ PCF8574_INPUT_P4, 4  ; Pin P4
.equ PCF8574_INPUT_P5, 5  ; Pin P5
.equ PCF8574_INPUT_P6, 6  ; Pin P6
.equ PCF8574_INPUT_P7, 7  ; Pin P7
.equ PCF8574_OUTPUT, 0x01
.equ PCF8574_POLARITY, 0x02

; 中断向量定义
.equ INT_VECTOR, 0  ; Pin change interrupt (open-drain, active low)

; 宏定义
.macro pcf8574_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
pcf8574_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
