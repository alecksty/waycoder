; MCP4725寄存器定义
; 生成自: Microchip/DAC/MCP4725
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: MCP4725 12-bit I2C DAC (single channel, EEPROM)

; CPU架构: DAC
; 位宽: 12位
; 时钟频率: 400000 Hz

; 内存段定义
; Power-on default DAC value
.equ EEPROM_START, 0x00
.equ EEPROM_END, 0x01
.equ EEPROM_SIZE, 2

; 外设定义
; MCP4725 12-bit DAC (0x60-0x67, 2.7V-5.5V)
.equ MCP4725_BASE, 0x60
.equ MCP4725_DAC_VALUE, 0x00
.equ MCP4725_DAC_VALUE_PD, 12  ; Power-down: 0=normal,1=1kΩ,2=100kΩ,3=500kΩ
.equ MCP4725_WRITE_EEPROM, 0x60

; 宏定义
.macro mcp4725_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
mcp4725_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
