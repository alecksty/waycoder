; CCS811寄存器定义
; 生成自: AMS/ScioSense/Sensor/CCS811
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: CCS811 VOC/eCO2 Air Quality Sensor (I2C, 400-8192ppm CO2, 0-1187ppb TVOC)

; CPU架构: Sensor
; 位宽: 16位
; 时钟频率: 400000 Hz

; 外设定义
; CCS811 Air Quality Sensor (0x5A/0x5B, 1.8V-3.6V)
.equ CCS811_BASE, 0x5A
.equ CCS811_STATUS, 0x00
.equ CCS811_MEAS_MODE, 0x01
.equ CCS811_ALG_RESULT, 0x02
.equ CCS811_ECO2, 0x02
.equ CCS811_TVOC, 0x04
.equ CCS811_RAW_DATA, 0x06
.equ CCS811_BASELINE, 0x0B
.equ CCS811_HW_ID, 0x20
.equ CCS811_ERROR_ID, 0xE0
.equ CCS811_APP_START, 0xF4
.equ CCS811_SW_RESET, 0xFF

; 中断向量定义
.equ INT_VECTOR, 0  ; Data ready / interrupt pin

; 引脚定义
.equ PIN_WAKE, 1  ; Wake pin (active low)

; 宏定义
.macro ccs811_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
ccs811_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
