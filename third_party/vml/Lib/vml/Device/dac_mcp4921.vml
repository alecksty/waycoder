; MCP4921寄存器定义
; 生成自: Microchip/DAC/MCP4921
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: MCP4921 12-bit SPI DAC (single channel, 2x buffered output)

; CPU架构: DAC
; 位宽: 12位
; 时钟频率: 20000000 Hz

; 外设定义
; MCP4921 12-bit DAC (SPI, 2.7V-5.5V)
.equ MCP4921_BASE, 0x00
.equ MCP4921_DAC_VALUE, 0x00
.equ MCP4921_DAC_VALUE_BUF, 14  ; VREF buffer (0=unbuffered, 1=buffered)
.equ MCP4921_DAC_VALUE_GA, 13  ; Gain (0=2x, 1=1x)
.equ MCP4921_DAC_VALUE_SHDN, 12  ; Shutdown (0=shutdown, 1=active)
.equ MCP4921_VREF, 0x02

; 宏定义
.macro mcp4921_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
mcp4921_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
