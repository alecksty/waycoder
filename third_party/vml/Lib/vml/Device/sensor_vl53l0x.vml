; VL53L0X寄存器定义
; 生成自: STMicroelectronics/Sensor/VL53L0X
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: VL53L0X ToF Laser Distance Sensor (I2C, 2cm-200cm, 940nm VCSEL)

; CPU架构: Sensor
; 位宽: 16位
; 时钟频率: 400000 Hz

; 外设定义
; VL53L0X ToF Distance Sensor (0x29, 2.6V-3.5V)
.equ VL53L0X_BASE, 0x29
.equ VL53L0X_DISTANCE, 0x00
.equ VL53L0X_SIGNAL_RATE, 0x02
.equ VL53L0X_AMBIENT_RATE, 0x04
.equ VL53L0X_SPAD_COUNT, 0x06
.equ VL53L0X_RANGE_STATUS, 0x08
.equ VL53L0X_TIMING_BUDGET, 0x09
.equ VL53L0X_INTER_MEAS, 0x0D
.equ VL53L0X_MODE, 0x0E

; 引脚定义
.equ PIN_XSHUT, 1  ; Shutdown pin (active low)
.equ PIN_INT, 2  ; Interrupt (open-drain)

; 宏定义
.macro vl53l0x_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
vl53l0x_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
