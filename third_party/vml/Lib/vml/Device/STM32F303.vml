; STM32F303CCT6寄存器定义
; 生成自: STMicroelectronics/STM32/STM32F303CCT6
; 版本: 1.0
; 日期: 2026-04-29
; 作者: VML Team
; 描述: 32-bit ARM Cortex-M4F MCU with 256KB Flash, 48KB SRAM, 72MHz, FPU+DSP

; CPU架构: ARM-Cortex-M4F
; 位宽: 32位
; 时钟频率: 72000000 Hz

; 外设定义
; USART 1
.equ USART1_BASE, 0x40013800
.equ USART1_SR, 0x00
.equ USART1_DR, 0x04
.equ USART1_BRR, 0x08
.equ USART1_CR1, 0x0C
.equ USART1_CR2, 0x10
.equ USART1_CR3, 0x14

; USART 2
.equ USART2_BASE, 0x40004400
.equ USART2_SR, 0x00
.equ USART2_DR, 0x04
.equ USART2_BRR, 0x08
.equ USART2_CR1, 0x0C

; USART 3
.equ USART3_BASE, 0x40004800
.equ USART3_SR, 0x00
.equ USART3_DR, 0x04
.equ USART3_BRR, 0x08
.equ USART3_CR1, 0x0C

; GPIO Port A
.equ GPIOA_BASE, 0x48000000
.equ GPIOA_MODER, 0x00
.equ GPIOA_OTYPER, 0x04
.equ GPIOA_OSPEEDR, 0x08
.equ GPIOA_PUPDR, 0x0C
.equ GPIOA_IDR, 0x10
.equ GPIOA_ODR, 0x14
.equ GPIOA_BSRR, 0x18
.equ GPIOA_AFRL, 0x20
.equ GPIOA_AFRH, 0x24

; 高级定时器 1
.equ TIM1_BASE, 0x40012C00
.equ TIM1_CR1, 0x00
.equ TIM1_CNT, 0x24
.equ TIM1_PSC, 0x28
.equ TIM1_ARR, 0x2C
.equ TIM1_CCR1, 0x34

; ADC 1
.equ ADC1_BASE, 0x50000000
.equ ADC1_SR, 0x00
.equ ADC1_CR, 0x08
.equ ADC1_CFGR, 0x0C
.equ ADC1_SMPR1, 0x14
.equ ADC1_DR, 0x40

; 宏定义
.macro stm32f303cct6_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
stm32f303cct6_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
