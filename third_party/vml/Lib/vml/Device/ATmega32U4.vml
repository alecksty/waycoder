; ATmega32U4寄存器定义
; 生成自: Atmel/AVR/ATmega32U4
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: 8-bit AVR microcontroller with USB, 32KB Flash, 2.5KB SRAM, 16MHz

; CPU架构: AVR
; 位宽: 8位
; 时钟频率: 16000000 Hz

; 寄存器定义
.equ R0, 0x00

.equ R1, 0x01

.equ R2, 0x02

.equ R3, 0x03

.equ R4, 0x04

.equ R5, 0x05

.equ R6, 0x06

.equ R7, 0x07

.equ R8, 0x08

.equ R9, 0x09

.equ R10, 0x0A

.equ R11, 0x0B

.equ R12, 0x0C

.equ R13, 0x0D

.equ R14, 0x0E

.equ R15, 0x0F

.equ R16, 0x10

.equ R17, 0x11

.equ R18, 0x12

.equ R19, 0x13

.equ R20, 0x14

.equ R21, 0x15

.equ R22, 0x16

.equ R23, 0x17

.equ R24, 0x18

.equ R25, 0x19

.equ R26, 0x1A

.equ R27, 0x1B

.equ R28, 0x1C

.equ R29, 0x1D

.equ R30, 0x1E

.equ R31, 0x1F

.equ SPL, 0x5D

.equ SPH, 0x5E

.equ SREG, 0x5F

; 内存段定义
; Program Flash Memory
.equ FLASH_START, 0x0000
.equ FLASH_END, 0x7FFF
.equ FLASH_SIZE, 32768

; Static RAM
.equ SRAM_START, 0x0100
.equ SRAM_END, 0x0AFF
.equ SRAM_SIZE, 2560

; EEPROM
.equ EEPROM_START, 0x0000
.equ EEPROM_END, 0x03FF
.equ EEPROM_SIZE, 1024

; I/O Registers
.equ IO_START, 0x00
.equ IO_END, 0x3F
.equ IO_SIZE, 64

; Extended I/O Registers
.equ EXTIO_START, 0x40
.equ EXTIO_END, 0xFF
.equ EXTIO_SIZE, 192

; 外设定义
; Port B
.equ PORTB_BASE, 0x23
.equ PORTB_PORTB, 0x25
.equ PORTB_DDRB, 0x24
.equ PORTB_PINB, 0x23

; Port C
.equ PORTC_BASE, 0x26
.equ PORTC_PORTC, 0x28
.equ PORTC_DDRC, 0x27
.equ PORTC_PINC, 0x26

; Port D
.equ PORTD_BASE, 0x29
.equ PORTD_PORTD, 0x2B
.equ PORTD_DDRD, 0x2A
.equ PORTD_PIND, 0x29

; Port E
.equ PORTE_BASE, 0x2C
.equ PORTE_PORTE, 0x2E
.equ PORTE_DDRE, 0x2D
.equ PORTE_PINE, 0x2C

; USART1
.equ UART1_BASE, 0xC8
.equ UART1_UDR1, 0xCE
.equ UART1_UCSR1A, 0xC8
.equ UART1_UCSR1B, 0xC9
.equ UART1_UCSR1C, 0xCA
.equ UART1_UBRR1, 0xCC

; USB Controller
.equ USB_BASE, 0xD0
.equ USB_UDCON, 0xD0
.equ USB_UDIEN, 0xD1
.equ USB_UDINT, 0xD2

; 中断向量定义
.equ INT0_VECTOR, 1  ; External Interrupt 0
.equ INT1_VECTOR, 2  ; External Interrupt 1
.equ INT2_VECTOR, 3  ; External Interrupt 2
.equ INT3_VECTOR, 4  ; External Interrupt 3
.equ INT4_VECTOR, 5  ; External Interrupt 4
.equ INT5_VECTOR, 6  ; External Interrupt 5
.equ INT6_VECTOR, 7  ; External Interrupt 6
.equ PCINT0_VECTOR, 8  ; Pin Change Interrupt 0
.equ USB_GENERAL_VECTOR, 9  ; USB General
.equ USB_ENDPOINT_VECTOR, 10  ; USB Endpoint
.equ WDT_VECTOR, 11  ; Watchdog Timeout
.equ TIMER1_CAPT_VECTOR, 12  ; Timer1 Capture
.equ TIMER1_COMPA_VECTOR, 13  ; Timer1 Compare A
.equ TIMER1_COMPB_VECTOR, 14  ; Timer1 Compare B
.equ TIMER1_OVF_VECTOR, 15  ; Timer1 Overflow
.equ TIMER0_COMPA_VECTOR, 16  ; Timer0 Compare A
.equ TIMER0_COMPB_VECTOR, 17  ; Timer0 Compare B
.equ TIMER0_OVF_VECTOR, 18  ; Timer0 Overflow
.equ SPI_STC_VECTOR, 19  ; SPI Transfer Complete
.equ UART1_RX_VECTOR, 20  ; UART1 Receive
.equ UART1_UDRE_VECTOR, 21  ; UART1 Data Register Empty
.equ UART1_TX_VECTOR, 22  ; UART1 Transmit
.equ ADC_VECTOR, 23  ; ADC Conversion Complete

; 宏定义
.macro atmega32u4_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
atmega32u4_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
