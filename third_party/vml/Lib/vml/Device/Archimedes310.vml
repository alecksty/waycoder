; Acorn-Archimedes-A310寄存器定义
; 生成自: Acorn Computers/Archimedes/Acorn-Archimedes-A310
; 版本: 1.0
; 日期: 2026-04-17
; 作者: VML Team
; 描述: Acorn Archimedes A310 - First ARM-based home computer with RISC OS, ARM250 @ 26MHz

; CPU架构: ARM250
; 位宽: 32位
; 时钟频率: 26000000 Hz

; 寄存器定义
; General Purpose Register 0
.equ R0, 0x00

; General Purpose Register 1
.equ R1, 0x04

; General Purpose Register 2
.equ R2, 0x08

; General Purpose Register 3
.equ R3, 0x0C

; General Purpose Register 4
.equ R4, 0x10

; General Purpose Register 5
.equ R5, 0x14

; General Purpose Register 6
.equ R6, 0x18

; General Purpose Register 7
.equ R7, 0x1C

; General Purpose Register 8
.equ R8, 0x20

; General Purpose Register 9
.equ R9, 0x24

; General Purpose Register 10
.equ R10, 0x28

; General Purpose Register 11 (fp)
.equ R11, 0x2C

; General Purpose Register 12
.equ R12, 0x30

; Stack Pointer (R13)
.equ SP, 0x34

; Link Register (R14)
.equ LR, 0x38

; Program Counter (R15)
.equ PC, 0x3C

; Processor Status Register
.equ PSR, 0x40
.equ PSR_MODE, 0  ; Mode bits (0-4)
.equ PSR_T, 5  ; Thumb state
.equ PSR_F, 6  ; FIQ disable
.equ PSR_I, 7  ; IRQ disable
.equ PSR_V, 28  ; Overflow
.equ PSR_C, 29  ; Carry
.equ PSR_Z, 30  ; Zero
.equ PSR_N, 31  ; Negative

; 内存段定义
; RISC OS ROM (512KB)
.equ ROM_START, 0x00000000
.equ ROM_END, 0x0007FFFF
.equ ROM_SIZE, 524288

; Main RAM (up to 4MB)
.equ RAM_START, 0x00080000
.equ RAM_END, 0x003FFFFF
.equ RAM_SIZE, 3932160

; Video RAM (4MB, VIDC)
.equ VRAM_START, 0x00400000
.equ VRAM_END, 0x007FFFFF
.equ VRAM_SIZE, 4194304

; I/O controller (IOC)
.equ IO_START, 0x03000000
.equ IO_END, 0x0301FFFF
.equ IO_SIZE, 131072

; Memory Controller (MEMC)
.equ MEMC_START, 0x03200000
.equ MEMC_END, 0x0320FFFF
.equ MEMC_SIZE, 4096

; Video Controller (VIDC)
.equ VIDC_START, 0x03400000
.equ VIDC_END, 0x0340FFFF
.equ VIDC_SIZE, 4096

; I/O and Memory DMA
.equ IOMD_START, 0x03300000
.equ IOMD_END, 0x0330FFFF
.equ IOMD_SIZE, 4096

; 外设定义
; I/O Controller (IOC) - Interrupt/Keyboard/RTC
.equ IOC_BASE, 0x03000000
.equ IOC_IOC_TIMER1, 0x03000000
.equ IOC_IOC_TIMER2, 0x03000004
.equ IOC_IOC_IOSEL, 0x03000008
.equ IOC_IOC_IRQST, 0x0300000C
.equ IOC_IOC_IRQLATCH, 0x03000010
.equ IOC_IOC_FIQST, 0x03000014
.equ IOC_IOC_FIQEN, 0x03000018
.equ IOC_IOC_IRQEN, 0x0300001C
.equ IOC_IOC_KBDDATA, 0x03000020
.equ IOC_IOC_KBDCR, 0x03000024
.equ IOC_IOC_RTCDR, 0x03000028
.equ IOC_IOC_RTCCR, 0x0300002C
.equ IOC_IOC_PRST, 0x03000030
.equ IOC_IOC_PORTA, 0x03000034
.equ IOC_IOC_PORTB, 0x03000038
.equ IOC_IOC_PORTC, 0x0300003C

; Memory Controller (MEMC1)
.equ MEMC_BASE, 0x03200000
.equ MEMC_MEMC_PT, 0x03200000
.equ MEMC_MEMC_CTRL, 0x03200004
.equ MEMC_MEMC_DRAM, 0x03200008
.equ MEMC_MEMC_ERR, 0x0320000C

; Video Controller - VIDC1
.equ VIDC_BASE, 0x03400000
.equ VIDC_VIDC_PALETTE, 0x03400000
.equ VIDC_VIDC_STARTL, 0x03400004
.equ VIDC_VIDC_STARTH, 0x03400008
.equ VIDC_VIDC_CONFIG, 0x0340000C
.equ VIDC_VIDC_HDISP, 0x03400010
.equ VIDC_VIDC_VDISP, 0x03400014
.equ VIDC_VIDC_HSYNC, 0x03400018
.equ VIDC_VIDC_VSYNC, 0x0340001C
.equ VIDC_VIDC_BORDER, 0x03400020
.equ VIDC_VIDC_CURSOR, 0x03400024
.equ VIDC_VIDC_SOUND, 0x03400028

; Intel 82710 Floppy Disk Controller
.equ FDC_BASE, 0x03010000
.equ FDC_FDC_STATUS, 0x03010000
.equ FDC_FDC_COMMAND, 0x03010000
.equ FDC_FDC_TRACK, 0x03010004
.equ FDC_FDC_SECTOR, 0x03010008
.equ FDC_FDC_DATA, 0x0301000C

; Serial Port (via IOC)
.equ SERIAL_BASE, 0x03010010
.equ SERIAL_SERIAL_TX, 0x03010010
.equ SERIAL_SERIAL_RX, 0x03010014
.equ SERIAL_SERIAL_CTRL, 0x03010018

; 中断向量定义
.equ RESET_VECTOR, 0  ; Reset
.equ UND_VECTOR, 1  ; Undefined instruction
.equ SWI_VECTOR, 2  ; Software Interrupt (SWI/SVC)
.equ PABORT_VECTOR, 3  ; Prefetch Abort
.equ DABORT_VECTOR, 4  ; Data Abort
.equ ADDRESS_VECTOR, 5  ; Address Exception
.equ IRQ_VECTOR, 6  ; IRQ interrupt (IOC)
.equ FIQ_VECTOR, 7  ; FIQ interrupt (VIDC)

; 引脚定义
.equ PIN_VCC, 1  ; +5V Power
.equ PIN_GND, 2  ; Ground
.equ PIN_CLK, 3  ; ARM clock (26MHz)
.equ PIN_NRESET, 4  ; Reset (active low)
.equ PIN_NMREQ, 5  ; Memory Request (active low)
.equ PIN_NIORQ, 6  ; I/O Request (active low)
.equ PIN_NRW, 7  ; Read/Write (0=write, 1=read)
.equ PIN_MAS0, 8  ; Master address bit 0
.equ PIN_MAS1, 9  ; Master address bit 1
.equ PIN_MAS2, 10  ; Master address bit 2
.equ PIN_LOCK, 11  ; Bus lock
.equ PIN_NMREQ, 12  ; Memory request (active low)
.equ PIN_NWAIT, 13  ; Wait state (active low)
.equ PIN_NIRQLINE, 14  ; IRQ line (active low)
.equ PIN_NFIRQLINE, 15  ; FIQ line (active low)
.equ PIN_A1_A25, 16  ; Address Bus (26-bit)
.equ PIN_D0_D31, 17  ; Data Bus (32-bit)

; 宏定义
.macro acorn_archimedes_a310_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
acorn_archimedes_a310_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
