; Neo Geo System Driver / Controller
.equ NEODRIVER_BASE, 0x310000
.equ NEODRIVER_PDI0, 0x00
.equ NEODRIVER_PDI0_UP, 0  ; Up (0=pressed)
.equ NEODRIVER_PDI0_DOWN, 1  ; Down (0=pressed)
.equ NEODRIVER_PDI0_LEFT, 2  ; Left (0=pressed)
.equ NEODRIVER_PDI0_RIGHT, 3  ; Right (0=pressed)
.equ NEODRIVER_PDI0_A, 4  ; A Button (0=pressed)
.equ NEODRIVER_PDI0_B, 5  ; B Button (0=pressed)
.equ NEODRIVER_PDI0_C, 6  ; C Button (0=pressed)
.equ NEODRIVER_PDI0_D, 7  ; D Button (0=pressed)
.equ NEODRIVER_PDI1, 0x01
.equ NEODRIVER_PDI2, 0x02
.equ NEODRIVER_PDI3, 0x03
.equ NEODRIVER_PDO0, 0x04
.equ NEODRIVER_PDO1, 0x05
.equ NEODRIVER_PDO2, 0x06
.equ NEODRIVER_PDO3, 0x07
.equ NEODRIVER_DIPSEL1, 0x08
.equ NEODRIVER_DIPSEL1_COIN_SELECT, 0  ; Coin Select (0=common, 1=1 coin 1 credit)
.equ NEODRIVER_DIPSEL1_FREE_PLAY, 1  ; Free Play
.equ NEODRIVER_DIPSEL1_DEMO_SOUND, 2  ; Demo Sound
.equ NEODRIVER_DIPSEL1_CHIP_MODE, 3  ; Chip Mode (0=AES, 1=MVS)
.equ NEODRIVER_DIPSEL1_CONTROLLER_TYPE, 4  ; Controller Type (0=standard, 1=keyboard)
