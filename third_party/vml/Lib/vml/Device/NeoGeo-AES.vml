.equ YGV628_VDP_CTRL_SCROLL1_DISP, 6  ; Scroll Layer 1 Display
.equ YGV628_VDP_CTRL_DMA_ENABLE, 7  ; DMA Enable
.equ YGV628_SCROLL1_BASE, 0x08
.equ YGV628_SCROLL2_BASE, 0x0A
