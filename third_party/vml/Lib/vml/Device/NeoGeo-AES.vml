.equ YGV628_VDP_STATUS_ODD_FIELD, 1  ; Odd Field Flag
.equ YGV628_VDP_STATUS_DMA_BUSY, 2  ; DMA Busy
.equ YGV628_VDP_STATUS_SPRITE_OVERFLOW, 3  ; Sprite Overflow (more than 16 per line)
