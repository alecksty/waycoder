; NeoGeo-68000寄存器定义
; 生成自: SNK/M68K/NeoGeo-68000
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: SNK Neo Geo AES main processor - Motorola 68000 @ 12MHz + Z80 @ 4MHz (audio coprocessor)

; CPU架构: MC68000
; 位宽: 32位
; 时钟频率: 12000000 Hz

; 寄存器定义
; Data Register 0
.equ D0, 0x00

; Data Register 1
.equ D1, 0x04

; Data Register 2
.equ D2, 0x08

; Data Register 3
.equ D3, 0x0C

; Data Register 4
.equ D4, 0x10

; Data Register 5
.equ D5, 0x14

; Data Register 6
.equ D6, 0x18

; Data Register 7
.equ D7, 0x1C

; Address Register 0
.equ A0, 0x20

; Address Register 1
.equ A1, 0x24

; Address Register 2
.equ A2, 0x28

; Address Register 3
.equ A3, 0x2C

; Address Register 4
.equ A4, 0x30

; Address Register 5
.equ A5, 0x34

; Address Register 6
.equ A6, 0x38

; User Stack Pointer (USP)
.equ A7, 0x3C

; Supervisor Stack Pointer (SSP)
.equ SP, 0x3C

; Program Counter
.equ PC, 0x40

; Status Register
.equ SR, 0x44
.equ SR_C, 0  ; Carry
.equ SR_V, 1  ; Overflow
.equ SR_Z, 2  ; Zero
.equ SR_N, 3  ; Negative
.equ SR_X, 4  ; Extend
.equ SR_I0, 8  ; Interrupt Mask 0
.equ SR_I1, 9  ; Interrupt Mask 1
.equ SR_I2, 10  ; Interrupt Mask 2
.equ SR_M, 11  ; Master/Interrupt
.equ SR_S, 13  ; Supervisor/User
.equ SR_T0, 14  ; Trace Mode 0
.equ SR_T1, 15  ; Trace Mode 1

; 内存段定义
; Work RAM (64KB)
.equ WORK_RAM_START, 0x100000
.equ WORK_RAM_END, 0x10FFFF
.equ WORK_RAM_SIZE, 65536

; Backup SRAM (battery-backed, 64KB)
.equ BACKUP_RAM_START, 0x200000
.equ BACKUP_RAM_END, 0x20FFFF
.equ BACKUP_RAM_SIZE, 65536

; Fix Layer ROM (512KB)
.equ FIX_ROM_START, 0x000000
.equ FIX_ROM_END, 0x07FFFF
.equ FIX_ROM_SIZE, 524288

; Sprite ROM (up to 1MB)
.equ SPR_ROM_START, 0x400000
.equ SPR_ROM_END, 0x4FFFFF
.equ SPR_ROM_SIZE, 1048576

; Audio ROM (up to 64KB)
.equ AUDIO_ROM_START, 0x800000
.equ AUDIO_ROM_END, 0x80FFFF
.equ AUDIO_ROM_SIZE, 65536

; Cartridge ROM (up to 512KB, expandable)
.equ CART_ROM_START, 0xC00000
.equ CART_ROM_END, 0xC7FFFF
.equ CART_ROM_SIZE, 524288

; I/O Area (VDP, YM2610, Z80 port, etc.)
.equ IO_AREA_START, 0x300000
.equ IO_AREA_END, 0x3FFFFF
.equ IO_AREA_SIZE, 1048576

; Z80 Work RAM (2KB)
.equ Z80_RAM_START, 0x10000
.equ Z80_RAM_END, 0x107FF
.equ Z80_RAM_SIZE, 2048

; 外设定义
; Z80 Audio Coprocessor @ 4MHz
.equ Z80_BASE, 0x300000
.equ Z80_Z80_A, 0x00
.equ Z80_Z80_F, 0x01
.equ Z80_Z80_B, 0x02
.equ Z80_Z80_C, 0x03
.equ Z80_Z80_D, 0x04
.equ Z80_Z80_E, 0x05
.equ Z80_Z80_H, 0x06
.equ Z80_Z80_L, 0x07
.equ Z80_Z80_AF, 0x08
.equ Z80_Z80_BC, 0x0A
.equ Z80_Z80_DE, 0x0C
.equ Z80_Z80_HL, 0x0E
.equ Z80_Z80_IX, 0x10
.equ Z80_Z80_IY, 0x12
.equ Z80_Z80_SP, 0x14
.equ Z80_Z80_PC, 0x16
.equ Z80_Z80_I, 0x18
.equ Z80_Z80_R, 0x19
.equ Z80_Z80_IM, 0x1A
.equ Z80_Z80_BUSREQ, 0x1E
.equ Z80_Z80_RESET, 0x1F

; Yamaha YM2610 FM + ADPCM Audio Generator
.equ YM2610_BASE, 0x300000
.equ YM2610_YM_ADDR_A0, 0x00
.equ YM2610_YM_DATA_A0, 0x01
