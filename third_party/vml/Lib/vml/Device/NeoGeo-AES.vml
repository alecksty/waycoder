; Neo Geo VDP (Video Display Processor)
.equ YGV628_BASE, 0x3C0000
.equ YGV628_VRAM_ADDR_L, 0x00
.equ YGV628_VRAM_ADDR_H, 0x01
.equ YGV628_VRAM_DATA, 0x02
.equ YGV628_VRAM_READ, 0x03
.equ YGV628_CRAM_ADDR, 0x04
.equ YGV628_CRAM_DATA, 0x05
