.equ PIN_D15, 53  ; Data Bus Bit 15
.equ PIN_AS, 54  ; Address Strobe (active low)
.equ PIN_UDS, 55  ; Upper Data Strobe (active low)
.equ PIN_LDS, 56  ; Lower Data Strobe (active low)
.equ PIN_R_W, 57  ; Read/Write (1=Read, 0=Write)
