.equ PIN_D1, 39  ; Data Bus Bit 1
.equ PIN_D2, 40  ; Data Bus Bit 2
.equ PIN_D3, 41  ; Data Bus Bit 3
.equ PIN_D4, 42  ; Data Bus Bit 4
.equ PIN_D5, 43  ; Data Bus Bit 5
.equ PIN_D6, 44  ; Data Bus Bit 6
