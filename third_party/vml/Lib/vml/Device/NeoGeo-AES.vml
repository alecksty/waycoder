.equ NEODRIVER_IRQMASK_HBLANK_MASK, 1  ; H-Blank Interrupt Mask
.equ NEODRIVER_IRQMASK_VECTOR_IN_MASK, 2  ; Vector In (from Z80) Mask
.equ NEODRIVER_IRQMASK_SYSTEM_IN_MASK, 3  ; System Input (JAMMA) Mask
.equ NEODRIVER_IRQFLAG, 0x0E
.equ NEODRIVER_SECAM_MODE, 0x0F

