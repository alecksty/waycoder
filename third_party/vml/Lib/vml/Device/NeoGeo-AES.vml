.equ IRQ4_VECTOR, 27  ; JAMMA / System Input
.equ IRQ5_VECTOR, 28  ; Z80 Interrupt Request
.equ TRAP0_VECTOR, 32  ; TRAP #0 (system call)
.equ TRAP1_VECTOR, 33  ; TRAP #1

