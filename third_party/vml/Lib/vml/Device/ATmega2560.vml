; ATmega2560寄存器定义
; 生成自: Atmel/AVR/ATmega2560
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: 8-bit AVR MCU with 256KB Flash, 8KB RAM, 4KB EEPROM, 16MHz, Arduino Mega

; CPU架构: AVR
; 位宽: 8位
; 时钟频率: 16000000 Hz

; 寄存器定义
.equ R0, 0x00

.equ R1, 0x01

.equ R2, 0x02

.equ SPL, 0x5D

.equ SPH, 0x5E

.equ SREG, 0x5F

; 内存段定义
.equ FLASH_START, 0x0000
.equ FLASH_END, 0x3FFFF
.equ FLASH_SIZE, 262144

.equ SRAM_START, 0x0200
.equ SRAM_END, 0x21FF
.equ SRAM_SIZE, 8192

.equ EEPROM_START, 0x0000
.equ EEPROM_END, 0x0FFF
.equ EEPROM_SIZE, 4096

.equ IO_START, 0x00
.equ IO_END, 0x3F
.equ IO_SIZE, 64

.equ EXTIO_START, 0x40
.equ EXTIO_END, 0xFF
.equ EXTIO_SIZE, 192

; 外设定义
; Port A
.equ PORTA_BASE, 0x22
.equ PORTA_DDRA, 0x21
.equ PORTA_PORTA, 0x22
.equ PORTA_PINA, 0x20

; Port B
.equ PORTB_BASE, 0x25
.equ PORTB_DDRB, 0x24
.equ PORTB_PORTB, 0x25
.equ PORTB_PINB, 0x23

; Port C
.equ PORTC_BASE, 0x28
.equ PORTC_DDRC, 0x27
.equ PORTC_PORTC, 0x28
.equ PORTC_PINC, 0x26

; Port D
.equ PORTD_BASE, 0x2B
.equ PORTD_DDRD, 0x2A
.equ PORTD_PORTD, 0x2B
.equ PORTD_PIND, 0x29

; Port E
.equ PORTE_BASE, 0x2E
.equ PORTE_DDRE, 0x2D
.equ PORTE_PORTE, 0x2E
.equ PORTE_PINE, 0x2C

; Port F
.equ PORTF_BASE, 0x31
.equ PORTF_DDRF, 0x30
.equ PORTF_PORTF, 0x31
.equ PORTF_PINF, 0x2F

; Port G
.equ PORTG_BASE, 0x34
.equ PORTG_DDRG, 0x33
.equ PORTG_PORTG, 0x34
.equ PORTG_PING, 0x32

; USART 0
.equ USART0_BASE, 0xC0
.equ USART0_UDR0, 0xC6
.equ USART0_UCSR0A, 0xC0
.equ USART0_UCSR0B, 0xC1
.equ USART0_UCSR0C, 0xC2
.equ USART0_UBRR0L, 0xC4
.equ USART0_UBRR0H, 0xC5

; 中断向量定义
.equ RESET_VECTOR, 1  ; 
.equ INT0_VECTOR, 2  ; 
.equ INT1_VECTOR, 3  ; 
.equ INT2_VECTOR, 4  ; 
.equ INT3_VECTOR, 5  ; 
.equ INT4_VECTOR, 6  ; 
.equ INT5_VECTOR, 7  ; 
.equ INT6_VECTOR, 8  ; 
.equ INT7_VECTOR, 9  ; 
.equ PCINT0_VECTOR, 10  ; 
.equ PCINT1_VECTOR, 11  ; 
.equ PCINT2_VECTOR, 12  ; 
.equ WDT_VECTOR, 13  ; 
.equ TIM2_COMPA_VECTOR, 14  ; 
.equ TIM2_COMPB_VECTOR, 15  ; 
.equ TIM2_OVF_VECTOR, 16  ; 
.equ TIM1_CAPT_VECTOR, 17  ; 
.equ TIM1_COMPA_VECTOR, 18  ; 
.equ TIM1_COMPB_VECTOR, 19  ; 
.equ TIM1_OVF_VECTOR, 20  ; 
.equ TIM0_COMPA_VECTOR, 21  ; 
.equ TIM0_COMPB_VECTOR, 22  ; 
.equ TIM0_OVF_VECTOR, 23  ; 
.equ SPI_STC_VECTOR, 24  ; 
.equ USART0_RX_VECTOR, 25  ; 
.equ USART0_UDRE_VECTOR, 26  ; 
.equ USART0_TX_VECTOR, 27  ; 

; 宏定义
.macro atmega2560_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
atmega2560_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
