; GD32VF103寄存器定义
; 生成自: GigaDevice/GD32/GD32VF103
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: 32-bit RISC-V RV32IMAC MCU with 128KB Flash, 32KB RAM, 108MHz, STM32F103 compatible

; CPU架构: RISC-V
; 位宽: 32位
; 时钟频率: 108000000 Hz

; 寄存器定义
; Return Address
.equ X1, 0x04

; Stack Pointer (SP)
.equ X2, 0x08

; Global Pointer (GP)
.equ X3, 0x0C

; Frame Pointer (FP)
.equ X8, 0x20

; Function Argument (A0)
.equ X10, 0x28

; Function Argument (A1)
.equ X11, 0x2C

; Program Counter
.equ PC, 0x3C

; 内存段定义
.equ FLASH_START, 0x08000000
.equ FLASH_END, 0x0801FFFF
.equ FLASH_SIZE, 131072

.equ SRAM_START, 0x20000000
.equ SRAM_END, 0x20007FFF
.equ SRAM_SIZE, 32768

.equ PERIPHERAL_START, 0x40000000
.equ PERIPHERAL_END, 0x4003FFFF
.equ PERIPHERAL_SIZE, 262144

; 外设定义
; Reset and Clock Control
.equ RCU_BASE, 0x40021000
.equ RCU_CTL, 0x00
.equ RCU_CFG0, 0x04
.equ RCU_CFG1, 0x08
.equ RCU_APB2EN, 0x18
.equ RCU_APB2EN_PAEN, 2  ; GPIOA enable
.equ RCU_APB2EN_PBEN, 3  ; GPIOB enable
.equ RCU_APB2EN_PCEN, 4  ; GPIOC enable
.equ RCU_APB2EN_USART0EN, 14  ; USART0 enable
.equ RCU_APB1EN, 0x1C

; General Purpose I/O Port A
.equ GPIOA_BASE, 0x40010800
.equ GPIOA_CTL0, 0x00
.equ GPIOA_CTL1, 0x04
.equ GPIOA_ISTAT, 0x08
.equ GPIOA_OCTL, 0x0C
.equ GPIOA_BOP, 0x10
.equ GPIOA_BC, 0x14

; General Purpose I/O Port B
.equ GPIOB_BASE, 0x40010C00
.equ GPIOB_CTL0, 0x00
.equ GPIOB_CTL1, 0x04
.equ GPIOB_ISTAT, 0x08
.equ GPIOB_OCTL, 0x0C
.equ GPIOB_BOP, 0x10
.equ GPIOB_BC, 0x14

; General Purpose I/O Port C
.equ GPIOC_BASE, 0x40011000
.equ GPIOC_CTL0, 0x00
.equ GPIOC_CTL1, 0x04
.equ GPIOC_ISTAT, 0x08
.equ GPIOC_OCTL, 0x0C
.equ GPIOC_BOP, 0x10
.equ GPIOC_BC, 0x14

; USART0
.equ USART0_BASE, 0x40013800
.equ USART0_STATR, 0x00
.equ USART0_DATAR, 0x04
.equ USART0_BRR, 0x08
.equ USART0_CTLR1, 0x0C

; 中断向量定义
.equ RESET_VECTOR, 1  ; 
.equ MACHINESOFTWARE_VECTOR, 3  ; 
.equ MACHINETIMER_VECTOR, 7  ; 
.equ MACHINEEXTERNAL_VECTOR, 11  ; 
.equ USART0_VECTOR, 25  ; USART0 Global Interrupt

; 宏定义
.macro gd32vf103_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
gd32vf103_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
