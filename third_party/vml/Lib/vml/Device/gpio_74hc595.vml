; 74HC595寄存器定义
; 生成自: TI/NXP/GPIO/74HC595
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: 74HC595 8-bit Shift Register (SPI-compatible, serial-in parallel-out, daisy-chainable)

; CPU架构: GPIO
; 位宽: 8位
; 时钟频率: 10000000 Hz

; 外设定义
; 74HC595 8-bit Shift Register (2V-6V, DIP-16)
.equ _74HC595_BASE, 0x00
.equ _74HC595_DATA, 0x00
.equ _74HC595_LATCH, 0x01
.equ _74HC595_CHAIN_COUNT, 0x02
.equ _74HC595_OE, 0x03
.equ _74HC595_CLEAR, 0x04

; 宏定义
.macro _74hc595_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
_74hc595_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
