; PIC16F84寄存器定义
; 生成自: Microchip Technology/PIC16/PIC16F84
; 版本: 
; 日期: 
; 作者: 
; 描述: Microchip PIC16F84 8-bit microcontroller with EEPROM

; CPU架构: PIC16
; 位宽: 0位
; 时钟频率: 0 Hz

; 外设定义
; 8-bit timer/counter with prescaler
.equ TIMER0_BASE, 
.equ TIMER0_TMR0, 0x01

; 16-bit timer/counter with prescaler
.equ TIMER1_BASE, 
.equ TIMER1_TMR1L, 0x0E
.equ TIMER1_TMR1H, 0x0F
.equ TIMER1_T1CON, 0x10
.equ TIMER1_T1CON_TMR1ON, 0  ; Timer1 On
.equ TIMER1_T1CON_TMR1CS, 1  ; Timer1 Clock Source
.equ TIMER1_T1CON_T1SYNC, 2  ; Timer1 External Clock Input Synchronization
.equ TIMER1_T1CON_T1OSCEN, 3  ; Timer1 Oscillator Enable
.equ TIMER1_T1CON_T1CKPS0, 4  ; Timer1 Input Clock Prescale Select bit 0
.equ TIMER1_T1CON_T1CKPS1, 5  ; Timer1 Input Clock Prescale Select bit 1

; Watchdog Timer
.equ WATCHDOG_BASE, 
.equ WATCHDOG_WDTCON, 0x07
.equ WATCHDOG_WDTCON_SWDTEN, 0  ; Software Watchdog Timer Enable

; 64-byte EEPROM data memory
.equ EEPROM_BASE, 
.equ EEPROM_EEDATA, 0x08
.equ EEPROM_EEADR, 0x09
.equ EEPROM_EECON1, 0x88
.equ EEPROM_EECON2, 0x89

; General Purpose I/O
.equ GPIO_BASE, 
.equ GPIO_PORTA, 0x05
.equ GPIO_PORTB, 0x06
.equ GPIO_TRISA, 0x85
.equ GPIO_TRISB, 0x86

; 中断向量定义
.equ INT_VECTOR, 4  ; External interrupt on RB0/INT pin
.equ TMR0_VECTOR, 4  ; Timer0 overflow interrupt
.equ PORTB_VECTOR, 4  ; PORTB change interrupt (RB4-RB7)
.equ EEPROM_VECTOR, 4  ; EEPROM write complete interrupt

; 宏定义
.macro pic16f84_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
pic16f84_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
