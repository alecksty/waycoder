; Sharp-LR35902寄存器定义
; 生成自: Sharp/Z80/Sharp-LR35902
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: Game Boy (DMG-01) main processor - Sharp LR35902 (Z80-like) @ 4.19MHz

; CPU架构: LR35902
; 位宽: 8位
; 时钟频率: 4194304 Hz

; 寄存器定义
; Accumulator
.equ A, 0x00

; B Register
.equ B, 0x01

; C Register
.equ C, 0x02

; D Register
.equ D, 0x03

; E Register
.equ E, 0x04

; Flags Register
.equ F, 0x05
.equ F_C, 4  ; Carry
.equ F_H, 5  ; Half Carry
.equ F_N, 6  ; Subtract
.equ F_Z, 7  ; Zero

; H Register
.equ H, 0x06

; L Register
.equ L, 0x07

; AF Register Pair (Accumulator + Flags)
.equ AF, 0x08

; BC Register Pair
.equ BC, 0x0A

; DE Register Pair
.equ DE, 0x0C

; HL Register Pair
.equ HL, 0x0E

; Stack Pointer
.equ SP, 0x10

; Program Counter
.equ PC, 0x12

; 内存段定义
; Work RAM (4KB)
.equ WRAM_START, 0xC000
.equ WRAM_END, 0xCFFF
.equ WRAM_SIZE, 4096

; Work RAM Shadow (Echo RAM)
.equ WRAM_SHADOW_START, 0xE000
.equ WRAM_SHADOW_END, 0xEFFF
.equ WRAM_SHADOW_SIZE, 4096

; High RAM (127 bytes)
.equ HRAM_START, 0xFF80
.equ HRAM_END, 0xFFFE
.equ HRAM_SIZE, 127

; I/O Registers
.equ IO_REGISTERS_START, 0xFF00
.equ IO_REGISTERS_END, 0xFF7F
.equ IO_REGISTERS_SIZE, 128

; Sprite Attribute Table (OAM)
.equ OAM_START, 0xFE00
.equ OAM_END, 0xFE9F
.equ OAM_SIZE, 160

; Video RAM (8KB)
.equ VRAM_START, 0x8000
.equ VRAM_END, 0x9FFF
.equ VRAM_SIZE, 8192

; Background Map 1
.equ BG_MAP_1_START, 0x9800
.equ BG_MAP_1_END, 0x9BFF
.equ BG_MAP_1_SIZE, 1024

; Background Map 2
.equ BG_MAP_2_START, 0x9C00
.equ BG_MAP_2_END, 0x9FFF
.equ BG_MAP_2_SIZE, 1024

; ROM Bank 0 (Cartridge Header)
.equ ROM_BANK0_START, 0x0000
.equ ROM_BANK0_END, 0x3FFF
.equ ROM_BANK0_SIZE, 16384

; ROM Bank 1 (Switchable)
.equ ROM_BANK1_START, 0x4000
.equ ROM_BANK1_END, 0x7FFF
.equ ROM_BANK1_SIZE, 16384

; Cartridge RAM / MBC
.equ CART_RAM_START, 0xA000
.equ CART_RAM_END, 0xBFFF
.equ CART_RAM_SIZE, 8192

; 外设定义
; LCD Controller / Picture Processing Unit
.equ PPU_BASE, 0xFF40
.equ PPU_LCDC, 0xFF40
.equ PPU_LCDC_BG_ENABLE, 0  ; Background Display Enable
.equ PPU_LCDC_SPRITE_ENABLE, 1  ; Sprite Display Enable
.equ PPU_LCDC_SPRITE_SIZE, 2  ; Sprite Size (0=8x8, 1=8x16)
.equ PPU_LCDC_BG_TILE_MAP, 3  ; BG Tile Map Area (0=9800, 1=9C00)
.equ PPU_LCDC_TILE_DATA, 4  ; Tile Data Area (0=8800, 1=8000)
.equ PPU_LCDC_WINDOW_ENABLE, 5  ; Window Display Enable
.equ PPU_LCDC_WINDOW_MAP, 6  ; Window Tile Map Area (0=9800, 1=9C00)
.equ PPU_LCDC_LCD_ENABLE, 7  ; LCD Display Enable
.equ PPU_STAT, 0xFF41
.equ PPU_STAT_MODE, 0  ; LCD Mode (0=H-Blank, 1=V-Blank, 2=OAM, 3=VRAM)
.equ PPU_STAT_LYC_FLAG, 2  ; LY=LYC Compare Flag
.equ PPU_STAT_HBLANK_IRQ, 3  ; H-Blank Interrupt Enable
.equ PPU_STAT_VBLANK_IRQ, 4  ; V-Blank Interrupt Enable
.equ PPU_STAT_OAM_IRQ, 5  ; OAM Interrupt Enable
.equ PPU_STAT_LYC_IRQ, 6  ; LYC Interrupt Enable
.equ PPU_SCY, 0xFF42
.equ PPU_SCX, 0xFF43
.equ PPU_LY, 0xFF44
.equ PPU_LYC, 0xFF45
.equ PPU_DMA, 0xFF46
.equ PPU_BGP, 0xFF47
.equ PPU_OBP0, 0xFF48
.equ PPU_OBP1, 0xFF49
.equ PPU_WY, 0xFF4A
.equ PPU_WX, 0xFF4B

; Audio Processing Unit
.equ APU_BASE, 0xFF10
.equ APU_NR10, 0xFF10
.equ APU_NR10_SWEEP_TIME, 0  ; Sweep Time
.equ APU_NR10_SWEEP_INCREASE, 3  ; Sweep Increase/Decrease
.equ APU_NR10_SWEEP_SHIFTS, 0  ; Sweep Number of Shifts
.equ APU_NR11, 0xFF11
.equ APU_NR12, 0xFF12
.equ APU_NR13, 0xFF13
.equ APU_NR14, 0xFF14
.equ APU_NR21, 0xFF16
.equ APU_NR22, 0xFF17
.equ APU_NR23, 0xFF18
.equ APU_NR24, 0xFF19
.equ APU_NR30, 0xFF1A
.equ APU_NR31, 0xFF1B
.equ APU_NR32, 0xFF1C
.equ APU_NR33, 0xFF1D
.equ APU_NR34, 0xFF1E
.equ APU_NR41, 0xFF20
.equ APU_NR42, 0xFF21
.equ APU_NR43, 0xFF22
.equ APU_NR44, 0xFF23
.equ APU_NR50, 0xFF24
.equ APU_NR51, 0xFF25
.equ APU_NR52, 0xFF26
.equ APU_NR52_CH1_ON, 0  ; Channel 1 ON
.equ APU_NR52_CH2_ON, 1  ; Channel 2 ON
.equ APU_NR52_CH3_ON, 2  ; Channel 3 ON
.equ APU_NR52_CH4_ON, 3  ; Channel 4 ON
.equ APU_NR52_ALL_ON, 7  ; All Sound ON

; Timer Unit
.equ TIMER_BASE, 0xFF04
.equ TIMER_DIV, 0xFF04
.equ TIMER_TIMA, 0xFF05
.equ TIMER_TMA, 0xFF06
.equ TIMER_TAC, 0xFF07
.equ TIMER_TAC_TIMER_ENABLE, 2  ; Timer Enable
.equ TIMER_TAC_CLOCK_SEL, 0  ; Clock Select (00=4kHz, 01=262kHz, 10=65kHz, 11=16kHz)

; Joypad Controller
.equ JOYPAD_BASE, 0xFF00
.equ JOYPAD_P1, 0xFF00
.equ JOYPAD_P1_A_BTN, 0  ; A Button (1=Pressed when selected)
.equ JOYPAD_P1_B_BTN, 1  ; B Button (1=Pressed when selected)
.equ JOYPAD_P1_SELECT, 2  ; Select Button (1=Pressed)
.equ JOYPAD_P1_START, 3  ; Start Button (1=Pressed)
.equ JOYPAD_P1_DIR_DOWN, 4  ; Direction Down (1=Pressed when selected)
.equ JOYPAD_P1_DIR_UP, 5  ; Direction Up (1=Pressed when selected)
.equ JOYPAD_P1_DIR_LEFT, 6  ; Direction Left (1=Pressed when selected)
.equ JOYPAD_P1_DIR_RIGHT, 7  ; Direction Right (1=Pressed when selected)

; Serial I/O (Link Cable)
.equ SERIAL_BASE, 0xFF01
.equ SERIAL_SB, 0xFF01
.equ SERIAL_SC, 0xFF02
.equ SERIAL_SC_TRANSFER_START, 7  ; Transfer Start
.equ SERIAL_SC_CLOCK_SPEED, 1  ; Clock Select (0=External, 1=Internal 8192Hz)

; Interrupt Flag Register
.equ INTERRUPT_BASE, 0xFF0F
.equ INTERRUPT_IF, 0xFF0F
.equ INTERRUPT_IF_VBLANK, 0  ; V-Blank Interrupt Request
.equ INTERRUPT_IF_LCDC, 1  ; LCDC Status Interrupt Request
.equ INTERRUPT_IF_TIMER, 2  ; Timer Overflow Interrupt Request
.equ INTERRUPT_IF_SERIAL, 3  ; Serial Transfer Complete Interrupt Request
.equ INTERRUPT_IF_JOYPAD, 4  ; Joypad Interrupt Request

; Interrupt Enable Register
.equ IE_BASE, 0xFFFF
.equ IE_IE, 0xFFFF
.equ IE_IE_VBLANK_IE, 0  ; V-Blank Interrupt Enable
.equ IE_IE_LCDC_IE, 1  ; LCDC Status Interrupt Enable
.equ IE_IE_TIMER_IE, 2  ; Timer Interrupt Enable
.equ IE_IE_SERIAL_IE, 3  ; Serial Interrupt Enable
.equ IE_IE_JOYPAD_IE, 4  ; Joypad Interrupt Enable

; 中断向量定义
.equ VBLANK_VECTOR, 0  ; V-Blank Interrupt (LY=144, during vertical blanking)
.equ LCDC_STATUS_VECTOR, 1  ; LCDC Status Interrupt (H-Blank/OAM/V-Count match)
.equ TIMER_OVERFLOW_VECTOR, 2  ; Timer Overflow Interrupt (TIMA overflow)
.equ SERIAL_COMPLETE_VECTOR, 3  ; Serial Transfer Complete Interrupt
.equ JOYPAD_VECTOR, 4  ; Joypad Interrupt (button press/release)

; 引脚定义
.equ PIN_VSS, 1  ; Ground
.equ PIN_VDD, 2  ; Power Supply
.equ PIN_PHI, 3  ; System Clock Output (4.19MHz / 2 = 2.1MHz CPU)
.equ PIN_RESET, 4  ; Reset Signal (active low)
.equ PIN_INT, 5  ; Interrupt Request
.equ PIN_BUSREQ, 6  ; Bus Request (external DMA access)
.equ PIN_A0, 7  ; Address Bus Bit 0
.equ PIN_A1, 8  ; Address Bus Bit 1
.equ PIN_A2, 9  ; Address Bus Bit 2
.equ PIN_A3, 10  ; Address Bus Bit 3
.equ PIN_A4, 11  ; Address Bus Bit 4
.equ PIN_A5, 12  ; Address Bus Bit 5
.equ PIN_A6, 13  ; Address Bus Bit 6
.equ PIN_A7, 14  ; Address Bus Bit 7
.equ PIN_A8, 15  ; Address Bus Bit 8
.equ PIN_A9, 16  ; Address Bus Bit 9
.equ PIN_A10, 17  ; Address Bus Bit 10
.equ PIN_A11, 18  ; Address Bus Bit 11
.equ PIN_A12, 19  ; Address Bus Bit 12
.equ PIN_A13, 20  ; Address Bus Bit 13
.equ PIN_A14, 21  ; Address Bus Bit 14
.equ PIN_A15, 22  ; Address Bus Bit 15
.equ PIN_D0, 23  ; Data Bus Bit 0
.equ PIN_D1, 24  ; Data Bus Bit 1
.equ PIN_D2, 25  ; Data Bus Bit 2
.equ PIN_D3, 26  ; Data Bus Bit 3
.equ PIN_D4, 27  ; Data Bus Bit 4
.equ PIN_D5, 28  ; Data Bus Bit 5
.equ PIN_D6, 29  ; Data Bus Bit 6
.equ PIN_D7, 30  ; Data Bus Bit 7
.equ PIN_RD, 31  ; Read Strobe (active low)
.equ PIN_WR, 32  ; Write Strobe (active low)
.equ PIN_CS, 33  ; Chip Select (active low)
.equ PIN_SOUND_OUT, 34  ; Audio Output
.equ PIN_LCD_DATA0, 35  ; LCD Data Bus Bit 0
.equ PIN_LCD_DATA1, 36  ; LCD Data Bus Bit 1
.equ PIN_LCD_DATA2, 37  ; LCD Data Bus Bit 2
.equ PIN_LCD_DATA3, 38  ; LCD Data Bus Bit 3
.equ PIN_LCD_DATA4, 39  ; LCD Data Bus Bit 4
.equ PIN_LCD_DATA5, 40  ; LCD Data Bus Bit 5
.equ PIN_LCD_DATA6, 41  ; LCD Data Bus Bit 6
.equ PIN_LCD_DATA7, 42  ; LCD Data Bus Bit 7
.equ PIN_IR, 43  ; Infrared Port (DMG-CGB-01)

; 宏定义
.macro sharp_lr35902_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
sharp_lr35902_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
