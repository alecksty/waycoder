; RA4M2寄存器定义
; 生成自: Renesas/RA/RA4M2
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: 32-bit ARM Cortex-M4 MCU with 256KB Flash, 128KB RAM, 100MHz

; CPU架构: ARM-Cortex-M4
; 位宽: 32位
; 时钟频率: 100000000 Hz

; 寄存器定义
.equ R0, 0x00

.equ R1, 0x04

.equ R2, 0x08

.equ R3, 0x0C

.equ R4, 0x10

.equ R5, 0x14

.equ SP, 0x34

.equ LR, 0x38

.equ PC, 0x3C

; 内存段定义
.equ FLASH_START, 0x00000000
.equ FLASH_END, 0x0003FFFF
.equ FLASH_SIZE, 262144

; SRAM0
.equ SRAM_START, 0x1FFE0000
.equ SRAM_END, 0x1FFE7FFF
.equ SRAM_SIZE, 32768

; SRAM1
.equ SRAM1_START, 0x20000000
.equ SRAM1_END, 0x20017FFF
.equ SRAM1_SIZE, 98304

.equ PERIPHERAL_START, 0x40000000
.equ PERIPHERAL_END, 0x400FFFFF
.equ PERIPHERAL_SIZE, 1048576

; 外设定义
; Module Stop Control
.equ MSTP_BASE, 0x40020000
.equ MSTP_MSTPCR_A, 0x20
.equ MSTP_MSTPCR_A_MSTP41, 9  ; GPIO A stop
.equ MSTP_MSTPCR_A_MSTP42, 10  ; GPIO B stop
.equ MSTP_MSTPCR_B, 0x24
.equ MSTP_MSTPCR_C, 0x28
.equ MSTP_MSTPCR_D, 0x2C

; Interrupt Controller Unit
.equ ICU_BASE, 0x40030000
.equ ICU_IRQCR0, 0x600
.equ ICU_IRQCR1, 0x602

; General Purpose I/O Port A
.equ GPIOA_BASE, 0x40040000
.equ GPIOA_PDR, 0x00
.equ GPIOA_PODR, 0x04
.equ GPIOA_PIDR, 0x08
.equ GPIOA_PMR, 0x10
.equ GPIOA_PCR, 0x18

; General Purpose I/O Port B
.equ GPIOB_BASE, 0x40040020
.equ GPIOB_PDR, 0x00
.equ GPIOB_PODR, 0x04
.equ GPIOB_PIDR, 0x08
.equ GPIOB_PMR, 0x10

; SCI UART 0
.equ SCIUART0_BASE, 0x40070000
.equ SCIUART0_SCR, 0x00
.equ SCIUART0_BRR, 0x04
.equ SCIUART0_TDR, 0x08
.equ SCIUART0_RDR, 0x0C
.equ SCIUART0_SSR, 0x10

; 中断向量定义
.equ RESET_VECTOR, 0  ; 
.equ SVCALL_VECTOR, 11  ; 
.equ SCIUART0_RXI_VECTOR, 24  ; SCI UART0 Receive Interrupt
.equ SCIUART0_TXI_VECTOR, 25  ; SCI UART0 Transmit Interrupt

; 宏定义
.macro ra4m2_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
ra4m2_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
