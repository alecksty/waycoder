; LPC54606寄存器定义
; 生成自: NXP/LPC/LPC54606
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: 32-bit ARM Cortex-M4 MCU with 256KB Flash, 136KB SRAM, 180MHz

; CPU架构: ARM-Cortex-M4
; 位宽: 32位
; 时钟频率: 180000000 Hz

; 寄存器定义
.equ R0, 0x00

.equ R1, 0x04

.equ R2, 0x08

.equ R3, 0x0C

.equ R4, 0x10

.equ R5, 0x14

.equ SP, 0x34

.equ LR, 0x38

.equ PC, 0x3C

; 内存段定义
.equ FLASH_START, 0x00000000
.equ FLASH_END, 0x0003FFFF
.equ FLASH_SIZE, 262144

.equ SRAM_START, 0x20000000
.equ SRAM_END, 0x20021FFF
.equ SRAM_SIZE, 139264

.equ PERIPHERAL_START, 0x40000000
.equ PERIPHERAL_END, 0x401FFFFF
.equ PERIPHERAL_SIZE, 2097152

; 外设定义
; System Control
.equ SYSCON_BASE, 0x40000000
.equ SYSCON_SYSAHBCLKCTRL, 0x80
.equ SYSCON_MAINCLKSEL, 0x04
.equ SYSCON_MAINCLKUEN, 0x08
.equ SYSCON_SYSPLLCTRL, 0x0C

; General Purpose I/O
.equ GPIO_BASE, 0x400F4000
.equ GPIO_DIR0, 0x0000
.equ GPIO_PIN0, 0x1000
.equ GPIO_SET0, 0x2000
.equ GPIO_CLR0, 0x3000
.equ GPIO_NOT0, 0x4000
.equ GPIO_DIR1, 0x0004
.equ GPIO_PIN1, 0x1004
.equ GPIO_SET1, 0x2004
.equ GPIO_CLR1, 0x3004
.equ GPIO_NOT1, 0x4004

; USART0
.equ USART0_BASE, 0x40086000
.equ USART0_CFG, 0x00
.equ USART0_CTRL, 0x04
.equ USART0_STAT, 0x08
.equ USART0_TXDAT, 0x10
.equ USART0_RXDAT, 0x14
.equ USART0_BRG, 0x20

; 中断向量定义
.equ RESET_VECTOR, 0  ; 
.equ SVCALL_VECTOR, 11  ; 
.equ USART0_VECTOR, 24  ; USART0 Interrupt

; 宏定义
.macro lpc54606_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
lpc54606_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
