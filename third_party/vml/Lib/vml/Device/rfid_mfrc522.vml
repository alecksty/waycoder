; MFRC522寄存器定义
; 生成自: NXP/RFID/MFRC522
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: MFRC522 13.56MHz RFID/NFC Reader (SPI, ISO 14443A, MIFARE)

; CPU架构: RFID
; 位宽: 8位
; 时钟频率: 10000000 Hz

; 内存段定义
; 64-byte FIFO buffer
.equ FIFO_START, 0x00
.equ FIFO_END, 0x3F
.equ FIFO_SIZE, 64

; 外设定义
; MFRC522 NFC Reader (SPI, 3.3V, 13.56MHz)
.equ MFRC522_BASE, 0x00
.equ MFRC522_CMD, 0x01
.equ MFRC522_COM_IRQ, 0x04
.equ MFRC522_COM_IRQ_TX_IRQ, 6  ; Transmitter interrupt
.equ MFRC522_COM_IRQ_RX_IRQ, 5  ; Receiver interrupt
.equ MFRC522_COM_IRQ_IDLE_IRQ, 4  ; Idle interrupt
.equ MFRC522_COM_IRQ_TIMER_IRQ, 0  ; Timer interrupt
.equ MFRC522_COM_IRQ_EN, 0x05
.equ MFRC522_ERROR, 0x06
.equ MFRC522_STATUS2, 0x08
.equ MFRC522_FIFO_DATA, 0x09
.equ MFRC522_FIFO_LEVEL, 0x0A
.equ MFRC522_TX_CTRL, 0x14
.equ MFRC522_TX_ASK, 0x15
.equ MFRC522_MODE, 0x11
.equ MFRC522_VERSION, 0x37

; 宏定义
.macro mfrc522_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
mfrc522_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
