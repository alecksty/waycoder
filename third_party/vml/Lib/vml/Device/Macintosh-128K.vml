; Macintosh-128K寄存器定义
; 生成自: Apple Computer/Macintosh/Macintosh-128K
; 版本: 1.0
; 日期: 2026-04-17
; 作者: VML Team
; 描述: Original Macintosh 128K with Motorola 68000 CPU, 128KB RAM, and 9-inch monochrome display

; CPU架构: Motorola 68000
; 位宽: 32位
; 时钟频率: 7998000 Hz

; 寄存器定义
; Data Register 0
.equ D0, 0

; Data Register 1
.equ D1, 0

; Data Register 2
.equ D2, 0

; Data Register 3
.equ D3, 0

; Data Register 4
.equ D4, 0

; Data Register 5
.equ D5, 0

; Data Register 6
.equ D6, 0

; Data Register 7
.equ D7, 0

; Address Register 0
.equ A0, 0

; Address Register 1
.equ A1, 0

; Address Register 2
.equ A2, 0

; Address Register 3
.equ A3, 0

; Address Register 4
.equ A4, 0

; Address Register 5
.equ A5, 0

; Address Register 6
.equ A6, 0

; Address Register 7 (SP)
.equ A7, 0

; Program Counter
.equ PC, 0

; Status Register
.equ SR, 0

; 外设定义
; Versatile Interface Adapter (6522)
.equ VIA_BASE, 
.equ VIA_VIA_ORB, 0xE80000
.equ VIA_VIA_ORA, 0xE80001
.equ VIA_VIA_DDRB, 0xE80002
.equ VIA_VIA_DDRA, 0xE80003
.equ VIA_VIA_T1CL, 0xE80004
.equ VIA_VIA_T1CH, 0xE80005
.equ VIA_VIA_T1LL, 0xE80006
.equ VIA_VIA_T1LH, 0xE80007
.equ VIA_VIA_T2CL, 0xE80008
.equ VIA_VIA_T2CH, 0xE80009
.equ VIA_VIA_SR, 0xE8000A
.equ VIA_VIA_ACR, 0xE8000B
.equ VIA_VIA_PCR, 0xE8000C
.equ VIA_VIA_IFR, 0xE8000D
.equ VIA_VIA_IER, 0xE8000E
.equ VIA_VIA_ORA2, 0xE8000F

; Integrated Woz Machine (floppy controller)
.equ IWM_BASE, 
.equ IWM_IWM_Q6, 0xD00000
.equ IWM_IWM_Q7, 0xD00002
.equ IWM_IWM_PH0, 0xD00004
.equ IWM_IWM_PH1, 0xD00006
.equ IWM_IWM_PH2, 0xD00008
.equ IWM_IWM_PH3, 0xD0000A

; Zilog 8530 Serial Communications Controller
.equ SCC_BASE, 
.equ SCC_SCC_CA, 0x500000
.equ SCC_SCC_DA, 0x500002
.equ SCC_SCC_CB, 0x500004
.equ SCC_SCC_DB, 0x500006

; Built-in speaker
.equ SOUND_BASE, 
.equ SOUND_SOUND_VOL, 0xE80100
.equ SOUND_SOUND_FREQ, 0xE80102

; 中断向量定义
.equ RESET_SP_VECTOR, 0  ; Reset (Initial SP)
.equ RESET_PC_VECTOR, 4  ; Reset (Initial PC)
.equ AUTOVECTOR1_VECTOR, 24  ; Auto vector 1
.equ AUTOVECTOR2_VECTOR, 25  ; Auto vector 2
.equ AUTOVECTOR3_VECTOR, 26  ; Auto vector 3
.equ AUTOVECTOR4_VECTOR, 27  ; Auto vector 4
.equ AUTOVECTOR5_VECTOR, 28  ; Auto vector 5
.equ AUTOVECTOR6_VECTOR, 29  ; Auto vector 6
.equ AUTOVECTOR7_VECTOR, 30  ; Auto vector 7
.equ SPURIOUS_VECTOR, 31  ; Spurious interrupt

; 宏定义
.macro macintosh_128k_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
macintosh_128k_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
