; IBM PC/AT寄存器定义
; 生成自: IBM/IBM PC/IBM PC/AT
; 版本: 
; 日期: 
; 作者: 
; 描述: IBM Personal Computer/Advanced Technology (Model 5170)

; CPU架构: x86-16
; 位宽: 0位
; 时钟频率: 0 Hz

; 外设定义
; Programmable Interrupt Controller
.equ _8259A_BASE, 
.equ _8259A_ICW1, 0x20
.equ _8259A_ICW2, 0x21
.equ _8259A_ICW3, 0x21
.equ _8259A_ICW4, 0x21
.equ _8259A_OCW1, 0x21
.equ _8259A_OCW2, 0x20
.equ _8259A_OCW3, 0x20

; Programmable Interval Timer
.equ _8253_BASE, 
.equ _8253_COUNTER0, 0x40
.equ _8253_COUNTER1, 0x41
.equ _8253_COUNTER2, 0x42
.equ _8253_CONTROL, 0x43

; Direct Memory Access Controller
.equ _8237_BASE, 
.equ _8237_CHANNEL0, 0x00
.equ _8237_CHANNEL1, 0x02
.equ _8237_CHANNEL2, 0x04
.equ _8237_CHANNEL3, 0x06
.equ _8237_STATUS, 0x08
.equ _8237_COMMAND, 0x08
.equ _8237_REQUEST, 0x09
.equ _8237_MASK, 0x0A
.equ _8237_MODE, 0x0B

; Keyboard Controller
.equ _8042_BASE, 
.equ _8042_DATA, 0x60
.equ _8042_STATUS, 0x64

; Real-Time Clock with CMOS RAM
.equ CMOS_BASE, 
.equ CMOS_ADDRESS, 0x70
.equ CMOS_DATA, 0x71

; Floppy Disk Controller
.equ FDC_BASE, 
.equ FDC_SRA, 0x3F2
.equ FDC_MSR, 0x3F4
.equ FDC_DATA, 0x3F5
.equ FDC_DIR, 0x3F7
.equ FDC_CCR, 0x3F7

; Hard Disk Controller (ST-506/412)
.equ HDC_BASE, 
.equ HDC_DATA, 0x1F0
.equ HDC_ERROR, 0x1F1
.equ HDC_SECTORCOUNT, 0x1F2
.equ HDC_SECTORNUMBER, 0x1F3
.equ HDC_CYLINDERLOW, 0x1F4
.equ HDC_CYLINDERHIGH, 0x1F5
.equ HDC_DRIVEHEAD, 0x1F6
.equ HDC_STATUS, 0x1F7
.equ HDC_COMMAND, 0x1F7

; Color Graphics Adapter
.equ CGA_BASE, 
.equ CGA_CRTC_INDEX, 0x3D4
.equ CGA_CRTC_DATA, 0x3D5
.equ CGA_MODECONTROL, 0x3D8
.equ CGA_COLORSELECT, 0x3D9
.equ CGA_STATUS, 0x3DA

; Enhanced Graphics Adapter
.equ EGA_BASE, 
.equ EGA_CRTC_INDEX, 0x3D4
.equ EGA_CRTC_DATA, 0x3D5
.equ EGA_FEATURECONTROL, 0x3DA
.equ EGA_GRAPHICS1POS, 0x3CC
.equ EGA_GRAPHICS2POS, 0x3CA
.equ EGA_SEQUENCERINDEX, 0x3C4
.equ EGA_SEQUENCERDATA, 0x3C5
.equ EGA_GRAPHICSINDEX, 0x3CE
.equ EGA_GRAPHICSDATA, 0x3CF
.equ EGA_ATTRIBUTEINDEX, 0x3C0
.equ EGA_ATTRIBUTEDATA, 0x3C1

; Video Graphics Array
.equ VGA_BASE, 
.equ VGA_CRTC_INDEX, 0x3D4
.equ VGA_CRTC_DATA, 0x3D5
.equ VGA_INPUTSTATUS1, 0x3DA
.equ VGA_FEATURECONTROL, 0x3DA
.equ VGA_MISCOUTPUT, 0x3C2
.equ VGA_SEQUENCERINDEX, 0x3C4
.equ VGA_SEQUENCERDATA, 0x3C5
.equ VGA_GRAPHICSINDEX, 0x3CE
.equ VGA_GRAPHICSDATA, 0x3CF
.equ VGA_ATTRIBUTEINDEX, 0x3C0
.equ VGA_ATTRIBUTEDATA, 0x3C1
.equ VGA_DACMASK, 0x3C6
.equ VGA_DACREADINDEX, 0x3C7
.equ VGA_DACWRITEINDEX, 0x3C8
.equ VGA_DACDATA, 0x3C9

; Game Port
.equ GAMEPORT_BASE, 
.equ GAMEPORT_DATA, 0x201

; Parallel Printer Port
.equ PARALLELPORT_BASE, 
.equ PARALLELPORT_DATA, 0x378
.equ PARALLELPORT_STATUS, 0x379
.equ PARALLELPORT_CONTROL, 0x37A

; Serial Communications Port
.equ SERIALPORT_BASE, 
.equ SERIALPORT_DATA, 0x3F8
.equ SERIALPORT_IER, 0x3F9
.equ SERIALPORT_IIR, 0x3FA
.equ SERIALPORT_LCR, 0x3FB
.equ SERIALPORT_MCR, 0x3FC
.equ SERIALPORT_LSR, 0x3FD
.equ SERIALPORT_MSR, 0x3FE
.equ SERIALPORT_SCR, 0x3FF

; PC Speaker
.equ SPEAKER_BASE, 
.equ SPEAKER_CONTROL, 0x61

; 中断向量定义
.equ DIVIDE_ERROR_VECTOR, 0  ; Division by zero
.equ SINGLE_STEP_VECTOR, 1  ; Debug single step
.equ NMI_VECTOR, 2  ; Non-maskable interrupt
.equ BREAKPOINT_VECTOR, 3  ; INT 3 instruction
.equ OVERFLOW_VECTOR, 4  ; INTO instruction
.equ PRINT_SCREEN_VECTOR, 5  ; Print screen key
.equ IRQ0_VECTOR, 8  ; Timer interrupt
.equ IRQ1_VECTOR, 9  ; Keyboard interrupt
.equ IRQ2_VECTOR, 10  ; Cascade to IRQ8-15
.equ IRQ3_VECTOR, 11  ; COM2 interrupt
.equ IRQ4_VECTOR, 12  ; COM1 interrupt
.equ IRQ5_VECTOR, 13  ; LPT2 interrupt
.equ IRQ6_VECTOR, 14  ; Floppy disk interrupt
.equ IRQ7_VECTOR, 15  ; LPT1 interrupt
.equ IRQ8_VECTOR, 112  ; Real-time clock interrupt
.equ IRQ9_VECTOR, 113  ; Redirected IRQ2
.equ IRQ10_VECTOR, 114  ; Reserved
.equ IRQ11_VECTOR, 115  ; Reserved
.equ IRQ12_VECTOR, 116  ; PS/2 mouse interrupt
.equ IRQ13_VECTOR, 117  ; Coprocessor interrupt
.equ IRQ14_VECTOR, 118  ; Primary IDE interrupt
.equ IRQ15_VECTOR, 119  ; Secondary IDE interrupt
.equ VIDEO_SERVICES_VECTOR, 16  ; Video BIOS services
.equ DISK_SERVICES_VECTOR, 19  ; Disk BIOS services
.equ DOS_SERVICES_VECTOR, 21  ; DOS function calls

; 宏定义
.macro ibm_pc_at_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
ibm_pc_at_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
