; 8051寄存器定义
; 生成自: Intel/MCS-51/8051
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: 8-bit microcontroller with 4KB ROM, 128B RAM, 32 I/O lines

; CPU架构: MCS-51
; 位宽: 8位
; 时钟频率: 11059200 Hz

; 寄存器定义
; Accumulator
.equ ACC, 0xE0

; B Register
.equ B, 0xF0

; Program Status Word
.equ PSW, 0xD0
.equ PSW_P, 0  ; Parity Flag
.equ PSW_OV, 2  ; Overflow Flag
.equ PSW_RS0, 3  ; Register Bank Select 0
.equ PSW_RS1, 4  ; Register Bank Select 1
.equ PSW_F0, 5  ; Flag 0
.equ PSW_AC, 6  ; Auxiliary Carry Flag
.equ PSW_CY, 7  ; Carry Flag

; Stack Pointer
.equ SP, 0x81

; Data Pointer (DPL/DPH)
.equ DPTR, 0x82

; 内存段定义
; Program Memory
.equ CODE_START, 0x0000
.equ CODE_END, 0x0FFF
.equ CODE_SIZE, 4096

; Internal Data Memory
.equ IDATA_START, 0x00
.equ IDATA_END, 0x7F
.equ IDATA_SIZE, 128

; Special Function Registers
.equ SFR_START, 0x80
.equ SFR_END, 0xFF
.equ SFR_SIZE, 128

; External Data Memory
.equ XDATA_START, 0x0000
.equ XDATA_END, 0xFFFF
.equ XDATA_SIZE, 65536

; 外设定义
; Port 0
.equ PORT0_BASE, 0x80
.equ PORT0_P0, 0x80

; Port 1
.equ PORT1_BASE, 0x90
.equ PORT1_P1, 0x90

; Port 2
.equ PORT2_BASE, 0xA0
.equ PORT2_P2, 0xA0

; Port 3
.equ PORT3_BASE, 0xB0
.equ PORT3_P3, 0xB0

; Timer/Counter 0
.equ TIMER0_BASE, 0x8A
.equ TIMER0_TH0, 0x8C
.equ TIMER0_TL0, 0x8A
.equ TIMER0_TMOD, 0x89
.equ TIMER0_TMOD_M0_0, 0  ; Timer 0 Mode bit 0
.equ TIMER0_TMOD_M1_0, 1  ; Timer 0 Mode bit 1
.equ TIMER0_TMOD_C_T0, 2  ; Timer 0 Counter/Timer Select
.equ TIMER0_TMOD_GATE0, 3  ; Timer 0 Gate Control
.equ TIMER0_TCON, 0x88
.equ TIMER0_TCON_TR0, 4  ; Timer 0 Run Control
.equ TIMER0_TCON_TF0, 5  ; Timer 0 Overflow Flag

; Serial Port
.equ UART_BASE, 0x98
.equ UART_SBUF, 0x99
.equ UART_SCON, 0x98
.equ UART_SCON_RI, 0  ; Receive Interrupt Flag
.equ UART_SCON_TI, 1  ; Transmit Interrupt Flag
.equ UART_SCON_REN, 4  ; Receive Enable
.equ UART_SCON_SM0, 6  ; Serial Mode bit 0
.equ UART_SCON_SM1, 7  ; Serial Mode bit 1

; 中断向量定义
.equ RESET_VECTOR, 0  ; Reset Vector
.equ INT0_VECTOR, 1  ; External Interrupt 0
.equ TIMER0_VECTOR, 2  ; Timer 0 Interrupt
.equ INT1_VECTOR, 3  ; External Interrupt 1
.equ TIMER1_VECTOR, 4  ; Timer 1 Interrupt
.equ UART_VECTOR, 5  ; Serial Port Interrupt

; 引脚定义
.equ PIN_P1_0, 1  ; Port 1, bit 0
.equ PIN_P1_1, 2  ; Port 1, bit 1
.equ PIN_P1_2, 3  ; Port 1, bit 2
.equ PIN_P1_3, 4  ; Port 1, bit 3
.equ PIN_P1_4, 5  ; Port 1, bit 4
.equ PIN_P1_5, 6  ; Port 1, bit 5
.equ PIN_P1_6, 7  ; Port 1, bit 6
.equ PIN_P1_7, 8  ; Port 1, bit 7
.equ PIN_RST, 9  ; Reset Pin
.equ PIN_RX, 10  ; Serial Receive (P3.0)
.equ PIN_TX, 11  ; Serial Transmit (P3.1)
.equ PIN_INT0, 12  ; External Interrupt 0 (P3.2)
.equ PIN_INT1, 13  ; External Interrupt 1 (P3.3)
.equ PIN_T0, 14  ; Timer 0 Input (P3.4)
.equ PIN_T1, 15  ; Timer 1 Input (P3.5)
.equ PIN_WR, 16  ; External Memory Write Strobe (P3.6)
.equ PIN_RD, 17  ; External Memory Read Strobe (P3.7)
.equ PIN_XTAL1, 18  ; Crystal Oscillator Input
.equ PIN_XTAL2, 19  ; Crystal Oscillator Output
.equ PIN_VCC, 20  ; Power Supply (+5V)
.equ PIN_GND, 21  ; Ground

; 宏定义
.macro _8051_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
_8051_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
