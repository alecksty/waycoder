; Sega-Master-System寄存器定义
; 生成自: Sega/Master System/Sega-Master-System
; 版本: 1.0
; 日期: 2026-04-17
; 作者: VML Team
; 描述: Sega Master System 8-bit video game console with Z80 CPU

; CPU架构: Zilog Z80
; 位宽: 8位
; 时钟频率: 3579545 Hz

; 寄存器定义
; Accumulator
.equ A, 0

; Flags
.equ F, 0

; B
.equ B, 0

; C
.equ C, 0

; D
.equ D, 0

; E
.equ E, 0

; H
.equ H, 0

; L
.equ L, 0

; Index Register X
.equ IX, 0

; Index Register Y
.equ IY, 0

; Stack Pointer
.equ SP, 0

; Program Counter
.equ PC, 0

; Interrupt Vector
.equ I, 0

; Memory Refresh
.equ R, 0

; 外设定义
; Video Display Processor (TMS9918A)
.equ VDP_BASE, 
.equ VDP_VDP_DATA, 0xBE
.equ VDP_VDP_ADDR, 0xBF
.equ VDP_VDP_STATUS, 0xBF

; Programmable Sound Generator (SN76489)
.equ PSG_BASE, 
.equ PSG_PSG_DATA, 0x7F

; I/O ports
.equ IO_BASE, 
.equ IO_IO_PORT_A, 0xDC
.equ IO_IO_PORT_B, 0xDD
.equ IO_IO_PORT_MISC, 0xDE
.equ IO_IO_PORT_VDP, 0xDF

; Memory mapper
.equ MEMORYMAPPER_BASE, 
.equ MEMORYMAPPER_MAPPER_0, 0xFFFC
.equ MEMORYMAPPER_MAPPER_1, 0xFFFD
.equ MEMORYMAPPER_MAPPER_2, 0xFFFE
.equ MEMORYMAPPER_MAPPER_3, 0xFFFF

; FM Sound Unit (optional)
.equ FMUNIT_BASE, 
.equ FMUNIT_FM_ADDR, 0xF0
.equ FMUNIT_FM_DATA, 0xF1
.equ FMUNIT_FM_DETECT, 0xF2

; 中断向量定义
.equ RST_00_VECTOR, 0  ; Restart 00h
.equ IM1_VECTOR, 56  ; Interrupt Mode 1
.equ VBLANK_VECTOR, 56  ; Vertical blank interrupt
.equ LINE_VECTOR, 100  ; Line interrupt

; 宏定义
.macro sega_master_system_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
sega_master_system_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
