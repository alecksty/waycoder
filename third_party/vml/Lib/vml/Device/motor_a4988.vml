; A4988寄存器定义
; 生成自: Allegro/Motor/A4988
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: A4988 Stepper Motor Driver (up to 1/16 microstepping, 2A, 8V-35V)

; CPU架构: Motor
; 位宽: 8位
; 时钟频率: 0 Hz

; 外设定义
; A4988 Stepper Motor Driver (3.3V/5V logic)
.equ A4988_BASE, 0x00
.equ A4988_CTRL, 0x00
.equ A4988_CTRL_STEP, 0  ; Step pulse (rising edge)
.equ A4988_CTRL_DIR, 1  ; Direction (0=CW, 1=CCW)
.equ A4988_CTRL_ENABLE, 2  ; Enable (active low)
.equ A4988_CTRL_SLEEP, 3  ; Sleep mode (active low)
.equ A4988_CTRL_RESET, 4  ; Reset (active low)
.equ A4988_MICROSTEP, 0x01
.equ A4988_MICROSTEP_MS1, 0  ; Microstep select 1
.equ A4988_MICROSTEP_MS2, 1  ; Microstep select 2
.equ A4988_MICROSTEP_MS3, 2  ; Microstep select 3
.equ A4988_STEPS, 0x02
.equ A4988_DELAY_US, 0x06

; 宏定义
.macro a4988_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
a4988_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
