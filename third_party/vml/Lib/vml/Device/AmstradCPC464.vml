; Amstrad-CPC-464寄存器定义
; 生成自: Amstrad/CPC/Amstrad-CPC-464
; 版本: 1.0
; 日期: 2026-04-17
; 作者: VML Team
; 描述: Amstrad CPC 464 - British 8-bit home computer with Z80 CPU and built-in cassette recorder

; CPU架构: Z80A
; 位宽: 8位
; 时钟频率: 4000000 Hz

; 寄存器定义
; Accumulator
.equ A, 0x00

; Flags
.equ F, 0x01
.equ F_C, 0  ; Carry
.equ F_N, 1  ; Subtract
.equ F_PV, 2  ; Parity/Overflow
.equ F_H, 4  ; Half Carry
.equ F_Z, 6  ; Zero
.equ F_S, 7  ; Sign

; B Register
.equ B, 0x02

; C Register
.equ C, 0x03

; D Register
.equ D, 0x04

; E Register
.equ E, 0x05

; H Register
.equ H, 0x06

; L Register
.equ L, 0x07

; Alternate AF
.equ AF, 0x08

; Alternate BC
.equ BC, 0x0A

; Alternate DE
.equ DE, 0x0C

; Alternate HL
.equ HL, 0x0E

; Interrupt Vector
.equ I, 0x10

; Refresh
.equ R, 0x11

; Index X
.equ IX, 0x12

; Index Y
.equ IY, 0x14

; Stack Pointer
.equ SP, 0x16

; Program Counter
.equ PC, 0x18

; 内存段定义
; Lower ROM (AMSDOS / CP/M)
.equ LOWER_ROM_START, 0x0000
.equ LOWER_ROM_END, 0x3FFF
.equ LOWER_ROM_SIZE, 16384

; Lower RAM bank (switchable)
.equ RAM_BANK0_START, 0x0000
.equ RAM_BANK0_END, 0x3FFF
.equ RAM_BANK0_SIZE, 16384

; Main RAM (32KB)
.equ RAM_MAIN_START, 0x4000
.equ RAM_MAIN_END, 0xBFFF
.equ RAM_MAIN_SIZE, 32768

; Upper ROM (BASIC)
.equ UPPER_ROM_START, 0xC000
.equ UPPER_ROM_END, 0xFFFF
.equ UPPER_ROM_SIZE, 16384

; 外设定义
; Gate Array - Custom ASIC (video/sound/RAM control)
.equ GA_BASE, 0x7F00
.equ GA_GA_MR, 0x7F00
.equ GA_GA_IR, 0x7F01
.equ GA_GA_R1, 0x7F02
.equ GA_GA_R2, 0x7F03
.equ GA_GA_R3, 0x7F04
.equ GA_GA_R4, 0x7F05
.equ GA_GA_R5, 0x7F06
.equ GA_GA_R6, 0x7F07
.equ GA_GA_R7, 0x7F08

; CRT Controller 6845 - Video timing
.equ CRTC_BASE, 0xBC00
.equ CRTC_CRTC_REG, 0xBC00
.equ CRTC_CRTC_DATA, 0xBD00
.equ CRTC_CRTC_H_TOTAL, 0xBC01
.equ CRTC_CRTC_H_DISP, 0xBC02
.equ CRTC_CRTC_HSYNC_POS, 0xBC03
.equ CRTC_CRTC_HSYNC_WIDTH, 0xBC04
.equ CRTC_CRTC_V_TOTAL, 0xBC05
.equ CRTC_CRTC_V_TOTAL_ADJ, 0xBC06
.equ CRTC_CRTC_V_DISP, 0xBC07
.equ CRTC_CRTC_VSYNC_POS, 0xBC08
.equ CRTC_CRTC_INTERLACE, 0xBC09
.equ CRTC_CRTC_CURSOR_START, 0xBC0A
.equ CRTC_CRTC_CURSOR_END, 0xBC0B
.equ CRTC_CRTC_SA_HI, 0xBC0C
.equ CRTC_CRTC_SA_LO, 0xBC0D
.equ CRTC_CRTC_CURSOR_HI, 0xBC0E
.equ CRTC_CRTC_CURSOR_LO, 0xBC0F

; AY-3-8912 Programmable Sound Generator
.equ PSG_BASE, 0xF400
.equ PSG_PSG_REG, 0xF400
.equ PSG_PSG_DATA, 0xF600
.equ PSG_FREQ_A_LO, 0xF400
.equ PSG_FREQ_A_HI, 0xF401
.equ PSG_FREQ_B_LO, 0xF402
.equ PSG_FREQ_B_HI, 0xF403
.equ PSG_FREQ_C_LO, 0xF404
.equ PSG_FREQ_C_HI, 0xF405
.equ PSG_NOISE_FREQ, 0xF406
.equ PSG_ENABLE, 0xF407
.equ PSG_VOL_A, 0xF408
.equ PSG_VOL_B, 0xF409
.equ PSG_VOL_C, 0xF40A
.equ PSG_ENV_FREQ_LO, 0xF40B
.equ PSG_ENV_FREQ_HI, 0xF40C
.equ PSG_ENV_SHAPE, 0xF40D
.equ PSG_PORT_A, 0xF40E
.equ PSG_PORT_B, 0xF40F

; WD1772 Floppy Disk Controller (via expansion)
.equ FDC_BASE, 0xF800
.equ FDC_FDC_STATUS, 0xF8E0
.equ FDC_FDC_COMMAND, 0xF8E0
.equ FDC_FDC_TRACK, 0xF8E1
.equ FDC_FDC_SECTOR, 0xF8E2
.equ FDC_FDC_DATA, 0xF8E3

; Centronics Parallel Printer Port
.equ PRINTER_BASE, 0xEE
.equ PRINTER_PRN_DATA, 0xEE
.equ PRINTER_PRN_STROBE, 0xEF

; 中断向量定义
.equ RESET_VECTOR, 0  ; Power-on / Reset
.equ NMI_VECTOR, 1  ; Non-Maskable Interrupt
.equ INT_VECTOR, 2  ; Gate Array interrupt (50Hz vertical blank)

; 引脚定义
.equ PIN_VCC, 1  ; +5V Power
.equ PIN_GND, 2  ; Ground
.equ PIN_CLK, 3  ; Z80 Clock (4MHz)
.equ PIN_A0_A15, 4  ; Address Bus
.equ PIN_D0_D7, 5  ; Data Bus
.equ PIN_MREQ, 6  ; Memory Request
.equ PIN_IORQ, 7  ; I/O Request
.equ PIN_RD, 8  ; Read
.equ PIN_WR, 9  ; Write
.equ PIN_INT, 10  ; Interrupt Request
.equ PIN_NMI, 11  ; Non-Maskable Interrupt
.equ PIN_RESET, 12  ; Reset

; 宏定义
.macro amstrad_cpc_464_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
amstrad_cpc_464_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
