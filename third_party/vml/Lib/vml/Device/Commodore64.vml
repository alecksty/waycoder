; Commodore-64寄存器定义
; 生成自: Commodore/C64/Commodore-64
; 版本: 1.0
; 日期: 2026-04-17
; 作者: VML Team
; 描述: Commodore 64 - Best-selling 8-bit home computer with MOS 6510 CPU, VIC-II graphics, and SID audio

; CPU架构: MOS-6510
; 位宽: 8位
; 时钟频率: 1022727 Hz

; 寄存器定义
; Accumulator
.equ A, 0x00

; X Index Register
.equ X, 0x01

; Y Index Register
.equ Y, 0x02

; Stack Pointer
.equ SP, 0x03

; Program Counter
.equ PC, 0x04

; Processor Status
.equ P, 0x06
.equ P_C, 0  ; Carry Flag
.equ P_Z, 1  ; Zero Flag
.equ P_I, 2  ; Interrupt Disable
.equ P_D, 3  ; Decimal Mode
.equ P_B, 4  ; Break Flag
.equ P_U, 5  ; Unused
.equ P_V, 6  ; Overflow Flag
.equ P_N, 7  ; Negative Flag

; I/O Port (6510 only: DDR + data)
.equ PORT, 0x00

; 内存段定义
; 64KB main RAM
.equ RAM_START, 0x0000
.equ RAM_END, 0xFFFF
.equ RAM_SIZE, 65536

; BASIC interpreter ROM
.equ BASIC_ROM_START, 0xA000
.equ BASIC_ROM_END, 0xBFFF
.equ BASIC_ROM_SIZE, 8192

; KERNAL operating system ROM
.equ KERNAL_ROM_START, 0xE000
.equ KERNAL_ROM_END, 0xFFFF
.equ KERNAL_ROM_SIZE, 8192

; Character generator ROM
.equ CHAR_ROM_START, 0xD000
.equ CHAR_ROM_END, 0xDFFF
.equ CHAR_ROM_SIZE, 4096

; I/O + RAM window (switchable)
.equ IO_RAM_START, 0xD000
.equ IO_RAM_END, 0xDFFF
.equ IO_RAM_SIZE, 4096

; 外设定义
; Video Interface Chip II - 6567/6569
.equ VICII_BASE, 0xD000
.equ VICII_SP0X, 0xD000
.equ VICII_SP0Y, 0xD001
.equ VICII_SP1X, 0xD002
.equ VICII_SP1Y, 0xD003
.equ VICII_SP2X, 0xD004
.equ VICII_SP2Y, 0xD005
.equ VICII_SP3X, 0xD006
.equ VICII_SP3Y, 0xD007
.equ VICII_SP4X, 0xD008
.equ VICII_SP4Y, 0xD009
.equ VICII_SP5X, 0xD00A
.equ VICII_SP5Y, 0xD00B
.equ VICII_SP6X, 0xD00C
.equ VICII_SP6Y, 0xD00D
.equ VICII_SP7X, 0xD00E
.equ VICII_SP7Y, 0xD00F
.equ VICII_MSIGX, 0xD010
.equ VICII_SCROLY, 0xD011
.equ VICII_SCROLX, 0xD016
.equ VICII_YPSTOP, 0xD012
.equ VICII_LPX, 0xD013
.equ VICII_LPY, 0xD014
.equ VICII_SPENA, 0xD015
.equ VICII_CSPMC, 0xD017
.equ VICII_MM0, 0xD018
.equ VICII_VM01, 0xD016
.equ VICII_VICBAS, 0xD018
.equ VICII_IRQMASK, 0xD019
.equ VICII_IRQST, 0xD01A
.equ VICII_SPBGPR, 0xD01B
.equ VICII_SPMC, 0xD01C
.equ VICII_SP1C, 0xD025
.equ VICII_SP2C, 0xD026
.equ VICII_SPBC, 0xD027
.equ VICII_SP1C0, 0xD028
.equ VICII_SP2C0, 0xD029
.equ VICII_SP3C0, 0xD02A
.equ VICII_SP4C0, 0xD02B
.equ VICII_SP5C0, 0xD02C
.equ VICII_SP6C0, 0xD02D
.equ VICII_SP7C0, 0xD02E
.equ VICII_REG_FD, 0xD01D
.equ VICII_BGCOL0, 0xD021
.equ VICII_BGCOL1, 0xD022
.equ VICII_BGCOL2, 0xD023
.equ VICII_BGCOL3, 0xD024

; Sound Interface Device 6581/8580
.equ SID_BASE, 0xD400
.equ SID_FREQ1LO, 0xD400
.equ SID_FREQ1HI, 0xD401
.equ SID_PW1LO, 0xD402
.equ SID_PW1HI, 0xD403
.equ SID_CR1, 0xD404
.equ SID_AD1, 0xD405
.equ SID_SR1, 0xD406
.equ SID_FREQ2LO, 0xD407
.equ SID_FREQ2HI, 0xD408
.equ SID_PW2LO, 0xD409
.equ SID_PW2HI, 0xD40A
.equ SID_CR2, 0xD40B
.equ SID_AD2, 0xD40C
.equ SID_SR2, 0xD40D
.equ SID_FREQ3LO, 0xD40E
.equ SID_FREQ3HI, 0xD40F
.equ SID_PW3LO, 0xD410
.equ SID_PW3HI, 0xD411
.equ SID_CR3, 0xD412
.equ SID_AD3, 0xD413
.equ SID_SR3, 0xD414
.equ SID_FCH, 0xD415
.equ SID_FCL, 0xD416
.equ SID_RES_FLT, 0xD417
.equ SID_VOLUME, 0xD418
.equ SID_POTX, 0xD419
.equ SID_POTY, 0xD41A
.equ SID_OSC3, 0xD41B
.equ SID_ENV3, 0xD41C

; Complex Interface Adapter 1 - Keyboard/Serial
.equ CIA1_BASE, 0xDC00
.equ CIA1_PRA, 0xDC00
.equ CIA1_PRB, 0xDC01
.equ CIA1_DDRA, 0xDC02
.equ CIA1_DDRB, 0xDC03
.equ CIA1_TA_LO, 0xDC04
.equ CIA1_TA_HI, 0xDC05
.equ CIA1_TB_LO, 0xDC06
.equ CIA1_TB_HI, 0xDC07
.equ CIA1_TOD_TENTH, 0xDC08
.equ CIA1_TOD_SEC, 0xDC09
.equ CIA1_TOD_MIN, 0xDC0A
.equ CIA1_TOD_HR, 0xDC0B
.equ CIA1_SDR, 0xDC0C
.equ CIA1_ICR, 0xDC0D
.equ CIA1_CRA, 0xDC0E
.equ CIA1_CRB, 0xDC0F

; Complex Interface Adapter 2 - Serial/Bus
.equ CIA2_BASE, 0xDD00
.equ CIA2_PRA, 0xDD00
.equ CIA2_PRB, 0xDD01
.equ CIA2_DDRA, 0xDD02
.equ CIA2_DDRB, 0xDD03
.equ CIA2_TA_LO, 0xDD04
.equ CIA2_TA_HI, 0xDD05
.equ CIA2_TB_LO, 0xDD06
.equ CIA2_TB_HI, 0xDD07
.equ CIA2_TOD_TENTH, 0xDD08
.equ CIA2_TOD_SEC, 0xDD09
.equ CIA2_TOD_MIN, 0xDD0A
.equ CIA2_TOD_HR, 0xDD0B
.equ CIA2_SDR, 0xDD0C
.equ CIA2_ICR, 0xDD0D
.equ CIA2_CRA, 0xDD0E
.equ CIA2_CRB, 0xDD0F

; Color RAM (4-bit per char cell)
.equ COLORRAM_BASE, 0xD800
.equ COLORRAM_COLOR, 0xD800

; IEC Serial Bus (via CIA1)
.equ IEC_BASE, 0xDC00
.equ IEC_IEC_DATA, 0xDC00
.equ IEC_IEC_CLOCK, 0xDC01

; 中断向量定义
.equ RESET_VECTOR, 0  ; Power-on / Reset
.equ NMI_VECTOR, 1  ; Non-Maskable Interrupt
.equ IRQ_VECTOR, 2  ; IRQ (VIC raster / CIA timer)

; 引脚定义
.equ PIN_VCC, 1  ; +5V Power
.equ PIN_GND, 2  ; Ground
.equ PIN_RESET, 3  ; System Reset
.equ PIN_CLK, 4  ; System Clock (~1MHz)
.equ PIN_DOTCLK, 5  ; VIC Dot Clock (8MHz NTSC / 7.8MHz PAL)
.equ PIN_AEC, 6  ; Address Enable Control (VIC steals cycles)
.equ PIN_BA, 7  ; Bus Available (from VIC)
.equ PIN_IRQ, 8  ; Interrupt Request
.equ PIN_NMI, 9  ; Non-Maskable Interrupt
.equ PIN_RWB, 10  ; Read/Write
.equ PIN_A0_A15, 11  ; Address Bus
.equ PIN_D0_D7, 12  ; Data Bus

; 宏定义
.macro commodore_64_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
commodore_64_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
