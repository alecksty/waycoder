; ARM7TDMI寄存器定义
; 生成自: ARM/ARM7/ARM7TDMI
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: Game Boy Advance main processor - ARM7TDMI @ 16.78MHz with 32-bit ARM + 16-bit Thumb instruction sets

; CPU架构: ARM7TDMI
; 位宽: 32位
; 时钟频率: 16780000 Hz

; 寄存器定义
; General Purpose Register 0
.equ R0, 0x00

; General Purpose Register 1
.equ R1, 0x04

; General Purpose Register 2
.equ R2, 0x08

; General Purpose Register 3
.equ R3, 0x0C

; General Purpose Register 4
.equ R4, 0x10

; General Purpose Register 5
.equ R5, 0x14

; General Purpose Register 6
.equ R6, 0x18

; General Purpose Register 7
.equ R7, 0x1C

; General Purpose Register 8
.equ R8, 0x20

; General Purpose Register 9 / SB
.equ R9, 0x24

; General Purpose Register 10 / SL
.equ R10, 0x28

; Frame Pointer / FP
.equ R11, 0x2C

; Intra-Procedure-call Scratch Register / IP
.equ R12, 0x30

; Stack Pointer / SP
.equ R13, 0x34

; Link Register / LR
.equ R14, 0x38

; Program Counter / PC
.equ R15, 0x3C

; Current Program Status Register
.equ CPSR, 0x40
.equ CPSR_MODE, 0  ; Processor Mode (10000=User, 10001=FIQ, 10010=IRQ, 10011=SVC, 10111=ABT, 11011=UND, 11111=SYS)
.equ CPSR_T, 5  ; Thumb State Bit (1=Thumb mode)
.equ CPSR_F, 6  ; FIQ Disable
.equ CPSR_I, 7  ; IRQ Disable
.equ CPSR_A, 8  ; Imprecise Data Abort Disable
.equ CPSR_E, 9  ; Endianness (0=Little)
.equ CPSR_GE, 0  ; Greater-than-or-Equal flags
.equ CPSR_N, 31  ; Negative
.equ CPSR_Z, 30  ; Zero
.equ CPSR_C, 29  ; Carry
.equ CPSR_V, 28  ; Overflow

; Saved PSR (Supervisor Mode)
.equ SPSR_SVC, 0x44

; Saved PSR (Abort Mode)
.equ SPSR_ABT, 0x48

; Saved PSR (IRQ Mode)
.equ SPSR_IRQ, 0x4C

; Saved PSR (FIQ Mode)
.equ SPSR_FIQ, 0x50

; 内存段定义
; Internal Work RAM (32KB, 2-cycle access)
.equ IWRAM_START, 0x03000000
.equ IWRAM_END, 0x03007FFF
.equ IWRAM_SIZE, 32768

; Internal Work RAM Fast (high-speed region)
.equ IWRAM_FAST_START, 0x03008000
.equ IWRAM_FAST_END, 0x03FFFFFF
.equ IWRAM_FAST_SIZE, 32752

; Video RAM (96KB + 64KB OBJ VRAM)
.equ VRAM_START, 0x06000000
.equ VRAM_END, 0x06017FFF
.equ VRAM_SIZE, 98304

; BG Palette RAM (256 colors x 2 bytes)
.equ PALETTE_START, 0x05000200
.equ PALETTE_END, 0x050003FF
.equ PALETTE_SIZE, 512

; Object Palette RAM
.equ OBJ_PALETTE_START, 0x05000400
.equ OBJ_PALETTE_END, 0x050005FF
.equ OBJ_PALETTE_SIZE, 512

; Object Attribute Memory (OAM, 128 sprites)
.equ OAM_START, 0x07000000
.equ OAM_END, 0x070003FF
.equ OAM_SIZE, 1024

; Cartridge ROM (max 32MB)
.equ ROM_START, 0x08000000
.equ ROM_END, 0x09FFFFFF
.equ ROM_SIZE, 33554432

; Cartridge SRAM / Flash
.equ CART_RAM_START, 0x0E000000
.equ CART_RAM_END, 0x0E00FFFF
.equ CART_RAM_SIZE, 65536

; GBA BIOS (16KB)
.equ BIOS_START, 0x00000000
.equ BIOS_END, 0x00003FFF
.equ BIOS_SIZE, 16384

; I/O Registers (MMIO)
.equ IO_REGS_START, 0x04000000
.equ IO_REGS_END, 0x04FFFFFF
.equ IO_REGS_SIZE, 16777216

; 外设定义
; LCD Controller
.equ LCD_BASE, 0x04000000
.equ LCD_DISPCNT, 0x04000000
.equ LCD_DISPCNT_BG_MODE, 0  ; BG Mode (0-6)
.equ LCD_DISPCNT_GB_WINDOW, 5  ; Game Boy Window Enable
.equ LCD_DISPCNT_WIN0_ENABLE, 13  ; Window 0 Enable
.equ LCD_DISPCNT_WIN1_ENABLE, 14  ; Window 1 Enable
.equ LCD_DISPCNT_OBJ_WIN, 15  ; Object Window Enable
.equ LCD_DISPCNT_BG0_ENABLE, 8  ; BG0 Enable
.equ LCD_DISPCNT_BG1_ENABLE, 9  ; BG1 Enable
.equ LCD_DISPCNT_BG2_ENABLE, 10  ; BG2 Enable
.equ LCD_DISPCNT_BG3_ENABLE, 11  ; BG3 Enable
.equ LCD_DISPCNT_OBJ_ENABLE, 12  ; Object/Sprite Enable
.equ LCD_GREEN_SWAP, 0x04000002
.equ LCD_DISPSTAT, 0x04000004
.equ LCD_DISPSTAT_V_COUNT, 0  ; Vertical Line Counter
.equ LCD_DISPSTAT_VBLANK_FLAG, 0  ; V-Blank Flag (read-only)
.equ LCD_DISPSTAT_HBLANK_FLAG, 1  ; H-Blank Flag (read-only)
.equ LCD_DISPSTAT_V_COUNT_FLAG, 2  ; V-Count Flag (LY==LYC)
.equ LCD_DISPSTAT_VBLANK_IRQ, 3  ; V-Blank IRQ Enable
.equ LCD_DISPSTAT_HBLANK_IRQ, 4  ; H-Blank IRQ Enable
.equ LCD_DISPSTAT_VCOUNT_IRQ, 5  ; V-Count IRQ Enable
.equ LCD_VCOUNT, 0x04000006
.equ LCD_BG0CNT, 0x04000008
.equ LCD_BG1CNT, 0x0400000A
.equ LCD_BG2CNT, 0x0400000C
.equ LCD_BG3CNT, 0x0400000E
.equ LCD_BG0HOFS, 0x04000010
.equ LCD_BG0VOFS, 0x04000012
.equ LCD_BG1HOFS, 0x04000014
.equ LCD_BG1VOFS, 0x04000016
.equ LCD_BG2HOFS, 0x04000018
.equ LCD_BG2VOFS, 0x0400001A
.equ LCD_BG3HOFS, 0x0400001C
.equ LCD_BG3VOFS, 0x0400001E
.equ LCD_BG2PA, 0x04000020
.equ LCD_BG2PB, 0x04000022
.equ LCD_BG2PC, 0x04000024
.equ LCD_BG2PD, 0x04000026
.equ LCD_BG2X, 0x04000028
.equ LCD_BG2Y, 0x0400002C
.equ LCD_BG3PA, 0x04000030
.equ LCD_BG3PB, 0x04000032
.equ LCD_BG3PC, 0x04000034
.equ LCD_BG3PD, 0x04000036
.equ LCD_BG3X, 0x04000038
.equ LCD_BG3Y, 0x0400003C
.equ LCD_WIN0H, 0x04000040
.equ LCD_WIN1H, 0x04000042
.equ LCD_WIN0V, 0x04000044
.equ LCD_WIN1V, 0x04000046
.equ LCD_WININ, 0x04000048
.equ LCD_WINOUT, 0x04000049
.equ LCD_MOSAIC, 0x0400004C
.equ LCD_BLDCNT, 0x04000050
.equ LCD_BLDCNT_BG1ST, 0  ; BG1 1st Target
.equ LCD_BLDCNT_BG2ST, 1  ; BG2 1st Target
.equ LCD_BLDCNT_BG3ST, 2  ; BG3 1st Target
.equ LCD_BLDCNT_OBJST, 3  ; Object 1st Target
.equ LCD_BLDCNT_BDST, 4  ; Backdrop 1st Target
.equ LCD_BLDCNT_BLEND_MODE, 0  ; Blend Mode (0=None, 1=Alpha, 2=Increase, 3=Decrease)
.equ LCD_BLDCNT_BG1ST2, 8  ; BG1 2nd Target
.equ LCD_BLDCNT_BG2ST2, 9  ; BG2 2nd Target
.equ LCD_BLDCNT_BG3ST2, 10  ; BG3 2nd Target
.equ LCD_BLDCNT_OBJST2, 11  ; Object 2nd Target
.equ LCD_BLDCNT_BDST2, 12  ; Backdrop 2nd Target
.equ LCD_BLDALPHA, 0x04000052
.equ LCD_BLDY, 0x04000054

; Direct Memory Access Controller
.equ DMA_BASE, 0x040000B0
.equ DMA_DMA0SAD, 0x040000B0
.equ DMA_DMA0DAD, 0x040000B4
.equ DMA_DMA0CNT_L, 0x040000B8
.equ DMA_DMA0CNT_H, 0x040000BA
.equ DMA_DMA0CNT_H_TRANSFER_COUNT, 0  ; Number of Transfers
.equ DMA_DMA0CNT_H_DEST_ADD_MODE, 0  ; Dest Address Control (0=fix, 1=inc, 2=dec, 3=inc+reload)
.equ DMA_DMA0CNT_H_SRC_ADD_MODE, 0  ; Source Address Control (0=fix, 1=inc, 2=dec)
.equ DMA_DMA0CNT_H_REPEAT, 18  ; Repeat (for 16-bit repeat mode)
.equ DMA_DMA0CNT_H_WORD_SIZE, 20  ; Word Size (0=16-bit, 1=32-bit)
.equ DMA_DMA0CNT_H_DRQ, 27  ; DRQ Trigger (DMA from external source)
.equ DMA_DMA0CNT_H_TIMING, 0  ; Start Timing (0=Now, 1=V-Blank, 2=H-Blank, 3=Special)
.equ DMA_DMA0CNT_H_ENABLE, 31  ; DMA Enable
.equ DMA_DMA1SAD, 0x040000BC
.equ DMA_DMA1DAD, 0x040000C0
.equ DMA_DMA1CNT_L, 0x040000C4
.equ DMA_DMA1CNT_H, 0x040000C6
.equ DMA_DMA2SAD, 0x040000C8
.equ DMA_DMA2DAD, 0x040000CC
.equ DMA_DMA2CNT_L, 0x040000D0
.equ DMA_DMA2CNT_H, 0x040000D2
.equ DMA_DMA3SAD, 0x040000D4
.equ DMA_DMA3DAD, 0x040000D8
.equ DMA_DMA3CNT_L, 0x040000DC
.equ DMA_DMA3CNT_H, 0x040000DE

; Timer Units (4 timers)
.equ TIMER_BASE, 0x04000100
.equ TIMER_TM0CNT_L, 0x04000100
.equ TIMER_TM0CNT_H, 0x04000102
.equ TIMER_TM0CNT_H_PRESCALER, 0  ; Prescaler (0=1, 1=64, 2=256, 3=1024)
.equ TIMER_TM0CNT_H_COUNT_UP, 2  ; Count Up (cascade mode)
.equ TIMER_TM0CNT_H_IRQ_ENABLE, 6  ; Timer IRQ Enable
.equ TIMER_TM0CNT_H_ENABLE, 7  ; Timer Enable
.equ TIMER_TM1CNT_L, 0x04000104
.equ TIMER_TM1CNT_H, 0x04000106
.equ TIMER_TM2CNT_L, 0x04000108
.equ TIMER_TM2CNT_H, 0x0400010A
.equ TIMER_TM3CNT_L, 0x0400010C
.equ TIMER_TM3CNT_H, 0x0400010E

; Serial I/O (JOY BUS / Link Cable)
.equ SIO_BASE, 0x04000120
.equ SIO_SIOCNT, 0x04000120
.equ SIO_SIOCNT_CLOCK_SEL, 0  ; Baud Rate Clock (0=9600, 1=57600, 2=115200, 3=768000)
.equ SIO_SIOCNT_SO_ENABLE, 3  ; SO Output Enable
.equ SIO_SIOCNT_RECV_ENABLE, 5  ; Receive Enable
.equ SIO_SIOCNT_SEND_ENABLE, 6  ; Send Enable
.equ SIO_SIOCNT_START_BIT, 7  ; Start Transfer
.equ SIO_SIODATA8, 0x0400012A
.equ SIO_JOYCNT, 0x04000130
.equ SIO_JOYSTAT, 0x04000134
.equ SIO_JOY_RECV, 0x04000150
.equ SIO_JOY_TRANS, 0x04000154

; Key Input
.equ KEYINPUT_BASE, 0x04000130
.equ KEYINPUT_KEYINPUT, 0x04000130
.equ KEYINPUT_KEYINPUT_A, 0  ; A Button (0=Pressed)
.equ KEYINPUT_KEYINPUT_B, 1  ; B Button (0=Pressed)
.equ KEYINPUT_KEYINPUT_SELECT, 2  ; Select Button (0=Pressed)
.equ KEYINPUT_KEYINPUT_START, 3  ; Start Button (0=Pressed)
.equ KEYINPUT_KEYINPUT_RIGHT, 4  ; D-Pad Right (0=Pressed)
.equ KEYINPUT_KEYINPUT_LEFT, 5  ; D-Pad Left (0=Pressed)
.equ KEYINPUT_KEYINPUT_UP, 6  ; D-Pad Up (0=Pressed)
.equ KEYINPUT_KEYINPUT_DOWN, 7  ; D-Pad Down (0=Pressed)
.equ KEYINPUT_KEYINPUT_R, 8  ; R Shoulder Button (0=Pressed)
.equ KEYINPUT_KEYINPUT_L, 9  ; L Shoulder Button (0=Pressed)
.equ KEYINPUT_KEYCNT, 0x04000132
.equ KEYINPUT_KEYCNT_KEY_MASK, 0  ; Key Interrupt Enable Mask
.equ KEYINPUT_KEYCNT_IRQ_ENABLE, 14  ; Key Interrupt Enable

; Interrupt Control
.equ INTERRUPT_BASE, 0x04000200
.equ INTERRUPT_IME, 0x04000208
.equ INTERRUPT_IE, 0x04000210
.equ INTERRUPT_IE_VBLANK, 0  ; V-Blank Interrupt Enable
.equ INTERRUPT_IE_HBLANK, 1  ; H-Blank Interrupt Enable
.equ INTERRUPT_IE_VCOUNT, 2  ; V-Count Match Interrupt Enable
.equ INTERRUPT_IE_TIMER0, 3  ; Timer 0 Interrupt Enable
.equ INTERRUPT_IE_TIMER1, 4  ; Timer 1 Interrupt Enable
.equ INTERRUPT_IE_TIMER2, 5  ; Timer 2 Interrupt Enable
.equ INTERRUPT_IE_TIMER3, 6  ; Timer 3 Interrupt Enable
.equ INTERRUPT_IE_SIO, 7  ; Serial I/O Interrupt Enable
.equ INTERRUPT_IE_DMA0, 8  ; DMA 0 Interrupt Enable
.equ INTERRUPT_IE_DMA1, 9  ; DMA 1 Interrupt Enable
.equ INTERRUPT_IE_DMA2, 10  ; DMA 2 Interrupt Enable
.equ INTERRUPT_IE_DMA3, 11  ; DMA 3 Interrupt Enable
.equ INTERRUPT_IE_KEYPAD, 12  ; Keypad Interrupt Enable
.equ INTERRUPT_IE_CART, 13  ; Game Pak Interrupt Enable
.equ INTERRUPT_IF, 0x04000214

; Waitstate Control
.equ WAITCNT_BASE, 0x04000204
.equ WAITCNT_WAITCNT, 0x04000204
.equ WAITCNT_WAITCNT_PHI_OD, 0  ; PHI Terminal Output (0=Disable)
.equ WAITCNT_WAITCNT_SRAM_WS, 0  ; SRAM Wait State (0=4, 1=3, 2=2, 3=8 cycles)
.equ WAITCNT_WAITCNT_WS0_N, 0  ; Wait State 0 (ROM/SRAM 1st access)
.equ WAITCNT_WAITCNT_WS0_S, 5  ; Wait State 0 (ROM/SRAM 2nd access)
.equ WAITCNT_WAITCNT_WS1_N, 0  ; Wait State 1 (ROM 2nd access)
.equ WAITCNT_WAITCNT_WS1_S, 8  ; Wait State 1 (ROM 2nd access short)
.equ WAITCNT_WAITCNT_WS2_N, 0  ; Wait State 2 (ROM 3rd access)
.equ WAITCNT_WAITCNT_WS2_S, 11  ; Wait State 2 (ROM 3rd access short)
.equ WAITCNT_WAITCNT_PREFE, 12  ; Prefetch Enable (GBA SP only)

; 中断向量定义
.equ VBLANK_VECTOR, 0  ; V-Blank Interrupt
.equ HBLANK_VECTOR, 1  ; H-Blank Interrupt
.equ VCOUNT_VECTOR, 2  ; V-Count Match Interrupt
.equ TIMER0_VECTOR, 3  ; Timer 0 Overflow Interrupt
.equ TIMER1_VECTOR, 4  ; Timer 1 Overflow Interrupt
.equ TIMER2_VECTOR, 5  ; Timer 2 Overflow Interrupt
.equ TIMER3_VECTOR, 6  ; Timer 3 Overflow Interrupt
.equ SIO_VECTOR, 7  ; Serial I/O Interrupt
.equ DMA0_VECTOR, 8  ; DMA 0 Complete Interrupt
.equ DMA1_VECTOR, 9  ; DMA 1 Complete Interrupt
.equ DMA2_VECTOR, 10  ; DMA 2 Complete Interrupt
.equ DMA3_VECTOR, 11  ; DMA 3 Complete Interrupt
.equ KEYPAD_VECTOR, 12  ; Keypad Interrupt
.equ CART_VECTOR, 13  ; Game Pak Interrupt

