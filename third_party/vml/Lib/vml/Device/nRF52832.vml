; nRF52832寄存器定义
; 生成自: Nordic/nRF52/nRF52832
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: 32-bit ARM Cortex-M4F BLE SoC with 512KB Flash, 64KB RAM, 64MHz

; CPU架构: ARM-Cortex-M4F
; 位宽: 32位
; 时钟频率: 64000000 Hz

; 寄存器定义
.equ R0, 0x00

.equ R1, 0x04

.equ R2, 0x08

.equ R3, 0x0C

.equ SP, 0x34

.equ LR, 0x38

.equ PC, 0x3C

; 内存段定义
.equ FLASH_START, 0x00000000
.equ FLASH_END, 0x0007FFFF
.equ FLASH_SIZE, 524288

.equ SRAM_START, 0x20000000
.equ SRAM_END, 0x2000FFFF
.equ SRAM_SIZE, 65536

.equ PERIPHERAL_START, 0x40000000
.equ PERIPHERAL_END, 0x400FFFFF
.equ PERIPHERAL_SIZE, 1048576

; Factory Information Configuration Registers
.equ FICR_START, 0x10000000
.equ FICR_END, 0x10000FFF
.equ FICR_SIZE, 4096

; 外设定义
; General Purpose I/O Port 0
.equ GPIO_P0_BASE, 0x50000000
.equ GPIO_P0_OUT, 0x504
.equ GPIO_P0_OUTSET, 0x508
.equ GPIO_P0_OUTCLR, 0x50C
.equ GPIO_P0_IN, 0x510
.equ GPIO_P0_DIR, 0x514
.equ GPIO_P0_DIRSET, 0x518
.equ GPIO_P0_DIRCLR, 0x51C

; Power Control
.equ POWER_BASE, 0x40000000
.equ POWER_DCDCEN, 0x1C4
.equ POWER_RAMSTATUS, 0x268

; Clock Control
.equ CLOCK_BASE, 0x40000000
.equ CLOCK_HFCLKSTART, 0x108
.equ CLOCK_HFCLKSTARTED, 0x208

; 中断向量定义
.equ RESET_VECTOR, 0  ; 
.equ SVCALL_VECTOR, 11  ; 

; 宏定义
.macro nrf52832_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
nrf52832_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
