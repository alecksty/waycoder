; Sega-Genesis寄存器定义
; 生成自: Sega/Genesis/Mega Drive/Sega-Genesis
; 版本: 1.0
; 日期: 2026-04-17
; 作者: VML Team
; 描述: Sega Genesis/Mega Drive 16-bit video game console with Motorola 68000 CPU

; CPU架构: Motorola 68000
; 位宽: 32位
; 时钟频率: 7670000 Hz

; 寄存器定义
; Data Register 0
.equ D0, 0

; Data Register 1
.equ D1, 0

; Data Register 2
.equ D2, 0

; Data Register 3
.equ D3, 0

; Data Register 4
.equ D4, 0

; Data Register 5
.equ D5, 0

; Data Register 6
.equ D6, 0

; Data Register 7
.equ D7, 0

; Address Register 0
.equ A0, 0

; Address Register 1
.equ A1, 0

; Address Register 2
.equ A2, 0

; Address Register 3
.equ A3, 0

; Address Register 4
.equ A4, 0

; Address Register 5
.equ A5, 0

; Address Register 6
.equ A6, 0

; Address Register 7 (SP)
.equ A7, 0

; Program Counter
.equ PC, 0

; Status Register
.equ SR, 0

; 外设定义
; Video Display Processor (315-5313)
.equ VDP_BASE, 
.equ VDP_VDP_DATA, 0xC00000
.equ VDP_VDP_CONTROL, 0xC00004
.equ VDP_VDP_HVCOUNTER, 0xC00008
.equ VDP_VDP_PSG, 0xC00011

; FM synthesis sound chip
.equ YM2612_BASE, 
.equ YM2612_YM2612_ADDR0, 0xA04000
.equ YM2612_YM2612_DATA0, 0xA04001
.equ YM2612_YM2612_ADDR1, 0xA04002
.equ YM2612_YM2612_DATA1, 0xA04003

; I/O ports
.equ IOPORTS_BASE, 
.equ IOPORTS_IO_DATA1, 0xA10002
.equ IOPORTS_IO_DATA2, 0xA10004
.equ IOPORTS_IO_DATA3, 0xA10006
.equ IOPORTS_IO_CTRL1, 0xA10008
.equ IOPORTS_IO_CTRL2, 0xA1000A
.equ IOPORTS_IO_CTRL3, 0xA1000C

; TradeMark Security System
.equ TMSS_BASE, 
.equ TMSS_TMSS, 0xA14000

; Z80 bus control
.equ Z80BUS_BASE, 
.equ Z80BUS_Z80_BUSREQ, 0xA11100
.equ Z80BUS_Z80_RESET, 0xA11200
.equ Z80BUS_Z80_YM2612, 0xA04000

; 中断向量定义
.equ RESET_SP_VECTOR, 0  ; Reset (Initial SP)
.equ RESET_PC_VECTOR, 4  ; Reset (Initial PC)
.equ HBLANK_VECTOR, 24  ; Horizontal blank interrupt
.equ VBLANK_VECTOR, 28  ; Vertical blank interrupt
.equ EXTINT1_VECTOR, 32  ; External interrupt 1
.equ EXTINT2_VECTOR, 36  ; External interrupt 2
.equ EXTINT3_VECTOR, 40  ; External interrupt 3
.equ EXTINT4_VECTOR, 44  ; External interrupt 4
.equ EXTINT5_VECTOR, 48  ; External interrupt 5
.equ EXTINT6_VECTOR, 52  ; External interrupt 6
.equ EXTINT7_VECTOR, 56  ; External interrupt 7

; 宏定义
.macro sega_genesis_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
sega_genesis_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
