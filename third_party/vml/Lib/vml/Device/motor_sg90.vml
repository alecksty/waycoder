; SG90寄存器定义
; 生成自: Tower Pro/Motor/SG90
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: SG90 Micro Servo Motor (0-180°, 4.8V-6V)

; CPU架构: Motor
; 位宽: 8位
; 时钟频率: 0 Hz

; 外设定义
; SG90 Micro Servo (500-2500us pulse, 50Hz)
.equ SG90_BASE, 0x00
.equ SG90_ANGLE, 0x00
.equ SG90_PULSE_MIN, 0x01
.equ SG90_PULSE_MAX, 0x03
.equ SG90_CURRENT_ANGLE, 0x05
.equ SG90_SPEED, 0x06

; 宏定义
.macro sg90_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
sg90_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
