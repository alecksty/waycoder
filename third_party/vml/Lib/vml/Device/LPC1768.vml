; LPC1768寄存器定义
; 生成自: NXP/LPC17xx/LPC1768
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: ARM Cortex-M3 up to 100MHz with 512KB Flash, 64KB SRAM

; CPU架构: ARM-Cortex-M3
; 位宽: 32位
; 时钟频率: 12000000 Hz

; 寄存器定义
; General Purpose Register 0
.equ R0, 0x00000000

; General Purpose Register 1
.equ R1, 0x00000004

; General Purpose Register 2
.equ R2, 0x00000008

; General Purpose Register 3
.equ R3, 0x0000000C

; General Purpose Register 4
.equ R4, 0x00000010

; General Purpose Register 5
.equ R5, 0x00000014

; General Purpose Register 6
.equ R6, 0x00000018

; General Purpose Register 7
.equ R7, 0x0000001C

; General Purpose Register 8
.equ R8, 0x00000020

; General Purpose Register 9
.equ R9, 0x00000024

; General Purpose Register 10
.equ R10, 0x00000028

; General Purpose Register 11
.equ R11, 0x0000002C

; General Purpose Register 12
.equ R12, 0x00000030

; Stack Pointer
.equ SP, 0x00000034

; Link Register
.equ LR, 0x00000038

; Program Counter
.equ PC, 0x0000003C

; Program Status Register
.equ PSR, 0x00000040
.equ PSR_N, 31  ; Negative Flag
.equ PSR_Z, 30  ; Zero Flag
.equ PSR_C, 29  ; Carry Flag
.equ PSR_V, 28  ; Overflow Flag
.equ PSR_Q, 27  ; Saturation Flag
.equ PSR_ICI1, 0  ; Interrupt Continue State
.equ PSR_GE, 0  ; Greater than or Equal
.equ PSR_IT, 0  ; If-Then execution state
.equ PSR_APSR, 0  ; Application Program Status

; Priority Mask Register
.equ PRIMASK, 0xE0000E20

; Fault Mask Register
.equ FAULTMASK, 0xE0000E28

; Base Priority Register
.equ BASEPRI, 0xE0000E24

; Control Register
.equ CONTROL, 0xE0000E2C

; 内存段定义
; Main Flash (512KB)
.equ FLASH_START, 0x00000000
.equ FLASH_END, 0x0007FFFF
.equ FLASH_SIZE, 524288

; Boot Flash (32KB)
.equ FLASH_BOOT_START, 0x00080000
.equ FLASH_BOOT_END, 0x0007FFFF
.equ FLASH_BOOT_SIZE, 32768

; SRAM (64KB)
.equ SRAM_START, 0x10000000
.equ SRAM_END, 0x1000FFFF
.equ SRAM_SIZE, 65536

; AHB1 Peripherals
.equ AHB1_START, 0x20000000
.equ AHB1_END, 0x200FFFFF
.equ AHB1_SIZE, 1048576

; APB0 Peripherals
.equ APB0_START, 0x40000000
