; Commodore-64寄存器定义
; 生成自: Commodore International/Commodore 64/Commodore-64
; 版本: 1.0
; 日期: 2026-04-17
; 作者: VML Team
; 描述: Commodore 64 home computer with MOS 6510 CPU, 64KB RAM, and SID sound chip

; CPU架构: MOS 6510
; 位宽: 8位
; 时钟频率: 985248 Hz

; 寄存器定义
; Accumulator
.equ A, 0

; Index Register X
.equ X, 0

; Index Register Y
.equ Y, 0

; Stack Pointer
.equ SP, 0

; Program Counter
.equ PC, 0

; Status Register
.equ P, 0

; I/O Port (6510 specific)
.equ PORT, 1

; 外设定义
; Video Interface Chip II
.equ VIC_II_BASE, 
.equ VIC_II_VIC_CTRL1, 0xD011
.equ VIC_II_VIC_CTRL2, 0xD016
.equ VIC_II_VIC_RASTER, 0xD012
.equ VIC_II_VIC_MEMPTR, 0xD018
.equ VIC_II_VIC_IRQ, 0xD019
.equ VIC_II_VIC_IRQMASK, 0xD01A
.equ VIC_II_VIC_BORDER, 0xD020
.equ VIC_II_VIC_BG0, 0xD021
.equ VIC_II_VIC_BG1, 0xD022
.equ VIC_II_VIC_BG2, 0xD023
.equ VIC_II_VIC_BG3, 0xD024
.equ VIC_II_VIC_SPRITE0_X, 0xD000
.equ VIC_II_VIC_SPRITE0_Y, 0xD001
.equ VIC_II_VIC_SPRITE1_X, 0xD002
.equ VIC_II_VIC_SPRITE1_Y, 0xD003

; Sound Interface Device (6581)
.equ SID_BASE, 
.equ SID_SID_VOICE1_FREQ_LO, 0xD400
.equ SID_SID_VOICE1_FREQ_HI, 0xD401
.equ SID_SID_VOICE1_PW_LO, 0xD402
.equ SID_SID_VOICE1_PW_HI, 0xD403
.equ SID_SID_VOICE1_CTRL, 0xD404
.equ SID_SID_VOICE1_AD, 0xD405
.equ SID_SID_VOICE1_SR, 0xD406
.equ SID_SID_VOICE2_FREQ_LO, 0xD407
.equ SID_SID_VOICE2_FREQ_HI, 0xD408
.equ SID_SID_VOICE2_PW_LO, 0xD409
.equ SID_SID_VOICE2_PW_HI, 0xD40A
.equ SID_SID_VOICE2_CTRL, 0xD40B
.equ SID_SID_VOICE2_AD, 0xD40C
.equ SID_SID_VOICE2_SR, 0xD40D
.equ SID_SID_VOICE3_FREQ_LO, 0xD40E
.equ SID_SID_VOICE3_FREQ_HI, 0xD40F
.equ SID_SID_VOICE3_PW_LO, 0xD410
.equ SID_SID_VOICE3_PW_HI, 0xD411
.equ SID_SID_VOICE3_CTRL, 0xD412
.equ SID_SID_VOICE3_AD, 0xD413
.equ SID_SID_VOICE3_SR, 0xD414
.equ SID_SID_FILTER_CUTOFF_LO, 0xD415
.equ SID_SID_FILTER_CUTOFF_HI, 0xD416
.equ SID_SID_FILTER_CTRL, 0xD417
.equ SID_SID_VOLUME, 0xD418
.equ SID_SID_POTX, 0xD419
.equ SID_SID_POTY, 0xD41A
.equ SID_SID_OSC3, 0xD41B
.equ SID_SID_ENV3, 0xD41C

; Complex Interface Adapter 1 (6526)
.equ CIA1_BASE, 
.equ CIA1_CIA1_PRA, 0xDC00
.equ CIA1_CIA1_PRB, 0xDC01
.equ CIA1_CIA1_DDRA, 0xDC02
.equ CIA1_CIA1_DDRB, 0xDC03
.equ CIA1_CIA1_TALO, 0xDC04
.equ CIA1_CIA1_TAHI, 0xDC05
.equ CIA1_CIA1_TBLO, 0xDC06
.equ CIA1_CIA1_TBHI, 0xDC07
.equ CIA1_CIA1_TODTEN, 0xDC08
.equ CIA1_CIA1_TODSEC, 0xDC09
.equ CIA1_CIA1_TODMIN, 0xDC0A
.equ CIA1_CIA1_TODHR, 0xDC0B
.equ CIA1_CIA1_SDR, 0xDC0C
.equ CIA1_CIA1_ICR, 0xDC0D
.equ CIA1_CIA1_CRA, 0xDC0E
.equ CIA1_CIA1_CRB, 0xDC0F

; Complex Interface Adapter 2 (6526)
.equ CIA2_BASE, 
.equ CIA2_CIA2_PRA, 0xDD00
.equ CIA2_CIA2_PRB, 0xDD01
.equ CIA2_CIA2_DDRA, 0xDD02
.equ CIA2_CIA2_DDRB, 0xDD03
.equ CIA2_CIA2_TALO, 0xDD04
.equ CIA2_CIA2_TAHI, 0xDD05
.equ CIA2_CIA2_TBLO, 0xDD06
.equ CIA2_CIA2_TBHI, 0xDD07
.equ CIA2_CIA2_TODTEN, 0xDD08
.equ CIA2_CIA2_TODSEC, 0xDD09
.equ CIA2_CIA2_TODMIN, 0xDD0A
.equ CIA2_CIA2_TODHR, 0xDD0B
.equ CIA2_CIA2_SDR, 0xDD0C
.equ CIA2_CIA2_ICR, 0xDD0D
.equ CIA2_CIA2_CRA, 0xDD0E
.equ CIA2_CIA2_CRB, 0xDD0F

; 中断向量定义
.equ IRQ_VECTOR, 65532  ; Maskable Interrupt
.equ NMI_VECTOR, 65534  ; Non-Maskable Interrupt
.equ RESET_VECTOR, 65526  ; Reset Vector

; 宏定义
.macro commodore_64_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
commodore_64_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
