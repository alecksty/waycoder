; GD32F103寄存器定义
; 生成自: GigaDevice/GD32/GD32F103
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: 32-bit ARM Cortex-M3 MCU, 108MHz, STM32F103 compatible

; CPU架构: ARM-Cortex-M3
; 位宽: 32位
; 时钟频率: 108000000 Hz

; 寄存器定义
.equ R0, 0x00

.equ R1, 0x04

.equ R2, 0x08

.equ R3, 0x0C

.equ R4, 0x10

.equ R5, 0x14

.equ SP, 0x34

.equ LR, 0x38

.equ PC, 0x3C

; 内存段定义
.equ FLASH_START, 0x08000000
.equ FLASH_END, 0x0801FFFF
.equ FLASH_SIZE, 131072

.equ SRAM_START, 0x20000000
.equ SRAM_END, 0x20004FFF
.equ SRAM_SIZE, 20480

.equ PERIPHERAL_START, 0x40000000
.equ PERIPHERAL_END, 0x4003FFFF
.equ PERIPHERAL_SIZE, 262144

; 外设定义
; Reset and Clock Control
.equ RCC_BASE, 0x40021000
.equ RCC_CTLR, 0x00
.equ RCC_CFGR0, 0x04
.equ RCC_APB2PCENR, 0x18
.equ RCC_APB2PCENR_IOPAEN, 2  ; GPIOA clock enable
.equ RCC_APB2PCENR_IOPBEN, 3  ; GPIOB clock enable
.equ RCC_APB2PCENR_IOPCEN, 4  ; GPIOC clock enable
.equ RCC_APB2PCENR_USART0EN, 14  ; USART0 clock enable
.equ RCC_APB1PCENR, 0x1C
.equ RCC_APB1PCENR_USART1EN, 17  ; USART1 clock enable

; General Purpose I/O Port A
.equ GPIOA_BASE, 0x40010800
.equ GPIOA_CTL0, 0x00
.equ GPIOA_CTL1, 0x04
.equ GPIOA_ISTAT, 0x08
.equ GPIOA_OCTL, 0x0C
.equ GPIOA_BOP, 0x10
.equ GPIOA_BC, 0x14

; General Purpose I/O Port B
.equ GPIOB_BASE, 0x40010C00
.equ GPIOB_CTL0, 0x00
.equ GPIOB_CTL1, 0x04
.equ GPIOB_ISTAT, 0x08
.equ GPIOB_OCTL, 0x0C
.equ GPIOB_BOP, 0x10
.equ GPIOB_BC, 0x14

; General Purpose I/O Port C
.equ GPIOC_BASE, 0x40011000
.equ GPIOC_CTL0, 0x00
.equ GPIOC_CTL1, 0x04
.equ GPIOC_ISTAT, 0x08
.equ GPIOC_OCTL, 0x0C
.equ GPIOC_BOP, 0x10
.equ GPIOC_BC, 0x14

; USART0
.equ USART0_BASE, 0x40013800
.equ USART0_STATR, 0x00
.equ USART0_DATAR, 0x04
.equ USART0_BRR, 0x08
.equ USART0_CTLR1, 0x0C

; USART1
.equ USART1_BASE, 0x40004400
.equ USART1_STATR, 0x00
.equ USART1_DATAR, 0x04
.equ USART1_BRR, 0x08
.equ USART1_CTLR1, 0x0C

; 中断向量定义
.equ RESET_VECTOR, 0  ; 
.equ SVCALL_VECTOR, 11  ; 
.equ USART0_VECTOR, 25  ; USART0 Global Interrupt
.equ USART1_VECTOR, 37  ; USART1 Global Interrupt

; 宏定义
.macro gd32f103_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
gd32f103_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
