; RP2040寄存器定义
; 生成自: Raspberry Pi/RP/RP2040
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: Dual-core ARM Cortex-M0+ up to 133MHz with 264KB SRAM

; CPU架构: ARM-Cortex-M0+
; 位宽: 32位
; 时钟频率: 12000000 Hz

; 寄存器定义
; General Purpose Register 0
.equ R0, 0x00000000

; General Purpose Register 1
.equ R1, 0x00000004

; General Purpose Register 2
.equ R2, 0x00000008

; General Purpose Register 3
.equ R3, 0x0000000C

; General Purpose Register 4
.equ R4, 0x00000010

; General Purpose Register 5
.equ R5, 0x00000014

; General Purpose Register 6
.equ R6, 0x00000018

; General Purpose Register 7
.equ R7, 0x0000001C

; General Purpose Register 8
.equ R8, 0x00000020

; General Purpose Register 9
.equ R9, 0x00000024

; General Purpose Register 10
.equ R10, 0x00000028

; General Purpose Register 11
.equ R11, 0x0000002C

; General Purpose Register 12
.equ R12, 0x00000030

; Stack Pointer
.equ SP, 0x00000034

; Link Register
.equ LR, 0x00000038

; Program Counter
.equ PC, 0x0000003C

; Program Status Register
.equ XPSR, 0x00000040
.equ XPSR_N, 31  ; Negative Flag
.equ XPSR_Z, 30  ; Zero Flag
.equ XPSR_C, 29  ; Carry Flag
.equ XPSR_V, 28  ; Overflow Flag
.equ XPSR_Q, 27  ; Saturation Flag
.equ XPSR_ICI, 0  ; ICI execution state
.equ XPSR_IT, 0  ; If-Then execution state
.equ XPSR_T, 24  ; Thumb bit
.equ XPSR_IPSR, 0  ; Exception number

; Priority Mask Register
.equ PRIMASK, 0xE0000E20

; Control Register
.equ CONTROL, 0xE0000E24

; Fault Mask Register
.equ FAULTMASK, 0xE0000E28

; 内存段定义
; ROM (bootloader)
.equ ROM_START, 0x00000000
.equ ROM_END, 0x00001000
.equ ROM_SIZE, 4096

; SRAM0 (16KB)
.equ SRAM0_START, 0x20000000
.equ SRAM0_END, 0x20003FFF
.equ SRAM0_SIZE, 16384

; SRAM1 (16KB)
.equ SRAM1_START, 0x20004000
.equ SRAM1_END, 0x20007FFF
.equ SRAM1_SIZE, 16384

; SRAM2 (16KB)
