; i.MX RT1062寄存器定义
; 生成自: NXP/i.MX RT/i.MX RT1062
; 版本: 1.0
; 日期: 2026-04-29
; 作者: VML Team
; 描述: 32-bit ARM Cortex-M7 MCU with 1MB SRAM, 600MHz, crossover processor

; CPU架构: ARM-Cortex-M7
; 位宽: 32位
; 时钟频率: 528000000 Hz

; 外设定义
; LPUART 1
.equ UART1_BASE, 0x40184000
.equ UART1_VERID, 0x000
.equ UART1_CTRL, 0x010
.equ UART1_STAT, 0x014
.equ UART1_DATA, 0x01C
.equ UART1_BAUD, 0x024

; LPUART 2
.equ UART2_BASE, 0x40188000
.equ UART2_CTRL, 0x010
.equ UART2_STAT, 0x014
.equ UART2_DATA, 0x01C
.equ UART2_BAUD, 0x024

; GPIO 1
.equ GPIO1_BASE, 0x401B8000
.equ GPIO1_DR, 0x000
.equ GPIO1_GDIR, 0x004
.equ GPIO1_PSR, 0x008
.equ GPIO1_ICR1, 0x00C
.equ GPIO1_ICR2, 0x010
.equ GPIO1_IMR, 0x014
.equ GPIO1_ISR, 0x018
.equ GPIO1_EDGE_SEL, 0x01C

; GPT 定时器 1
.equ GPT1_BASE, 0x401EC000
.equ GPT1_CR, 0x000
.equ GPT1_PR, 0x004
.equ GPT1_SR, 0x008
.equ GPT1_IR, 0x00C
.equ GPT1_OCR1, 0x010
.equ GPT1_CNT, 0x024

; USB OTG 1
.equ USB1_BASE, 0x402E0000
.equ USB1_ID, 0x000
.equ USB1_OTGSC, 0x00C
.equ USB1_USBCMD, 0x100
.equ USB1_PORTSC1, 0x184

; 宏定义
.macro i_mx_rt1062_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
i_mx_rt1062_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
