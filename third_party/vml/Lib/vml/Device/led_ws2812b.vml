; WS2812B寄存器定义
; 生成自: Worldsemi/LED/WS2812B
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: WS2812B Intelligent RGB LED (single-wire, 800KHz, daisy-chainable)

; CPU架构: LED
; 位宽: 24位
; 时钟频率: 800000 Hz

; 内存段定义
; Frame buffer (up to 256 LEDs × 3 bytes)
.equ LED_FB_START, 0x00
.equ LED_FB_END, 0xFF
.equ LED_FB_SIZE, 256

; 外设定义
; WS2812B RGB LED Strip (5V, 60mA/led)
.equ WS2812B_BASE, 0x00
.equ WS2812B_LED_COUNT, 0x00
.equ WS2812B_LED_DATA, 0x02
.equ WS2812B_BRIGHTNESS, 0x05
.equ WS2812B_SHOW, 0x06
.equ WS2812B_CLEAR, 0x07

; 宏定义
.macro ws2812b_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
ws2812b_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
