; MIPS-R3000A寄存器定义
; 生成自: Sony / MIPS Technologies/MIPS-I/MIPS-R3000A
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: Sony PlayStation (PS1) main processor - MIPS R3000A @ 33.87MHz with R4000-like ISA

; CPU架构: MIPS-R3000A
; 位宽: 32位
; 时钟频率: 33870000 Hz

; 寄存器定义
; Hard-wired Zero
.equ R0, 0x00

; Assembler Temporary
.equ R1, 0x04

; Value Returned by Subroutines
.equ R2, 0x08

; Expression Evaluation
.equ R3, 0x0C

; Expression Evaluation
.equ R4, 0x10

; Expression Evaluation
.equ R5, 0x14

; Expression Evaluation
.equ R6, 0x18

; Expression Evaluation
.equ R7, 0x1C

; Expression Evaluation
.equ R8, 0x20

; Expression Evaluation
.equ R9, 0x24

; Expression Evaluation
.equ R10, 0x28

; Expression Evaluation
.equ R11, 0x2C

; Expression Evaluation
.equ R12, 0x30

; Expression Evaluation
.equ R13, 0x34

; Expression Evaluation
.equ R14, 0x38

; Expression Evaluation
.equ R15, 0x3C

; Saved Value
.equ R16, 0x40

; Saved Value
.equ R17, 0x44

; Saved Value
.equ R18, 0x48

; Saved Value
.equ R19, 0x4C

; Saved Value
.equ R20, 0x50

; Saved Value
.equ R21, 0x54

; Saved Value
.equ R22, 0x58

; Saved Value
.equ R23, 0x5C

; Temporary
.equ R24, 0x60

; Temporary
.equ R25, 0x64

; Kernel Reserved
.equ R26, 0x68

; Kernel Reserved
.equ R27, 0x6C

; Global Pointer
.equ R28, 0x70

; Stack Pointer
.equ R29, 0x74

; Frame Pointer
.equ R30, 0x78

; Return Address
.equ R31, 0x7C

; Multiply/Divide High
.equ HI, 0x80

; Multiply/Divide Low
.equ LO, 0x84

; Program Counter
.equ PC, 0x88

; Coprocessor 0 - Status Register
.equ CP0_SR, 0x90
.equ CP0_SR_IE, 0  ; Interrupt Enable
.equ CP0_SR_EXL, 1  ; Exception Level
.equ CP0_SR_ERL, 2  ; Error Level
.equ CP0_SR_KSU, 0  ; Kernel/User Mode
.equ CP0_SR_IM0_7, 0  ; Interrupt Mask bits
.equ CP0_SR_CU0, 28  ; Coprocessor 0 Usable
.equ CP0_SR_BEV, 22  ; Bootstrap Exception Vector

; Coprocessor 0 - Cause Register
.equ CP0_CAUSE, 0x94
.equ CP0_CAUSE_EXCCODE, 0  ; Exception Code
.equ CP0_CAUSE_IP0_7, 0  ; Interrupt Pending bits

; Coprocessor 0 - Exception PC
.equ CP0_EPC, 0x98

; Coprocessor 0 - Bad Virtual Address
.equ CP0_BADVADDR, 0x9C

; Coprocessor 0 - Context Register
.equ CP0_CONTEXT, 0xA0

; Coprocessor 0 - Process ID
.equ CP0_PID, 0xA4

; 内存段定义
; KSEG0 - Cached RAM (2MB System RAM)
.equ KSEG0_START, 0x80000000
.equ KSEG0_END, 0x801FFFFF
.equ KSEG0_SIZE, 2097152

; KSEG1 - Uncached RAM (2MB System RAM)
.equ KSEG1_START, 0xA0000000
.equ KSEG1_END, 0xA01FFFFF
.equ KSEG1_SIZE, 2097152

; VRAM (1MB, mirrored in KSEG1 at 0xB0000000)
.equ VRAM_START, 0xA0000000
.equ VRAM_END, 0xA01FFFFF
.equ VRAM_SIZE, 1048576

; Expansion Region (maps to expansion RAM area)
.equ EXPANSION_START, 0xA0000000
.equ EXPANSION_END, 0xA00FFFFF
.equ EXPANSION_SIZE, 1048576

; Data Scratchpad (1KB)
.equ SCRATCHPAD_START, 0x1F800000
.equ SCRATCHPAD_END, 0x1F8003FF
.equ SCRATCHPAD_SIZE, 1024

; Kernel BIOS ROM (512KB)
.equ EXP_ROM_START, 0x1FC00000
.equ EXP_ROM_END, 0x1FC7FFFF
.equ EXP_ROM_SIZE, 524288

; User ROM / Kernel Expansion
.equ USER_ROM_START, 0x1F800000
.equ USER_ROM_END, 0x1FBFFFFF
.equ USER_ROM_SIZE, 4194304

; I/O Register Area (Expansion 1)
.equ MMIO_START, 0x1F801000
.equ MMIO_END, 0x1F802FFF
.equ MMIO_SIZE, 8192

; GPU Registers
.equ GPU_START, 0x1F801810
.equ GPU_END, 0x1F801817
.equ GPU_SIZE, 8

; CD-ROM Registers
.equ CDROM_START, 0x1F801800
.equ CDROM_END, 0x1F80180F
.equ CDROM_SIZE, 16

; SPU Registers
.equ SPU_START, 0x1F801C00
.equ SPU_END, 0x1F801DFF
.equ SPU_SIZE, 512

; Interrupt Control
.equ IRQ_START, 0x1F801070
.equ IRQ_END, 0x1F801077
.equ IRQ_SIZE, 8

; DMA Registers (7 channels)
.equ DMA_START, 0x1F801080
.equ DMA_END, 0x1F8010FF
.equ DMA_SIZE, 128

; Timer Registers
.equ TIMER_START, 0x1F801100
.equ TIMER_END, 0x1F80112F
.equ TIMER_SIZE, 48

; JOY Interface Registers
.equ JOY_START, 0x1F801040
.equ JOY_END, 0x1F80104F
.equ JOY_SIZE, 16

; MDEC (Motion Decoder) Registers
.equ MDEC_START, 0x1F801820
.equ MDEC_END, 0x1F801827
.equ MDEC_SIZE, 8

; SIO Registers
.equ SIO_START, 0x1F801050
.equ SIO_END, 0x1F80105F
.equ SIO_SIZE, 16

; GPU Status
.equ GPU_STAT_START, 0x1F801814
.equ GPU_STAT_END, 0x1F801817
.equ GPU_STAT_SIZE, 4

; CD-ROM Status
.equ CDROM_STAT_START, 0x1F801801
.equ CDROM_STAT_END, 0x1F801803
.equ CDROM_STAT_SIZE, 3

; SPU Work RAM (1KB)
.equ SPU_RAM_START, 0x1F800000
.equ SPU_RAM_END, 0x1F800FFF
.equ SPU_RAM_SIZE, 1024

; 外设定义
; Graphics Processing Unit
.equ GPU_BASE, 0x1F801810
.equ GPU_GP0_CMD, 0x00
.equ GPU_GP0_DATA, 0x04
