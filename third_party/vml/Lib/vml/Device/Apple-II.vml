; Apple-II寄存器定义
; 生成自: Apple Computer/Apple II/Apple-II
; 版本: 1.0
; 日期: 2026-04-17
; 作者: VML Team
; 描述: Apple II personal computer with MOS 6502 CPU, 48KB RAM, and color graphics

; CPU架构: MOS 6502
; 位宽: 8位
; 时钟频率: 1023000 Hz

; 寄存器定义
; Accumulator
.equ A, 0

; Index Register X
.equ X, 0

; Index Register Y
.equ Y, 0

; Stack Pointer
.equ SP, 0

; Program Counter
.equ PC, 0

; Status Register
.equ P, 0

; 外设定义
; Apple II keyboard
.equ KEYBOARD_BASE, 
.equ KEYBOARD_KBD, 0xC000
.equ KEYBOARD_KBDSTRB, 0xC010

; Built-in speaker
.equ SPEAKER_BASE, 
.equ SPEAKER_SPKR, 0xC030

; Cassette tape interface
.equ CASSETTE_BASE, 
.equ CASSETTE_TAPEIN, 0xC060
.equ CASSETTE_TAPEOUT, 0xC020

; Game controller port
.equ GAMEPORT_BASE, 
.equ GAMEPORT_PADDLE0, 0xC064
.equ GAMEPORT_PADDLE1, 0xC065
.equ GAMEPORT_PADDLE2, 0xC066
.equ GAMEPORT_PADDLE3, 0xC067
.equ GAMEPORT_BUTTON0, 0xC061
.equ GAMEPORT_BUTTON1, 0xC062

; Disk II controller
.equ DISKCONTROLLER_BASE, 
.equ DISKCONTROLLER_DISKUNIT, 0xC0E0
.equ DISKCONTROLLER_DISKCMD, 0xC0E8
.equ DISKCONTROLLER_DISKSTAT, 0xC0E9
.equ DISKCONTROLLER_DISKDATA, 0xC0EA

; 中断向量定义
.equ NMI_VECTOR, 65526  ; Non-maskable interrupt
.equ RESET_VECTOR, 65528  ; Reset vector
.equ IRQ_VECTOR, 65530  ; Interrupt request
.equ BRK_VECTOR, 65532  ; Break instruction

; 宏定义
.macro apple_ii_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
apple_ii_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
