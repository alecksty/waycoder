; APDS9960寄存器定义
; 生成自: Broadcom/Avago/Sensor/APDS9960
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: APDS9960 Gesture/Proximity/Ambient Light/RGB Sensor (I2C)

; CPU架构: Sensor
; 位宽: 8位
; 时钟频率: 400000 Hz

; 外设定义
; APDS9960 Gesture/RGB Sensor (0x39, 3.3V)
.equ APDS9960_BASE, 0x39
.equ APDS9960_ENABLE, 0x80
.equ APDS9960_GESTURE, 0xFC
.equ APDS9960_PROXIMITY, 0x9C
.equ APDS9960_AMBIENT, 0x96
.equ APDS9960_RED, 0x98
.equ APDS9960_GREEN, 0x9A
.equ APDS9960_BLUE, 0x9C
.equ APDS9960_GESTURE_FIFO, 0xFC
.equ APDS9960_GESTURE_COUNT, 0xFD

; 中断向量定义
.equ INT_VECTOR, 0  ; Gesture/Proximity/Light interrupt

; 宏定义
.macro apds9960_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
apds9960_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
