; L298N寄存器定义
; 生成自: STMicroelectronics/Motor/L298N
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: L298N Dual H-Bridge DC Motor Driver (2A per channel, 5V-35V)

; CPU架构: Motor
; 位宽: 8位
; 时钟频率: 0 Hz

; 外设定义
; L298N Dual H-Bridge Motor Driver (5V logic, 5-35V motor)
.equ L298N_BASE, 0x00
.equ L298N_MOTOR_A, 0x00
.equ L298N_MOTOR_A_IN1, 0  ; Motor A Input 1
.equ L298N_MOTOR_A_IN2, 1  ; Motor A Input 2
.equ L298N_MOTOR_A_ENA, 2  ; Motor A Enable/PWM
.equ L298N_MOTOR_B, 0x01
.equ L298N_MOTOR_B_IN3, 0  ; Motor B Input 3
.equ L298N_MOTOR_B_IN4, 1  ; Motor B Input 4
.equ L298N_MOTOR_B_ENB, 2  ; Motor B Enable/PWM
.equ L298N_SPEED_A, 0x02
.equ L298N_SPEED_B, 0x03
.equ L298N_STATUS, 0x04

; 宏定义
.macro l298n_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
l298n_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
