; BL618寄存器定义
; 生成自: Bouffalo Lab/BL6/BL618
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: 32-bit RISC-V RV32IMAFC WiFi6 + BLE SoC with 4MB Flash, 512KB SRAM, 480MHz

; CPU架构: RISC-V
; 位宽: 32位
; 时钟频率: 320000000 Hz

; 寄存器定义
; Return Address
.equ X1, 0x04

; Stack Pointer (SP)
.equ X2, 0x08

; Global Pointer (GP)
.equ X3, 0x0C

; Frame Pointer (FP)
.equ X8, 0x20

; Function Argument (A0)
.equ X10, 0x28

; Function Argument (A1)
.equ X11, 0x2C

; Program Counter
.equ PC, 0x3C

; 内存段定义
.equ FLASH_START, 0x20000000
.equ FLASH_END, 0x203FFFFF
.equ FLASH_SIZE, 4194304

.equ SRAM_HPSYS_START, 0x22000000
.equ SRAM_HPSYS_END, 0x22003FFF
.equ SRAM_HPSYS_SIZE, 16384

; DTCM
.equ SRAM_DTCM_START, 0x22010000
.equ SRAM_DTCM_END, 0x22017FFF
.equ SRAM_DTCM_SIZE, 32768

.equ SRAM_SYS_START, 0x22020000
.equ SRAM_SYS_END, 0x2208FFFF
.equ SRAM_SYS_SIZE, 458752

.equ PERIPHERAL_START, 0x30000000
.equ PERIPHERAL_END, 0x300FFFFF
.equ PERIPHERAL_SIZE, 1048576

; 外设定义
; Global Control (Clock and Reset)
.equ GLB_BASE, 0x30000000
.equ GLB_GLB_CLK_EN, 0x10
.equ GLB_GLB_CLK_EN_GPIO_CLK_EN, 6  ; GPIO clock enable
.equ GLB_GLB_CLK_EN_UART0_CLK_EN, 12  ; UART0 clock enable
.equ GLB_GLB_SYS_CLK_CTRL, 0x14
.equ GLB_GLB_PLL_CTRL, 0x1C

; GPIO Port A
.equ GPIO_P0_BASE, 0x30007000
.equ GPIO_P0_GPIO_CFG0, 0x00
.equ GPIO_P0_GPIO_CFG1, 0x04
.equ GPIO_P0_GPIO_OE, 0x08
.equ GPIO_P0_GPIO_OUT, 0x0C
.equ GPIO_P0_GPIO_IN, 0x10
.equ GPIO_P0_GPIO_SET, 0x14
.equ GPIO_P0_GPIO_CLR, 0x18
.equ GPIO_P0_GPIO_TOG, 0x1C

; GPIO Port B
.equ GPIO_P1_BASE, 0x30007200
.equ GPIO_P1_GPIO_CFG0, 0x00
.equ GPIO_P1_GPIO_CFG1, 0x04
.equ GPIO_P1_GPIO_OE, 0x08
.equ GPIO_P1_GPIO_OUT, 0x0C
.equ GPIO_P1_GPIO_IN, 0x10
.equ GPIO_P1_GPIO_SET, 0x14
.equ GPIO_P1_GPIO_CLR, 0x18
.equ GPIO_P1_GPIO_TOG, 0x1C

; UART 0
.equ UART0_BASE, 0x30002000
.equ UART0_UART_CR, 0x00
.equ UART0_UART_BRR, 0x04
.equ UART0_UART_TDR, 0x08
.equ UART0_UART_RDR, 0x0C
.equ UART0_UART_SR, 0x10

; 中断向量定义
.equ RESET_VECTOR, 1  ; 
.equ MACHINESOFTWARE_VECTOR, 3  ; 
.equ MACHINETIMER_VECTOR, 7  ; 
.equ MACHINEEXTERNAL_VECTOR, 11  ; 
.equ UART0_VECTOR, 20  ; UART0 Interrupt

; 宏定义
.macro bl618_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
bl618_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
