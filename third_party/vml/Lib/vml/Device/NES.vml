; Nintendo Entertainment System寄存器定义
; 生成自: Nintendo/NES/Nintendo Entertainment System
; 版本: 
; 日期: 
; 作者: 
; 描述: Nintendo Entertainment System (NES/Famicom) 8-bit video game console

; CPU架构: 6502
; 位宽: 0位
; 时钟频率: 0 Hz

; 外设定义
; Picture Processing Unit (Ricoh 2C02)
.equ PPU_BASE, 
.equ PPU_PPUCTRL, 0x2000
.equ PPU_PPUCTRL_NMI, 7  ; VBlank NMI enable
.equ PPU_PPUCTRL_MASTERSLAVE, 6  ; Master/slave select
.equ PPU_PPUCTRL_SPRITESIZE, 5  ; Sprite size (0=8x8, 1=8x16)
.equ PPU_PPUCTRL_BGPATTERN, 4  ; Background pattern table address
.equ PPU_PPUCTRL_SPRITEPATTERN, 3  ; Sprite pattern table address
.equ PPU_PPUCTRL_VRAMINCREMENT, 2  ; VRAM address increment (0=1, 1=32)
.equ PPU_PPUCTRL_NAMETABLE, 0  ; Nametable address
.equ PPU_PPUMASK, 0x2001
.equ PPU_PPUMASK_EMPHASIZEBLUE, 7  ; Emphasize blue
.equ PPU_PPUMASK_EMPHASIZEGREEN, 6  ; Emphasize green
.equ PPU_PPUMASK_EMPHASIZERED, 5  ; Emphasize red
.equ PPU_PPUMASK_SHOWSPRITES, 4  ; Show sprites
.equ PPU_PPUMASK_SHOWBACKGROUND, 3  ; Show background
.equ PPU_PPUMASK_SHOWLEFTSPRITES, 2  ; Show sprites in left 8 pixels
.equ PPU_PPUMASK_SHOWLEFTBACKGROUND, 1  ; Show background in left 8 pixels
.equ PPU_PPUMASK_GRAYSCALE, 0  ; Grayscale mode
.equ PPU_PPUSTATUS, 0x2002
.equ PPU_PPUSTATUS_VBLANK, 7  ; VBlank started
.equ PPU_PPUSTATUS_SPRITE0HIT, 6  ; Sprite 0 hit
.equ PPU_PPUSTATUS_SPRITEOVERFLOW, 5  ; Sprite overflow
.equ PPU_OAMADDR, 0x2003
.equ PPU_OAMDATA, 0x2004
.equ PPU_PPUSCROLL, 0x2005
.equ PPU_PPUADDR, 0x2006
.equ PPU_PPUDATA, 0x2007
.equ PPU_OAMDMA, 0x4014

; Audio Processing Unit (Ricoh 2A03)
.equ APU_BASE, 
.equ APU_SQ1_VOL, 0x4000
.equ APU_SQ1_VOL_DUTY, 6  ; Duty cycle
.equ APU_SQ1_VOL_LENGTHCOUNTERHALT, 5  ; Length counter halt/envelope loop
.equ APU_SQ1_VOL_CONSTANTVOLUME, 4  ; Constant volume
.equ APU_SQ1_VOL_VOLUME, 0  ; Volume/envelope period
.equ APU_SQ1_SWEEP, 0x4001
.equ APU_SQ1_SWEEP_ENABLED, 7  ; Sweep enabled
.equ APU_SQ1_SWEEP_PERIOD, 4  ; Sweep period
.equ APU_SQ1_SWEEP_NEGATE, 3  ; Sweep negate
.equ APU_SQ1_SWEEP_SHIFT, 0  ; Sweep shift amount
.equ APU_SQ1_LO, 0x4002
.equ APU_SQ1_HI, 0x4003
.equ APU_SQ1_HI_LENGTHCOUNTER, 3  ; Length counter load
.equ APU_SQ1_HI_TIMERHIGH, 0  ; Timer high bits
.equ APU_SQ2_VOL, 0x4004
.equ APU_SQ2_SWEEP, 0x4005
.equ APU_SQ2_LO, 0x4006
.equ APU_SQ2_HI, 0x4007
.equ APU_TRI_LINEAR, 0x4008
.equ APU_TRI_LINEAR_CONTROL, 7  ; Length counter halt/linear counter control
.equ APU_TRI_LINEAR_PERIOD, 0  ; Linear counter load
.equ APU_TRI_LO, 0x400A
.equ APU_TRI_HI, 0x400B
.equ APU_NOISE_VOL, 0x400C
.equ APU_NOISE_LO, 0x400E
.equ APU_NOISE_LO_MODE, 7  ; Noise mode
.equ APU_NOISE_LO_PERIOD, 0  ; Noise period
.equ APU_NOISE_HI, 0x400F
.equ APU_DMC_FREQ, 0x4010
.equ APU_DMC_FREQ_IRQ, 7  ; IRQ enable
.equ APU_DMC_FREQ_LOOP, 6  ; Loop flag
.equ APU_DMC_FREQ_FREQUENCY, 0  ; Frequency index
.equ APU_DMC_RAW, 0x4011
.equ APU_DMC_START, 0x4012
.equ APU_DMC_LEN, 0x4013
.equ APU_OAMDMA, 0x4014
.equ APU_APUSTATUS, 0x4015
.equ APU_APUSTATUS_DMCINTERRUPT, 7  ; DMC interrupt flag
.equ APU_APUSTATUS_FRAMEINTERRUPT, 6  ; Frame interrupt flag
.equ APU_APUSTATUS_DMCENABLED, 4  ; DMC enabled
.equ APU_APUSTATUS_NOISEENABLED, 3  ; Noise enabled
.equ APU_APUSTATUS_TRIANGLEENABLED, 2  ; Triangle enabled
.equ APU_APUSTATUS_SQUARE2ENABLED, 1  ; Square 2 enabled
.equ APU_APUSTATUS_SQUARE1ENABLED, 0  ; Square 1 enabled
.equ APU_APUFRAME, 0x4017
.equ APU_APUFRAME_MODE, 7  ; Frame counter mode
.equ APU_APUFRAME_IRQINHIBIT, 6  ; IRQ inhibit

; Controller Interface
.equ CONTROLLER_BASE, 
.equ CONTROLLER_JOY1, 0x4016
.equ CONTROLLER_JOY1_A, 7  ; A button
.equ CONTROLLER_JOY1_B, 6  ; B button
.equ CONTROLLER_JOY1_SELECT, 5  ; Select button
.equ CONTROLLER_JOY1_START, 4  ; Start button
.equ CONTROLLER_JOY1_UP, 3  ; Up direction
.equ CONTROLLER_JOY1_DOWN, 2  ; Down direction
.equ CONTROLLER_JOY1_LEFT, 1  ; Left direction
.equ CONTROLLER_JOY1_RIGHT, 0  ; Right direction
.equ CONTROLLER_JOY2, 0x4017

; Memory Mapper (Cartridge)
.equ MAPPER_BASE, 
.equ MAPPER_PRGROM, 0
.equ MAPPER_CHRROM, 0
.equ MAPPER_PRGRAM, 0
.equ MAPPER_CHRRAM, 0

; 中断向量定义
.equ NMI_VECTOR, 65530  ; Non-maskable interrupt (VBlank)
.equ RESET_VECTOR, 65532  ; Reset vector
.equ IRQ_VECTOR, 65534  ; Interrupt request

; 宏定义
.macro nintendo_entertainment_system_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
nintendo_entertainment_system_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
