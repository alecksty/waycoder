; EFR32MG24寄存器定义
; 生成自: Silicon Labs/EFR32/EFR32MG24
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: 32-bit ARM Cortex-M33 MCU with 1536KB Flash, 256KB RAM, 78MHz, Zigbee/Thread/Matter

; CPU架构: ARM-Cortex-M33
; 位宽: 32位
; 时钟频率: 78000000 Hz

; 寄存器定义
.equ R0, 0x00

.equ R1, 0x04

.equ R2, 0x08

.equ R3, 0x0C

.equ R4, 0x10

.equ R5, 0x14

.equ SP, 0x34

.equ LR, 0x38

.equ PC, 0x3C

; 内存段定义
.equ FLASH_START, 0x08000000
.equ FLASH_END, 0x0817FFFF
.equ FLASH_SIZE, 1572864

.equ SRAM_START, 0x20000000
.equ SRAM_END, 0x2003FFFF
.equ SRAM_SIZE, 262144

.equ PERIPHERAL_START, 0x40000000
.equ PERIPHERAL_END, 0x4007FFFF
.equ PERIPHERAL_SIZE, 524288

; 外设定义
; Clock Management Unit
.equ CMU_BASE, 0x40080000
.equ CMU_CTRL, 0x00
.equ CMU_HFCORECLKCFG, 0x08
.equ CMU_HFPERCLKEN0, 0x10
.equ CMU_HFPERCLKEN0_GPIOEN, 4  ; GPIO clock enable
.equ CMU_HFPERCLKEN0_USART0EN, 12  ; USART0 clock enable
.equ CMU_HFPERCLKEN0_USART1EN, 13  ; USART1 clock enable
.equ CMU_LFBCLKEN0, 0x20

; GPIO Controller
.equ GPIO_BASE, 0x40088000
.equ GPIO_PORT_A_CTRL, 0x00
.equ GPIO_PORT_B_CTRL, 0x04
.equ GPIO_PORT_C_CTRL, 0x08
.equ GPIO_PORT_D_CTRL, 0x0C
.equ GPIO_MODEL, 0x10
.equ GPIO_MODEH, 0x14
.equ GPIO_DOUT, 0x1C
.equ GPIO_DOUTSET, 0x20
.equ GPIO_DOUTCLR, 0x24
.equ GPIO_DOUTTGL, 0x28
.equ GPIO_DIN, 0x2C

; GPIO Port A extended
.equ GPIO_PA_BASE, 0x40088400
.equ GPIO_PA_PA_CFG, 0x00
.equ GPIO_PA_PA_PINOUT, 0x04

; GPIO Port B extended
.equ GPIO_PB_BASE, 0x40088800
.equ GPIO_PB_PB_CFG, 0x00

; USART 0
.equ USART0_BASE, 0x40060000
.equ USART0_CTRL, 0x00
.equ USART0_CMD, 0x04
.equ USART0_STATUS, 0x08
.equ USART0_RXDATA, 0x0C
.equ USART0_TXDATA, 0x10
.equ USART0_CLKDIV, 0x14

; 中断向量定义
.equ RESET_VECTOR, 0  ; 
.equ SVCALL_VECTOR, 11  ; 
.equ USART0_RX_VECTOR, 12  ; USART0 Receive Interrupt
.equ USART0_TX_VECTOR, 13  ; USART0 Transmit Interrupt

; 宏定义
.macro efr32mg24_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
efr32mg24_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
