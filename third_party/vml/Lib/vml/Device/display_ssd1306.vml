; SSD1306寄存器定义
; 生成自: Solomon Systech/Display/SSD1306
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: SSD1306 128x64 OLED Display Controller (I2C/SPI)

; CPU架构: Display
; 位宽: 8位
; 时钟频率: 400000 Hz

; 内存段定义
; Graphic Display Data RAM (128x64 = 1024 bytes)
.equ GDDRAM_START, 0x00
.equ GDDRAM_END, 0x3FF
.equ GDDRAM_SIZE, 1024

; 外设定义
; SSD1306 128x64 OLED (0x3C/0x3D I2C, 3.3V-5V)
.equ SSD1306_BASE, 0x3C
.equ SSD1306_CMD, 0x00
.equ SSD1306_DATA, 0x40
.equ SSD1306_DISPLAY_OFF, 0xAE
.equ SSD1306_DISPLAY_ON, 0xAF
.equ SSD1306_CONTRAST, 0x81
.equ SSD1306_SEG_REMAP, 0xA1
.equ SSD1306_COM_SCAN, 0xC8
.equ SSD1306_ADDR_MODE, 0x20
.equ SSD1306_COL_START, 0x21
.equ SSD1306_PAGE_START, 0x22

; 宏定义
.macro ssd1306_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
ssd1306_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
