; NEC-VR4300寄存器定义
; 生成自: NEC/MIPS-R4000/NEC-VR4300
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: Nintendo 64 main processor - NEC VR4300 (MIPS R4300i-compatible) @ 93.75MHz, 64-bit R4000-like

; CPU架构: MIPS-R4300i
; 位宽: 64位
; 时钟频率: 93750000 Hz

; 寄存器定义
; Hard-wired Zero
.equ R0, 0x00

; Assembler Temporary
.equ R1, 0x08

; Value Return
.equ R2, 0x10

; Expression Evaluation
.equ R3, 0x18

; Expression Evaluation
.equ R4, 0x20

; Expression Evaluation
.equ R5, 0x28

; Expression Evaluation
.equ R6, 0x30

; Expression Evaluation
.equ R7, 0x38

; Expression Evaluation
.equ R8, 0x40

; Expression Evaluation
.equ R9, 0x48

; Expression Evaluation
.equ R10, 0x50

; Expression Evaluation
.equ R11, 0x58

; Expression Evaluation
.equ R12, 0x60

; Expression Evaluation
.equ R13, 0x68

; Expression Evaluation
.equ R14, 0x70

; Expression Evaluation
.equ R15, 0x78

; Saved Value
.equ R16, 0x80

; Saved Value
.equ R17, 0x88

; Saved Value
.equ R18, 0x90

; Saved Value
.equ R19, 0x98

; Saved Value
.equ R20, 0xA0

; Saved Value
.equ R21, 0xA8

; Saved Value
.equ R22, 0xB0

; Saved Value
.equ R23, 0xB8

; Temporary
.equ R24, 0xC0

; Temporary
.equ R25, 0xC8

; Kernel Reserved
.equ R26, 0xD0

; Kernel Reserved
.equ R27, 0xD8

; Global Pointer
.equ R28, 0xE0

; Stack Pointer
.equ R29, 0xE8

; Frame Pointer
.equ R30, 0xF0

; Return Address
.equ R31, 0xF8

; Multiply/Divide High (64-bit)
.equ HI, 0x100

; Multiply/Divide Low (64-bit)
.equ LO, 0x108

; Program Counter
.equ PC, 0x110

; LLAddr / LLBit (for LL/SC)
.equ LLB, 0x118

; TLB Index
.equ CP0_INDEX, 0x200

; TLB Random
.equ CP0_RANDOM, 0x208

; TLB EntryLo 0 (even page)
.equ CP0_ENTRYLO0, 0x210

; TLB EntryLo 1 (odd page)
.equ CP0_ENTRYLO1, 0x218

; Context Register (PTE base)
.equ CP0_CONTEXT, 0x220

; Page Mask (variable page size)
.equ CP0_PAGEMASK, 0x228

; TLB Wired
.equ CP0_WIRED, 0x230

; Bad Virtual Address
.equ CP0_BADVADDR, 0x238

; Count (incrementing timer)
.equ CP0_COUNT, 0x240

; TLB EntryHi (VPN2 + ASID)
.equ CP0_ENTRYHI, 0x250

; Compare (timer interrupt)
.equ CP0_COMPARE, 0x258

; Status Register
.equ CP0_STATUS, 0x260
.equ CP0_STATUS_IE, 0  ; Interrupt Enable
.equ CP0_STATUS_EXL, 1  ; Exception Level
.equ CP0_STATUS_ERL, 2  ; Error Level
.equ CP0_STATUS_KSU, 0  ; Kernel/User Mode
.equ CP0_STATUS_UX, 5  ; User Mode 64-bit (1=64-bit user)
.equ CP0_STATUS_SX, 6  ; Supervisor Mode 64-bit
.equ CP0_STATUS_KX, 7  ; Kernel Mode 64-bit
.equ CP0_STATUS_IM0_7, 0  ; Interrupt Mask
.equ CP0_STATUS_CU0, 28  ; Coprocessor 0 Usable
.equ CP0_STATUS_BEV, 22  ; Bootstrap Exception Vector
.equ CP0_STATUS_TS, 21  ; TLB Shutdown
.equ CP0_STATUS_FR, 26  ; Floating-Point Register Mode (32 double)

; Cause Register
.equ CP0_CAUSE, 0x268
.equ CP0_CAUSE_EXCCODE, 0  ; Exception Code
.equ CP0_CAUSE_IP0_7, 0  ; Interrupt Pending
.equ CP0_CAUSE_BD, 31  ; Branch Delay Slot
.equ CP0_CAUSE_CE, 0  ; Coprocessor Error

; Exception PC
.equ CP0_EPC, 0x270

; Config Register
.equ CP0_CONFIG, 0x280

; Load Linked Address
.equ CP0_LLADDR, 0x288

; WatchLo (data/instruction break)
.equ CP0_WATCHLO, 0x290

; WatchHi
.equ CP0_WATCHHI, 0x298

; Extended Context
.equ CP0_XCONTEXT, 0x2A0

; Tag/Process ID
.equ CP0_PID, 0x2B0

; Debug Register
.equ CP0_DEBUG, 0x2D8

; Performance Counter
.equ CP0_PERF, 0x2F0

; 内存段定义
; RDRAM (4MB base, up to 8MB)
.equ RDRAM_START, 0x00000000
.equ RDRAM_END, 0x003FFFFF
.equ RDRAM_SIZE, 4194304

; RDRAM Registers
.equ RDRAM_REG_START, 0x18000000
.equ RDRAM_REG_END, 0x18000FFF
.equ RDRAM_REG_SIZE, 4096

; RCP SP Memory / DMEM (2KB)
.equ SP_MEM_START, 0x1FC00000
.equ SP_MEM_END, 0x1FC007FF
.equ SP_MEM_SIZE, 2048

; RCP SP Instruction Memory / IMEM (2KB)
.equ SP_IMEM_START, 0x1FC00800
.equ SP_IMEM_END, 0x1FC00FFF
.equ SP_IMEM_SIZE, 2048

; RCP Register Area
.equ RCP_REGS_START, 0x1FC00000
.equ RCP_REGS_END, 0x1FC3FFFF
.equ RCP_REGS_SIZE, 262144

; PI (Peripheral Interface) Registers
.equ PI_REGS_START, 0x1FC00000
.equ PI_REGS_END, 0x1FC007FF
.equ PI_REGS_SIZE, 2048

; VI (Video Interface) Registers
.equ VI_REGS_START, 0x1FC002C0
.equ VI_REGS_END, 0x1FC002FF
.equ VI_REGS_SIZE, 64

; AI (Audio Interface) Registers
.equ AI_REGS_START, 0x1FC00500
.equ AI_REGS_END, 0x1FC0053F
.equ AI_REGS_SIZE, 64

; SI (Serial Interface) Registers
.equ SI_REGS_START, 0x1FC004C0
.equ SI_REGS_END, 0x1FC004FF
.equ SI_REGS_SIZE, 64

; PI Bus DRAM (cartridge)
.equ PI_DRAM_START, 0xA0000000
.equ PI_DRAM_END, 0xA4000000
.equ PI_DRAM_SIZE, 67108864

; Cartridge ROM (up to 256MB)
.equ CART_ROM_START, 0xB0000000
.equ CART_ROM_END, 0xBFFFFFFF
.equ CART_ROM_SIZE, 268435456

; PIF-NUS ROM/RAM (CIC)
.equ PIF_RAM_START, 0x1FC007C0
.equ PIF_RAM_END, 0x1FC007FF
.equ PIF_RAM_SIZE, 64

; 外设定义
; Reality Signal Processor (Audio/Video microcode engine)
.equ RSP_BASE, 0x04040000
.equ RSP_SP_MEM_ADDR, 0x00
.equ RSP_SP_DRAM_ADDR, 0x04
.equ RSP_SP_RD_LEN, 0x08
.equ RSP_SP_WR_LEN, 0x0C
.equ RSP_SP_STATUS, 0x10
.equ RSP_SP_STATUS_BROKE, 0  ; Command Queue Broke
.equ RSP_SP_STATUS_SLEEP, 2  ; SP Sleep
.equ RSP_SP_STATUS_GOODMATCH, 3  ; DMEM/IMEM Goodmatch
.equ RSP_SP_STATUS_SSTEP, 4  ; Single Step
.equ RSP_SP_STATUS_INTSIG, 5  ; Interrupt Signal
.equ RSP_SP_STATUS_HALT, 6  ; Halt
.equ RSP_SP_STATUS_CLEAR, 7  ; Clear SP Status
.equ RSP_SP_STATUS_INTR_BRK, 8  ; IntrOnBreak
.equ RSP_SP_STATUS_SIGNAL0, 12  ; Software Signal 0
.equ RSP_SP_STATUS_SIGNAL1, 13  ; Software Signal 1
.equ RSP_SP_STATUS_SIGNAL2, 14  ; Software Signal 2
.equ RSP_SP_STATUS_SIGNAL3, 15  ; Software Signal 3
.equ RSP_SP_STATUS_SIGNAL4, 16  ; Software Signal 4
.equ RSP_SP_STATUS_SIGNAL5, 17  ; Software Signal 5
.equ RSP_SP_STATUS_SIGNAL6, 18  ; Software Signal 6
.equ RSP_SP_STATUS_SIGNAL7, 19  ; Software Signal 7
.equ RSP_SP_DMA_FULL, 0x14
.equ RSP_SP_DMA_BUSY, 0x18
.equ RSP_SP_SEMAPHORE, 0x1C
.equ RSP_SP_PC, 0x20
.equ RSP_SP_IBIST, 0x24

; Reality Drawing Processor (Triangle/Quad rasterizer)
.equ RDP_BASE, 0x04100000
.equ RDP_DP_START, 0x00
.equ RDP_DP_END, 0x04
.equ RDP_DP_CURRENT, 0x08
.equ RDP_DP_STATUS, 0x0C
.equ RDP_DP_STATUS_TERMINATE, 0  ; Terminator
.equ RDP_DP_STATUS_PIPE_BUSY, 1  ; Pipeline Busy
.equ RDP_DP_STATUS_TOMINO_BUSY, 2  ; ToMini Busy
.equ RDP_DP_STATUS_PIPE_FLUSH, 3  ; Pipeline Flush
.equ RDP_DP_STATUS_TOMINO_FLUSH, 4  ; ToMini Flush
.equ RDP_DP_STATUS_FREEZE, 5  ; Freeze
.equ RDP_DP_STATUS_START_GCLK, 24  ; Start GCLK
.equ RDP_DP_CLOCK, 0x10
.equ RDP_DP_BUFBUSY, 0x14
.equ RDP_DP_PIPEBUSY, 0x18
.equ RDP_DP_TMEM, 0x1C

; Video Interface (scanout engine)
.equ VI_BASE, 0x04400000
.equ VI_VI_STATUS, 0x00
.equ VI_VI_STATUS_TYPE, 0  ; Display Type (0=blank, 1=reserved, 2=480i, 3=240p, 4=1080i, 5=576i)
.equ VI_VI_STATUS_DITHER_FILTER, 6  ; Dither Filter Enable
.equ VI_VI_STATUS_GAMMA, 7  ; Gamma Correction Enable
.equ VI_VI_STATUS_GAMMA_DITHER, 8  ; Gamma Dither Enable
.equ VI_VI_STATUS_DIVOT, 9  ; Divot Control
.equ VI_VI_STATUS_SERRATION, 10  ;  Serration Enable (for interlaced)
.equ VI_VI_ORIGIN, 0x04
.equ VI_VI_WIDTH, 0x08
.equ VI_VI_V_INTR, 0x0C
.equ VI_VI_V_CURRENT, 0x10
.equ VI_VI_BURST, 0x14
.equ VI_VI_H_SYNC, 0x18
.equ VI_VI_H_SYNC_LEAP, 0x1C
.equ VI_VI_H_VIDEO, 0x20
.equ VI_VI_V_VIDEO, 0x24
.equ VI_VI_V_BURST, 0x28
.equ VI_VI_X_SCALE, 0x2C
.equ VI_VI_Y_SCALE, 0x30

; Audio Interface (DAC)
.equ AI_BASE, 0x04500000
.equ AI_AI_DRAM_ADDR, 0x00
.equ AI_AI_LEN, 0x04
.equ AI_AI_CONTROL, 0x08
.equ AI_AI_CONTROL_DMA_ENABLE, 0  ; DMA Enable
.equ AI_AI_CONTROL_DMA_FIFO_FULL, 1  ; DMA FIFO Full
.equ AI_AI_STATUS, 0x0C
.equ AI_AI_DACRATE, 0x10
.equ AI_AI_BITRATE, 0x14

; Peripheral Interface (cartridge bus)
.equ PI_BASE, 0x04600000
.equ PI_PI_DRAM_ADDR, 0x00
.equ PI_PI_CART_ADDR, 0x04
.equ PI_PI_RD_LEN, 0x08
.equ PI_PI_WR_LEN, 0x0C
.equ PI_PI_STATUS, 0x10
.equ PI_PI_STATUS_DMA_BUSY, 0  ; DMA Busy
.equ PI_PI_STATUS_IO_BUSY, 1  ; I/O Busy
.equ PI_PI_STATUS_ERROR, 2  ; Bus Error
.equ PI_PI_BSD_DOM1_LAT, 0x14
.equ PI_PI_BSD_DOM1_PWD, 0x18
.equ PI_PI_BSD_DOM1_PGS, 0x1C
.equ PI_PI_BSD_DOM1_RLS, 0x20
.equ PI_PI_BSD_DOM2_LAT, 0x24
.equ PI_PI_BSD_DOM2_PWD, 0x28
.equ PI_PI_BSD_DOM2_PGS, 0x2C
.equ PI_PI_BSD_DOM2_RLS, 0x30

; Serial Interface (Controller Pak / 64DD)
.equ SI_BASE, 0x04800000
.equ SI_SI_DRAM_ADDR, 0x00
.equ SI_SI_PIF_ADDR_RD64B, 0x04
.equ SI_SI_PIF_ADDR_WR64B, 0x08
.equ SI_SI_STATUS, 0x10
.equ SI_SI_STATUS_DMA_BUSY, 0  ; DMA Busy
.equ SI_SI_STATUS_IO_BUSY, 1  ; I/O Busy
.equ SI_SI_STATUS_INTERRUPT, 12  ; SI Interrupt

; PIF (CIC / NUSYC - anti-piracy/copy protection)
.equ PIF_BASE, 0x1FC007C0
.equ PIF_PIF_CMD0, 0x00
.equ PIF_PIF_CMD1, 0x01
.equ PIF_PIF_CMD2, 0x02
.equ PIF_PIF_CMD3, 0x03
.equ PIF_PIF_CMD4, 0x04
.equ PIF_PIF_CMD5, 0x05
.equ PIF_PIF_CMD6, 0x06
.equ PIF_PIF_CMD7, 0x07
.equ PIF_PIF_STATUS, 0x3F

; Interrupt Control
.equ INTERRUPT_BASE, 0x1FC00200
.equ INTERRUPT_MI_MODE, 0x00
.equ INTERRUPT_MI_MODE_INIT_MODE, 0  ; Initialize Mode
.equ INTERRUPT_MI_MODE_EBUS_TEST, 1  ; EBUS Test Mode
.equ INTERRUPT_MI_VERSION, 0x04
.equ INTERRUPT_MI_INTR, 0x08
.equ INTERRUPT_MI_INTR_SP, 0  ; SP Interrupt Pending
.equ INTERRUPT_MI_INTR_SI, 1  ; SI Interrupt Pending
.equ INTERRUPT_MI_INTR_AI, 2  ; AI Interrupt Pending
.equ INTERRUPT_MI_INTR_VI, 3  ; VI Interrupt Pending
.equ INTERRUPT_MI_INTR_PI, 4  ; PI Interrupt Pending
.equ INTERRUPT_MI_INTR_DP, 5  ; DP Interrupt Pending
.equ INTERRUPT_MI_INTR_MASK, 0x0C
.equ INTERRUPT_MI_INTR_MASK_SP_MASK, 0  ; SP Interrupt Mask
.equ INTERRUPT_MI_INTR_MASK_SI_MASK, 1  ; SI Interrupt Mask
.equ INTERRUPT_MI_INTR_MASK_AI_MASK, 2  ; AI Interrupt Mask
.equ INTERRUPT_MI_INTR_MASK_VI_MASK, 3  ; VI Interrupt Mask
.equ INTERRUPT_MI_INTR_MASK_PI_MASK, 4  ; PI Interrupt Mask
.equ INTERRUPT_MI_INTR_MASK_DP_MASK, 5  ; DP Interrupt Mask

; Controller Interface (SI channel 0-3)
.equ CONTROLLER_BASE, 0x1FC00600
.equ CONTROLLER_SI_CH0_DATA, 0x00
.equ CONTROLLER_SI_CH1_DATA, 0x08
.equ CONTROLLER_SI_CH2_DATA, 0x10
.equ CONTROLLER_SI_CH3_DATA, 0x18

; 中断向量定义
.equ RESET_VECTOR, 0  ; Soft Reset / NMI
.equ TLB_REFILL_VECTOR, 1  ; TLB Refill (I) / TLB Refill (D)
.equ CACHE_ERROR_VECTOR, 2  ; Cache Error
.equ GENERAL_EXCEPTION_VECTOR, 3  ; General Exception
.equ RSP_VECTOR, 4  ; RSP Interrupt (microcode signal)
.equ RDP_VECTOR, 5  ; RDP Interrupt (display list complete)
.equ VI_VECTOR, 6  ; VI Interrupt (V-Blank / scanline)
.equ AI_VECTOR, 7  ; AI Interrupt (audio DMA complete)
.equ PI_VECTOR, 8  ; PI Interrupt (cartridge DMA)
.equ SI_VECTOR, 9  ; SI Interrupt (serial interface)
.equ TIMER_COMPARE_VECTOR, 10  ; Timer Compare (CP0 Count == Compare)

; 引脚定义
.equ PIN_VCC, 1  ; Power Supply (3.3V)
.equ PIN_VSS, 2  ; Ground
.equ PIN_CLK, 3  ; System Clock (93.75MHz from CIC/PLL)
.equ PIN_RESET, 4  ; Reset (active low)
.equ PIN_NMI, 5  ; Non-Maskable Interrupt
.equ PIN_INT0, 6  ; Interrupt 0 (RCP)
