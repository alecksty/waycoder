; 宏定义
.macro nec_vr4300_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
nec_vr4300_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
