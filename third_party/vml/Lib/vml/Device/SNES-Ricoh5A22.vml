; Ricoh-5A22寄存器定义
; 生成自: Ricoh/MOS-6502/Ricoh-5A22
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: Super Nintendo Entertainment System (SNES) main processor - 16-bit 6502 variant with enhanced capabilities

; CPU架构: Ricoh-5A22
; 位宽: 16位
; 时钟频率: 3580000 Hz

; 寄存器定义
; Accumulator (8-bit, expandable to 16-bit)
.equ A, 0x00

; Accumulator high byte when 16-bit
.equ B, 0x01

; X Index Register (8/16-bit)
.equ X, 0x02

; Y Index Register (8/16-bit)
.equ Y, 0x03

; Stack Pointer (8-bit, banked)
.equ SP, 0x04

; Program Counter (16-bit)
.equ PC, 0x06

; Direct Page Register
.equ D, 0x08

; Processor Status
.equ P, 0x0A
.equ P_N, 0  ; Negative
.equ P_V, 1  ; Overflow
.equ P_M, 2  ; Memory/Accumulator Select (0=16-bit, 1=8-bit)
.equ P_X, 3  ; Index Select (0=16-bit, 1=8-bit)
.equ P_B, 4  ; Break
.equ P_D, 5  ; Decimal Mode
.equ P_I, 6  ; Interrupt Disable
.equ P_Z, 7  ; Zero
.equ P_C, 8  ; Carry

; 内存段定义
; Work RAM (128KB internal)
.equ WRAM_START, 0x7E0000
.equ WRAM_END, 0x7FFFFF
.equ WRAM_SIZE, 131072

; Save RAM / Cartridge SRAM
.equ SRAM_START, 0x600000
.equ SRAM_END, 0x6FFFFF
.equ SRAM_SIZE, 1048576

; Cartridge ROM (LoROM/HiROM mapping)
.equ CART_ROM_START, 0x800000
.equ CART_ROM_END, 0xFFFFFF
.equ CART_ROM_SIZE, 8388608

; PPU1 Registers (background)
.equ PPU1_REGS_START, 0x2100
.equ PPU1_REGS_END, 0x213F
.equ PPU1_REGS_SIZE, 64

; PPU2 Registers (sprites)
.equ PPU2_REGS_START, 0x2140
.equ PPU2_REGS_END, 0x217F
.equ PPU2_REGS_SIZE, 64

; PPU3 Registers (extra)
.equ PPU3_REGS_START, 0x2180
.equ PPU3_REGS_END, 0x21FF
.equ PPU3_REGS_SIZE, 128

; APU I/O Registers
.equ APU_REGS_START, 0x2140
.equ APU_REGS_END, 0x217F
.equ APU_REGS_SIZE, 64

; CPU I/O Ports
.equ CPU_IO_START, 0x2000
.equ CPU_IO_END, 0x20FF
.equ CPU_IO_SIZE, 256

; DMA Channel Registers
.equ DMA_REGS_START, 0x4300
.equ DMA_REGS_END, 0x437F
