; BMP280寄存器定义
; 生成自: Bosch/Sensor/BMP280
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: Digital Barometric Pressure and Temperature Sensor (I2C/SPI)

; CPU架构: Sensor
; 位宽: 8位
; 时钟频率: 3400000 Hz

; 内存段定义
; LGA-8 (2.0x2.5x0.95mm)
.equ PACKAGE_START, 0x00
.equ PACKAGE_END, 0x00
.equ PACKAGE_SIZE, 8

; 外设定义
; BMP280 I2C Sensor (0x76/0x77, 1.71V-3.6V)
.equ BMP280_BASE, 0x76
.equ BMP280_TEMP_XLSB, 0xFC
.equ BMP280_TEMP_LSB, 0xFB
.equ BMP280_TEMP_MSB, 0xFA
.equ BMP280_PRESS_XLSB, 0xF9
.equ BMP280_PRESS_LSB, 0xF8
.equ BMP280_PRESS_MSB, 0xF7
.equ BMP280_CONFIG, 0xF5
.equ BMP280_CONFIG_T_SB, 5  ; Standby time in normal mode
.equ BMP280_CONFIG_FILTER, 2  ; Filter coefficient
.equ BMP280_CONFIG_SPI3W_EN, 0  ; Enable 3-wire SPI
.equ BMP280_CTRL_MEAS, 0xF4
.equ BMP280_CTRL_MEAS_MODE, 0  ; 0=sleep, 1/2=forced, 3=normal
.equ BMP280_CTRL_MEAS_OSRS_P, 2  ; Pressure oversampling
.equ BMP280_CTRL_MEAS_OSRS_T, 5  ; Temperature oversampling
.equ BMP280_STATUS, 0xF3
.equ BMP280_STATUS_IM_UPDATE, 0  ; 1=Image register update in progress
.equ BMP280_STATUS_MEASURING, 3  ; 1=Conversion is running
.equ BMP280_CHIP_ID, 0xD0
.equ BMP280_RESET, 0xE0

; 宏定义
.macro bmp280_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
bmp280_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
