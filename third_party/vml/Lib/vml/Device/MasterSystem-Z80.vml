; Zilog-Z80寄存器定义
; 生成自: Zilog/Z80/Zilog-Z80
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: Sega Master System (Mark III) main processor - Zilog Z80A @ 3.58MHz

; CPU架构: Z80
; 位宽: 8位
; 时钟频率: 3580000 Hz

; 寄存器定义
; Accumulator
.equ A, 0x00

; Flags Register
.equ F, 0x01
.equ F_C, 0  ; Carry
.equ F_N, 1  ; Subtract
.equ F_P, 2  ; Parity/Overflow
.equ F_H, 4  ; Half Carry
.equ F_Z, 6  ; Zero
.equ F_S, 7  ; Sign/Negative

; B Register
.equ B, 0x02

; C Register
.equ C, 0x03

; D Register
.equ D, 0x04

; E Register
.equ E, 0x05

; H Register
.equ H, 0x06

; L Register
.equ L, 0x07

; Alternate AF
.equ AF, 0x08

; Alternate BC
.equ BC, 0x0A

; Alternate DE
.equ DE, 0x0C

; Alternate HL
.equ HL, 0x0E

; Index Register X
.equ IX, 0x10

; Index Register Y
.equ IY, 0x12

; Stack Pointer
.equ SP, 0x14

; Program Counter
.equ PC, 0x16

; Interrupt Vector Register
.equ I, 0x18

; Memory Refresh Register
.equ R, 0x19

; Interrupt Mode (0/1/2)
.equ IM, 0x1A

; 内存段定义
; Work RAM (2KB internal)
.equ WRAM_START, 0xC000
.equ WRAM_END, 0xC7FF
.equ WRAM_SIZE, 2048

; Work RAM Shadow (Echo RAM)
.equ WRAM_SHADOW_START, 0xE000
.equ WRAM_SHADOW_END, 0xE7FF
.equ WRAM_SHADOW_SIZE, 2048

; Video RAM (16KB)
.equ VRAM_START, 0x4000
.equ VRAM_END, 0x7FFF
.equ VRAM_SIZE, 16384

; Cartridge SRAM (if present)
.equ SRAM_START, 0x8000
.equ SRAM_END, 0xBFFF
.equ SRAM_SIZE, 16384

; Cartridge ROM (up to 48KB)
.equ CART_ROM_START, 0x0000
.equ CART_ROM_END, 0x7FFF
.equ CART_ROM_SIZE, 32768

; BIOS ROM (Master System built-in, 8KB)
.equ BIOS_START, 0x0000
.equ BIOS_END, 0x1FFF
.equ BIOS_SIZE, 8192

; I/O Register Area
.equ IO_REGS_START, 0x3F00
.equ IO_REGS_END, 0x3FFF
.equ IO_REGS_SIZE, 256

; 外设定义
; Video Display Processor (TMS9918A variant)
.equ VDP_BASE, 0xBE
.equ VDP_VDP_CTRL, 0xBF
.equ VDP_VDP_DATA, 0xBE
.equ VDP_VDP_STATUS, 0xBF
.equ VDP_VDP_STATUS_FIFO_FULL, 0  ; VRAM to CPU Transfer Pending
.equ VDP_VDP_STATUS_FIFO_EMPTY, 1  ; VRAM Write FIFO Empty
.equ VDP_VDP_STATUS_INT_FLAG, 7  ; V-Blank / Sprite Collision Flag
.equ VDP_R0, 0x00
.equ VDP_R0_M3, 0  ; Mode 3 Enable
.equ VDP_R0_M2, 1  ; Mode 2 Enable
.equ VDP_R0_M1, 2  ; Mode 1 Enable
.equ VDP_R0_DISPLAY_DISABLE, 3  ; Display Disable (1=blank screen)
.equ VDP_R0_VIRQ_EN, 4  ; Vertical Interrupt Enable
.equ VDP_R0_M4, 5  ; Mode 4 Enable (SMS2 only)
.equ VDP_R0_SPRITE_SHIFT, 6  ; Sprite Double Height
.equ VDP_R0_HVC_LATCH, 7  ; H-Counter Latch Enable
.equ VDP_R1, 0x01
.equ VDP_R1_DISPLAY, 3  ; Display Enable (1=active)
.equ VDP_R1_FRAME_INT, 4  ; Frame Interrupt (V-Blank) Enable
.equ VDP_R1_M4, 5  ; Mode 4 (256-color)
.equ VDP_R1_SMS_MODE, 6  ; SMS Display Mode (vs Coleco)
.equ VDP_R1_EXT_VIDEO, 7  ; External Video Enable
.equ VDP_R2, 0x02
.equ VDP_R3, 0x03
.equ VDP_R4, 0x04
.equ VDP_R5, 0x05
.equ VDP_R6, 0x06
.equ VDP_R7, 0x07
.equ VDP_R8, 0x08
.equ VDP_R8_HSCROLL_EN, 0  ; Horizontal Scroll Enable
.equ VDP_R8_VSCROLL_EN, 1  ; Vertical Scroll Enable
.equ VDP_R8_LINE_INT, 4  ; Line Interrupt Enable
.equ VDP_R8_VSCROLL_2X, 7  ; Vertical Scroll 2x Speed
.equ VDP_R9, 0x09
.equ VDP_R10, 0x0A
.equ VDP_R11, 0x0B
.equ VDP_R12, 0x0C
.equ VDP_R13, 0x0D
.equ VDP_R14, 0x0E
.equ VDP_R15, 0x0F
.equ VDP_VCOUNTER, 0x7E
.equ VDP_HCOUNTER, 0x7F

; SN76489 Programmable Sound Generator (3 Square + 1 Noise)
.equ PSG_BASE, 0x7F
.equ PSG_CH0_FREQ, 0x00
.equ PSG_CH1_FREQ, 0x02
.equ PSG_CH2_FREQ, 0x04
.equ PSG_CH3_CONFIG, 0x06
.equ PSG_CH3_CONFIG_TYPE, 0  ; Noise Type (0=White, 1=Periodic, 2-3=Periodic at freq/2^type)
.equ PSG_CH3_CONFIG_VOLUME, 0  ; Volume (0-15)
.equ PSG_CH0_VOLUME, 0x01
.equ PSG_CH1_VOLUME, 0x03
.equ PSG_CH2_VOLUME, 0x05

; I/O Port Registers
.equ PORTS_BASE, 0x3F
.equ PORTS_PORT_A, 0x3F
.equ PORTS_PORT_A_UP, 0  ; Up (0=pressed)
.equ PORTS_PORT_A_DOWN, 1  ; Down (0=pressed)
.equ PORTS_PORT_A_LEFT, 2  ; Left (0=pressed)
.equ PORTS_PORT_A_RIGHT, 3  ; Right (0=pressed)
.equ PORTS_PORT_A_TR, 4  ; Button TR (0=pressed)
.equ PORTS_PORT_A_TL, 5  ; Button TL (0=pressed)
.equ PORTS_PORT_B, 0x3F
.equ PORTS_PORT_B_UP, 0  ; Up (0=pressed)
.equ PORTS_PORT_B_DOWN, 1  ; Down (0=pressed)
.equ PORTS_PORT_B_LEFT, 2  ; Left (0=pressed)
.equ PORTS_PORT_B_RIGHT, 3  ; Right (0=pressed)
.equ PORTS_PORT_B_TR, 4  ; Button TR (0=pressed)
.equ PORTS_PORT_B_TL, 5  ; Button TL (0=pressed)
.equ PORTS_PORT_A_DDR, 0x3F
.equ PORTS_PORT_B_DDR, 0x3F

; Sega Mapper (Memory Bank Switching)
.equ SEGAMAPPER_BASE, 0xFFFD
.equ SEGAMAPPER_ROM_BANK0, 0xFFFD
.equ SEGAMAPPER_ROM_BANK1, 0xFFFE
.equ SEGAMAPPER_ROM_BANK2, 0xFFFF

; Memory Mapper Control
.equ MAPPER_BASE, 0xFFFF
.equ MAPPER_SRAM_BANK, 0xFFF8

; 中断向量定义
.equ NMI_VECTOR, 0  ; Non-Maskable Interrupt (Pause button / V-Blank)
.equ INT_VBLANK_VECTOR, 1  ; V-Blank Interrupt (Frame end)
.equ INT_LINE_VECTOR, 2  ; Scanline Interrupt (Line counter match)
.equ INT_EXT_VECTOR, 3  ; External I/O Interrupt

; 引脚定义
.equ PIN_A, 1  ; Power Supply
.equ PIN_GND, 2  ; Ground
.equ PIN_PHI, 3  ; System Clock (3.579545 MHz NTSC / 3.546894 MHz PAL)
.equ PIN_RESET, 4  ; Reset (active low)
.equ PIN_M1, 5  ; Machine Cycle 1 (instruction fetch)
.equ PIN_MREQ, 6  ; Memory Request
.equ PIN_IORQ, 7  ; I/O Request
.equ PIN_RD, 8  ; Read Strobe
.equ PIN_WR, 9  ; Write Strobe
.equ PIN_HALT, 10  ; Halt State
.equ PIN_WAIT, 11  ; Wait State Request
.equ PIN_INT, 12  ; Interrupt Request (active low)
.equ PIN_NMI, 13  ; Non-Maskable Interrupt (active low)
.equ PIN_BUSRQ, 14  ; Bus Request (active low)
.equ PIN_BUSAK, 15  ; Bus Acknowledge (active low)
.equ PIN_A0, 16  ; Address Bus Bit 0
.equ PIN_A1, 17  ; Address Bus Bit 1
.equ PIN_A2, 18  ; Address Bus Bit 2
.equ PIN_A3, 19  ; Address Bus Bit 3
.equ PIN_A4, 20  ; Address Bus Bit 4
.equ PIN_A5, 21  ; Address Bus Bit 5
.equ PIN_A6, 22  ; Address Bus Bit 6
.equ PIN_A7, 23  ; Address Bus Bit 7
.equ PIN_A8, 24  ; Address Bus Bit 8
.equ PIN_A9, 25  ; Address Bus Bit 9
.equ PIN_A10, 26  ; Address Bus Bit 10
.equ PIN_A11, 27  ; Address Bus Bit 11
.equ PIN_A12, 28  ; Address Bus Bit 12
.equ PIN_A13, 29  ; Address Bus Bit 13
.equ PIN_A14, 30  ; Address Bus Bit 14
.equ PIN_A15, 31  ; Address Bus Bit 15
.equ PIN_D0, 32  ; Data Bus Bit 0
.equ PIN_D1, 33  ; Data Bus Bit 1
.equ PIN_D2, 34  ; Data Bus Bit 2
.equ PIN_D3, 35  ; Data Bus Bit 3
.equ PIN_D4, 36  ; Data Bus Bit 4
.equ PIN_D5, 37  ; Data Bus Bit 5
.equ PIN_D6, 38  ; Data Bus Bit 6
.equ PIN_D7, 39  ; Data Bus Bit 7
.equ PIN_AUDIO_OUT, 40  ; Audio Output
.equ PIN_VIDEO_SYNC, 41  ; Composite Video Sync
.equ PIN_VIDEO_OUT, 42  ; Composite Video Output

; 宏定义
.macro zilog_z80_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
zilog_z80_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
