; Ricoh-2A03寄存器定义
; 生成自: Ricoh/MOS-6502/Ricoh-2A03
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: NES (Famicom) main processor - 8-bit MOS 6502 variant with audio/video support

; CPU架构: MOS-6502
; 位宽: 8位
; 时钟频率: 10765930 Hz

; 寄存器定义
; Accumulator
.equ A, 0x00

; X Index
.equ X, 0x01

; Y Index
.equ Y, 0x02

; Stack Pointer
.equ SP, 0x03

; Program Counter (16-bit)
.equ PC, 0x04

; Processor Status
.equ P, 0x06
.equ P_C, 0  ; Carry
.equ P_Z, 1  ; Zero
.equ P_I, 2  ; Interrupt Disable
.equ P_D, 3  ; Decimal Mode
.equ P_B, 4  ; Break
.equ P_U, 5  ; Unused
.equ P_V, 6  ; Overflow
.equ P_N, 7  ; Negative

; 内存段定义
; CPU 2KB RAM (mirrored)
.equ CPU_RAM_START, 0x0000
.equ CPU_RAM_END, 0x07FF
.equ CPU_RAM_SIZE, 2048

; PPU Registers (mirrored every 8 bytes)
.equ PPU_REGISTERS_START, 0x2000
.equ PPU_REGISTERS_END, 0x3FFF
.equ PPU_REGISTERS_SIZE, 8192

; APU and I/O Registers
.equ APU_REGISTERS_START, 0x4000
.equ APU_REGISTERS_END, 0x401F
.equ APU_REGISTERS_SIZE, 32

; Expansion ROM
.equ EXPANSION_START, 0x4020
.equ EXPANSION_END, 0x5FFF
.equ EXPANSION_SIZE, 8160

; Save RAM
.equ SRAM_START, 0x6000
.equ SRAM_END, 0x7FFF
.equ SRAM_SIZE, 8192

; PRG ROM Lower Bank (16KB)
.equ PRG_ROM_LOW_START, 0x8000
.equ PRG_ROM_LOW_END, 0xBFFF
.equ PRG_ROM_LOW_SIZE, 16384

; PRG ROM Higher Bank (16KB)
.equ PRG_ROM_HIGH_START, 0xC000
.equ PRG_ROM_HIGH_END, 0xFFFF
.equ PRG_ROM_HIGH_SIZE, 16384

; 外设定义
; Picture Processing Unit
.equ PPU_BASE, 0x2000
.equ PPU_PPUCTRL, 0x2000
.equ PPU_PPUMASK, 0x2001
.equ PPU_PPUSTATUS, 0x2002
.equ PPU_OAMADDR, 0x2003
.equ PPU_OAMDATA, 0x2004
.equ PPU_PPUSCROLL, 0x2005
.equ PPU_PPUADDR, 0x2006
.equ PPU_PPUDATA, 0x2007

; Audio Processing Unit
.equ APU_BASE, 0x4000
.equ APU_PULSE1_VOL, 0x4000
.equ APU_PULSE1_SWEEP, 0x4001
.equ APU_PULSE1_LO, 0x4002
.equ APU_PULSE1_HI, 0x4003
.equ APU_PULSE2_VOL, 0x4004
.equ APU_PULSE2_SWEEP, 0x4005
.equ APU_PULSE2_LO, 0x4006
.equ APU_PULSE2_HI, 0x4007
.equ APU_TRIANGLE, 0x4008
.equ APU_TRIANGLE_HI, 0x400B
.equ APU_NOISE_VOL, 0x400C
.equ APU_NOISE_HI, 0x400E
.equ APU_NOISE_LENGTH, 0x400F
.equ APU_DMC_RATE, 0x4010
.equ APU_DMC_RAW, 0x4011
.equ APU_DMC_START, 0x4012
.equ APU_DMC_LENGTH, 0x4013
.equ APU_OAMDMA, 0x4014
.equ APU_SNDCHN, 0x4015
.equ APU_JOY1, 0x4016
.equ APU_JOY2, 0x4017

; Controller Port 1
.equ INPUT1_BASE, 0x4016
.equ INPUT1_JOYPAD1, 0x4016

; Controller Port 2
.equ INPUT2_BASE, 0x4017
.equ INPUT2_JOYPAD2, 0x4017

; 中断向量定义
.equ RESET_VECTOR, 0  ; Reset
.equ NMI_VECTOR, 1  ; Non-Maskable Interrupt (VBlank)
.equ IRQ_VECTOR, 2  ; IRQ / BRK

; 宏定义
.macro ricoh_2a03_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
ricoh_2a03_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
