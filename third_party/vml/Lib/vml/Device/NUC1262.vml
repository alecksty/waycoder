; NUC1262SE寄存器定义
; 生成自: Nuvoton/NuMicro/NUC1262SE
; 版本: 1.0
; 日期: 2026-04-29
; 作者: VML Team
; 描述: 32-bit ARM Cortex-M4F MCU with 512KB Flash, 96KB SRAM, 72MHz, USB

; CPU架构: ARM-Cortex-M4F
; 位宽: 32位
; 时钟频率: 72000000 Hz

; 宏定义
.macro nuc1262se_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
nuc1262se_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
