; MSP432P401R寄存器定义
; 生成自: Texas Instruments/MSP432/MSP432P401R
; 版本: 1.0
; 日期: 2026-04-29
; 作者: VML Team
; 描述: 32-bit ARM Cortex-M4F MCU with 256KB Flash, 64KB SRAM, 48MHz, FPU

; CPU架构: ARM-Cortex-M4F
; 位宽: 32位
; 时钟频率: 48000000 Hz

; 外设定义
; eUSCI_A0 UART
.equ UART0_BASE, 0x40001000
.equ UART0_CTLW0, 0x00
.equ UART0_BRW, 0x06
.equ UART0_UCA0TXBUF, 0x08
.equ UART0_UCA0RXBUF, 0x0A
.equ UART0_IFG, 0x0C
.equ UART0_IE, 0x0E

; eUSCI_A1 UART
.equ UART1_BASE, 0x40002000
.equ UART1_CTLW0, 0x00
.equ UART1_BRW, 0x06
.equ UART1_TXBUF, 0x08
.equ UART1_RXBUF, 0x0A
.equ UART1_IFG, 0x0C
.equ UART1_IE, 0x0E

; Timer_A0 16bit
.equ TIMER0_BASE, 0x40003000
.equ TIMER0_CTL, 0x00
.equ TIMER0_R, 0x10
.equ TIMER0_CCR0, 0x12
.equ TIMER0_CCR1, 0x14
.equ TIMER0_CCR2, 0x16
.equ TIMER0_EX0, 0x20

; ADC14 14-bit
.equ ADC14_BASE, 0x40006000
.equ ADC14_CTL0, 0x00
.equ ADC14_CTL1, 0x02
.equ ADC14_LO, 0x04
.equ ADC14_HI, 0x06
.equ ADC14_MCTL0, 0x08
.equ ADC14_MEM0, 0x20

; 宏定义
.macro msp432p401r_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
msp432p401r_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
