; TM4C123GH6PM寄存器定义
; 生成自: Texas Instruments/Tiva C/TM4C123GH6PM
; 版本: 1.0
; 日期: 2026-04-29
; 作者: VML Team
; 描述: 32-bit ARM Cortex-M4F MCU with 256KB Flash, 32KB SRAM, 80MHz, USB

; CPU架构: ARM-Cortex-M4F
; 位宽: 32位
; 时钟频率: 80000000 Hz

; 外设定义
; UART 0
.equ UART0_BASE, 0x4000C000
.equ UART0_DR, 0x000
.equ UART0_FR, 0x018
.equ UART0_IBRD, 0x024
.equ UART0_FBRD, 0x028
.equ UART0_LCRH, 0x02C
.equ UART0_CTL, 0x030
.equ UART0_IM, 0x038
.equ UART0_RIS, 0x03C
.equ UART0_ICR, 0x044

; UART 1
.equ UART1_BASE, 0x4000D000
.equ UART1_DR, 0x000
.equ UART1_FR, 0x018
.equ UART1_IBRD, 0x024
.equ UART1_FBRD, 0x028
.equ UART1_LCRH, 0x02C
.equ UART1_CTL, 0x030

; GPIO Port A
.equ GPIOA_BASE, 0x40004000
.equ GPIOA_DATA, 0x3FC
.equ GPIOA_DIR, 0x400
.equ GPIOA_IS, 0x404
.equ GPIOA_IBE, 0x408
.equ GPIOA_IEV, 0x40C
.equ GPIOA_IM, 0x410
.equ GPIOA_RIS, 0x414
.equ GPIOA_MIS, 0x418
.equ GPIOA_ICR, 0x41C
.equ GPIOA_AFSEL, 0x420
.equ GPIOA_DEN, 0x51C

; 16/32-bit Timer 0
.equ TIMER0_BASE, 0x40030000
.equ TIMER0_CFG, 0x000
.equ TIMER0_TAMR, 0x004
.equ TIMER0_CTL, 0x00C
.equ TIMER0_ILR, 0x028
.equ TIMER0_V, 0x038
.equ TIMER0_ICR, 0x024

; ADC 0
.equ ADC0_BASE, 0x40038000
.equ ADC0_ACTSS, 0x000
.equ ADC0_EMUX, 0x014
.equ ADC0_SSMUX0, 0x040
.equ ADC0_SSFIFO0, 0x048
.equ ADC0_PROC, 0x030

; 宏定义
.macro tm4c123gh6pm_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
tm4c123gh6pm_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
