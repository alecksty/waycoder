; PIC16F877A寄存器定义
; 生成自: Microchip/PIC/PIC16F877A
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: 8-bit PIC microcontroller with 8KB Flash, 368 bytes RAM, 256 bytes EEPROM

; CPU架构: PIC16
; 位宽: 8位
; 时钟频率: 4000000 Hz

; 寄存器定义
; Working Register
.equ W, 0x00

; Status Register
.equ STATUS, 0x03
.equ STATUS_C, 0  ; Carry flag
.equ STATUS_DC, 1  ; Digit carry flag
.equ STATUS_Z, 2  ; Zero flag
.equ STATUS_PD, 3  ; Power-down flag
.equ STATUS_TO, 4  ; Time-out flag
.equ STATUS_RP, 5  ; Register bank select
.equ STATUS_IRP, 7  ; Indirect register bank select

; Interrupt Control Register
.equ INTCON, 0x0B
.equ INTCON_RBIF, 0  ; PORTB change interrupt flag
.equ INTCON_INTF, 1  ; External interrupt flag
.equ INTCON_TMR0IF, 2  ; TMR0 overflow interrupt flag
.equ INTCON_RBIE, 3  ; PORTB change interrupt enable
.equ INTCON_INTE, 4  ; External interrupt enable
.equ INTCON_TMR0IE, 5  ; TMR0 overflow interrupt enable
.equ INTCON_PEIE, 6  ; Peripheral interrupt enable
.equ INTCON_GIE, 7  ; Global interrupt enable

; PORT B
.equ PORTB, 0x06

; TRIS B
.equ TRISB, 0x86

; PORT C
.equ PORTC, 0x07

; TRIS C
.equ TRISC, 0x87

; PORT D
.equ PORTD, 0x08

; TRIS D
.equ TRISD, 0x88

; PORT E
.equ PORTE, 0x09

; TRIS E
.equ TRISE, 0x89

; Timer 0
.equ TMR0, 0x01

; Option Register
.equ OPTION_REG, 0x81

; Program Counter Low
.equ PCL, 0x02

; Program Counter Latch High
.equ PCLATH, 0x0A

; File Select Register
.equ FSR, 0x04

; EEPROM Data
.equ EEDATA, 0x10C

; EEPROM Address
.equ EEADR, 0x10D

; EEPROM Control 1
.equ EECON1, 0x18C
.equ EECON1_RD, 0  ; Read control
.equ EECON1_WR, 1  ; Write control
.equ EECON1_WREN, 2  ; Write enable
.equ EECON1_WRERR, 3  ; Write error flag
.equ EECON1_EEPGD, 7  ; EEPROM program/data select

; EEPROM Control 2
.equ EECON2, 0x18D

; A/D Result High
.equ ADRESH, 0x1E

; A/D Result Low
.equ ADRESL, 0x1F

; A/D Control 0
.equ ADCON0, 0x1F
.equ ADCON0_ADON, 0  ; A/D enable
.equ ADCON0_GO_DONE, 2  ; A/D conversion status
.equ ADCON0_CHS, 3  ; Channel select

; A/D Control 1
.equ ADCON1, 0x9F

; MSSP Status
.equ SSPSTAT, 0x94

; MSSP Control
.equ SSPCON, 0x14

; SSP Buffer
.equ SSPBUF, 0x13

; USART Transmit Register
.equ TXREG, 0x19

; USART Receive Register
.equ RCREG, 0x1A

; Baud Rate Generator
.equ SPBRG, 0x99

; TX Status and Control
.equ TXSTA, 0x98

; RX Status and Control
.equ RCSTA, 0x18

; CCP1 Control
.equ CCP1CON, 0x17

; CCP1 Low
.equ CCPR1L, 0x15

; CCP1 High
.equ CCPR1H, 0x16

; CCP2 Control
.equ CCP2CON, 0x1D

; CCP2 Low
.equ CCPR2L, 0x1B

; CCP2 High
.equ CCPR2H, 0x1C

; Timer 1 Control
.equ T1CON, 0x10

; Timer 1 Low
.equ TMR1L, 0x0E

; Timer 1 High
.equ TMR1H, 0x0F

; Timer 2 Control
.equ T2CON, 0x12

; Timer 2
.equ TMR2, 0x11

; Timer 2 Period
.equ PR2, 0x92

; 内存段定义
; Program Memory (8KB)
.equ PROGRAM_START, 0x0000
.equ PROGRAM_END, 0x1FFF
.equ PROGRAM_SIZE, 8192

; General Purpose RAM Bank 0
.equ DATA_START, 0x20
.equ DATA_END, 0x7F
.equ DATA_SIZE, 96

; General Purpose RAM Bank 1
.equ SRAM_START, 0xA0
.equ SRAM_END, 0xFF
.equ SRAM_SIZE, 96

; EEPROM Data Memory
.equ EEPROM_START, 0x2100
.equ EEPROM_END, 0x21FF
.equ EEPROM_SIZE, 256

; 外设定义
; Port B
.equ GPIO_PORTB_BASE, 0x06
.equ GPIO_PORTB_PORTB, 0x06
.equ GPIO_PORTB_TRISB, 0x86

; Port C
.equ GPIO_PORTC_BASE, 0x07
.equ GPIO_PORTC_PORTC, 0x07
.equ GPIO_PORTC_TRISC, 0x87

; Port D
.equ GPIO_PORTD_BASE, 0x08
.equ GPIO_PORTD_PORTD, 0x08
.equ GPIO_PORTD_TRISD, 0x88

; Timer 0
.equ TIMER0_BASE, 0x01
.equ TIMER0_TMR0, 0x01
.equ TIMER0_OPTION_REG, 0x81

; Timer 1
.equ TIMER1_BASE, 0x0E
.equ TIMER1_T1CON, 0x10
.equ TIMER1_TMR1L, 0x0E
.equ TIMER1_TMR1H, 0x0F

; Timer 2
.equ TIMER2_BASE, 0x11
.equ TIMER2_T2CON, 0x12
.equ TIMER2_TMR2, 0x11
.equ TIMER2_PR2, 0x92

; A/D Converter
.equ ADC_BASE, 0x1E
.equ ADC_ADRESH, 0x1E
.equ ADC_ADRESL, 0x9F
.equ ADC_ADCON0, 0x1F
.equ ADC_ADCON1, 0x9F

; Master Synchronous Serial Port
.equ MSSP_BASE, 0x13
.equ MSSP_SSPSTAT, 0x94
.equ MSSP_SSPCON, 0x14
.equ MSSP_SSPBUF, 0x13

; USART
.equ USART_BASE, 0x19
.equ USART_TXREG, 0x19
.equ USART_RCREG, 0x1A
.equ USART_SPBRG, 0x99
.equ USART_TXSTA, 0x98
.equ USART_RCSTA, 0x18

; Capture/Compare/PWM 1
.equ CCP1_BASE, 0x15
.equ CCP1_CCP1CON, 0x17
.equ CCP1_CCPR1L, 0x15
.equ CCP1_CCPR1H, 0x16

; Capture/Compare/PWM 2
.equ CCP2_BASE, 0x1B
.equ CCP2_CCP2CON, 0x1D
.equ CCP2_CCPR2L, 0x1B
.equ CCP2_CCPR2H, 0x1C

; 中断向量定义
.equ INT_VECTOR, 1  ; External Interrupt
.equ TMR0_VECTOR, 2  ; Timer 0 Overflow
.equ RB_VECTOR, 3  ; PORTB Change
.equ CCP1_VECTOR, 4  ; CCP1
.equ CCP2_VECTOR, 5  ; CCP2
.equ TMR1_VECTOR, 6  ; Timer 1 Overflow
.equ TMR2_VECTOR, 8  ; Timer 2 Overflow
.equ SPI_VECTOR, 9  ; SPI/I2C
.equ SCI_VECTOR, 10  ; USART Receive
.equ SCI_VECTOR, 11  ; USART Transmit
.equ ADC_VECTOR, 12  ; A/D Converter
.equ EEPROM_VECTOR, 13  ; EEPROM Write Complete

; 引脚定义
.equ PIN_MCLR_VPP, 1  ; Master Clear (Reset)
.equ PIN_RA0_AN0, 2  ; PORTA Bit 0 / Analog 0
.equ PIN_RA1_AN1, 3  ; PORTA Bit 1 / Analog 1
.equ PIN_RA2_AN2_VREF, 4  ; PORTA Bit 2 / Analog 2 / VREF-
.equ PIN_RA3_AN3_VREFP, 5  ; PORTA Bit 3 / Analog 3 / VREF+
.equ PIN_RA4_T0CKI, 6  ; PORTA Bit 4 / Timer 0 Clock Input
.equ PIN_RA5_AN4_SS, 7  ; PORTA Bit 4 / Analog 4 / SPI Slave Select
.equ PIN_RE0_RD_AN5, 8  ; PORTE Bit 0 / Read Control / Analog 5
.equ PIN_RE1_WR_AN6, 9  ; PORTE Bit 1 / Write Control / Analog 6
.equ PIN_RE2_CS_AN7, 10  ; PORTE Bit 2 / Chip Select / Analog 7
.equ PIN_VDD, 11  ; Positive Supply
.equ PIN_VSS, 12  ; Ground
.equ PIN_OSC1_CLKIN, 13  ; Oscillator/Clock Input
.equ PIN_OSC2_CLKOUT, 14  ; Oscillator/Clock Output
.equ PIN_RC0_T1OSO, 15  ; PORTC Bit 0 / Timer 1 Oscillator
.equ PIN_RC1_T1OSI, 16  ; PORTC Bit 1 / Timer 1 Oscillator
.equ PIN_RC2_CCP1, 17  ; PORTC Bit 2 / Capture/Compare/PWM 1
.equ PIN_RC3_SCK_SCL, 18  ; PORTC Bit 3 / SPI Clock / I2C Clock
.equ PIN_RC4_SDI_SDA, 23  ; PORTC Bit 4 / SPI Data In / I2C Data
.equ PIN_RC5_SDO, 24  ; PORTC Bit 5 / SPI Data Out
.equ PIN_RC6_TX, 25  ; PORTC Bit 6 / USART Transmit
.equ PIN_RC7_RX, 26  ; PORTC Bit 7 / USART Receive
.equ PIN_RD0, 19  ; PORTD Bit 0
.equ PIN_RD1, 20  ; PORTD Bit 1
.equ PIN_RD2, 21  ; PORTD Bit 2
.equ PIN_RD3, 22  ; PORTD Bit 3
.equ PIN_RD4, 27  ; PORTD Bit 4
.equ PIN_RD5, 28  ; PORTD Bit 5
.equ PIN_RD6, 29  ; PORTD Bit 6
.equ PIN_RD7, 30  ; PORTD Bit 7
.equ PIN_VSS, 31  ; Ground
.equ PIN_VDD, 32  ; Positive Supply
.equ PIN_RB0_INT, 33  ; PORTB Bit 0 / External Interrupt
.equ PIN_RB1, 34  ; PORTB Bit 1
.equ PIN_RB2, 35  ; PORTB Bit 2
.equ PIN_RB3_PGC, 36  ; PORTB Bit 3 / Programming Clock
.equ PIN_RB4_PGD, 37  ; PORTB Bit 4 / Programming Data
.equ PIN_RB5, 38  ; PORTB Bit 5
.equ PIN_RB6_PGC, 39  ; PORTB Bit 6 / Programming Clock
.equ PIN_RB7_PGD, 40  ; PORTB Bit 7 / Programming Data

; 宏定义
.macro pic16f877a_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
pic16f877a_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
