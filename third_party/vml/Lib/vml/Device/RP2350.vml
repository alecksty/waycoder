; RP2350寄存器定义
; 生成自: Raspberry/RP2/RP2350
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: Dual Cortex-M33 + RISC-V Hazard3 MCU with 520KB SRAM, 150MHz

; CPU架构: ARM-Cortex-M33
; 位宽: 32位
; 时钟频率: 150000000 Hz

; 寄存器定义
.equ R0, 0x00

.equ R1, 0x04

.equ R2, 0x08

.equ R3, 0x0C

.equ R4, 0x10

.equ R5, 0x14

.equ SP, 0x34

.equ LR, 0x38

.equ PC, 0x3C

; 内存段定义
; XIP Flash
.equ FLASH_START, 0x10000000
.equ FLASH_END, 0x107FFFFF
.equ FLASH_SIZE, 8388608

; Total SRAM
.equ SRAM_START, 0x20000000
.equ SRAM_END, 0x20081FFF
.equ SRAM_SIZE, 532480

.equ PERIPHERAL_START, 0x40000000
.equ PERIPHERAL_END, 0x5000FFFF
.equ PERIPHERAL_SIZE, 16777216

; 外设定义
; Single-Cycle I/O (GPIO)
.equ SIO_BASE, 0xD0000000
.equ SIO_GPIO_IN, 0x004
.equ SIO_GPIO_OUT, 0x010
.equ SIO_GPIO_OUT_SET, 0x014
.equ SIO_GPIO_OUT_CLR, 0x018
.equ SIO_GPIO_OUT_XOR, 0x01C
.equ SIO_GPIO_OE, 0x020
.equ SIO_GPIO_OE_SET, 0x024
.equ SIO_GPIO_OE_CLR, 0x028

; IO Bank 0 (GPIO control)
.equ IO_BANK0_BASE, 0x40028000
.equ IO_BANK0_GPIO0_STATUS, 0x000
.equ IO_BANK0_GPIO0_CTRL, 0x004
.equ IO_BANK0_GPIO1_STATUS, 0x008
.equ IO_BANK0_GPIO1_CTRL, 0x00C

; Pad controls for GPIO 0-29
.equ PADS_BANK0_BASE, 0x4002C000
.equ PADS_BANK0_GPIO0, 0x000
.equ PADS_BANK0_GPIO1, 0x004

; Reset Controller
.equ RESETS_BASE, 0x4000C000
.equ RESETS_RESET, 0x000
.equ RESETS_RESET_DONE, 0x008

; 中断向量定义
.equ RESET_VECTOR, 0  ; 
.equ SVCALL_VECTOR, 11  ; 

; 宏定义
.macro rp2350_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
rp2350_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
