; PIC18F4550寄存器定义
; 生成自: Microchip/PIC18/PIC18F4550
; 版本: 1.0
; 日期: 2026-04-16
; 作者: VML Team
; 描述: 8-bit PIC with USB 2.0, 32KB Flash, 2KB SRAM

; CPU架构: PIC18
; 位宽: 8位
; 时钟频率: 20000000 Hz

; 寄存器定义
; Working Register
.equ W, 0x0E

; Status Register
.equ STATUS, 0xFD8
.equ STATUS_C, 0  ; Carry Flag
.equ STATUS_DC, 1  ; Digit Carry Flag
.equ STATUS_Z, 2  ; Zero Flag
.equ STATUS_PD, 3  ; Power-Down Flag
.equ STATUS_TO, 4  ; Time-out Flag
.equ STATUS_RP, 0  ; Register Bank Select
.equ STATUS_IRP, 7  ; Indirect Register Bank Select

; Bank Select Register
.equ BSR, 0xFE0

; Port A
.equ PORTA, 0xF80

; Port B
.equ PORTB, 0xF81

; Port C
.equ PORTC, 0xF82

; Port D
.equ PORTD, 0xF83

; Port E
.equ PORTE, 0xF84

; Tri-state Port A
.equ TRISA, 0xF92

; Tri-state Port B
.equ TRISB, 0xF93

; Tri-state Port C
.equ TRISC, 0xF94

; Tri-state Port D
.equ TRISD, 0xF95

; Tri-state Port E
.equ TRISE, 0xF96

; Latch Port A
.equ LATA, 0xF89

; Latch Port B
.equ LATB, 0xF8A

; Latch Port C
.equ LATC, 0xF8B

; Latch Port D
.equ LATD, 0xF8C

; Latch Port E
.equ LATE, 0xF8D

; Interrupt Control
.equ INTCON, 0xFF2
.equ INTCON_RBIF, 0  ; Port B Interrupt Flag
.equ INTCON_INT0IF, 1  ; INT0 Interrupt Flag
.equ INTCON_TMR0IF, 2  ; Timer 0 Interrupt Flag
.equ INTCON_RBIE, 3  ; Port B Interrupt Enable
.equ INTCON_INT0IE, 4  ; INT0 Interrupt Enable
.equ INTCON_TMR0IE, 5  ; Timer 0 Interrupt Enable
.equ INTCON_PEIE, 6  ; Peripheral Interrupt Enable
.equ INTCON_GIE, 7  ; Global Interrupt Enable

; Peripheral Interrupt 1
.equ PIR1, 0xF9E

; Peripheral Interrupt 2
.equ PIR2, 0xF9F

; Peripheral Interrupt Enable 1
.equ PIE1, 0xF9D

; Peripheral Interrupt Enable 2
.equ PIE2, 0xF9C

; Interrupt Priority 1
.equ IPR1, 0xF9B

; Interrupt Priority 2
.equ IPR2, 0xF9A

; Reset Control
.equ RCON, 0xFD0
.equ RCON_NOT_TO, 3  ; Time-out Flag
.equ RCON_NOT_PD, 4  ; Power-Down Flag
.equ RCON_NOT_RI, 5  ; RESET Flag
.equ RCON_NOT_POR, 6  ; Power-on Reset Flag
.equ RCON_NOT_BOR, 7  ; Brown-out Reset Flag

; Timer 0 Control
.equ T0CON, 0xFD1

; Timer 0 Register
.equ TMR0, 0xFD6

; Timer 1 Control
.equ T1CON, 0xFCD

; Timer 1 Register High
.equ TMR1, 0xFCE

; Timer 1 Register Low
.equ TMR1L, 0xFCF

; Timer 2 Control
.equ T2CON, 0xFCA

; Timer 2 Register
.equ TMR2, 0xFCB

; Timer 3 Control
.equ T3CON, 0xFB1

; Timer 3 Register High
.equ TMR3, 0xFB3

; Timer 3 Register Low
.equ TMR3L, 0xFB2

; SSP Control 1
.equ SSPCON1, 0xFC6

; SSP Control 2
.equ SSPCON2, 0xFC5

; SSP Status
.equ SSPSTAT, 0xFC7

; SSP Buffer
.equ SSPBUF, 0xFC9

; SSP Shift Register
.equ SSPOR, 0xFC8

; A/D Control 0
.equ ADCON0, 0xFC2

; A/D Control 1
.equ ADCON1, 0xFC1

; A/D Control 2
.equ ADCON2, 0xFC0

; A/D Result
.equ ADRES, 0xFC3

; A/D Result Low
.equ ADRESL, 0xFC4

; CCP 1 Control
.equ CCP1CON, 0xFD4

; CCP 1 Register High
.equ CCPR1, 0xFD6

; CCP 1 Register Low
.equ CCPR1L, 0xFD5

; CCP 2 Control
.equ CCP2CON, 0xFBA

; CCP 2 Register High
.equ CCPR2, 0xFBB

; CCP 2 Register Low
.equ CCPR2L, 0xFBC

; USB Control
.equ USBCON, 0xF75

; USB Status
.equ USBSTAT, 0xF74

; USB Interrupt Enable
.equ UIE, 0xF73

; USB Interrupt Flag
.equ UIR, 0xF72

; USB Control
.equ UCON, 0xF71

; USB Status
.equ USTAT, 0xF70

; USB Endpoint 0
.equ UEP0, 0xF60

; USB Endpoint 1
.equ UEP1, 0xF61

; USB Endpoint 2
.equ UEP2, 0xF62

; USB Endpoint 3
.equ UEP3, 0xF63

; USB Endpoint 4
.equ UEP4, 0xF64

; 内存段定义
; Program Flash (32KB)
.equ FLASH_START, 0x0000
.equ FLASH_END, 0x7FFF
.equ FLASH_SIZE, 32768

; EEPROM (256B)
.equ EEPROM_START, 0xF00000
.equ EEPROM_END, 0xF000FF
.equ EEPROM_SIZE, 256

; SRAM (2KB)
.equ SRAM_START, 0x0000
.equ SRAM_END, 0x07FF
.equ SRAM_SIZE, 2048

; Access Bank
.equ ACCESS_START, 0x0000
.equ ACCESS_END, 
.equ ACCESS_SIZE, 1

; 外设定义
; Port A
.equ PORTA_BASE, 0xF80
.equ PORTA_PORT, 0xF80
.equ PORTA_TRIS, 0xF92
.equ PORTA_LAT, 0xF89

; Port B
.equ PORTB_BASE, 0xF81
.equ PORTB_PORT, 0xF81
.equ PORTB_TRIS, 0xF93
.equ PORTB_LAT, 0xF8A

; Port C
.equ PORTC_BASE, 0xF82
.equ PORTC_PORT, 0xF82
.equ PORTC_TRIS, 0xF94
.equ PORTC_LAT, 0xF8B

; Port D
.equ PORTD_BASE, 0xF83
.equ PORTD_PORT, 0xF83
.equ PORTD_TRIS, 0xF95
.equ PORTD_LAT, 0xF8C

; Port E
.equ PORTE_BASE, 0xF84
.equ PORTE_PORT, 0xF84
.equ PORTE_TRIS, 0xF96
.equ PORTE_LAT, 0xF8D

; Timer 0
.equ TIMER0_BASE, 0xFD1
.equ TIMER0_T0CON, 0xFD1
.equ TIMER0_TMR0, 0xFD6

; Timer 1
.equ TIMER1_BASE, 0xFCD
.equ TIMER1_T1CON, 0xFCD
.equ TIMER1_TMR1, 0xFCF
.equ TIMER1_TMR1L, 0xFCE

; Timer 2
.equ TIMER2_BASE, 0xFCA
.equ TIMER2_T2CON, 0xFCA
.equ TIMER2_TMR2, 0xFCB

; Timer 3
.equ TIMER3_BASE, 0xFB0
.equ TIMER3_T3CON, 0xFB0
.equ TIMER3_TMR3, 0xFB2

; A/D Converter
.equ ADC_BASE, 0xFC2
.equ ADC_ADCON0, 0xFC2
.equ ADC_ADCON1, 0xFC1
.equ ADC_ADCON2, 0xFC0
.equ ADC_ADRES, 0xFC3
.equ ADC_ADRESL, 0xFC4

; CCP 1
.equ CCP1_BASE, 0xFD4
.equ CCP1_CCP1CON, 0xFD4
.equ CCP1_CCPR1, 0xFD6
.equ CCP1_CCPR1L, 0xFD5

; CCP 2
.equ CCP2_BASE, 0xFBA
.equ CCP2_CCP2CON, 0xFBA
.equ CCP2_CCPR2, 0xFBB
.equ CCP2_CCPR2L, 0xFBC

; SSP (I2C/SPI)
.equ SSP_BASE, 0xFC6
.equ SSP_SSPCON1, 0xFC6
.equ SSP_SSPCON2, 0xFC5
.equ SSP_SSPSTAT, 0xFC7
.equ SSP_SSPBUF, 0xFC9
.equ SSP_SSPOV, 0xFC8

; EUSART
.equ EUSART_BASE, 0xF15
.equ EUSART_TXSTA, 0xFE2
.equ EUSART_RCSTA, 0xFE3
.equ EUSART_TXREG, 0xFAD
.equ EUSART_RCREG, 0xFAE
.equ EUSART_SPBRG, 0xFAF
.equ EUSART_SPBRGH, 0xFB0
.equ EUSART_BAUDCON, 0xFB8

; Comparators
.equ COMPARATOR_BASE, 0xFB4
.equ COMPARATOR_CMCON, 0xFB4
.equ COMPARATOR_CVRCON, 0xFB5

; USB Module
.equ USB_BASE, 0xF70
.equ USB_UCON, 0xF71
.equ USB_USTAT, 0xF72
.equ USB_UIR, 0xF73
.equ USB_UIE, 0xF74
.equ USB_UEP0, 0xF80
.equ USB_UEP1, 0xF81
.equ USB_UEP2, 0xF82
.equ USB_UEP3, 0xF83
.equ USB_BD0, 0xF00
.equ USB_BD1, 0xF08
.equ USB_BD2, 0xF10
.equ USB_BD3, 0xF18

; Oscillator
.equ OSCCON_BASE, 0xFD3
.equ OSCCON_OSCCON, 0xFD3
.equ OSCCON_OSCTUNE, 0xFD9

; Watchdog Timer
.equ WDTCON_BASE, 0xFD1
.equ WDTCON_WDTCON, 0xFD1

; 中断向量定义
.equ RESET_VECTOR, 0  ; RESET
.equ INT0_VECTOR, 1  ; External Interrupt 0
.equ INT1_VECTOR, 2  ; External Interrupt 1
.equ INT2_VECTOR, 3  ; External Interrupt 2
.equ TMR0_VECTOR, 4  ; Timer 0 Overflow
.equ TMR1_VECTOR, 5  ; Timer 1 Overflow
.equ TMR2_VECTOR, 6  ; Timer 2 Match
.equ TMR3_VECTOR, 7  ; Timer 3 Overflow
.equ CCP1_VECTOR, 8  ; CCP 1
.equ CCP2_VECTOR, 9  ; CCP 2
.equ SSP_VECTOR, 10  ; SSP
.equ TX_VECTOR, 11  ; USART TX
.equ RC_VECTOR, 12  ; USART RX
.equ ADC_VECTOR, 13  ; A/D
.equ RBO_VECTOR, 14  ; Port B Change
.equ EXT_VECTOR, 15  ; External

; 引脚定义
.equ PIN_RE3, 1  ; MCLR/VPP/RE3
.equ PIN_RA0, 2  ; AN0/RA0
.equ PIN_RA1, 3  ; AN1/RA1
.equ PIN_RA2, 4  ; AN2/VREF-/RA2
.equ PIN_RA3, 5  ; AN3/VREF+/RA3
.equ PIN_RA4, 6  ; AN4/T0CKI/RA4
.equ PIN_RA5, 7  ; AN5/RE5
.equ PIN_VSS, 8  ; Ground
.equ PIN_RA7, 9  ; OSC1/CLKI/RA7
.equ PIN_RA6, 10  ; OSC2/CLKO/RA6
.equ PIN_RC0, 11  ; T1OSO/T1CKI/RC0
.equ PIN_RC1, 12  ; T1OSI/RC1
.equ PIN_RC2, 13  ; CCP1/RC2
.equ PIN_RC3, 14  ; SCK/SCL/RC3
.equ PIN_RD0, 15  ; SDO/RD0
.equ PIN_RD1, 16  ; SDI/RD1
.equ PIN_RD2, 17  ; RD2
.equ PIN_RC6, 18  ; TX/CK/RC6
.equ PIN_RC7, 19  ; RX/DT/RC7
.equ PIN_VSS, 20  ; Ground
.equ PIN_RD3, 21  ; RD3
.equ PIN_RD4, 22  ; RD4
.equ PIN_RD5, 23  ; PWRB/RD5
.equ PIN_RD6, 24  ; PBC/RD6
.equ PIN_RD7, 25  ; PCD/RD7
.equ PIN_RC4, 26  ; D-/RC4
.equ PIN_RC5, 27  ; D+/RC5
.equ PIN_RE0, 28  ; AN5/RE0
.equ PIN_RE1, 29  ; AN6/RE1
.equ PIN_RE2, 30  ; AN7/RE2
.equ PIN_VSS, 31  ; Ground
.equ PIN_VDD, 32  ; Vdd

; 宏定义
.macro pic18f4550_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
pic18f4550_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
