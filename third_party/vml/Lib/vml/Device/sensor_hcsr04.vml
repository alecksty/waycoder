; HC_SR04寄存器定义
; 生成自: Generic/Sensor/HC_SR04
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: Ultrasonic Distance Sensor (2cm-400cm)

; CPU架构: Sensor
; 位宽: 8位
; 时钟频率: 0 Hz

; 内存段定义
; PCB Module (45x20x15mm)
.equ PACKAGE_START, 0x00
.equ PACKAGE_END, 0x00
.equ PACKAGE_SIZE, 0

; 外设定义
; HC-SR04 Ultrasonic Sensor (4.5V-5.5V)
.equ HC_SR04_BASE, 0x00
.equ HC_SR04_TRIG, 0x00
.equ HC_SR04_DISTANCE_H, 0x01
.equ HC_SR04_DISTANCE_L, 0x02
.equ HC_SR04_STATUS, 0x03
.equ HC_SR04_STATUS_BUSY, 0  ; 1=Measurement in progress
.equ HC_SR04_STATUS_VALID, 1  ; 1=Valid measurement available
.equ HC_SR04_STATUS_TIMEOUT, 2  ; 1=No echo received (out of range)

; 宏定义
.macro hc_sr04_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
hc_sr04_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
