; ESP32-C3寄存器定义
; 生成自: Espressif/ESP32-C/ESP32-C3
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: 32-bit RISC-V single-core WiFi + BLE SoC, 160MHz, 400KB SRAM

; CPU架构: RISC-V
; 位宽: 32位
; 时钟频率: 160000000 Hz

; 寄存器定义
; Return Address
.equ X1, 0x04

; Stack Pointer (SP)
.equ X2, 0x08

; Global Pointer (GP)
.equ X3, 0x0C

; Frame Pointer (FP)
.equ X8, 0x20

; Function Argument (A0)
.equ X10, 0x28

; Function Argument (A1)
.equ X11, 0x2C

; Program Counter
.equ PC, 0x3C

; 内存段定义
; Flash via Cache
.equ FLASH_START, 0x42000000
.equ FLASH_END, 0x427FFFFF
.equ FLASH_SIZE, 8388608

; Internal SRAM
.equ SRAM_START, 0x3FC80000
.equ SRAM_END, 0x3FCE3FFF
.equ SRAM_SIZE, 409600

.equ PERIPHERAL_START, 0x60000000
.equ PERIPHERAL_END, 0x600FFFFF
.equ PERIPHERAL_SIZE, 1048576

; 外设定义
; General Purpose I/O
.equ GPIO_BASE, 0x60004000
.equ GPIO_OUT, 0x04
.equ GPIO_OUT_W1TS, 0x08
.equ GPIO_OUT_W1TC, 0x0C
.equ GPIO_IN, 0x10
.equ GPIO_ENABLE, 0x20
.equ GPIO_ENABLE_W1TS, 0x24
.equ GPIO_ENABLE_W1TC, 0x28

; I/O MUX
.equ IO_MUX_BASE, 0x60009000
.equ IO_MUX_GPIO0, 0x00
.equ IO_MUX_GPIO1, 0x04
.equ IO_MUX_GPIO2, 0x08
.equ IO_MUX_GPIO3, 0x0C

; RTC Control
.equ RTC_CNTL_BASE, 0x60008000
.equ RTC_CNTL_OPTIONS0, 0x00
.equ RTC_CNTL_CLK_CONF, 0x30

; 中断向量定义
.equ RESET_VECTOR, 1  ; 
.equ MACHINESOFTWARE_VECTOR, 3  ; 
.equ MACHINETIMER_VECTOR, 7  ; 
.equ MACHINEEXTERNAL_VECTOR, 11  ; 

; 宏定义
.macro esp32_c3_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
esp32_c3_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
