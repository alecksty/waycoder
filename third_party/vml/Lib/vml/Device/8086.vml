; 8086寄存器定义
; 生成自: Intel/x86/8086
; 版本: 1.0
; 日期: 2026-04-17
; 作者: VML Team
; 描述: 16-bit microprocessor, first x86 processor

; CPU架构: x86
; 位宽: 16位
; 时钟频率: 5000000 Hz

; 寄存器定义
; Accumulator
.equ AX, 0
.equ AX_AH, 8  ; High byte of AX
.equ AX_AL, 0  ; Low byte of AX

; Base
.equ BX, 1
.equ BX_BH, 8  ; High byte of BX
.equ BX_BL, 0  ; Low byte of BX

; Counter
.equ CX, 2
.equ CX_CH, 8  ; High byte of CX
.equ CX_CL, 0  ; Low byte of CX

; Data
.equ DX, 3
.equ DX_DH, 8  ; High byte of DX
.equ DX_DL, 0  ; Low byte of DX

; Source Index
.equ SI, 4

; Destination Index
.equ DI, 5

; Base Pointer
.equ BP, 6

; Stack Pointer
.equ SP, 7

; Instruction Pointer
.equ IP, 8

; Code Segment
.equ CS, 9

; Data Segment
.equ DS, 10

; Extra Segment
.equ ES, 11

; Stack Segment
.equ SS, 12

; Flags Register
.equ FLAGS, 13
.equ FLAGS_CF, 0  ; Carry Flag
.equ FLAGS_PF, 2  ; Parity Flag
.equ FLAGS_AF, 4  ; Auxiliary Flag
.equ FLAGS_ZF, 6  ; Zero Flag
.equ FLAGS_SF, 7  ; Sign Flag
.equ FLAGS_TF, 8  ; Trap Flag
.equ FLAGS_IF, 9  ; Interrupt Enable Flag
.equ FLAGS_DF, 10  ; Direction Flag
.equ FLAGS_OF, 11  ; Overflow Flag

; 内存段定义
; 1MB address space
.equ CODE_START, 0x00000
.equ CODE_END, 0xFFFFF
.equ CODE_SIZE, 1048576

; Data memory
.equ DATA_START, 0x00000
.equ DATA_END, 0xFFFFF
.equ DATA_SIZE, 1048576

; Stack memory
.equ STACK_START, 0xF0000
.equ STACK_END, 0xFFFFF
.equ STACK_SIZE, 65536

; BIOS ROM
.equ BIOS_START, 0xF0000
.equ BIOS_END, 0xFFFFF
.equ BIOS_SIZE, 65536

; 外设定义
; Programmable Interrupt Controller
.equ PIC_BASE, 0x0020
.equ PIC_PIC1_CMD, 0x0020
.equ PIC_PIC1_DATA, 0x0021
.equ PIC_PIC2_CMD, 0x00A0
.equ PIC_PIC2_DATA, 0x00A1

; Programmable Interval Timer
.equ PIT_BASE, 0x0040
.equ PIT_PIT_CH0, 0x0040
.equ PIT_PIT_CH1, 0x0041
.equ PIT_PIT_CH2, 0x0042
.equ PIT_PIT_CMD, 0x0043

; Programmable Peripheral Interface
.equ PPI_BASE, 0x0060
.equ PPI_PPI_PA, 0x0060
.equ PPI_PPI_PB, 0x0061
.equ PPI_PPI_PC, 0x0062
.equ PPI_PPI_CMD, 0x0063

; 中断向量定义
.equ DIVIDE_ERROR_VECTOR, 0  ; Divide by zero
.equ DEBUG_VECTOR, 1  ; Single step
.equ NMI_VECTOR, 2  ; Non-maskable interrupt
.equ BREAKPOINT_VECTOR, 3  ; Breakpoint
.equ OVERFLOW_VECTOR, 4  ; INTO detected overflow
.equ IRQ0_VECTOR, 8  ; Timer interrupt
.equ IRQ1_VECTOR, 9  ; Keyboard interrupt
.equ IRQ2_VECTOR, 10  ; Cascade
.equ IRQ3_VECTOR, 11  ; COM2
.equ IRQ4_VECTOR, 12  ; COM1
.equ IRQ5_VECTOR, 13  ; LPT2
.equ IRQ6_VECTOR, 14  ; Floppy disk
.equ IRQ7_VECTOR, 15  ; LPT1

; 宏定义
.macro _8086_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
_8086_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
