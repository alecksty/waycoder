; MPU6050寄存器定义
; 生成自: InvenSense/TDK/Sensor/MPU6050
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: 6-Axis MEMS Accelerometer and Gyroscope (I2C)

; CPU架构: Sensor
; 位宽: 8位
; 时钟频率: 400000 Hz

; 内存段定义
; QFN-24 (4x4x0.9mm)
.equ PACKAGE_START, 0x00
.equ PACKAGE_END, 0x00
.equ PACKAGE_SIZE, 24

; 外设定义
; MPU6050 IMU (0x68/0x69, 2.375V-3.46V)
.equ MPU6050_BASE, 0x68
.equ MPU6050_SMPLRT_DIV, 0x19
.equ MPU6050_CONFIG, 0x1A
.equ MPU6050_CONFIG_DLPF_CFG, 0  ; Digital low-pass filter configuration
.equ MPU6050_GYRO_CONFIG, 0x1B
.equ MPU6050_GYRO_CONFIG_FS_SEL, 3  ; Gyro full scale: 0=±250, 1=±500, 2=±1000, 3=±2000 °/s
.equ MPU6050_ACCEL_CONFIG, 0x1C
.equ MPU6050_ACCEL_CONFIG_AFS_SEL, 3  ; Accel full scale: 0=±2g, 1=±4g, 2=±8g, 3=±16g
.equ MPU6050_ACCEL_XOUT_H, 0x3B
.equ MPU6050_ACCEL_XOUT_L, 0x3C
.equ MPU6050_ACCEL_YOUT_H, 0x3D
.equ MPU6050_ACCEL_YOUT_L, 0x3E
.equ MPU6050_ACCEL_ZOUT_H, 0x3F
.equ MPU6050_ACCEL_ZOUT_L, 0x40
.equ MPU6050_TEMP_OUT_H, 0x41
.equ MPU6050_TEMP_OUT_L, 0x42
.equ MPU6050_GYRO_XOUT_H, 0x43
.equ MPU6050_GYRO_XOUT_L, 0x44
.equ MPU6050_GYRO_YOUT_H, 0x45
.equ MPU6050_GYRO_YOUT_L, 0x46
.equ MPU6050_GYRO_ZOUT_H, 0x47
.equ MPU6050_GYRO_ZOUT_L, 0x48
.equ MPU6050_PWR_MGMT_1, 0x6B
.equ MPU6050_PWR_MGMT_1_DEVICE_RESET, 7  ; 1=Reset all internal registers
.equ MPU6050_PWR_MGMT_1_SLEEP, 6  ; 1=Sleep mode
.equ MPU6050_PWR_MGMT_1_CYCLE, 5  ; 1=Cycle mode
.equ MPU6050_PWR_MGMT_1_CLKSEL, 0  ; Clock source select
.equ MPU6050_WHO_AM_I, 0x75

; 宏定义
.macro mpu6050_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
mpu6050_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
