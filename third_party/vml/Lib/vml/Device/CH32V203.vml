; CH32V203寄存器定义
; 生成自: WCH/CH32V2/CH32V203
; 版本: 1.0
; 日期: 2026-04-28
; 作者: VML Team
; 描述: 32-bit RISC-V MCU with 64KB Flash, 20KB RAM, 144MHz

; CPU架构: RISC-V
; 位宽: 32位
; 时钟频率: 144000000 Hz

; 寄存器定义
; Return Address
.equ X1, 0x04

; Stack Pointer (SP)
.equ X2, 0x08

; Global Pointer (GP)
.equ X3, 0x0C

; Frame Pointer (FP)
.equ X8, 0x20

; Function Argument (A0)
.equ X10, 0x28

; Function Argument (A1)
.equ X11, 0x2C

; Program Counter
.equ PC, 0x3C

; 内存段定义
.equ FLASH_START, 0x08000000
.equ FLASH_END, 0x0800FFFF
.equ FLASH_SIZE, 65536

.equ SRAM_START, 0x20000000
.equ SRAM_END, 0x20004FFF
.equ SRAM_SIZE, 20480

.equ PERIPHERAL_START, 0x40000000
.equ PERIPHERAL_END, 0x4003FFFF
.equ PERIPHERAL_SIZE, 262144

; 外设定义
; Reset and Clock Control
.equ RCC_BASE, 0x40021000
.equ RCC_RCC_CTLR, 0x00
.equ RCC_RCC_CFGR0, 0x04
.equ RCC_RCC_APB2PCENR, 0x18
.equ RCC_RCC_APB2PCENR_IOPAEN, 2  ; GPIOA clock enable
.equ RCC_RCC_APB2PCENR_IOPBEN, 3  ; GPIOB clock enable
.equ RCC_RCC_APB2PCENR_IOPCEN, 4  ; GPIOC clock enable

; General Purpose I/O Port A
.equ GPIOA_BASE, 0x40010800
.equ GPIOA_CFGLR, 0x00
.equ GPIOA_CFGHR, 0x04
.equ GPIOA_INDR, 0x08
.equ GPIOA_OUTDR, 0x0C
.equ GPIOA_BSHR, 0x10
.equ GPIOA_BCR, 0x14

; General Purpose I/O Port B
.equ GPIOB_BASE, 0x40010C00
.equ GPIOB_CFGLR, 0x00
.equ GPIOB_CFGHR, 0x04
.equ GPIOB_INDR, 0x08
.equ GPIOB_OUTDR, 0x0C
.equ GPIOB_BSHR, 0x10
.equ GPIOB_BCR, 0x14

; General Purpose I/O Port C
.equ GPIOC_BASE, 0x40011000
.equ GPIOC_CFGLR, 0x00
.equ GPIOC_CFGHR, 0x04
.equ GPIOC_INDR, 0x08
.equ GPIOC_OUTDR, 0x0C
.equ GPIOC_BSHR, 0x10
.equ GPIOC_BCR, 0x14

; USART1
.equ USART1_BASE, 0x40013800
.equ USART1_USART_STATR, 0x00
.equ USART1_USART_DATAR, 0x04
.equ USART1_USART_BRR, 0x08
.equ USART1_USART_CTLR1, 0x0C

; 中断向量定义
.equ RESET_VECTOR, 1  ; 
.equ MACHINESOFTWARE_VECTOR, 3  ; 
.equ MACHINETIMER_VECTOR, 7  ; 
.equ MACHINEEXTERNAL_VECTOR, 11  ; 
.equ USART1_VECTOR, 25  ; USART1 Global Interrupt

; 宏定义
.macro ch32v203_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
ch32v203_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
