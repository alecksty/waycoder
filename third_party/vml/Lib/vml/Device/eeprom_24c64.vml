; 24C64寄存器定义
; 生成自: Generic/Memory/24C64
; 版本: 1.0
; 日期: 2026-05-06
; 作者: VML Team
; 描述: 24C64 64Kbit I2C Serial EEPROM (8K×8, 32-byte page write)

; CPU架构: Memory
; 位宽: 8位
; 时钟频率: 400000 Hz

; 内存段定义
; EEPROM main memory array (8KB, 32-byte page write)
.equ EEPROM_START, 0x00
.equ EEPROM_END, 0x1FFF
.equ EEPROM_SIZE, 8192

; 外设定义
; 24C64 I2C EEPROM (0x50-0x57, 1.7V-5.5V)
.equ _24C64_BASE, 0x50
.equ _24C64_ADDR_H, 0x00
.equ _24C64_ADDR_L, 0x01
.equ _24C64_DATA, 0x02
.equ _24C64_PAGE_SIZE, 0xFE
.equ _24C64_SIZE, 0xFD

; 宏定义
.macro _24c64_init
    ; 设备初始化代码
.endm

.macro read_register reg_addr
    ; 读取寄存器值到R0
    LOAD R0, [\reg_addr]
.endm

.macro write_register reg_addr, value
    ; 将值写入寄存器
    LOAD R1, \value
    STORE [\reg_addr], R1
.endm

; 常用函数
_24c64_init_proc:
    ; 设备初始化过程
    RET

read_register_proc:
    ; 参数: R0 = 寄存器地址
    ; 返回: R0 = 寄存器值
    LOAD R0, [R0]
    RET

write_register_proc:
    ; 参数: R0 = 寄存器地址, R1 = 值
    STORE [R0], R1
    RET
