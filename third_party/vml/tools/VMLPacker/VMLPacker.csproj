<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Authors>施探宇;alecksty</Authors>
    <Company>深圳市探索智能科技有限公司</Company>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <!-- Native AOT 发布 -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VMLPacker</AssemblyName>
    <Description>VML 程序打包工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VMLAssembler\VMLAssembler.csproj" />
    <ProjectReference Include="..\..\VMLRuntime\VMLRuntime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="main.vml" />
  </ItemGroup>

</Project>
