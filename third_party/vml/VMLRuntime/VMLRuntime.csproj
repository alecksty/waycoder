<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VMLAssembler\VMLAssembler.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Authors>施探宇;alecksty</Authors>
    <Company>深圳市探索智能科技有限公司</Company>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- FFI 动态委托创建使用反射发射，IL 链接器无法分析 -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- .NET 10+ 后备: 禁用 trim 分析器 (Roslyn 侧) -->
    <EnableTrimAnalyzer Condition="'$(EnableTrimAnalyzer)' == ''">false</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
