; float_ops.vml —— 浮点数运算自测（汇编层）
;
; 验的是两件事：
;   ① **汇编能不能初始化浮点数**：`.float`（4 字节 IEEE754 单精度）/ `.double`（8 字节双精度）
;      —— 2026-09-27 加的指令。此前只能 `.word <BitConverter 算出的位模式>`。
;   ② **浮点运算指令是通的**：FADD/FSUB/FMUL/FDIV/FNEG（单精度）、DADD/DDIV（双精度）、
;      I2F/F2I（整数⇄浮点）。
;
; 打印：`SYSCALL 8` 打 **F0**（浮动寄存器 0）；`SYSCALL 6` 打 R0（整数）。
; 期望输出（逐行）：
;   3.75   ← 1.5 + 2.25
;   -0.75  ← 1.5 - 2.25
;   3.375  ← 1.5 × 2.25
;   0.666... ← 1.5 ÷ 2.25
;   6.28   ← 双精度 3.14 × 2
;   7      ← 3.7 截断成整数
;   -16    ← `.float -0x10`（负数+十六进制）
;   255    ← `.word 0xFF`
;
; 编译运行（桌面秒级，手机上走 vml run）：
;   vmlcli Examples/vml/float_ops.vml
;   App 命令行页：vml run examples/vml/float_ops.vml

; ⚠⚠ **单精度运算指令是三操作数**：`FADD dst, src1, src2`（`dst = src1 op src2`）。
;   只写两个操作数**不报错**，但第三只寄存器读到的是**垃圾**（本仓实测过：
;   `FDIV F0, F1` 表现为"TIMER 恒等于除数 1000"）。双精度那两个（DADD/DMUL…）走的是
;   另一套实现，两操作数也成立 —— 所以别拿 D 的写法去推 F。

.data
a:        .float  1.5
b:        .float  2.25
pi:       .double 3.14
two:      .double 2.0
i3_7:     .float  3.7
neg:      .float  -0x10      ; **负数 + 十六进制**：-16.0（此前这种写法全线失效，见文件头）
hx:       .word   0xFF

.text
start:
    ; ── ① 单精度四则 ─────────────────────────────
    MOVEF F0, [a]
    MOVEF F1, [b]
    FADD  F2, F0, F1        ; ⚠ **三操作数**：F2 = F0 + F1（只写两个的话第三只读垃圾，见文件头）
    MOVEF F0, F2            ; 结果搬到 F0 才能打（SYSCALL 8 只打 F0）
    SYSCALL 8

    MOVEF F0, [a]
    MOVEF F1, [b]
    FSUB  F2, F0, F1
    MOVEF F0, F2
    SYSCALL 8

    MOVEF F0, [a]
    MOVEF F1, [b]
    FMUL  F2, F0, F1
    MOVEF F0, F2
    SYSCALL 8

    MOVEF F0, [a]
    MOVEF F1, [b]
    FDIV  F2, F0, F1
    MOVEF F0, F2
    SYSCALL 8

    ; ── ② 双精度：3.14 × 2 ───────────────────────
    MOVED D0, [pi]
    MOVED D1, [two]
    DMUL  D0, D1
    D2F   F0, D0            ; 转成单精度才能用 SYSCALL 8 打
    SYSCALL 8

    ; ── ③ 浮点→整数（截断）──────────────────────
    MOVEF F0, [i3_7]
    F2I   R0, F0            ; 3.7 → 3
    SYSCALL 6

    ; ── ④ 负数十六进制常量（此前 `-0x10` 会被当成字符串 ⇒ 读出来是垃圾）──
    MOVEF F0, [neg]         ; -16.0
    SYSCALL 8
    MOVE  R0, [hx]          ; 0xFF
    SYSCALL 6

    SYSCALL 3               ; Exit
