# 64 位比较「取值」结果写进 64 位寄存器视图。
#
# `a == b`（两个 long）作为**值**用时结果恒等于**左操作数**（实测 5 而非 1），
# 而 `if (a == b)` 分支形式正常 —— 说明比较与标志位都对，坏在「物化成 0/1」这一步。
#
# 根因：`MOVE R0, #imm` 只写 32 位视图 `registers[0]`，而 `R0..R7` 同时是长整数
# 寄存器 `longRegisters[0..7]`（`GetLongValue(R0)` 读的是后者，二者只在
# `SetLongValue` 里同步）。于是后续任何把该值按 64 位读的指令（如 `(int)` 强转
# 产生的 `L2I R0, R0`）读到的都是 `CMPL` 之后残留的左操作数。
#
# 修法：比较结果为 long（`l` / `isLong`）时，紧随 `MOVE R0, #0/#1` 补一句
# `I2L R0, R0` —— `ExecuteI2L` 对寄存器源读 32 位视图、再 `SetLongValue` 回写两套。
#
# 实测：`long a=5,b=5; (long)(a==b)` 5 → 1；`long <` 5 → 0；`a == 5L` 5 → 1。
diff --git a/third_party/vml/VMLPrepares/CompilerBase/ExpressionManager.cs b/third_party/vml/VMLPrepares/CompilerBase/ExpressionManager.cs
index d9a10917..d413cd6c 100644
--- a/third_party/vml/VMLPrepares/CompilerBase/ExpressionManager.cs
+++ b/third_party/vml/VMLPrepares/CompilerBase/ExpressionManager.cs
@@ -474,9 +474,11 @@ namespace CompilerBase
             };
             _emit(jmpOp, [Lbl(trueLabel)]);
             _emit(OpCode.MOVE, [R(0), Imm(0)]);
+            if (l) _emit(OpCode.I2L, [R(0), R(0)]);
             _emit(OpCode.JMP, [Lbl(endLabel)]);
             _placeLabel(trueLabel);
             _emit(OpCode.MOVE, [R(0), Imm(1)]);
+            if (l) _emit(OpCode.I2L, [R(0), R(0)]);
             _placeLabel(endLabel);
 
             return ExpVar.Reg(0, ExpType.I32);
@@ -755,10 +757,12 @@ namespace CompilerBase
 
             _emit(jmpOp, [Lbl(trueLabel)]);
             _emit(OpCode.MOVE, [R(0), Imm(0)]);
+            if (isLong) _emit(OpCode.I2L, [R(0), R(0)]);
             _emit(OpCode.JMP, [Lbl(endLabel)]);
 
             _placeLabel(trueLabel);
             _emit(OpCode.MOVE, [R(0), Imm(1)]);
+            if (isLong) _emit(OpCode.I2L, [R(0), R(0)]);
             _placeLabel(endLabel);
         }
 
