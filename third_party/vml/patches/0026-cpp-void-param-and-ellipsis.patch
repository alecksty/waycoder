+        /// 程序在预处理后必定碰到这个形态 —— 不认它就等于「C++ 用不了 C 标准头」。</para>
+        /// </summary>
+        private bool IsVoidOnlyParamList()
+            => Check(TokenType.VOID)
+               && _pos + 1 < _tokens.Count
+               && GetTokenType(_tokens[_pos + 1]) == TokenType.RPAREN;
