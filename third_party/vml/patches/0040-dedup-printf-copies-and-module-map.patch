-/* shared_vsnprintf — 被 vmlib.c 等调用的共享格式化函数 */
-int shared_vsnprintf(char *buf, const char *format, const int *args, int nargs)
-{
-    if (!buf || !format) return -1;
-    return _vformat_buf(format, args, nargs, buf, 0);
