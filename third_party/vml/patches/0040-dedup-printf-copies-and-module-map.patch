-/* 统计格式串中变参个数 */
-static int _count_args(const char *format)
-{
-    int n = 0;
-    const char *p = format;
-    while (*p) {
-        if (*p == '%') {
-            p++;
-            if (*p == '%' || *p == 0) { }
