<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Authors>施探宇;alecksty</Authors>
    <Company>深圳市探索智能科技有限公司</Company>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VMLAssembler\VMLAssembler.csproj" />
  </ItemGroup>

  <!-- 多语言资源（.resx 由 SDK 自动嵌入为 EmbeddedResource） -->
  <PropertyGroup>
    <EnableDefaultEmbeddedResourceItems>true</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <!-- 项目根 VERSION 文件（统一版本号） -->
  <ItemGroup>
    <Content Include="..\VERSION" Link="VERSION">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>