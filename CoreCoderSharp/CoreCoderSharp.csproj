<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CoreCoderSharp</RootNamespace>
    <!-- AOT 暂时禁用：Terminal.Gui v2 不支持 NativeAOT，待 v2 正式版后恢复 -->
    <PublishAot>false</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <AssemblyName>corecoder</AssemblyName>
    <!-- Terminal.Gui v2 迁移标志 -->
    <DefineConstants>$(DefineConstants);TERMINAL_GUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.*" />
    <PackageReference Include="Terminal.Gui" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="game/**/*.cs" />
    <None Remove="game/**/*" />
  </ItemGroup>

</Project>
