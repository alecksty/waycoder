<Window x:Class="WayCoder.Preview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:WayCoder.Preview.Render"
        Title="WayCoder .tui 预览" Height="640" Width="860"
        Background="Black">
    <DockPanel>
        <!-- 顶部：路径（可编辑组合框，记住最近打开的文件）+ 打开 -->
        <DockPanel DockPanel.Dock="Top" Margin="6">
            <Button x:Name="OpenBtn" DockPanel.Dock="Right" Content="打开…" Padding="16,3"
                    Margin="6,0,0,0" Click="OpenBtn_Click" />
            <ComboBox x:Name="PathBox" IsEditable="True" VerticalContentAlignment="Center"
                      Padding="2,1" ToolTip="输入 .tui 文件路径或资源名（如 dialogs/modelpicker.tui），或从下拉选择可用资源/最近打开" />
        </DockPanel>

        <!-- 底部控制栏（先停靠，保证始终可见）：左侧屏幕尺寸模拟 + 右侧缩放 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="6,0,6,4">
            <!-- 左侧：屏幕分辨率快选（下拉直接跳转）+ 行列微调 -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="屏幕:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White" />
                <ComboBox x:Name="SizeCombo" Width="88" VerticalAlignment="Center"
                          SelectionChanged="SizeCombo_SelectionChanged" />
                <TextBlock x:Name="SizeLabel" Text="80x25" Width="54" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="White" />
                <Button x:Name="SizeDecBtn" Content="−" Padding="8,3" Margin="4,0,0,0" Click="SizeDec_Click" />
                <Button x:Name="SizeIncBtn" Content="＋" Padding="8,3" Margin="2,0,0,0" Click="SizeInc_Click" />
                <TextBlock Text="|" VerticalAlignment="Center" Margin="10,0" Foreground="#555" />
                <CheckBox x:Name="GridToggle" Content="网格" VerticalAlignment="Center"
                          Foreground="White" Margin="0,0,6,0"
                          Checked="GridToggle_Checked" Unchecked="GridToggle_Checked" />
            </StackPanel>
            <!-- 右侧：缩放 -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="缩放:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White" />
                <TextBlock x:Name="ZoomLabel" Text="100%" Width="52" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="White" />
                <Button x:Name="ZoomOutBtn" Content="− 缩小" Padding="12,3" Margin="4,0,0,0"
                        Click="ZoomOut_Click" />
                <Button x:Name="ZoomInBtn" Content="＋ 放大" Padding="12,3" Margin="4,0,0,0"
                        Click="ZoomIn_Click" />
            </StackPanel>
            <!-- 末子填充剩余宽度 → 长滑块 -->
            <Slider x:Name="ZoomSlider" Minimum="25" Maximum="400" Value="100"
                    TickFrequency="25" VerticalAlignment="Center"
                    ValueChanged="ZoomSlider_ValueChanged" />
        </DockPanel>

        <!-- 底部：状态栏（黑底） -->
        <StatusBar DockPanel.Dock="Bottom" Background="Black" Foreground="White">
            <StatusBarItem x:Name="Status" Content="未加载文件（可传命令行参数或点“打开…”）" Foreground="White" />
        </StatusBar>

        <!-- 中部：预览区（最后填充剩余空间 → 高度由窗口决定，内容再大只在内部滚动，底栏不消失） -->
        <Border BorderBrush="#333" BorderThickness="0,1,0,1" Background="Black" Margin="0,6">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" Padding="8" Background="Black">
                <Grid x:Name="ContentHost">
                    <r:TuiGridPanel x:Name="Grid" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
