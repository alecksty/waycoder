# WayCoder 配置文件
# 复制此文件为 .env 并填入你的 API 密钥
# .env 已被 .gitignore 忽略，不会提交到 Git

# DeepSeek V4 Flash（默认模型）
WAYCODER_API_KEY=sk-在此填入你的密钥

# 切换为 DeepSeek V4 Pro（取消下面两行注释）
# WAYCODER_MODEL=deepseek-v4-pro
# WAYCODER_API_KEY=sk-在此填入你的DeepSeek密钥

# 切换为 OpenAI（取消下面两行注释）
# WAYCODER_MODEL=gpt-5.5
# WAYCODER_API_KEY=sk-在此填入你的OpenAI密钥
