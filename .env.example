# CoreCoder 配置文件
# 复制此文件为 .env 并填入你的 API 密钥
# .env 已被 .gitignore 忽略，不会提交到 Git

# DeepSeek V4 Flash（默认模型）
CORECODER_API_KEY=sk-bcf4794aba5940bab92668a42ab8ee02

# 切换为 DeepSeek V4 Pro（取消下面两行注释）
# CORECODER_MODEL=deepseek-v4-pro
# CORECODER_API_KEY=sk-在此填入你的DeepSeek密钥

# 切换为 OpenAI（取消下面两行注释）
# CORECODER_MODEL=gpt-5.5
# CORECODER_API_KEY=sk-在此填入你的OpenAI密钥
